{
 "id": "weekday/maariv/evening-shema-and-its-blessings:sefard",
 "refs": {
  "Weekday Siddur Sefard Linear, Maariv, Berachos Preceding Shema": {
   "edition": "metsudah-sefard-weekday",
   "he": {
    "16": "בָּרוּךְ  אַתָּה יְהֹוָה",
    "17": "אֱלֹהֵֽינוּ מֶֽלֶךְ הָעוֹלָם",
    "18": "אֲשֶׁר בִּדְבָרוֹ מַעֲרִיב עֲרָבִים",
    "19": "בְּחָכְמָה פּוֹתֵֽחַ שְׁעָרִים",
    "20": "וּבִתְבוּנָה",
    "21": "מְשַׁנֶּה עִתִּים",
    "22": "וּמַחֲלִיף אֶת הַזְּ֒מַנִּים",
    "23": "וּמְסַדֵּר אֶת הַכּוֹכָבִים",
    "24": "בְּמִשְׁמְ֒רוֹתֵיהֶם בָּרָקִֽיעַ",
    "25": "כִּרְצוֹנוֹ.",
    "26": "בּוֹרֵא יוֹם וָלָֽיְלָה",
    "27": "גּוֹלֵל אוֹר מִפְּ֒נֵי חֽשֶׁךְ",
    "28": "וְחֽשֶׁךְ מִפְּ֒נֵי אוֹר",
    "29": "וּמַעֲבִיר יוֹם",
    "30": "וּמֵבִיא לָֽיְלָה",
    "31": "וּמַבְדִּיל בֵּין יוֹם וּבֵין לָֽיְלָה",
    "32": "יְהֹוָה צְבָאוֹת שְׁמוֹ:",
    "33": "אֵל",
    "34": "חַי וְקַיָּם",
    "35": "תָּמִיד יִמְלֹךְ עָלֵֽינוּ",
    "36": "לְעוֹלָם וָעֶד.",
    "37": "בָּרוּךְ אַתָּה יְהֹוָה",
    "38": "הַמַּעֲרִיב עֲרָבִים:",
    "39": "אַהֲבַת עוֹלָם",
    "40": "בֵּית יִשְׂרָאֵל עַמְּ֒ךָ אָהָֽבְתָּ",
    "41": "תּוֹרָה וּמִצְוֹת",
    "42": "חֻקִּים וּמִשְׁפָּטִים",
    "43": "אוֹתָֽנוּ לִמַּֽדְתָּ.",
    "44": "עַל כֵּן יְהֹוָה אֱלֹהֵֽינוּ",
    "45": "בְּשָׁכְבֵֽנוּ וּבְקוּמֵֽנוּ",
    "46": "נָשִֽׂיחַ בְּחֻקֶּֽיךָ",
    "47": "וְנִשְׂמַח",
    "48": "בְּדִבְרֵי תַלמוּד תּוֹרָתֶֽךָ",
    "49": "וּבְמִצְוֹתֶֽיךָ לְעוֹלָם וָעֶד.",
    "50": "כִּי הֵם חַיֵּֽינוּ",
    "51": "וְאֹֽרֶךְ יָמֵֽינוּ",
    "52": "וּבָהֶם נֶהְגֶּה יוֹמָם וָלָֽיְלָה.",
    "53": "וְאַהֲבָתְ֒ךָ",
    "54": "אַל תָּסִיר מִמֶּֽנּוּ לְעוֹלָמִים.",
    "55": "בָּרוּךְ אַתָּה יְהֹוָה",
    "56": "אוֹהֵב עַמּוֹ יִשְׂרָאֵל:"
   },
   "en": {
    "16": "Blessed are You, Adonoy,",
    "17": "our God, King of the Universe,",
    "18": "With His word He brings on evenings,",
    "19": "with wisdom He opens the gates (of heaven);",
    "20": "and with understanding",
    "21": "changes the times",
    "22": "and alternates the seasons,",
    "23": "and arranges the stars",
    "24": "in their watches, in the sky,",
    "25": "according to His will.",
    "26": "He creates day and night,",
    "27": "He rolls the light away from before darkness,",
    "28": "and darkness from before light;",
    "29": "He causes day to pass",
    "30": "and brings night,",
    "31": "and separates between day and night;",
    "32": "Adonoy of Hosts is His Name.",
    "33": "The Almighty,",
    "34": "[Who is] living and enduring",
    "35": "will always reign over us",
    "36": "forever and ever.",
    "37": "Blessed are You, Adonoy,",
    "38": "Who brings on evening.",
    "39": "[With] An everlasting love",
    "40": "You loved the House of Israel, Your people.",
    "41": "Torah and commandments,",
    "42": "statutes and laws,",
    "43": "You taught us.",
    "44": "Therefore, Adonoy, our God,",
    "45": "when we lie down and when we rise,",
    "46": "we will discuss Your statutes,",
    "47": "and rejoice",
    "48": "in the words of the teachings of Your Torah",
    "49": "and in Your commandments forever.",
    "50": "For they are our life",
    "51": "and they lengthen our days,",
    "52": "and on them we will meditate day and night.",
    "53": "[May] Your love",
    "54": "never be removed from us",
    "55": "Blessed are You, Adonoy,",
    "56": "Who loves His people Israel."
   }
  },
  "Weekday Siddur Sefard Linear, Maariv, Shema": {
   "edition": "metsudah-sefard-weekday",
   "he": {
    "2": "אֵל מֶֽלֶךְ נֶאֱמָן:",
    "3": "<b>שְׁמַע יִשְׂרָאֵל</b>",
    "4": "<b>יְהֹוָה אֱלֹהֵֽינוּ יְהֹוָה אֶחָד:</b>",
    "6": "בָּרוּךְ שֵׁם",
    "7": "כְּבוֹד מַלְכוּתוֹ",
    "8": "לְעוֹלָם וָעֶד:",
    "9": "וְאָהַבְתָּ  אֵת יְהֹוָה אֱלֹהֶֽיךָ",
    "10": "בְּכָל֯־לְ֯בָבְ֒ךָ",
    "11": "וּבְכָל־נַפְשְׁךָ",
    "12": "וּבְכָל־מְאֹדֶֽךָ:",
    "13": "וְהָיוּ הַדְּ֒בָרִים הָאֵֽלֶּה",
    "14": "אֲשֶׁר֯ אָ֯נֹכִי מְצַוְּ֒ךָ הַיּוֹם",
    "15": "עַל֯־לְ֯בָבֶֽךָ:",
    "16": "וְשִׁנַּנְתָּם",
    "17": "לְבָנֶֽיךָ",
    "18": "וְדִבַּרְתָּ בָּם",
    "19": "בְּשִׁבְתְּ֒ךָ בְּבֵיתֶֽךָ",
    "20": "וּבְ֒לֶכְתְּךָ בַדֶּֽרֶךְ",
    "21": "וּבְ֒שָׁכְבְּךָ וּבְ֒קוּמֶֽךָ:",
    "22": "וּקְ֒שַׁרְתָּם לְאוֹת",
    "23": "עַל֯־יָ֯דֶֽךָ",
    "24": "וְהָיוּ לְטֹטָפֹת",
    "25": "בֵּין עֵינֶֽיךָ:",
    "26": "וּכְ֒תַבְתָּם",
    "27": "עַל־מְזֻזוֹת בֵּיתֶֽךָ",
    "28": "וּבִשְׁ֒עָרֶֽיךָ:",
    "29": "וְהָיָה",
    "30": "אִם־שָׁמֹֽעַ תִּשְׁמְעוּ אֶל־מִצְוֹתַי",
    "31": "אֲשֶׁר֯ אָ֯נֹכִי מְצַוֶּה אֶתְ֒כֶם הַיּוֹם",
    "32": "לְאַהֲבָה אֶת־יְהֹוָה אֱלֹהֵיכֶם",
    "33": "וּלְ֒עָבְ֒דוֹ",
    "34": "בְּכָל־לְבַבְ֒כֶם",
    "35": "וּבְכָל־נַפְשְׁכֶם:",
    "36": "וְנָתַתִּי מְטַר֯־אַ֯רְצְכֶם",
    "37": "בְּעִתּוֹ",
    "38": "יוֹרֶה",
    "39": "וּמַלְקוֹשׁ",
    "40": "וְאָסַפְתָּ דְגָנֶֽךָ",
    "41": "וְתִירשְׁךָ וְיִצְהָרֶֽךָ:",
    "42": "וְנָתַתִּי עֵֽשֶׂב֯",
    "43": "בְּ֯שָׂדְ֒ךָ לִבְ֒הֶמְתֶּֽךָ",
    "44": "וְאָכַלְתָּ וְשָׂבָֽעְתָּ:",
    "45": "הִשָּׁמְ֒רוּ לָכֶם פֶּן֯־יִ֯פְתֶּה לְבַבְ֒כֶם",
    "46": "וְסַרְתֶּם",
    "47": "וַעֲבַדְתֶּם אֱלֹהִים֯ אֲ֯חֵרִים",
    "48": "וְהִשְׁתַּחֲוִיתֶם לָהֶם:",
    "49": "וְחָרָה אַף־יְהֹוָה בָּכֶם",
    "50": "וְעָצַר֯ אֶ֯ת־הַשָּׁמַֽיִם",
    "51": "וְלֹּא֯־יִ֯הְיֶה מָטָר",
    "52": "וְהָאֲדָמָה לֹא תִתֵּן אֶת֯־יְ֯בוּלָהּ",
    "53": "וַאֲבַדְתֶּם֯ מְ֯הֵרָה",
    "54": "מֵעַל הָאָֽרֶץ הַטֹּבָה",
    "55": "אֲשֶׁר֯ יְ֯הֹוָה נֹתֵן לָכֶם:",
    "56": "וְשַׂמְתֶּם֯ אֶ֯ת־דְּבָרַי֯ אֵֽ֯לֶּה",
    "57": "עַל֯־לְ֯בַבְ֒כֶם וְעַל־נַפְשְׁ֒כֶם",
    "58": "וּקְ֒שַׁרְתֶּם֯ אֹ֯תָם לְאוֹת",
    "59": "עַלּ־יֶּדְ֒כֶם",
    "60": "וְהָיוּ לְטוֹטָפֹת",
    "61": "בֵּין עֵינֵיכֶם:",
    "62": "וְלִמַּדְתֶּם֯ אֹ֯תָם אֶת־בְּנֵיכֶם",
    "63": "לְדַבֵּר בָּם",
    "64": "בְּשִׁבְתְּךָ בְּבֵיתֶֽךָ",
    "65": "וּבְ֒לֶכְתְּ֒ךָ בַדֶּֽרֶךְ",
    "66": "וּבְ֒שָׁכְבְּ֒ךָ וּבְ֒קוּמֶֽךָ:",
    "67": "וּכְ֒תַבְתָּם",
    "68": "עַל־מְזוּזוֹת בֵּיתֶֽךָ",
    "69": "וּבִשְׁ֒עָרֶֽיךָ:",
    "70": "לְמַֽעַן֯ יִ֯רְבּוּ יְמֵיכֶם",
    "71": "וִימֵי בְנֵיכֶם",
    "72": "עַל הָאֲדָמָה",
    "73": "אֲשֶׁר נִשְׁבַּע יְהֹוָה לַאֲבֹתֵיכֶם",
    "74": "לָתֵת לָהֶם",
    "75": "כִּימֵי הַשָּׁמַֽיִם עַל־הָאָֽרֶץ:",
    "76": "וַֽיֹּאמֶר֯ יְהֹוָה אֶ֯ל־משֶׁה לֵּאמֹר:",
    "77": "דַּבֵּר֯ אֶ֯ל־בְּנֵי יִשְׂרָאֵל",
    "78": "וְאָמַרְתָּ אֲלֵהֶם",
    "79": "וְעָשׂוּ לָהֶם צִיצִת",
    "80": "עַל־כַּנְ֒פֵי בִגְ֒דֵיהֶם",
    "81": "לְדֹרֹתָם",
    "82": "וְנָתְ֒נוּ עַל־צִיצִת",
    "83": "הַכָּנָף֯",
    "84": "פְּ֯תִיל תְּכֵֽלֶת:",
    "85": "וְהָיָה לָכֶם לְצִיצִת",
    "86": "וּרְ֒אִיתֶם֯ אֹ֯תוֹ",
    "87": "וּזְ֒כַרְתֶּם֯",
    "88": "אֶ֯ת־כָּל־מִצְוֹת֯ יְ֯הֹוָה",
    "89": "וַעֲשִׂיתֶם֯ אֹ֯תָם",
    "90": "וְלֹא תָתֽוּרוּ אַחֲרֵי לְבַבְ֒כֶם",
    "91": "וְאַחֲרֵי עֵינֵיכֶם",
    "92": "אֲשֶׁר֯־אַ֯תֶּם זֹנִים֯ אַ֯חֲרֵיהֶם:",
    "93": "לְמַֽעַן תִּזְכְּרוּ",
    "94": "וַעֲשִׂיתֶם֯ אֶ֯ת־כָּל־מִצְוֹתָי",
    "95": "וִהְיִיתֶם קְדשִׁים לֵאלֹהֵיכֶם:",
    "96": "אֲנִי יְהֹוָה אֱלֹהֵיכֶם֯",
    "97": "אֲ֯שֶׁר הוֹצֵֽאתִי אֶתְ֒כֶם֯",
    "98": "מֵּאֶֽרֶץ מִצְרַֽיִם",
    "99": "לִהְיוֹת לָכֶם לֵאלֹהִים֯",
    "100": "אֲ֯נִי יְהֹוָה אֱלֹהֵיכֶם֯:",
    "102": "אֱ֯מֶת",
    "104": "יְהֹוָה אֱלֹהֵיכֶם֯ אֱ֯מֶת:"
   },
   "en": {
    "1": "<small>The following three words should be said when praying without a minyan:</small>",
    "2": "(Almighty, faithful King)",
    "3": "<b>Hear, Israel:</b>",
    "4": "<b>Adonoy is our God, Adonoy is One.</b>",
    "5": "<small>The following three lines are to be said silently:</small>",
    "6": "Blessed [is His] Name,",
    "7": "Whose glorious kingdom",
    "8": "is forever and ever.",
    "9": "And you shall love Adonoy your God",
    "10": "with all your heart",
    "11": "and with all your soul",
    "12": "and with all your possessions.",
    "13": "And these words",
    "14": "which I command you today,",
    "15": "shall be upon your heart.",
    "16": "And you shall teach them sharply",
    "17": "to your children.",
    "18": "And you shall discuss them",
    "19": "when you sit in your house,",
    "20": "and when you travel on the road,",
    "21": "and when you lie down and when you rise.",
    "22": "And you shall bind them for a sign",
    "23": "upon your hand,",
    "24": "and they shall be for <i>totafos</i>",
    "25": "between your eyes.",
    "26": "And you shall write them",
    "27": "upon the doorposts of your house",
    "28": "and upon your gateways.",
    "29": "And it will be—",
    "30": "if you vigilantly obey My commandments",
    "31": "which I command you this day,",
    "32": "to love Adonoy your God,",
    "33": "and serve Him",
    "34": "with your entire hearts",
    "35": "and with your entire souls—",
    "36": "that I will give rain for your land",
    "37": "in its proper time,",
    "38": "the early (autumn) rain",
    "39": "and the late (spring) rain;",
    "40": "and you will harvest your grain",
    "41": "and your wine and your oil.",
    "42": "And I will put grass",
    "43": "in your fields for your cattle,",
    "44": "and you will eat and be satisfied.",
    "45": "Beware lest your hearts be swayed",
    "46": "and you turn astray,",
    "47": "and you worship alien gods",
    "48": "and bow to them.",
    "49": "And Adonoy's fury will blaze among you,",
    "50": "and He will close off the heavens",
    "51": "and there will be no rain",
    "52": "and the earth will not yield its produce;",
    "53": "and you will perish swiftly",
    "54": "from the good land",
    "55": "which Adonoy gives you.",
    "56": "Place these words of Mine",
    "57": "upon your hearts and upon your souls,—",
    "58": "and bind them for a sign",
    "59": "upon your hands,",
    "60": "and they shall be for <i>totafos</i>",
    "61": "between your eyes.",
    "62": "And you shall teach them to your sons,",
    "63": "to speak them",
    "64": "when you sit in your house,",
    "65": "and when you travel on the road,",
    "66": "and when you lie down and when you rise.",
    "67": "And you shall write them",
    "68": "upon the doorposts of your house",
    "69": "and upon your gateways.",
    "70": "In order that your days be prolonged,",
    "71": "and the days of your children,",
    "72": "upon the land",
    "73": "which Adonoy swore to your fathers",
    "74": "to give them [for as long]",
    "75": "as the heavens are above the earth.",
    "76": "And Adonoy spoke to Moses saying:",
    "77": "Speak to the children of Israel,",
    "78": "and tell them",
    "79": "to make for themselves fringes",
    "80": "on the corners of their garments",
    "81": "throughout their generations;",
    "82": "and they will place with the fringes",
    "83": "of each corner",
    "84": "a thread of blue.",
    "85": "And it will be to you for fringes,",
    "86": "and you will look upon it",
    "87": "and you will remember",
    "88": "all the commandments of Adonoy,",
    "89": "and you will perform them;",
    "90": "and you will not turn aside after your hearts",
    "91": "and after your eyes",
    "92": "which cause you to go astray.",
    "93": "In order that you will remember",
    "94": "and perform all My commandments;",
    "95": "and you will be holy unto your God.",
    "96": "I am Adonoy, your God,",
    "97": "Who brought you out",
    "98": "of the land of Egypt",
    "99": "to be your God:",
    "100": "I am Adonoy, your God—",
    "102": "—is true—",
    "104": "Adonoy, your God, is true."
   }
  },
  "Weekday Siddur Sefard Linear, Maariv, Berachos Following Shema": {
   "edition": "metsudah-sefard-weekday",
   "he": {
    "2": "וֶאֱמוּנָה  כָּל זֹאת",
    "3": "וְקַיָּם עָלֵֽינוּ",
    "4": "כִּי הוּא יְהֹוָה אֱלֹהֵֽינוּ",
    "5": "וְאֵין זוּלָתוֹ",
    "6": "וַאֲנַֽחְנוּ יִשְׂרָאֵל עַמּוֹ:",
    "7": "הַפּוֹדֵֽנוּ",
    "8": "מִיַּד מְלָכִים",
    "9": "מַלְכֵּֽנוּ הַגּוֹאֲלֵֽנוּ",
    "10": "מִכַּף כָּל הֶעָרִיצִים:",
    "11": "הָאֵל",
    "12": "הַנִּפְרָע לָֽנוּ",
    "13": "מִצָּרֵֽינוּ",
    "14": "וְהַמְ֒שַׁלֵּם גְּמוּל",
    "15": "לְכָל אֹיְ֒בֵי נַפְשֵֽׁנוּ:",
    "16": "הָעֹשֶׂה גְדוֹלוֹת",
    "17": "עַד אֵין חֵֽקֶר",
    "18": "נִסִּים וְנִפְלָאוֹת עַד אֵין מִסְפָּר:",
    "19": "הַשָּׂם נַפְשֵֽׁנוּ בַּחַיִּים",
    "20": "וְלֹא נָתַן לַמּוֹט רַגְלֵֽנוּ",
    "21": "הַמַּדְרִיכֵֽנוּ",
    "22": "עַל בָּמוֹת אֹיְ֒בֵֽינוּ",
    "23": "וַיָּֽרֶם קַרְנֵֽנוּ",
    "24": "עַל כָּל שׂוֹנְ֒אֵֽינוּ:",
    "25": "הָעֹֽשֶׂה לָּֽנוּ נִסִּים",
    "26": "וּנְקָמָה בְּפַרְעֹה",
    "27": "אוֹתוֹת וּמוֹפְ֒תִים",
    "28": "בְּאַדְמַת בְּנֵי חָם:",
    "29": "הַמַּכֶּה בְעֶבְרָתוֹ",
    "30": "כָּל בְּכוֹרֵי מִצְרָֽיִם",
    "31": "וַיּוֹצֵא אֶת עַמּוֹ יִשְׂרָאֵל",
    "32": "מִתּוֹכָם",
    "33": "לְחֵרוּת עוֹלָם:",
    "34": "הַמַּעֲבִיר בָּנָיו",
    "35": "בֵּין גִּזְרֵי",
    "36": "יַם סוּף",
    "37": "אֶת רוֹדְ֒פֵיהֶם וְאֶת שׂוֹנְ֒אֵיהֶם",
    "38": "בִּתְהוֹמוֹת טִבַּע:",
    "39": "וְרָאוּ בָנָיו גְּבוּרָתוֹ",
    "40": "שִׁבְּ֒חוּ וְהוֹדוּ לִשְׁמוֹ.",
    "41": "וּמַלְכוּתוֹ",
    "42": "בְרָצוֹן קִבְּ֒לוּ עֲלֵיהֶם",
    "43": "משֶׁה וּבְנֵי יִשְׂרָאֵל",
    "44": "לְךָ עָנוּ שִׁירָה בְּשִׂמְחָה רַבָּה",
    "45": "וְאָמְ֒רוּ כֻלָּם:",
    "46": "מִי כָמֹֽכָה  בָּאֵלִם יְהֹוָה",
    "47": "מִי כָּמֹֽכָה",
    "48": "נֶאְדָּר בַּקֹּֽדֶשׁ",
    "49": "נוֹרָא תְהִלֹּת עֹֽשֵׂה פֶלֶא:",
    "50": "מַלְכוּתְךָ רָאוּ בָנֶֽיךָ",
    "51": "בּוֹקֵֽעַ יָם לִפְנֵי משֶׁה",
    "52": "זֶה אֵלִי עָנוּ",
    "53": "וְאָמְ֒רוּ:",
    "54": "יְהֹוָה יִמְלֹךְ לְעֹלָם וָעֶד:",
    "55": "וְנֶאֱמַר",
    "56": "כִּי פָדָה יְהֹוָה אֶת יַעֲקֹב",
    "57": "וּגְאָלוֹ",
    "58": "מִיַּד חָזָק מִמֶּֽנּוּ.",
    "59": "בָּרוּךְ אַתָּה יְהֹוָה",
    "60": "גָּאַל יִשְׂרָאֵל:",
    "62": "הַשְׁכִּיבֵֽנוּ  יְהֹוָה אֱלֹהֵֽינוּ לְשָׁלוֹם",
    "63": "וְהַעֲמִידֵֽנוּ מַלְכֵּֽנוּ לְחַיִּים",
    "64": "טוֹבִים וּלְשָׁלוֹם",
    "65": "וּפְרוֹשׂ עָלֵֽינוּ סֻכַּת שְׁלוֹמֶֽךָ",
    "66": "וְתַקְּ֒נֵֽנוּ",
    "67": "בְּעֵצָה טוֹבָה מִלְּ֒פָנֶֽיךָ",
    "68": "וְהוֹשִׁיעֵֽנוּ מְהֵרָה לְמַֽעַן שְׁמֶֽךָ.",
    "69": "וְהָגֵן בַּעֲדֵֽנוּ וְהָסֵר מֵעָלֵֽינוּ",
    "70": "אוֹיֵב דֶּֽבֶר וְחֶֽרֶב",
    "71": "וְרָעָב וְיָגוֹן",
    "72": "וְהָסֵר שָׂטָן מִלְּ֒פָנֵֽינוּ",
    "73": "וּמֵאַחֲרֵֽינוּ",
    "74": "וּבְצֵל כְּנָפֶֽיךָ תַּסְתִּירֵֽנוּ.",
    "75": "כִּי אֵל",
    "76": "שׁוֹמְ֒רֵֽנוּ וּמַצִּילֵֽנוּ אָֽתָּה",
    "77": "כִּי אֵל",
    "78": "מֶֽלֶךְ חַנּוּן וְרַחוּם אָֽתָּה.",
    "79": "וּשְׁמוֹר צֵאתֵֽנוּ וּבוֹאֵֽנוּ",
    "80": "לְחַיִּים וּלְשָׁלוֹם",
    "81": "מֵעַתָּה וְעַד עוֹלָם.",
    "82": "בָּרוּךְ אַתָּה יְהֹוָה",
    "83": "שׁוֹמֵר עַמּוֹ יִשְׂרָאֵל לָעַד:",
    "85": "בָּרוּךְ יְהֹוָה לְעוֹלָם",
    "86": "אָמֵן וְאָמֵן:",
    "87": "בָּרוּךְ יְהֹוָה מִצִּיּוֹן",
    "88": "שֹׁכֵן יְרוּשָׁלָֽםִ",
    "89": "הַלְ֒לוּיָהּ:",
    "90": "בָּרוּךְ יְהֹוָה אֱלֹהִים",
    "91": "אֱלֹהֵי יִשְׂרָאֵל",
    "92": "עֹשֵׂה נִפְלָאוֹת לְבַדּוֹ:",
    "93": "וּבָרוּךְ שֵׁם כְּבוֹדוֹ לְעוֹלָם",
    "94": "וְיִמָּלֵא כְבוֹדוֹ אֶת כָּל הָאָֽרֶץ",
    "95": "אָמֵן וְאָמֵן:",
    "96": "יְהִי כְבוֹד יְהֹוָה לְעוֹלָם",
    "97": "יִשְׂמַח יְהֹוָה בְּמַעֲשָׂיו:",
    "98": "יְהִי שֵׁם יְהֹוָה מְבֹרָךְ",
    "99": "מֵעַתָּה וְעַד עוֹלָם:",
    "100": "כִּי לֹא יִטּשׁ יְהֹוָה אֶת עַמּוֹ",
    "101": "בַּעֲבוּר שְׁמוֹ הַגָּדוֹל",
    "102": "כִּי הוֹאִיל יְהֹוָה",
    "103": "לַעֲשׂוֹת אֶתְכֶם לוֹ לְעָם:",
    "104": "וַיַּרְא כָּל הָעָם",
    "105": "וַיִּפְּ֒לוּ עַל פְּנֵיהֶם וַיֹּאמְ֒רוּ",
    "106": "יְהֹוָה הוּא הָאֱלֹהִים",
    "107": "יְהֹוָה הוּא הָאֱלֹהִים:",
    "108": "וְהָיָה יְהֹוָה לְמֶֽלֶךְ",
    "109": "עַל כָּל הָאָֽרֶץ",
    "110": "בַּיּוֹם הַהוּא יִהְיֶה יְהֹוָה אֶחָד",
    "111": "וּשְׁמוֹ אֶחָד:",
    "112": "יְהִי חַסְדְּ֒ךָ יְהֹוָה עָלֵֽינוּ",
    "113": "כַּאֲשֶׁר יִחַֽלְנוּ לָךְ:",
    "114": "הוֹשִׁיעֵֽנוּ יְהֹוָה אֱלֹהֵֽינוּ",
    "115": "וְקַבְּ֒צֵֽנוּ מִן הַגּוֹיִם",
    "116": "לְהוֹדוֹת לְשֵׁם קָדְשֶֽׁךָ",
    "117": "לְהִשְׁתַּבֵּֽחַ בִּתְהִלָּתֶֽךָ:",
    "118": "כָּל גּוֹיִם אֲשֶׁר עָשִֽׂיתָ",
    "119": "יָבֹֽאוּ וְיִשְׁתַּחֲווּ",
    "120": "לְפָנֶֽיךָ אֲדֹנָי",
    "121": "וִיכַבְּ֒דוּ לִשְׁמֶֽךָ:",
    "122": "כִּי גָדוֹל אַתָּה וְעֹשֵׂה נִפְלָאוֹת",
    "123": "אַתָּה אֱלֹהִים לְבַדֶּֽךָ:",
    "124": "וַאֲנַֽחְנוּ",
    "125": "עַמְּ֒ךָ וְצֹאן מַרְעִיתֶֽךָ",
    "126": "נוֹדֶה לְּךָ לְעוֹלָם",
    "127": "לְדוֹר וָדוֹר",
    "128": "נְסַפֵּר תְּהִלָּתֶֽךָ:",
    "129": "בָּרוּךְ יְהֹוָה בַּיּוֹם",
    "130": "בָּרוּךְ יְהֹוָה בַּלָּֽיְלָה",
    "131": "בָּרוּךְ יְהֹוָה בְּשָׁכְבֵֽנוּ",
    "132": "בָּרוּךְ יְהֹוָה בְּקוּמֵֽנוּ:",
    "133": "כִּי בְיָדְ֒ךָ",
    "134": "נַפְשׁוֹת הַחַיִּים וְהַמֵּתִים",
    "135": "אֲשֶׁר בְּיָדוֹ",
    "136": "נֶֽפֶשׁ כָּל חָי",
    "137": "וְרֽוּחַ כָּל בְּשַׂר אִישׁ:",
    "138": "בְּיָדְ֒ךָ אַפְקִיד רוּחִי",
    "139": "פָּדִֽיתָה אוֹתִי",
    "140": "יְהֹוָה אֵל אֱמֶת:",
    "141": "אֱלֹהֵֽינוּ שֶׁבַּשָּׁמַֽיִם",
    "142": "יַחֵד שִׁמְךָ",
    "143": "וְקַיֵּם מַלְכוּתְ֒ךָ תָּמִיד",
    "144": "וּמְלֹךְ עָלֵֽינוּ לְעוֹלָם וָעֶד:",
    "145": "יִרְאוּ עֵינֵֽינוּ",
    "146": "וְיִשְׂמַח לִבֵּֽנוּ וְתָגֵל נַפְשֵֽׁנוּ",
    "147": "בִּישׁוּעָתְ֒ךָ בֶּאֱמֶת",
    "148": "בֶּאֱמֹר לְצִיּוֹן",
    "149": "מָלַךְ אֱלֹהָֽיִךְ:",
    "150": "יְהֹוָה מֶֽלֶךְ יְהֹוָה מָלָךְ",
    "151": "יְהֹוָה יִמְלֹךְ לְעוֹלָם וָעֶד:",
    "152": "כִּי הַמַּלְכוּת שֶׁלְּ֒ךָ הִיא",
    "153": "וּלְעֽוֹלְ֒מֵי עַד תִּמְלֹךְ בְּכָבוֹד",
    "154": "כִּי אֵין לָֽנוּ מֶֽלֶךְ אֶלָּא אָֽתָּה:",
    "155": "בָּרוּךְ אַתָּה יְהֹוָה",
    "156": "הַמֶּֽלֶךְ בִּכְבוֹדוֹ",
    "157": "תָּמִיד יִמְלוֹךְ עָלֵֽינוּ",
    "158": "לְעוֹלָם וָעֶד",
    "159": "וְעַל כָּל מַעֲשָׂיו:"
   },
   "en": {
    "2": "—and faithful is all this,",
    "3": "and it is permanently established with us",
    "4": "that he is Adonoy, our God,",
    "5": "and there is nothing besides Him,",
    "6": "and that we, Israel, are His people.",
    "7": "[He] Who liberated us",
    "8": "from the hand of kings,",
    "9": "[is] our King, Who redeemed us",
    "10": "from the grasp of all the tyrants.",
    "11": "[He is] the Almighty",
    "12": "Who exacts payment [punishment]",
    "13": "from our oppressors,",
    "14": "and brings retribution",
    "15": "on all those who are enemies of our soul.",
    "16": "He does great things",
    "17": "beyond comprehension,",
    "18": "miracles and wonders without number.",
    "19": "He sustains our soul in life",
    "20": "and does not allow our feet to slip.",
    "21": "He makes us tread",
    "22": "upon the high places of our enemies,",
    "23": "and exalts our strength",
    "24": "over all who hate us.",
    "25": "He performed miracles for us",
    "26": "and vengeance upon Pharaoh,",
    "27": "signs and wonders",
    "28": "in the land of the Hamites.",
    "29": "He slew in His wrath,",
    "30": "all the firstborn of Egypt,",
    "31": "and brought out His people, Israel,",
    "32": "from their midst",
    "33": "to everlasting freedom.",
    "34": "He led His children",
    "35": "through the divided parts of",
    "36": "the Sea of Reeds,",
    "37": "their pursuers and their enemies",
    "38": "He drowned in its depths.",
    "39": "And His children saw His mighty power—",
    "40": "they praised and gave thanks to His Name,",
    "41": "His sovereignty",
    "42": "they willingly accepted;",
    "43": "Moses and the children of Israel",
    "44": "sang unto You with great joy,",
    "45": "and they all said:",
    "46": "“Who is like You among the mighty, Adonoy!",
    "47": "Who is like You?",
    "48": "[You are] adorned in holiness,",
    "49": "awesome in praise, performing wonders”",
    "50": "Your children beheld Your sovereignty",
    "51": "when You divided the sea before Moses.",
    "52": "“This is my God,” they exclaimed,",
    "53": "and declared,",
    "54": "“Adonoy will reign forever and ever.”",
    "55": "And it is said,",
    "56": "“For Adonoy has liberated Jacob",
    "57": "and redeemed him",
    "58": "from a hand, mightier than his.”",
    "59": "Blessed are You, Adonoy",
    "60": "Who has redeemed Israel.",
    "62": "Adonoy our God; make us lie down in peace,",
    "63": "our King, raise us again",
    "64": "to good life, and peace",
    "65": "Spread over us the shelter of Your peace,",
    "66": "and direct us to better ourselves",
    "67": "through Your good counsel;",
    "68": "and deliver us speedily for Your Name's sake.",
    "69": "Shield us, and remove from us",
    "70": "enemies, pestilence, sword,",
    "71": "famine and sorrow.",
    "72": "Remove the adversary from before us",
    "73": "and from behind us,",
    "74": "and shelter us in the shadow of Your wings.",
    "75": "For, Almighty,",
    "76": "You are our Protector and Rescuer,",
    "77": "For, Almighty",
    "78": "You are a gracious and merciful King.",
    "79": "Guard our going out and our coming in",
    "80": "for life and peace",
    "81": "for now forever.",
    "82": "Blessed are You, Adonoy,",
    "83": "Who guards His people Israel forever.",
    "85": "Blessed is Adonoy forever,",
    "86": "Amein and Amein!",
    "87": "Blessed is Adonoy from Zion",
    "88": "Who dwells in Jerusalem,",
    "89": "Praise God.",
    "90": "Blessed is Adonoy, God,",
    "91": "God of Israel",
    "92": "Who alone performs wonders.",
    "93": "Blessed is the Name of His glory forever",
    "94": "and may His glory fill the whole earth;",
    "95": "Amein and Amein!",
    "96": "The Glory of Adonoy will endure forever;",
    "97": "Adonoy will rejoice in His works.",
    "98": "The Name of Adonoy will be blessed",
    "99": "from now forever.",
    "100": "For Adonoy will not cast off His people,",
    "101": "for the sake of His great Name,",
    "102": "because Adonoy has determined",
    "103": "to make you His people.",
    "104": "And all the people saw it",
    "105": "and they fell on their faces, and proclaimed,",
    "106": "“Adonoy, He is God!",
    "107": "Adonoy, He is God!”",
    "108": "And Adonoy will be King",
    "109": "over the whole earth;",
    "110": "on that day Adonoy will be One",
    "111": "and His Name One.",
    "112": "Adonoy, may Your kindness be upon us",
    "113": "as we have hoped for You.",
    "114": "Deliver us, Adonoy, our God,",
    "115": "gather us from the nations",
    "116": "to give thanks to Your Holy Name,",
    "117": "to be extolled in Your praise.",
    "118": "All the nations which You have made",
    "119": "will come and bow down",
    "120": "before You, my Master,",
    "121": "and they will give honor to Your Name.",
    "122": "For You are great and do wondrous things,",
    "123": "You alone are God.",
    "124": "And we,",
    "125": "Your people, the sheep of Your pasture,",
    "126": "will give thanks to You forever,",
    "127": "from generation to generation",
    "128": "we will recount Your praise.",
    "129": "Blessed is Adonoy by day,",
    "130": "Blessed is Adonoy by night,",
    "131": "Blessed is Adonoy when we lie down,",
    "132": "Blessed is Adonoy when we rise.",
    "133": "For in Your hand",
    "134": "are the souls of the living and the dead:",
    "135": "[as it is written]: for in His hand",
    "136": "is the soul of every living thing,",
    "137": "and the spirit of every human being.",
    "138": "In Your hand, I commit my spirit;",
    "139": "You have liberated me",
    "140": "Adonoy, Almighty of truth.",
    "141": "Our God in heaven,",
    "142": "reveal the unity of Your Name,",
    "143": "preserve Your kingdom always",
    "144": "and reign over us forever and ever.",
    "145": "May our eyes behold,",
    "146": "our heart rejoice, and our soul exalt",
    "147": "in Your true deliverance,",
    "148": "when it will be said to Zion:",
    "149": "“Your God has begun His reign.”",
    "150": "“Adonoy is King, Adonoy was King",
    "151": "Adonoy will reign for ever and ever”",
    "152": "For the kingdom is Yours",
    "153": "and to all eternity, You will reign in glory;",
    "154": "for we have no king except You.",
    "155": "Blessed are You,",
    "156": "the King in His glory,",
    "157": "will always reign over us",
    "158": "forever and ever,",
    "159": "and over all His creation."
   }
  }
 }
