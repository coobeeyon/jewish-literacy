{
 "id": "weekday/maariv/mourners-kaddish:sefard",
 "refs": {
  "Weekday Siddur Sefard Linear, Maariv, Aleinu": {
   "edition": "metsudah-sefard-weekday",
   "he": {
    "110": "<b>יִתְגַּדַּל</b> וְיִתְקַדַּשׁ שְׁמֵהּ רַבָּא",
    "111": "בְּעָלְמָא דִּי בְרָא",
    "112": "כִרְעוּתֵהּ",
    "113": "וְיַמְלִיךְ מַלְכוּתֵהּ",
    "114": "וְיַצְמַח פּוּרְ֒קָנֵהּ",
    "115": "וִיקָרֵב (קֵץ) מְשִׁיחֵהּ.",
    "116": "בְּחַיֵּיכוֹן וּבְיוֹמֵיכוֹן",
    "117": "וּבְחַיֵּי",
    "118": "דְכָל בֵּית יִשְׂרָאֵל.",
    "119": "בַּעֲגָלָא וּבִזְמַן קָרִיב.",
    "120": "וְאִמְרוּ אָמֵן:",
    "121": "<b>יְהֵא שְׁמֵהּ רַבָּא מְבָרַךְ</b>",
    "122": "לְעָלַם וּלְעָלְמֵי עָלְמַיָּא:",
    "123": "יִתְבָּרַךְ וְיִשְׁתַּבַּח",
    "124": "וְיִתְפָּאַר וְיִתְרוֹמַם וְיִתְנַשֵּׂא",
    "125": "וְיִתְהַדָּר וְיִתְעַלֶּה וְיִתְהַלָּל",
    "126": "שְׁמֵהּ דְקֻדְשָׁא. בְּרִיךְ הוּא",
    "127": "לְעֵלָּא (<small>בעשי\"ת</small> וּלְעֵלָּא מִכָּל) ",
    "128": "מִן כָּל בִּרְכָתָא וְשִׁירָתָא.",
    "129": "תֻּשְׁבְּחָתָא וְנֶחֱמָתָא.",
    "130": "דַּאֲמִירָן בְּעָלְמָא. וְאִמְרוּ אָמֵן:",
    "131": "יְהֵא שְׁלָמָא רַבָּא מִן שְׁמַיָּא",
    "132": "וְחַיִּים",
    "133": "עָלֵֽינוּ וְעַל כָּל יִשְׂרָאֵל.",
    "134": "וְאִמְרוּ אָמֵן:",
    "135": "עוֹשֶׂה שָׁלוֹם בִּמְרוֹמָיו",
    "136": "הוּא יַעֲשֶׂה שָׁלוֹם",
    "137": "עָלֵֽינוּ וְעַל כָּל יִשְׂרָאֵל",
    "138": "וְאִמְרוּ אָמֵן:"
   },
   "en": {
    "110": "Exalted and sanctified be His great Name",
    "111": "in the world which He created",
    "112": "according to His will",
    "113": "and may He rule His kingdom",
    "114": "bring forth His redemption",
    "115": "and hasten the coming of His Mashiach",
    "116": "in your lifetime and in your days,",
    "117": "and in the lifetime",
    "118": "of the entire House of Israel,",
    "119": "speedily and in the near future—",
    "120": "and say Amein.",
    "121": "May His great Name be blessed",
    "122": "forever and for all eternity.",
    "123": "Blessed and praised,",
    "124": "glorified, and exalted and uplifted,",
    "125": "honored and elevated and extolled",
    "126": "be the Name of the Holy One, blessed is He;",
    "127": "above (<i>Ten Days of Penitence:</i> far above)",
    "128": "all the blessings and hymns,",
    "129": "praises and consolations",
    "130": "which we utter in the world—and say Amein.",
    "131": "May there be abundant peace from heaven",
    "132": "and life",
    "133": "for us and for all Israel,",
    "134": "—and say Amein.",
    "135": "He Who makes peace in His high heavens",
    "136": "may He, make peace",
    "137": "for us and for all Israel,",
    "138": "—and say Amein."
   }
  }
 }
}
