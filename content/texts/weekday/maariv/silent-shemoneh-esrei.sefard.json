{
 "id": "weekday/maariv/silent-shemoneh-esrei:sefard",
 "refs": {
  "Weekday Siddur Sefard Linear, Maariv, Shemoneh Esrei": {
   "edition": "metsudah-sefard-weekday",
   "he": {
    "1": "אֲדֹנָי שְׂפָתַי תִּפְתָּח",
    "2": "וּפִי יַגִּיד תְּהִלָּתֶֽךָ:",
    "4": "בָּרוּךְ אַתָּה יְהֹוָה",
    "5": "אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ",
    "6": "אֱלֹהֵי אַבְרָהָם אֱלֹהֵי יִצְחָק",
    "7": "וֵאלֹהֵי יַעֲקֹב",
    "8": "הָאֵל",
    "9": "הַגָּדוֹל הַגִּבּוֹר וְהַנּוֹרָא",
    "10": "אֵל עֶלְיוֹן",
    "11": "גּוֹמֵל חֲסָדִים טוֹבִים",
    "12": "וְקוֹנֵה הַכֹּל",
    "13": "וְזוֹכֵר חַסְ֒דֵי אָבוֹת",
    "14": "וּמֵבִיא גוֹאֵל",
    "15": "לִבְנֵי בְנֵיהֶם",
    "16": "לְמַֽעַן שְׁמוֹ בְּאַהֲבָה:",
    "18": "זָכְ֒רֵֽנוּ לְחַיִּים",
    "19": "מֶֽלֶךְ חָפֵץ בַּחַיִּים",
    "20": "וְכָתְ֒בֵֽנוּ בְּסֵֽפֶר הַחַיִּים",
    "21": "לְמַעַנְ֒ךָ אֱלֹהִים חַיִּים:",
    "23": "מֶֽלֶךְ עוֹזֵר וּמוֹשִֽׁיעַ וּמָגֵן:",
    "24": "בָּרוּךְ אַתָּה יְהֹוָה",
    "25": "מָגֵן אַבְרָהָם:",
    "27": "אַתָּה גִבּוֹר לְעוֹלָם אֲדֹנָי",
    "28": "מְחַיֶּה מֵתִים אַתָּה",
    "29": "רַב לְהוֹשִֽׁיעַ:",
    "31": "מוֹרִיד הַטָּל",
    "33": "מַשִּׁיב הָרֽוּחַ",
    "34": "וּמוֹרִיד הַגֶּֽשֶׁם:",
    "36": "מְכַלְכֵּל חַיִּים בְּחֶֽסֶד",
    "37": "מְחַיֵּה מֵתִים בְּרַחֲמִים רַבִּים",
    "38": "סוֹמֵךְ נוֹפְ֒לִים",
    "39": "וְרוֹפֵא חוֹלִים",
    "40": "וּמַתִּיר אֲסוּרִים",
    "41": "וּמְ֒קַיֵּם אֱמוּנָתוֹ",
    "42": " לִישֵׁנֵי עָפָר,",
    "43": "מִי כָמֽוֹךָ בַּֽעַל גְּבוּרוֹת",
    "44": "וּמִי דּֽוֹמֶה לָּךְ",
    "45": "מֶֽלֶךְ מֵמִית וּמְ֒חַיֶּה",
    "46": "וּמַצְמִֽיחַ יְשׁוּעָה:",
    "48": "מִי כָמֽוֹךָ אָב הָרַחַמָן",
    "49": "זוֹכֵר יְצוּרָיו לְחַיִּים",
    "50": "בְּרַחֲמִים:",
    "52": "וְנֶאֱמָן אַתָּה",
    "53": "לְהַחֲיוֹת מֵתִים:",
    "54": "בָּרוּךְ אַתָּה יְהֹוָה",
    "55": "מְחַיֵּה הַמֵּתִים:",
    "57": "אַתָּה קָדוֹשׁ וְשִׁמְךָ קָדוֹשׁ",
    "58": "וּקְ֒דוֹשִׁים",
    "59": "בְּכָל יוֹם יְהַלְ֒לֽוּךָ סֶּֽלָה:",
    "60": "כִּי אֵל מֶֽלֶךְ",
    "61": "גָּדוֹל וְקָדוֹשׁ אָֽתָּה:",
    "63": "בָּרוּךְ אַתָּה יְהֹוָה",
    "64": "הָאֵל הַקָּדוֹשׁ:",
    "66": "בָּרוּךְ אַתָּה יְהֹוָה",
    "67": "הַמֶּֽלֶךְ הַקָּדוֹשׁ:",
    "70": "אַתָּה חוֹנֵן לְאָדָם דַּֽעַת",
    "71": "וּמְ֒לַמֵּד לֶאֱנוֹשׁ בִּינָה:",
    "72": "(אַתָּה חוֹנַנְתָּֽנוּ",
    "73": "לְמַדַּע תּוֹרָתֶֽךָ.",
    "74": "וַתְּ֒לַמְּ֒דֵֽנוּ",
    "75": "לַעֲשׂוֹת חֻקֵּי רְצוֹנֶֽךָ.",
    "76": "וַתַּבְדֵּל יְהֹוָה אֱלֹהֵֽינוּ",
    "77": "בֵּין קֹֽדֶשׁ לְחֹל",
    "78": "בֵּין אוֹר לְחֽשֶׁךְ",
    "79": "בֵּין יִשְׂרָאֵל לָעַמִּים",
    "80": "בֵּין יוֹם הַשְּׁ֒בִיעִי",
    "81": "לְשֵֽׁשֶׁת יְמֵי הַמַּעֲשֶׂה.",
    "82": "אָבִֽינוּ מַלְכֵּֽנוּ",
    "83": "הָחֵל עָלֵֽינוּ",
    "84": "הַיָּמִים הַבָּאִים לִקְרָאתֵֽנוּ",
    "85": "לְשָׁלוֹם",
    "86": "חֲשׂוּכִים מִכָּל חֵטְא",
    "87": "וּמְנֻקִּים מִכָּל עָוֹן",
    "88": "וּמְדֻבָּקִים בְּיִרְאָתֶֽךָ:)",
    "89": "וְחָנֵּֽנוּ מֵאִתְּ֒ךָ",
    "90": "חָכְמָה בִּינָה וָדָּֽעַת",
    "91": "בָּרוּךְ אַתָּה יְהֹוָה",
    "92": "חוֹנֵן הַדָּֽעַת:",
    "94": "הֲשִׁיבֵֽנוּ אָבִֽינוּ",
    "95": "לְתוֹרָתֶֽךָ",
    "96": "וְקָרְ֒בֵֽנוּ מַלְכֵּֽנוּ לַעֲבוֹדָתֶֽךָ",
    "97": "וְהַחֲזִירֵֽנוּ",
    "98": "בִּתְ֒שׁוּבָה שְׁלֵמָה לְפָנֶֽיךָ:",
    "99": "בָּרוּךְ אַתָּה יְהֹוָה",
    "100": "הָרוֹצֶה בִּתְ֒שׁוּבָה:",
    "102": "סְלַח לָֽנוּ אָבִֽינוּ כִּי חָטָֽאנוּ",
    "103": "מְחַל לָֽנוּ מַלְכֵּֽנוּ",
    "104": " כִּי פָשָֽׁעְנוּ,",
    "105": "כִּי אֵל טוֹב וְסַלָּח אָֽתָּה:",
    "106": "בָּרוּךְ אַתָּה יְהֹוָה",
    "107": "חַנּוּן הַמַּרְבֶּה לִסְלֽוֹחַ:",
    "109": "רְאֵה נָא בְעָנְיֵֽנוּ",
    "110": "וְרִֽיבָה רִיבֵֽנוּ",
    "111": "וּגְ֒אָלֵֽנוּ",
    "112": "גְאוּלָה שְׁלֵמָה מְהֵרָה",
    "113": "לְמַֽעַן שְׁמֶֽךָ",
    "114": "כִּי אֵל גּוֹאֵל חָזָק אָֽתָּה:",
    "115": "בָּרוּךְ אַתָּה יְהֹוָה",
    "116": "גּוֹאֵל יִשְׂרָאֵל:",
    "119": "רְפָאֵֽנוּ יְהֹוָה וְנֵרָפֵא",
    "120": "הוֹשִׁיעֵֽנוּ וְנִוָּשֵֽׁעָה",
    "121": "כִּי תְהִלָּתֵֽנוּ אָֽתָּה",
    "122": "וְהַעֲלֵה אֲרוּכָה וּמַרְפֵּא",
    "123": "לְכָל תַּחֲלוּאֵֽינוּ",
    "124": "וּלְ֒כָל מַכְאוֹבֵֽינוּ",
    "125": "וּלְ֒כָל מַכּוֹתֵֽינוּ",
    "126": "כִּי אֵל מֶֽלֶךְ",
    "127": "רוֹפֵא נֶאֱמָן וְרַחֲמָן אָֽתָּה:",
    "128": "בָּרוּךְ אַתָּה יְהֹוָה",
    "129": "רוֹפֵא חוֹלֵי עַמּוֹ יִשְׂרָאֵל:",
    "131": "בָּרֵךְ עָלֵֽינוּ יְהֹוָה אֱלֹהֵֽינוּ",
    "132": "אֶת הַשָּׁנָה הַזֹּאת",
    "133": "וְאֶת כָּל מִינֵי תְבוּאָתָהּ",
    "134": " לְטוֹבָה,",
    "135": "וְתֵן",
    "137": "בְּרָכָה",
    "139": "טַל וּמָטָר לִבְ֒רָכָה",
    "141": "עַל פְּנֵי הָאֲדָמָה",
    "142": "וְשַׂבְּ֒עֵֽנוּ מִטּוּבָהּ",
    "143": "וּבָרֵךְ שְׁנָתֵנוּ",
    "144": "כַּשָּׁנִים הַטּוֹבוֹת לִבְרָכָה",
    "145": "כִּי אֵל טוֹב",
    "146": "ומֵטִיב אַתָּה",
    "147": "וּמְ֒בָרֵךְ הַשָׁנִים",
    "148": "בָּרוּךְ אַתָּה יְהֹוָה",
    "149": "מְבָרֵךְ הַשָּׁנִים:",
    "151": "תְּקַע בְּשׁוֹפָר גָּדוֹל לְחֵרוּתֵֽנוּ",
    "152": "וְשָׂא נֵס לְקַבֵּץ גָּלֻיּוֹתֵֽינוּ",
    "153": "וְקַבְּ֒צֵֽנוּ יַֽחַד מְהֵרָה",
    "154": "מֵאַרְבַּע כַּנְ֒פוֹת הָאָֽרֶץ",
    "155": "לְאַרְצֵֽנוּ:",
    "156": "בָּרוּךְ אַתָּה יְהֹוָה",
    "157": "מְקַבֵּץ",
    "158": "נִדְחֵי עַמּוֹ יִשְׂרָאֵל:",
    "160": "הָשִֽׁיבָה שׁוֹפְ֒טֵֽינוּ כְּבָרִאשׁוֹנָה",
    "161": "וְיוֹעֲצֵֽינוּ כְּבַתְּ֒חִלָּה",
    "162": "וְהָסֵר מִמֶּֽנּוּ יָגוֹן וַאֲנָחָה",
    "163": "וּמְ֒לוֹךְ עָלֵֽינוּ מְהֵרָה",
    "164": "אַתָּה יְהֹוָה לְבַדְּ֒ךָ",
    "165": "בְּחֶֽסֶד וּבְ֒רַחֲמִים",
    "166": "וְצַדְּ֒קֵֽנוּ",
    "167": "בְּצֶֽדֶק וּבְ֒מִשְׁפָּט:",
    "169": "בָּרוּךְ אַתָּה יְהֹוָה",
    "170": "מֶֽלֶךְ אֹהֵב צְדָקָה וּמִשְׁפָּט:",
    "172": "בָּרוּךְ אַתָּה יְהֹוָה",
    "173": "הַמֶּֽלֶךְ הַמִּשְׁפָּט:",
    "176": "וְלַמַּלְשִׁינִים אַל תְּהִי תִקְוָה",
    "177": "וְכָל הָרִשְׁעָה כְּרֶגַע תֹּאבֵד",
    "178": " וְכָל אֹיְ֒בֶֽיךָ מְהֵרָה יִכָּרֵֽתוּ,",
    "179": "וְהַזֵּדִים",
    "180": "מְהֵרָה תְעַקֵּר וּתְ֒שַׁבֵּר וּתְ֒מַגֵּר",
    "181": "וּתְ֒כַלֵם וְתַשְׁפִּילֵם",
    "182": "וְתַכְנִיעֵם בִּמְ֒הֵרָה בְיָמֵֽינוּ:",
    "183": "בָּרוּךְ אַתָּה יְהֹוָה",
    "184": "שׁוֹבֵר אֹיְ֒בִים",
    "185": "וּמַכְנִֽיעַ זֵדִים:",
    "187": "עַל הַצַּדִּיקִים וְעַל הַחֲסִידִים",
    "188": "וְעַל זִקְ֒נֵי שְׁאֵרִית עַמְּ֒ךָ",
    "189": "בֵּית יִשְׂרָאֵל",
    "190": "וְעַל פְּלֵיטַת (בֵּית) סוֹפְרֵיהֶם",
    "191": "וְעַל גֵּרֵי הַצֶּֽדֶק וְעָלֵֽינוּ",
    "192": "יֶהֱמוּ נָא רַחֲמֶֽיךָ",
    "193": "יְהֹוָה אֱלֹהֵֽינוּ",
    "194": "וְתֵן שָׂכָר טוֹב",
    "195": "לְכָל הַבּוֹטְ֒חִים בְּשִׁמְךָ בֶּאֱמֶת",
    "196": "וְשִׂים חֶלְקֵֽנוּ עִמָּהֶם",
    "197": "וּלְ֒עוֹלָם לֹא נֵבוֹשׁ",
    "198": "כִּי בְךָ בָטָֽחְנוּ",
    "199": "וְעַל חַסְדְּ֒ךָ הַגָּדוֹל",
    "200": "בֶּאֱמֶת נִשְׁעָֽנְנוּ:",
    "201": "בָּרוּךְ אַתָּה יְהֹוָה",
    "202": "מִשְׁעָן וּמִבְטָח לַצַּדִּיקִים:",
    "204": "וְלִירוּשָׁלַֽיִם עִירְ֒ךָ",
    "205": "בְּרַחֲמִים תָּשׁוּב",
    "206": "וְתִשְׁכּוֹן בְּתוֹכָהּ כַּאֲשֶׁר דִּבַּֽרְתָּ",
    "207": "וּבְ֒נֵה אוֹתָהּ בְּקָרוֹב בְּיָמֵֽינוּ",
    "208": "בִּנְיַן עוֹלָם",
    "209": " וְכִסֵּא דָוִד עַבְדֶּךָ,",
    "210": "מְהֵרָה לְתוֹכָהּ תָּכִין:",
    "211": "בָּרוּךְ אַתָּה יְהֹוָה",
    "212": "בּוֹנֵה יְרוּשָׁלָֽיִם:",
    "214": "אֶת צֶֽמַח דָּוִד עַבְדְּ֒ךָ",
    "215": "מְהֵרָה תַצְמִֽיחַ",
    "216": " וְקַרְנוֹ תָּרוּם בִּישׁוּעָתֶֽךָ,",
    "217": "כִּי לִישׁוּעָתְ֒ךָ קִוִּֽינוּ כָּל הַיּוֹם",
    "218": "וּמְ֒צַפִּים לִישׁוּעָה:",
    "219": "בָּרוּךְ אַתָּה יְהֹוָה",
    "220": "מַצְמִֽיחַ",
    "221": "קֶֽרֶן יְשׁוּעָה:",
    "223": "אָב הָרַחֲמָן",
    "224": "שְׁמַע קוֹלֵֽנוּ יְהֹוָה אֱלֹהֵֽינוּ",
    "225": "חוּס וְרַחֵם עָלֵֽינוּ",
    "226": "וְקַבֵּל",
    "227": " בְּרַחֲמִים וּבְ֒רָצוֹן אֶת תְּפִלָּתֵֽנוּ,",
    "228": "כִּי אֵל",
    "229": "שׁוֹמֵֽעַ תְּפִלּוֹת וְתַחֲנוּנִים אָֽתָּה",
    "230": "וּמִלְּ֒פָנֶֽיךָ מַלְכֵּֽנוּ",
    "231": " רֵיקָם אַל תְּשִׁיבֵֽנוּ,",
    "232": "חָנֵּֽנוּ וַעֲנֵֽנוּ",
    "233": "וּשְׁ֒מַע תְּפִלָתֵֽנוּ",
    "234": "כִּי אַתָּה שׁוֹמֵֽעַ תְּפִלַּת כָּל פֶּה",
    "235": "עַמְּ֒ךָ יִשְׂרָאֵל בְּרַחֲמִים:",
    "236": "בָּרוּךְ אַתָּה יְהֹוָה",
    "237": "שׁוֹמֵֽעַ תְּפִלָּה:",
    "239": "רְצֵה יְהֹוָה אֱלֹהֵֽינוּ",
    "240": "בְּעַמְּ֒ךָ יִשְׂרָאֵל",
    "241": " וְלִתְ֒פִלָּתָם שְׁעֵה,",
    "242": "וְהָשֵׁב אֶת הָעֲבוֹדָה",
    "243": "לִדְ֒בִיר בֵּיתֶֽךָ",
    "244": " וְאִשֵּׁי יִשְׂרָאֵל,",
    "245": "וּתְ֒פִלָּתָם בְּאַהֲבָה תְקַבֵּל",
    "246": "בְּרָצוֹן",
    "247": "וּתְ֒הִי לְרָצוֹן תָּמִיד",
    "248": "עֲבוֹדַת יִשְׂרָאֵל עַמֶּֽךָ:",
    "251": "אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ",
    "252": "יַעֲלֶה וְיָבֹא וְיַגִּֽיעַ",
    "253": "וְיֵרָאֶה וְיֵרָצֶה וְיִשָּׁמַע",
    "254": "וְיִפָּקֵד וְיִזָּכֵר",
    "255": "זִכְרוֹנֵֽנוּ וּפִקְ֒דוֹנֵֽנוּ",
    "256": "וְזִכְרוֹן אֲבוֹתֵֽינוּ",
    "257": "וְזִכְרוֹן מָשִֽׁיחַ",
    "258": "בֶּן דָּוִד עַבְדֶּֽךָ",
    "259": "וְזִכְרוֹן יְרוּשָׁלַֽיִם",
    "260": "עִיר קָדְשֶֽׁךָ",
    "261": "וְזִכְרוֹן כָּל עַמְּ֒ךָ",
    "262": " בֵּית יִשְׂרָאֵל לְפָנֶֽיךָ,",
    "263": "לִפְ֒לֵיטָה לְטוֹבָה",
    "264": "לְחֵן וּלְ֒חֶֽסֶד וּלְ֒רַחֲמִים",
    "265": "וּלְ֒חַיִּים טוֹבִים וּלְ֒שָׁלוֹם",
    "266": "בְּיוֹם",
    "267": "<small>לְר\"ח:</small> רֹאשׁ הַחֹֽדֶשׁ הַזֶּה",
    "268": "<small>לְפֶסַח:</small> חַג הַמַּצּוֹת הַזֶּה",
    "269": "<small>לְסֻכּוֹת:</small> חַג הַסֻּכּוֹת הַזֶּה",
    "270": "זָכְ֒רֵֽנוּ יְהֹוָה אֱלֹהֵֽינוּ",
    "271": " בּוֹ לְטוֹבָה,",
    "272": " וּפָקְ֒דֵֽנוּ בוֹ לִבְ֒רָכָה,",
    "273": " וְהוֹשִׁיעֵֽנוּ בוֹ לְחַיִּים טוֹבִים,",
    "274": "וּבִדְ֒בַר יְשׁוּעָה",
    "275": "וְרַחֲמִים",
    "276": " חוּס וְחָנֵּֽנוּ,",
    "277": " וְרַחֵם עָלֵֽינוּ וְהוֹשִׁיעֵֽנוּ,",
    "278": " כִּי אֵלֶֽיךָ עֵינֵֽינוּ,",
    "279": "כִּי אֵל",
    "280": "מֶֽלֶךְ חַנּוּן וְרַחוּם אָֽתָּה:",
    "282": "וְתֶחֱזֶֽינָה עֵינֵֽינוּ",
    "283": "בְּשׁוּבְ֒ךָ לְצִיּוֹן בְּרַחֲמִים:",
    "284": "בָּרוּךְ אַתָּה יְהֹוָה",
    "285": "הַמַּחֲזִיר שְׁכִינָתוֹ לְצִיּוֹן:",
    "288": "מוֹדִים אֲנַֽחְנוּ לָךְ",
    "289": "שָׁאַתָּה הוּא יְהֹוָה אֱלֹהֵֽינוּ",
    "290": "וֵאלֹהֵי אֲבוֹתֵֽינוּ לְעוֹלָם וָעֶד",
    "291": "צוּרֵֽנוּ צוּר חַיֵּֽינוּ",
    "292": "מָגֵן יִשְׁעֵֽנוּ",
    "293": "אַתָּה הוּא לְדוֹר וָדוֹר",
    "294": "נוֹדֶה לְּךָ",
    "295": "וּנְ֒סַפֵּר תְּהִלָּתֶֽךָ",
    "296": "עַל חַיֵּֽינוּ",
    "297": "הַמְּ֒סוּרִים בְּיָדֶֽךָ",
    "298": "וְעַל נִשְׁ֒מוֹתֵֽינוּ",
    "299": "הַפְּ֒קוּדוֹת לָךְ",
    "300": "וְעַל נִסֶּֽיךָ שֶׁבְּ֒כָל יוֹם עִמָּֽנוּ",
    "301": "וְעַל נִפְלְאוֹתֶֽיךָ וְטוֹבוֹתֶֽיךָ",
    "302": " שֶׁבְּ֒כָל עֵת,",
    "303": " עֶֽרֶב וָבֹֽקֶר וְצָהֳרָֽיִם,",
    "304": "הַטּוֹב",
    "305": "כִּי לֹא כָלוּ רַחֲמֶֽיךָ",
    "306": "וְהַמְ֒רַחֵם",
    "307": " כִּי לֹא תַֽמּוּ חֲסָדֶֽיךָ,",
    "308": "כִּי מֵעוֹלָם קִוִּֽינוּ לָךְ:",
    "310": "וְעַל הַנִּסִּים",
    "311": "וְעַל הַפֻּרְקָן וְעַל הַגְּ֒בוּרוֹת",
    "312": "וְעַל הַתְּ֒שׁוּעוֹת וְעַל הַנִּפְלָאוֹת",
    "313": "וְעַל הַנֶּחָמוֹת וְעַל הַמִּלְחָמוֹת",
    "314": "שֶׁעָשִֽׂיתָ לַאֲבוֹתֵֽינוּ",
    "315": "בַּיָּמִים הָהֵם בִּזְּ֒מַן הַזֶּה:",
    "317": "בִּימֵי מַתִּתְיָֽהוּ",
    "318": "בֶּן יוֹחָנָן כֹּהֵן גָּדוֹל",
    "319": "חַשְׁמוֹנָאִי וּבָנָיו",
    "320": "כְּשֶׁעָמְ֒דָה מַלְכוּת יָוָן הָרְ֒שָׁעָה",
    "321": "עַל עַמְּ֒ךָ יִשְׂרָאֵל",
    "322": "לְהַשְׁכִּיחָם תּוֹרָתֶֽךָ",
    "323": "וּלְ֒הַעֲבִירָם",
    "324": " מֵחֻקֵּי רְצוֹנֶֽךָ,",
    "325": "וְאַתָּה בְּרַחֲמֶֽיךָ הָרַבִּים",
    "326": "עָמַֽדְתָּ לָהֶם בְּעֵת צָרָתָם",
    "327": "רַֽבְתָּ אֶת רִיבָם",
    "328": "דַּֽנְתָּ אֶת דִּינָם",
    "329": "נָקַֽמְתָּ אֶת נִקְ֒מָתָם",
    "330": "מָסַֽרְתָּ גִבּוֹרִים",
    "331": "בְּיַד חַלָּשִׁים",
    "332": "וְרַבִּים בְּיַד מְעַטִּים",
    "333": "וּטְ֒מֵאִים בְּיַד טְהוֹרִים",
    "334": "וּרְ֒שָׁעִים בְּיַד צַדִּיקִים",
    "335": "וְזֵדִים בְּיַד",
    "336": "עוֹסְ֒קֵי תוֹרָתֶֽךָ",
    "337": "וּלְ֒ךָ עָשִֽׂיתָ",
    "338": "שֵׁם גָּדוֹל וְקָדוֹשׁ בְּעוֹלָמֶֽךָ",
    "339": "וּלְ֒עַמְּ֒ךָ יִשְׂרָאֵל",
    "340": "עָשִֽׂיתָ תְּשׁוּעָה גְדוֹלָה",
    "341": "וּפֻרְקָן כְּהַיּוֹם הַזֶּה",
    "342": "וְאַחַר כַּךְ בָּֽאוּ בָנֶֽיךָ",
    "343": "לִדְ֒בִיר בֵּיתֶֽךָ",
    "344": "וּפִנּוּ אֶת הֵיכָלֶֽךָ",
    "345": "וְטִהֲרוּ אֶת מִקְדָּשֶֽׁךָ",
    "346": "וְהִדְלִֽיקוּ נֵרוֹת",
    "347": "בְּחַצְ֒רוֹת קָדְשֶֽׁךָ",
    "348": "וְקָבְ֒עוּ שְׁמוֹנַת יְמֵי חֲנֻכָּה אֵֽלּוּ",
    "349": "לְהוֹדוֹת וּלְ֒הַלֵּל לְשִׁמְךָ הַגָּדוֹל:",
    "351": "בִּימֵי מָרְדְּכַי וְאֶסְתֵּר",
    "352": "בְּשׁוּשַׁן הַבִּירָה",
    "353": "כְּשֶׁעָמַד עֲלֵיהֶם הָמָן הָרָשָׁע",
    "354": "בִּקֵּשׁ לְהַשְׁמִיד לַהֲרוֹג",
    "355": "וּלְ֒אַבֵּד אֶת כָּל הַיְ֒הוּדִים",
    "356": "מִנַּֽעַר וְעַד זָקֵן טַף וְנָשִׁים",
    "357": "בְּיוֹם אֶחָד בִּשְׁ֒לוֹשָׁה עָשָׂר",
    "358": "לְחֹֽדֶשׁ שְׁנֵים עָשָׂר",
    "359": "הוּא חֹֽדֶשׁ אֲדָר",
    "360": "וּשְׁ֒לָלָם לָבוֹז:",
    "361": "וְאַתָּה בְּרַחֲמֶֽיךָ הָרַבִּים",
    "362": "הֵפַֽרְתָּ אֶת עֲצָתוֹ",
    "363": "וְקִלְקַֽלְתָּ אֶת מַחֲשַׁבְתּוֹ",
    "364": "וַהֲשֵׁבֽוֹתָ לּוֹ גְּמוּלוֹ בְּרֹאשׁוֹ",
    "365": "וְתָלוּ אוֹתוֹ וְאֶת בָּנָיו",
    "366": "עַל הָעֵץ:",
    "367": "וְעַל כֻּלָּם",
    "368": "יִתְבָּרַךְ וְיִתְרוֹמַם וְיִתְנַשֵׂא",
    "369": "שִׁמְךָ מַלְכֵּֽנוּ",
    "370": "תָּמִיד לְעוֹלָם וָעֶד:",
    "372": "וּכְ֒תוֹב לְחַיִּים טוֹבִים",
    "373": "כָּל בְּנֵי בְרִיתֶֽךָ:",
    "375": "וְכֹל הַחַיִּים יוֹדֽוּךָ סֶּֽלָה",
    "376": "וִיהַלְ֒לוּ וְיבָרְ֒כוּ",
    "377": "אֶת שִׁמְךָ הַגָּדוֹל בְּאֱמֶת לְעוֹלָם",
    "378": "כִּי טוֹב",
    "379": "הָאֵל יְשׁוּעָתֵֽנוּ",
    "380": "וְעֶזְרָתֵֽנוּ סֶֽלָה",
    "381": "הָאֵל הַטּוֹב:",
    "382": "בָּרוּךְ אַתָּה יְהֹוָה",
    "383": "הַטּוֹב שִׁמְךָ",
    "384": "וּלְ֒ךָ נָאֶה לְהוֹדוֹת:",
    "386": "שִׂים שָׁלוֹם טוֹבָה וּבְ֒רָכָה",
    "387": "חַיִים חֵן וָחֶֽסֶד וְרַחֲמִים",
    "388": " עָלֵֽינוּ וְעַל כָּל יִשְׂרָאֵל עַמֶּֽךָ,",
    "389": "בָּרְ֒כֵֽנוּ אָבִֽינוּ כֻּלָּֽנוּ כְּאֶחָד",
    "390": "בְּאוֹר פָּנֶֽיךָ",
    "391": "כִּי בְאוֹר פָּנֶֽיךָ",
    "392": "נָתַֽתָּ לָּֽנוּ יְהֹוָה אֱלֹהֵֽינוּ",
    "393": "תּוֹרַת חַיִּים וְאַהֲבַת חֶֽסֶד",
    "394": "וּצְ֒דָקָה וּבְ֒רָכָה וְרַחֲמִים",
    "395": " וְחַיִּים וְשָׁלוֹם,",
    "396": "וְטוֹב יִהְיֶה בְּעֵינֶֽיךָ",
    "397": "לְבָרְ֒כֵֽנוּ",
    "398": "וּלְ֒בָרֵךְ אֶת כָּל עַמְּ֒ךָ יִשְׂרָאֵל",
    "399": "בְּכָל עֵת וּבְכָל שָׁעָה",
    "400": "בִּשְׁ֒לוֹמֶֽךָ",
    "401": "(בְּרוֹב עוֹז וְשָׁלוֹם).",
    "403": "בְּסֵֽפֶר חַיִּים בְּרָכָה וְשָׁלוֹם",
    "404": "וּפַרְנָסָה טוֹבָה",
    "405": " וּגְ֒זֵרוֹת טוֹבוֹת, יְשׁוּעוֹת וְנֶחָמוֹת,",
    "406": "נִזָּכֵר וְנִכָּתֵב",
    "407": "לְפָנֶֽיךָ",
    "408": "אֲנַֽחְנוּ וְכָל עַמְּ֒ךָ בֵּית יִשְׂרָאֵל",
    "409": "לְחַיִּים טוֹבִים וּלְ֒שָׁלוֹם:",
    "411": "בָּרוּךְ אַתָּה יְהֹוָה",
    "412": "הַמְּ֒בָרֵךְ אֶת עַמּוֹ יִשְׂרָאֵל",
    "413": "בַּשָּׁלוֹם:",
    "415": "שָׁלוֹם רָב",
    "416": "עַל יִשְׂרָאֵל עַמְּ֒ךָ.",
    "417": "תָּשִׂים לְעוֹלָם",
    "418": "כִּי אַתָּה הוּא מֶֽלֶךְ",
    "419": "אָדוֹן לְכָל הַשָּׁלוֹם",
    "420": "וְטוֹב יִהְיֶה בְּעֵינֶֽיךָ",
    "421": "לְבָרְ֒כֵֽנוּ",
    "422": "וּלְ֒בָרֵךְ אֶת כָּל עַמְּ֒ךָ יִשְׂרָאֵל",
    "423": "בְּכָל עֵת וּבְכָל שָׁעָה",
    "424": "בִּשְׁ֒לוֹמֶֽךָ",
    "426": "בְּסֵֽפֶר חַיִּים בְּרָכָה וְשָׁלוֹם",
    "427": "וּפַרְנָסָה טוֹבָה",
    "428": " וּגְ֒זֵרוֹת טוֹבוֹת, יְשׁוּעוֹת וְנֶחָמוֹת,",
    "429": "נִזָּכֵר וְנִכָּתֵב",
    "430": "לְפָנֶֽיךָ",
    "431": "אֲנַֽחְנוּ וְכָל עַמְּ֒ךָ בֵּית יִשְׂרָאֵל",
    "432": "לְחַיִּים טוֹבִים וּלְ֒שָׁלוֹם:",
    "434": "בָּרוּךְ אַתָּה יְהֹוָה",
    "435": "הַמְּ֒בָרֵךְ אֶת עַמּוֹ יִשְׂרָאֵל",
    "436": "בַּשָּׁלוֹם:",
    "437": "יִהְיוּ לְרָצוֹן",
    "438": "אִמְ֒רֵי פִי",
    "439": "וְהֶגְיוֹן לִבִּי לְפָנֶֽיךָ",
    "440": "יְהֹוָה צוּרִי וְגוֹאֲלִי:",
    "441": "אֱלֹהַי נְצוֹר לְשׁוֹנִי מֵרָע",
    "442": "וּשְׂ֒פָתַי מִדַּבֵּר מִרְמָה",
    "443": "וְלִמְ֒קַלְ֒לַי",
    "444": "נַפְשִׁי תִדּוֹם",
    "445": "וְנַפְשִׁי כֶּעָפָר לַכֹּל תִּהְיֶה",
    "446": "פְּתַח לִבִּי בְּתוֹרָתֶֽךָ",
    "447": "וְאַחֲרֵי מִצְוֹתֶֽיךָ תִּרְדּוֹף נַפְשִׁי",
    "448": "וְכָל הַקָמִים וְהַחוֹשְׁ֒בִים עָלַי רָעָה",
    "449": "מְהֵרָה הָפֵר עֲצָתָם",
    "450": "וְקַלְקֵל מַחֲשַׁבְתָּם:",
    "451": "(יְהִי רָצוֹן מִלְ֒פָנֶיךָ",
    "452": "יְהֹוָה אֱלֹהַי וֵאלֹהֵי אֲבוֹתַי",
    "453": "שֶׁלֹּא תַעֲלֶה קִנְאַת אָדָם עָלַי",
    "454": "וְלֹא קִנְאָתִי עַל אֲחֵרִים",
    "455": "וְשֶׁלֹּא אֶכְעֹס הַיּוֹם",
    "456": "וְשֶׁלֹּא אַכְעִיסֶֽךָ",
    "457": "וְתַצִּילֵנִי מִיֵּֽצֶר הָרָע",
    "458": "וְתֵן בְּלִבִּי הַכְנָעָה וַעֲנָוָה.",
    "459": "מַלְכֵּֽנוּ וֵאלֹהֵֽינוּ",
    "460": " יַחֵד שִׁמְךָ בְּעוֹלָמֶֽךָ,",
    "461": " בְּנֵה עִירְ֒ךָ, יַסֵּד בֵּיתֶֽךָ,",
    "462": "וְשַׁכְלֵל הֵיכָלֶֽךָ.",
    "463": " וְקַבֵּץ קִבּוּץ גָּלֻיּוֹת,",
    "464": "וּפְ֒דֵה צֹאנֶֽךָ וְשַׂמַּח עֲדָתֶֽךָ.)",
    "465": " עֲשֵׂה לְמַֽעַן שְׁמֶֽךָ,",
    "466": " עֲשֵׂה לְמַֽעַן יְמִינֶֽךָ,",
    "467": " עֲשֵׂה לְמַֽעַן תּוֹרָתֶֽךָ,",
    "468": "עֲשֵׂה לְמַֽעַן קְדֻשָּׁתֶֽךָ.",
    "469": "לְמַֽעַן יֵחָלְ֒צוּן יְדִידֶֽיךָ",
    "470": "הוֹשִֽׁיעָה יְמִינְ֒ךָ וַעֲנֵֽנִי:",
    "472": "יִהְיוּ לְרָצוֹן",
    "473": "אִמְרֵי פִי",
    "474": "וְהֶגְיוֹן לִבִּי לְפָנֶֽיךָ",
    "475": "יְהֹוָה צוּרִי וְגוֹאֲלִי:",
    "476": " עֹשֶׂה (<small>בעשי\"ת</small> הַשָּׁלוֹם) שָׁלוֹם",
    "477": "בִּמְרוֹמָיו",
    "478": "הוּא יַעֲשֶׂה שָׁלוֹם",
    "479": "עָלֵֽינוּ וְעַל כָּל יִשְׂרָאֵל",
    "480": "וְאִמְרוּ אָמֵן:",
    "481": "יְהִי רָצוֹן מִלְּ֒פָנֶֽיךָ",
    "482": "יְהֹוָה אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ",
    "483": "שֶׁיִּבָּנֶה בֵּית הַמִּקְדָּשׁ",
    "484": "בִּמְהֵרָה בְיָמֵֽינוּ",
    "485": "וְתֵן חֶלְקֵֽנוּ בְּתוֹרָתֶֽךָ:",
    "486": "וְשָׁם נַעֲבָדְ֒ךָ בְּיִרְאָה",
    "487": "כִּימֵי עוֹלָם",
    "488": "וּכְ֒שָׁנִים קַדְמוֹנִיּוֹת:",
    "489": "וְעָרְ֒בָה לַיהֹוָה",
    "490": "מִנְחַת יְהוּדָה וִירוּשָׁלָֽםִ",
    "491": "כִּימֵי עוֹלָם וּכְ֒שָׁנִים קַדְמוֹנִיּוֹת:"
   },
   "en": {
    "1": "My Master, open my lips,",
    "2": "and my mouth will declare Your praise.",
    "4": "Blessed are You, Adonoy,",
    "5": "our God, and God of our fathers,",
    "6": "God of Abraham, God of Isaac,",
    "7": "and God of Jacob,",
    "8": "the Almighty,",
    "9": "the Great, the Powerful, the Awesome,",
    "10": "most high Almighty,",
    "11": "Who bestows beneficent kindness,",
    "12": "Who possesses everything,",
    "13": "Who remembers the piety of the Patriarchs,",
    "14": "and Who brings a redeemer",
    "15": "to their children's children,",
    "16": "for the sake of His Name, with love.",
    "17": "<small>(During the Ten Days of Penitence add:</small>",
    "18": "Remember us for life",
    "19": "King, Who desires life;",
    "20": "and inscribe us in the Book of Life,",
    "21": "for Your sake, Living God.)",
    "23": "King, Helper, and Deliverer and Shield.",
    "24": "Blessed are You, Adonoy,",
    "25": "Shield of Abraham.",
    "27": "You are mighty forever, my Master;",
    "28": "You are the Resurrector of the dead",
    "29": "the Powerful One to deliver us.",
    "30": "<small>From the Musaf of the first day of Pesach until the Musaf of Shemini Atzeres you should say:</small>",
    "31": "He causes the dew to descend.",
    "32": "<small>From the Musaf of Shemini Atzeres until the Musaf of the first day of Pesach you should say:</small>",
    "33": "Causer of the wind to blow",
    "34": "and of the rain to fall.",
    "36": "Sustainer of the living with kindliness,",
    "37": "Resurrector of the dead with great mercy,",
    "38": "Supporter of the fallen,",
    "39": "and Healer of the sick,",
    "40": "and Releaser of the imprisoned,",
    "41": "and Fulfiller of His faithfulness",
    "42": "to those who sleep in the dust.",
    "43": "Who is like You, Master of mighty deeds,",
    "44": "and who can be compared to You?",
    "45": "King Who causes death and restores life,",
    "46": "and causes deliverance to sprout forth.",
    "47": "<small>(During the Ten Days of Penitence add:</small>",
    "48": "Who is like You merciful Father,",
    "49": "Who remembers His creatures for life,",
    "50": "in His mercy.)",
    "52": "And You are faithful",
    "53": "to restore the dead to life.",
    "54": "Blessed are You, Adonoy,",
    "55": "Resurrector of the dead.",
    "57": "You are holy and Your Name is holy",
    "58": "and holy beings",
    "59": "praise You every day, forever.",
    "60": "For a great and Almighty King—",
    "61": "great and holy—are You.",
    "62": "<small>During the Ten Days of Penitence, continue at the asterisk (*) below</small>",
    "63": "Blessed are You, Adonoy,",
    "64": "the Almighty, the Holy One.",
    "65": "<small>*During the Ten Days of Penitence:</small>",
    "66": "Blessed are You, Adonoy,",
    "67": "the King, the Holy One.",
    "70": "You favor man with perception",
    "71": "and teach mankind understanding.",
    "72": "(You have favored us",
    "73": "[with the ability] to know Your Torah",
    "74": "and taught us to fulfill",
    "75": "the statutes of Your will.",
    "76": "You made a distinction, Adonoy, our God,",
    "77": "between sacred and unhallowed,",
    "78": "between light and darkness,",
    "79": "between Israel and the peoples,",
    "80": "between the seventh day",
    "81": "and the six work days.",
    "82": "Our Father, our King,",
    "83": "commence for us",
    "84": "the days that approach us,",
    "85": "in peace,",
    "86": "devoid of all sin,",
    "87": "and cleansed of all iniquity,",
    "88": "and devoted to the fear of You.)",
    "89": "And grant us from Your",
    "90": "wisdom, understanding and knowledge.",
    "91": "Blessed are You, Adonoy,",
    "92": "Grantor of perception.",
    "94": "Cause us to return, our Father,",
    "95": "to Your Torah",
    "96": "and bring us near, our King, to Your service;",
    "97": "and bring us back",
    "98": "in whole-hearted repentance before You",
    "99": "Blessed are You, Adonoy,",
    "100": "Who desires penitence.",
    "102": "Pardon us, our Father, for we have sinned,",
    "103": "forgive us, our King,",
    "104": "for we have transgressed;",
    "105": "for you are a good and forgiving almighty.",
    "106": "Blessed are You, Adonoy,",
    "107": "Gracious One, Who pardons abundantly.",
    "109": "Look, please, upon our affliction,",
    "110": "and defend our cause:",
    "111": "and redeem us",
    "112": "speedily with complete redemption",
    "113": "for the sake of Your Name;",
    "114": "because You are a Mighty Redeemer.",
    "115": "Blessed are You, Adonoy,",
    "116": "Redeemer of Israel.",
    "117": "<small>(On Fast Days, the Chazzan says “Answer us” which is on page 000 and concludes, “Blessed are . . . Who responds at times of trouble.”)</small>",
    "119": "Heal us, Adonoy, and we will be healed,",
    "120": "deliver us and we will be delivered;",
    "121": "for You are our praise.",
    "122": "Grant a cure and healing",
    "123": "to all our sickness",
    "124": "and to all our pain",
    "125": "and to all our affliction",
    "126": "because You are the Almighty, King,",
    "127": "Who is a faithful and merciful Healer.",
    "128": "Blessed are You, Adonoy,",
    "129": "Healer of the sick of His people Israel.",
    "131": "Bless for us, Adonoy our God,",
    "132": "this year",
    "133": "and all the varieties of its produce",
    "134": "for good;",
    "135": "and bestow",
    "136": "<small>From the first day of Pesach until the evening service [<i>Maariv</i>] on December 4, or, on a civil leap year, December 5, we say the following line.</small>",
    "137": "blessing",
    "138": "<small>From the evening service [<i>Maariv</i>] on December 4, or, on a civil leap year, December 5, until the First day of Pesach, we say the following line.</small>",
    "139": "dew and rain for a blessing",
    "141": "upon the face of the earth;",
    "142": "satisfy us from its bounty",
    "143": "and bless our year",
    "144": "as other good years, for blessing,",
    "145": "for You are generous Almighty",
    "146": "who bestows goodness",
    "147": "and blesses the years.",
    "148": "Blessed are You, Adonoy,",
    "149": "Blesser of the years.",
    "151": "Sound the great <i>shofar</i> for our liberty,",
    "152": "and raise a banner to gather our exiles,",
    "153": "and gather us together quickly",
    "154": "from the four corners of the earth.",
    "155": "into our Land.",
    "156": "Blessed are You, Adonoy,",
    "157": "Gatherer",
    "158": "of the dispersed of His people Israel.",
    "160": "Restore our judges as before",
    "161": "and our counselors as at first.",
    "162": "Remove from us sorrow and sighing,",
    "163": "and reign over us quickly",
    "164": "You, Adonoy, alone",
    "165": "with kindness and compassion;",
    "166": "and make us righteous",
    "167": "with righteousness and justice,",
    "168": "<small>During the Ten Days of Penitence, continue at the asterisk (*) below</small>",
    "169": "Blessed are You, Adonoy,",
    "170": "King, Lover of righteousness and justice.",
    "171": "<small>*During the Ten Days of Penitence:</small>",
    "172": "Blessed are You, Adonoy,",
    "173": "the King of Justice.",
    "176": "For informers let there be no hope",
    "177": "and may all wickedness instantly perish",
    "178": "may all Your enemies be swiftly cut off,",
    "179": "and the insolent",
    "180": "may You quickly uproot, crush, rout,",
    "181": "disgrace, humble",
    "182": "and subdue speedily in our days.",
    "183": "Blessed are You, Adonoy,",
    "184": "Crusher of enemies",
    "185": "and Subduer of the insolent.",
    "187": "Upon the righteous, upon the pious,",
    "188": "upon the elders of the remnant of Your people",
    "189": "the House of Israel,",
    "190": "upon the remnant of their scholars,",
    "191": "upon the true proselytes, and upon us,",
    "192": "may Your mercy be aroused,",
    "193": "Adonoy our God.",
    "194": "Grant bountiful reward",
    "195": "to all who trust in Your Name in truth;",
    "196": "and place our lot among them,",
    "197": "and may we never be put to shame,",
    "198": "for in You we have put our trust,",
    "199": "and on Your great compassion",
    "200": "we truly rely.",
    "201": "Blessed are You, Adonoy,",
    "202": "Support and Trust of the righteous.",
    "204": "And to Jerusalem, Your city,",
    "205": "return in mercy,",
    "206": "and dwell therein as You have spoken;",
    "207": "and rebuild it soon, in our days,",
    "208": "as an everlasting structure,",
    "209": "and the throne of David, Your servant",
    "210": "may You speedily establish therein.",
    "211": "Blessed are You, Adonoy,",
    "212": "Builder of Jerusalem.",
    "214": "The sprout of David, Your servant,",
    "215": "speedily cause to flourish",
    "216": "and exalt his power with Your deliverance,",
    "217": "For Your deliverance we hope all day.",
    "218": "and watch for Your deliverance.",
    "219": "Blessed are You, Adonoy,",
    "220": "Who causes to sprout",
    "221": "the power of salvation.",
    "223": "Merciful Father",
    "224": "Hear our voice, Adonoy, our God;",
    "225": "spare us and have compassion on us,",
    "226": "and accept",
    "227": "our prayers compassionately and willingly,",
    "228": "for You are Almighty",
    "229": "Who hears prayers and supplications;",
    "230": "and from Your Presence, our King,",
    "231": "do not turn us away empty-handed,",
    "232": "be gracious and answer us",
    "233": "and hear our prayer",
    "234": "for You hear the prayers of every mouth",
    "235": "of Your people, Israel, with compassion.",
    "236": "Blessed are You, Adonoy,",
    "237": "Who hears prayers.",
    "239": "Be pleased, Adonoy, our God,",
    "240": "with Your people Israel",
    "241": "and pay heed to their prayer;",
    "242": "and restore the service",
    "243": "to the Holy of Holies in Your abode,",
    "244": "and the fire-offerings of Israel;",
    "245": "and accept their prayer, lovingly",
    "246": "and willingly.",
    "247": "And may You always find pleasure",
    "248": "with the service of Your people, Israel.",
    "249": "<small>On regular weekdays continue, “And may our eyes,” on p. 000.</small>",
    "250": "<small>On Rosh Chodesh and on Chol HaMoed, the following prayer is added:</small>",
    "251": "Our God and God of our fathers,",
    "252": "may there ascend, come, and reach,",
    "253": "appear, be desired, and heard,",
    "254": "counted and recalled",
    "255": "our remembrance and reckoning;",
    "256": "the remembrance of our fathers;",
    "257": "the remembrance of the Mashiach",
    "258": "the son of David, Your servant;",
    "259": "the remembrance of Jerusalem,",
    "260": "city of Your Sanctuary;",
    "261": "and the remembrance of Your entire people,",
    "262": "the House of Israel, before You",
    "263": "for survival, for well-being,",
    "264": "for favor, kindliness, compassion,",
    "265": "for good life and peace",
    "266": "on this day of:",
    "267": "<i>Rosh Chodesh</i>",
    "268": "the <i>Festival of Matzos</i>",
    "269": "the <i>Festival of Sukkos</i>",
    "270": "Remember us Adonoy, our God,",
    "271": "on this day for well-being;",
    "272": "be mindful of us on this day for blessing,",
    "273": "and deliver us for good life.",
    "274": "In accord with the promise of deliverance",
    "275": "and compassion,",
    "276": "spare us and favor us,",
    "277": "have compassion on us and deliver us;",
    "278": "for to You our eyes are directed",
    "279": "because You are the Almighty",
    "280": "Who is King, Gracious, and Merciful.",
    "282": "And may our eyes behold",
    "283": "Your merciful return to Zion.",
    "284": "Blessed are You, Adonoy,",
    "285": "Who returns His Divine Presence to Zion.",
    "286": "<small>At the words, <i>We are thankful</i>, bend forward; at <i>Adonoy</i> return to an upright position.</small>",
    "288": "We are thankful to You",
    "289": "that You Adonoy are our God",
    "290": "and the God of our fathers forever;",
    "291": "our Rock, Rock of our lives,",
    "292": "the Shield of our deliverance,",
    "293": "You are in every generation.",
    "294": "We will give thanks to You",
    "295": "and recount Your praise,",
    "296": "for our lives",
    "297": "which are committed into Your hand,",
    "298": "and for our souls",
    "299": "which are entrusted to You,",
    "300": "and for Your miracles of every day with us,",
    "301": "and for Your wonders and benefactions",
    "302": "at all times—",
    "303": "evening, morning and noon.",
    "304": "(You are) The Beneficent One—",
    "305": "for Your compassion is never withheld;",
    "306": "And (You are) the Merciful One—",
    "307": "for Your kindliness never ceases;",
    "308": "for we have always placed our hope in You.",
    "310": "[We thank You] for the miracles",
    "311": "for the redemption, for the mighty deeds,",
    "312": "for the deliverances, for the wonders",
    "313": "for the consolations and for the wars",
    "314": "that You performed for our fathers",
    "315": "in those days at this season.",
    "316": "<small>On Chanukah:</small>",
    "317": "In the days of Matisyahu,",
    "318": "son of Yochanan the High Priest,",
    "319": "the Hasmonean and his sons,",
    "320": "when the evil Greek kingdom rose up",
    "321": "against Your people Israel",
    "322": "to make them forget Your Torah",
    "323": "and to turn them away",
    "324": "from the statutes of Your will—",
    "325": "You, in Your abundant mercy,",
    "326": "stood by them in their time of distress,",
    "327": "You defended their cause,",
    "328": "You judged their grievances,",
    "329": "You avenged them.",
    "330": "You delivered the mighty",
    "331": "into the hands of the weak,",
    "332": "many into the hands of the few,",
    "333": "defiled people into the hands of the undefiled,",
    "334": "the wicked into the hands of the righteous,",
    "335": "and insolent [sinners] into the hands of",
    "336": "diligent students of Your Torah.",
    "337": "And You made Yourself",
    "338": "a great and sanctified name in Your world.",
    "339": "And for Your people, Israel,",
    "340": "You performed a great deliverance",
    "341": "and redemption unto this very day.",
    "342": "Afterwards, Your sons entered",
    "343": "the Holy of Holies of Your Abode,",
    "344": "cleaned Your Temple,",
    "345": "purified Your Sanctuary,",
    "346": "and kindled lights",
    "347": "in the Courtyards of Your Sanctuary,",
    "348": "and designated these eight days of Chanukah",
    "349": "to thank and praise Your great Name.",
    "350": "<small>On Purim:</small>",
    "351": "In the days of Mordechai and Esther",
    "352": "in Shushan the Capital [of Persia],",
    "353": "when the evil Haman rose up against them,",
    "354": "he sought to destroy, to kill,",
    "355": "and to annihilate all the Jews,",
    "356": "young and old, infants and women,",
    "357": "in one day, the thirteenth day",
    "358": "of the twelfth month,",
    "359": "which is the month of Adar,",
    "360": "and to plunder their wealth—",
    "361": "And You, in Your abundant mercy,",
    "362": "annulled his counsel,",
    "363": "frustrated his intention,",
    "364": "and brought his evil plan upon his own head,",
    "365": "and they hanged him and his sons",
    "366": "upon the gallows.",
    "367": "And for all the foregoing",
    "368": "blessed, exalted and extolled",
    "369": "your Name, our King",
    "370": "constantly, forever and ever.",
    "371": "<small>During the Ten Days of Penitence, add:</small>",
    "372": "Inscribe for a good life",
    "373": "all the children of Your covenant.",
    "375": "And all the living shall thank You forever",
    "376": "and praise and bless",
    "377": "Your great Name with sincerity forever;",
    "378": "for You are goodness—",
    "379": "the Almighty, Who is our deliverance",
    "380": "and our help forever—",
    "381": "the benevolent Almighty.",
    "382": "Blessed are You, Adonoy,",
    "383": "“The Beneficent” is Your Name",
    "384": "and You it is fitting to praise.",
    "386": "Grant peace, goodness, and blessing,",
    "387": "life favor, kindness and compassion",
    "388": "upon us and upon all Israel, Your people.",
    "389": "Bless us, our Father, all of us as one",
    "390": "with the light of Your countenance.",
    "391": "For by the light of Your countenance",
    "392": "You gave us Adonoy our God,",
    "393": "a Torah of life and the love of kindliness,",
    "394": "righteousness, blessing, compassion,",
    "395": "life, and peace.",
    "396": "And may it be good in Your sight",
    "397": "to bless us",
    "398": "and to bless Your people Israel,",
    "399": "at all times and at every moment",
    "400": "with Your peace",
    "401": "(with much strength and peace).",
    "402": "<small>During the Ten Days of Penitence continue here:</small>",
    "403": "In the book of life, blessing, peace",
    "404": "and abundant maintenance,",
    "405": "good decrees, salvations and condolences,",
    "406": "may we be remembered and inscribed",
    "407": "before You;",
    "408": "we and all Your people, the House of Israel",
    "409": "for a good life and peace.",
    "411": "Blessed are You, Adonoy,",
    "412": "Who blesses His people Israel",
    "413": "with peace.",
    "414": "<small> The following is said by some in place of  שים שלום  on the previous page.</small>",
    "415": "Abundant peace",
    "416": "upon Israel, Your people,",
    "417": "bestow forever,",
    "418": "for You King",
    "419": "are the Master of all peace.",
    "420": "And may it be good in Your sight",
    "421": "to bless us",
    "422": "and to bless Your people Israel,",
    "423": "at all times and at every moment",
    "424": "with Your peace.",
    "425": "<small>During the Ten Days of Penitence continue here:</small>",
    "426": "In the book of life, blessing, peace",
    "427": "and abundant maintenance,",
    "428": "good decrees, salvations and condolences,",
    "429": "may we be remembered and inscribed",
    "430": "before You;",
    "431": "we and all Your people, the House of Israel",
    "432": "for a good life and peace.",
    "434": "Blessed are You, Adonoy,",
    "435": "Who blesses His people Israel",
    "436": "with peace.",
    "437": "May they be acceptable",
    "438": "the words of my mouth",
    "439": "and the thoughts of my heart, before You",
    "440": "Adonoy, my Rock and my Redeemer.",
    "441": "My God, guard my tongue from evil",
    "442": "and my lips from speaking deceitfully.",
    "443": "To those who curse me,",
    "444": "may my soul be unresponsive;",
    "445": "and let my soul be like dust to all.",
    "446": "Open my heart to Your Torah",
    "447": "and let my soul pursue Your commandments.",
    "448": "And all who plan evil against me,",
    "449": "quickly annul their counsel",
    "450": "and frustrate their intention.",
    "451": "(May it it be Your will",
    "452": "Adonoy, my God and God of my fathers,",
    "453": "that no person be envious of me",
    "454": "and that I not be envious of others,",
    "455": "that I not be brought to anger this day,",
    "456": "and that I not cause Your anger;",
    "457": "and save me from the evil inclination,",
    "458": "and help me be humble and any modest.",
    "459": "Our King and our Father,",
    "460": "unify Your Name in Your world,",
    "461": "rebuild Your city, establish Your house",
    "462": "and perfect your sanctuary.",
    "463": "Gather our exiles,",
    "464": "redeem Your people, rejoice Your congregation).",
    "465": "Act for the sake of Your Name.",
    "466": "Act for the sake of Your right hand.",
    "467": "Act for the sake of Your Torah.",
    "468": "Act for the sake of Your holiness.",
    "469": "In order that Your loved ones be released,",
    "470": "deliver [with] Your right hand and answer me.",
    "472": "May they be acceptable—",
    "473": "the words of my mouth",
    "474": "and the thoughts of my heart—before You",
    "475": "Adonoy, my Rock and my Redeemer.",
    "476": "He Who makes peace",
    "477": "in His high heavens",
    "478": "may He make peace",
    "479": "upon us and upon all Israel",
    "480": "and say Amein.",
    "481": "May it be Your will,",
    "482": "Adonoy, our God, and the God of our Fathers",
    "483": "that the Holy Temple be rebuilt",
    "484": "speedily in our days,",
    "485": "and grant us our share in Your Torah.",
    "486": "And there we will serve You reverently",
    "487": "as in the days of old,",
    "488": "and in earlier years.",
    "489": "And let Adonoy be pleased",
    "490": "with the offerings of Judah and Jerusalem",
    "491": "as in the days of old and in earlier years.",
    "492": "<small>The Chazzan recites the half Kaddish, and the congregation then says, “May the pleasantness” and “and You Holy One,” found on p. 000.</small>"
   }
  }
 }
}
