{
 "id": "weekday/maariv/full-kaddish-titkabel:sefard",
 "refs": {
  "Weekday Siddur Sefard Linear, Maariv, Aleinu": {
   "edition": "metsudah-sefard-weekday",
   "he": {
    "2": "<b>יִתְגַּדַּל</b> וְיִתְקַדַּשׁ שְׁמֵהּ רַבָּא",
    "3": "בְּעָלְמָא דִּי בְרָא",
    "4": "כִרְעוּתֵהּ",
    "5": "וְיַמְלִיךְ מַלְכוּתֵהּ",
    "6": "וְיַצְמַח פּוּרְקָנֵהּ",
    "7": "וִיקָרֵב (קֵץ) מְשִׁיחֵהּ.",
    "8": "בְּחַיֵּיכוֹן וּבְיוֹמֵיכוֹן",
    "9": "וּבְחַיֵּי",
    "10": "דְכָל בֵּית יִשְׂרָאֵל.",
    "11": "בַּעֲגָלָא וּבִזְמַן קָרִיב",
    "12": "וְאִמְרוּ אָמֵן:",
    "13": "<b>יְהֵא שְׁמֵהּ רַבָּא מְבָרַךְ</b>",
    "14": "לְעָלַם וּלְעָלְמֵי עָלְמַיָּא:",
    "15": "יִתְבָּרַךְ וְיִשְׁתַּבַּח",
    "16": "וְיִתְפָּאַר וְיִתְרוֹמַם וְיִתְנַשֵּׂא",
    "17": "וְיִתְהַדָּר וְיִתְעַלֶּה וְיִתְהַלָּל",
    "18": "שְׁמֵהּ דְקֻדְשָׁא. בְּרִיךְ הוּא",
    "19": "לְעֵֽלָּא (<small>בעשי\"ת</small> וּלְעֵֽלָּא מִכָּל) ",
    "20": "מִן כָּל בִּרְכָתָא וְשִׁירָתָא.",
    "21": "תֻּשְׁבְּ֒חָתָא וְנֶחֱמָתָא.",
    "22": "דַּאֲמִירָן בְּעָלְמָא. וְאִמְרוּ אָמֵן:",
    "23": "תִּתְקַבֵּל",
    "24": "צְלוֹתְ֒הוֹן וּבָעוּתְ֒הוֹן",
    "25": "דְּכָל בֵּית יִשְׂרָאֵל",
    "26": "קֳדָם אֲבוּהוֹן דִּי בִשְׁמַיָּא",
    "27": "וְאִמְרוּ אָמֵן:",
    "28": "יְהֵא שְׁלָמָא רַבָּא מִן שְׁמַיָּא",
    "29": "וְחַיִּים",
    "30": "עָלֵֽינוּ וְעַל כָּל יִשְׂרָאֵל",
    "31": "וְאִמְרוּ אָמֵן:",
    "32": "עוֹשֶׂה שָׁלוֹם בִּמְרוֹמָיו",
    "33": "הוּא יַעֲשֶׂה שָׁלוֹם",
    "34": "עָלֵֽינוּ וְעַל כָּל יִשְׂרָאֵל",
    "35": "וְאִמְרוּ אָמֵן:"
   },
   "en": {
    "1": "<small>The Chazzan recites the following Kaddish:</small>",
    "2": "Exalted and sanctified be His great Name",
    "3": "in the world which He created",
    "4": "according to His will",
    "5": "and may He rule His kingdom",
    "6": "bring forth His redemption",
    "7": "and hasten the coming of His Mashiach",
    "8": "in your lifetime and in your days,",
    "9": "and in the lifetime",
    "10": "of the entire House of Israel,",
    "11": "speedily and in the near future—",
    "12": "and say Amein.",
    "13": "May His great Name be blessed",
    "14": "forever and for all eternity.",
    "15": "Blessed and praised,",
    "16": "glorified, and exalted and uplifted,",
    "17": "honored and elevated and extolled",
    "18": "be the Name of the Holy One, blessed is He;",
    "19": "above (<i>Ten Days of Penitence:</i> far above)",
    "20": "all the blessings and hymns,",
    "21": "praises and consolations",
    "22": "which we utter in the world—and say Amein.",
    "23": "May there be acceptance",
    "24": "of the prayers and supplications",
    "25": "of the entire House of Israel",
    "26": "before their Father in heaven.",
    "27": "And say, Amein.",
    "28": "May there be abundant peace from heaven",
    "29": "and life",
    "30": "for us and for all Israel,",
    "31": "—and say Amein.",
    "32": "He Who makes peace in His high heavens",
    "33": "may He, make peace",
    "34": "for us and for all Israel,",
    "35": "—and say Amein."
   }
  }
 }
}
