{
 "id": "weekday/mincha/mourners-kaddish:sefard",
 "refs": {
  "Weekday Siddur Sefard Linear, Mincha, Aleinu": {
   "edition": "metsudah-sefard-weekday",
   "he": {
    "74": "<b>יִתְגַּדַּל</b> וְיִתְקַדַּשׁ שְׁמֵהּ רַבָּא",
    "75": "בְּעָלְ֒מָא דִּי בְרָא",
    "76": "כִרְעוּתֵהּ",
    "77": "וְיַמְלִיךְ מַלְכוּתֵהּ",
    "78": "וְיַצְמַח פּוּרְ֒קָנֵהּ",
    "79": "וִיקָרֵב (קֵץ) מְשִׁיחֵהּ",
    "80": "בְּחַיֵּיכוֹן וּבְיוֹמֵיכוֹן",
    "81": "וּבְחַיֵּי",
    "82": " דְכָל בֵּית יִשְׂרָאֵל,",
    "83": "בַּעֲגָלָא וּבִזְמַן קָרִיב",
    "84": "וְאִמְרוּ אָמֵן:",
    "85": "<b>יְהֵא שְׁמֵהּ רַבָּא מְבָרַךְ</b>",
    "86": "<b>לְעָלַם וּלְעָלְ֒מֵי עָלְ֒מַיָּא</b>:",
    "87": "יִתְבָּרַךְ וְיִשְׁתַּבַּח",
    "88": "וְיִתְפָּאַר וְיִתְרוֹמַם וְיִתְנַשֵּׂא",
    "89": "וְיִתְהַדָּר וְיִתְעַלֶּה וְיִתְהַלָּל",
    "90": " שְׁמֵהּ דְקוּדְשָׁא, בְּרִיךְ הוּא",
    "91": "  לְעֵֽלָּא (<small>בעשי\"ת</small> וּלְ֒עֵֽלָּא מִכָּל)",
    "92": " מִן כָּל בִּרְכָתָא וְשִׁירָתָא,",
    "93": " תֻּשְׁבְּחָתָא וְנֶחֱמָתָא,",
    "94": " דַּאֲמִירָן בְּעָלְ֒מָא, וְאִמְרוּ אָמֵן:",
    "95": "יְהֵא שְׁלָמָא רַבָּא מִן שְׁמַיָּא",
    "96": "וְחַיִּים טוֹבִים",
    "97": "עָלֵֽינוּ וְעַל כָּל יִשְׂרָאֵל",
    "98": "וְאִמְרוּ אָמֵן:",
    "99": "עוֹשֶׂה שָׁלוֹם",
    "100": "  (<small>בעשי\"ת</small> הַשָּׁלוֹם)",
    "101": "בִּמְרוֹמָיו",
    "102": "הוּא יַעֲשֶׂה שָׁלוֹם",
    "103": "עָלֵינוּ וְעַל כָּל יִשְׂרָאֵל",
    "104": "וְאִמְרוּ אָמֵן"
   },
   "en": {
    "74": "Exalted and sanctified be His great Name",
    "75": "in the world which He created",
    "76": "according to His will",
    "77": "and may He rule His kingdom",
    "78": "bring forth His redemption",
    "79": "and hasten the coming of His Mashiach",
    "80": "in your lifetime and in your days,",
    "81": "and in the lifetime",
    "82": "of the entire House of Israel,",
    "83": "speedily and in the near future—",
    "84": "and say Amein.",
    "85": "May His great Name be blessed",
    "86": "forever and for all eternity.",
    "87": "Blessed and praised,",
    "88": "glorified, and exalted and uplifted,",
    "89": "honored and elevated and extolled",
    "90": "be the Name of the Holy One, blessed is He;",
    "91": "above (<i>Ten Days of Penitence:</i> far above)",
    "92": "all the blessings and hymns,",
    "93": "praises and consolations",
    "94": "which we utter in the world—and say Amein.",
    "95": "May there be abundant peace from heaven",
    "96": "and good life",
    "97": "for us and for all Israel,",
    "98": "—and say Amein.",
    "99": "He Who makes peace",
    "100": "(<i>Ten Days of Penitence:</i> the peace)",
    "101": "in His high heavens",
    "102": "may He, make peace",
    "103": "for us and for all Israel,",
    "104": "and say, Amen."
   }
  }
 }
}
