{
 "id": "weekday/mincha/full-kaddish-titkabel:sefard",
 "refs": {
  "Weekday Siddur Sefard Linear, Mincha, Tachanun": {
   "edition": "metsudah-sefard-weekday",
   "he": {
    "180": "<b>יִתְגַּדַּל</b> וְיִתְקַדַּשׁ שְׁמֵהּ רַבָּא",
    "181": "בְּעָלְ֒מָא דִּי בְרָא",
    "182": "כִרְעוּתֵהּ",
    "183": "וְיַמְלִיךְ מַלְכוּתֵהּ",
    "184": "וְיַצְמַח פּוּרְ֒קָנֵהּ",
    "185": "וִיקָרֵב (קֵץ) מְשִׁיחֵהּ",
    "186": "בְּחַיֵּיכוֹן וּבְיוֹמֵיכוֹן",
    "187": "וּבְחַיֵּי",
    "188": " דְכָל בֵּית יִשְׂרָאֵל,",
    "189": "בַּעֲגָלָא וּבִזְמַן קָרִיב",
    "190": "וְאִמְרוּ אָמֵן:",
    "191": "<b>יְהֵא שְׁמֵהּ רַבָּא מְבָרַךְ</b>",
    "192": "<b>לְעָלַם וּלְעָלְ֒מֵי עָלְ֒מַיָּא</b>:",
    "193": "יִתְבָּרַךְ וְיִשְׁתַּבַּח",
    "194": "וְיִתְפָּאַר וְיִתְרוֹמַם וְיִתְנַשֵּׂא",
    "195": "וְיִתְהַדָּר וְיִתְעַלֶּה וְיִתְהַלָּל",
    "196": " שְׁמֵהּ דְקוּדְשָׁא, בְּרִיךְ הוּא",
    "197": "  לְעֵֽלָּא (<small>בעשי\"ת</small> וּלְ֒עֵֽלָּא מִכָּל)",
    "198": " מִן כָּל בִּרְכָתָא וְשִׁירָתָא,",
    "199": " תֻּשְׁבְּחָתָא וְנֶחֱמָתָא,",
    "200": " דַּאֲמִירָן בְּעָלְ֒מָא, וְאִמְרוּ אָמֵן:",
    "201": "תִּתְקַבֵּל",
    "202": "צְלוֹתְ֒הוֹן וּבָעוּתְ֒הוֹן",
    "203": "דְּכָל בֵּית יִשְׂרָאֵל",
    "204": "קֳדָם אֲבוּהוֹן דִּי בִשְׁ֒מַיָּא",
    "205": "וְאִמְרוּ אָמֵן:",
    "206": "יְהֵא שְׁלָמָא רַבָּא מִן שְׁמַיָּא",
    "207": "וְחַיִּים טוֹבִים",
    "208": "עָלֵֽינוּ וְעַל כָּל יִשְׂרָאֵל",
    "209": "וְאִמְרוּ אָמֵן:",
    "210": "עוֹשֶׂה שָׁלוֹם",
    "211": "  (<small>בעשי\"ת</small> הַשָּׁלוֹם)",
    "212": "בִּמְרוֹמָיו",
    "213": "הוּא יַעֲשֶׂה שָׁלוֹם",
    "214": "עָלֵינוּ וְעַל כָּל יִשְׂרָאֵל",
    "215": "וְאִמְרוּ אָמֵן"
   },
   "en": {
    "179": "<small>The Chazzan recites the following Kaddish</small>",
    "180": "Exalted and sanctified be His great Name",
    "181": "in the world which He created",
    "182": "according to His will",
    "183": "and may He rule His kingdom",
    "184": "bring forth His redemption",
    "185": "and hasten the coming of His Mashiach",
    "186": "in your lifetime and in your days,",
    "187": "and in the lifetime",
    "188": "of the entire House of Israel,",
    "189": "speedily and in the near future—",
    "190": "and say Amein.",
    "191": "May His great Name be blessed",
    "192": "forever and for all eternity.",
    "193": "Blessed and praised,",
    "194": "glorified, and exalted and uplifted,",
    "195": "honored and elevated and extolled",
    "196": "be the Name of the Holy One, blessed is He;",
    "197": "above (<i>Ten Days of Penitence:</i> far above)",
    "198": "all the blessings and hymns,",
    "199": "praises and consolations",
    "200": "which we utter in the world—and say Amein.",
    "201": "May there be acceptance",
    "202": "of the prayers and supplications",
    "203": "of the entire House of Israel",
    "204": "before their Father in heaven.",
    "205": "And say, Amein.",
    "206": "May there be abundant peace from heaven",
    "207": "and good life",
    "208": "for us and for all Israel,",
    "209": "—and say Amein.",
    "210": "He Who makes peace",
    "211": "(<i>Ten Days of Penitence:</i> the peace)",
    "212": "in His high heavens",
    "213": "may He, make peace",
    "214": "for us and for all Israel,",
    "215": "and say, Amein."
   }
  }
 }
}
