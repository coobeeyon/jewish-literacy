{
 "id": "weekday/mincha/aleinu:sefard",
 "refs": {
  "Weekday Siddur Sefard Linear, Mincha, Aleinu": {
   "edition": "metsudah-sefard-weekday",
   "he": {
    "1": "עָלֵֽינוּ לְשַׁבֵּֽחַ",
    "2": "לַאֲדוֹן הַכֹּל",
    "3": "לָתֵת גְּדֻלָּה",
    "4": "לְיוֹצֵר בְּרֵאשִׁית",
    "5": "שֶׁלֹּא עָשָֽׂנוּ",
    "6": "כְּגוֹיֵי הָאֲרָצוֹת",
    "7": "וְלֹא שָׂמָֽנוּ",
    "8": "כְּמִשְׁפְּחוֹת הָאֲדָמָה",
    "9": "שֶׁלֹּא שָׂם",
    "10": "חֶלְקֵֽנוּ כָּהֶם",
    "11": "וְגוֹרָלֵֽנוּ כְּכָל הֲמוֹנָם:",
    "12": "שֶׁהֵם מִשְׁתַּחֲוִים",
    "13": "לָהֶֽבֶל וָרִיק",
    "14": " וּמִתְפַּלְּ֒לִים אֶל אֵל לֹא יוֹשִֽׁיעַ,",
    "15": "וַאֲנַֽחְנוּ כּוֹרְ֒עִים וּמִשְׁתַּחֲוִים",
    "16": "וּמוֹדִים",
    "17": "לִפְנֵי מֶֽלֶךְ מַלְ֒כֵי הַמְּ֒לָכִים",
    "18": " הַקָּדוֹשׁ בָּרוּךְ הוּא,",
    "19": "שֶׁהוּא נוֹטֶה שָׁמַֽיִם",
    "20": " וְיוֹסֵד אָֽרֶץ,",
    "21": " וּמוֹשַׁב יְקָרוֹ בַּשָּׁמַֽיִם מִמַּֽעַל,",
    "22": "וּשְׁ֒כִינַת עֻזּוֹ",
    "23": " בְּגָבְ֒הֵי מְרוֹמִים,",
    "24": " הוּא אֱלֹהֵֽינוּ אֵין עוֹד,",
    "25": "אֱמֶת מַלְכֵּֽנוּ",
    "26": "אֶֽפֶס זוּלָתוֹ",
    "27": "כַּכָּתוּב בְּתוֹרָתוֹ",
    "28": "וְיָדַעְתָּ הַיּוֹם",
    "29": "וַהֲשֵׁבֹתָ אֶל לְבָבֶֽךָ",
    "30": "כִּי יְהֹוָה הוּא הָאֱלֹהִים",
    "31": "בַּשָּׁמַֽיִם מִמַּֽעַל",
    "32": "וְעַל הָאָֽרֶץ מִתָּֽחַת",
    "33": "אֵין עוֹד:",
    "34": "עַל כֵּן נְקַוֶּה לְךָ",
    "35": "יְהֹוָה אֱלֹהֵֽינוּ",
    "36": "לִרְאוֹת מְהֵרָה בְּתִפְאֶֽרֶת עֻזֶּֽךָ",
    "37": "לְהַעֲבִיר גִּלּוּלִים מִן הָאָֽרֶץ",
    "38": "וְהָאֱלִילִים כָּרוֹת יִכָּרֵתוּן",
    "39": "לְתַקֵּן עוֹלָם",
    "40": "בְּמַלְכוּת שַׁדַּי",
    "41": " וְכָל בְּנֵי בָשָׂר יִקְרְאוּ בִשְׁ֒מֶֽךָ,",
    "42": "לְהַפְנוֹת אֵלֶֽיךָ",
    "43": " כָּל רִשְׁ֒עֵי אָֽרֶץ,",
    "44": "יַכִּֽירוּ וְיֵדְ֒עוּ",
    "45": "כָּל יוֹשְׁ֒בֵי תֵבֵל",
    "46": "כִּי לְךָ תִכְרַע כָּל בֶּֽרֶךְ",
    "47": "תִּשָּׁבַע כָּל לָשׁוֹן:",
    "48": "לְפָנֶֽיךָ יְהֹוָה אֱלֹהֵֽינוּ",
    "49": " יִכְרְעוּ וְיִפֹּֽלוּ,",
    "50": " וְלִכְ֒בוֹד שִׁמְךָ יְקָר יִתֵּֽנוּ,",
    "51": "וִיקַבְּ֒לוּ כֻלָּם",
    "52": " אֶת עֹל מַלְכוּתֶֽךָ,",
    "53": "וְתִמְלֹךְ עֲלֵיהֶם מְהֵרָה",
    "54": " לְעוֹלָם וָעֶד,",
    "55": "כִּי הַמַּלְ֒כוּת שֶׁלְּ֒ךָ הִיא",
    "56": " וּלְ֒עֽוֹלְ֒מֵי עַד תִּמְלוֹךְ בְּכָבוֹד,",
    "57": "כַּכָּתוּב בְּתוֹרָתֶֽךָ",
    "58": "יְהֹוָה יִמְלֹךְ לְעֹלָם וָעֶד:",
    "59": "וְנֶאֱמַר",
    "60": "וְהָיָה יְהֹוָה לְמֶֽלֶךְ",
    "61": "עַל כָּל הָאָֽרֶץ",
    "62": "בַּיּוֹם הַהוּא יִהְיֶה יְהֹוָה אֶחָד",
    "63": "וּשְׁמוֹ אֶחָד:",
    "64": "אַל תִּירָא מִפַּֽחַד פִּתְאֹם",
    "65": "וּמִשֹּׁאַת רְשָׁעִים",
    "66": "כִּי תָבֹא:",
    "67": "עֻֽצוּ עֵצָה וְתֻפָר",
    "68": "דַּבְּ֒רוּ דָבָר וְלֹא יָקוּם",
    "69": "כִּי עִמָּֽנוּ אֵל:",
    "70": "וְעַד זִקְנָה אֲנִי הוּא",
    "71": "וְעַד שֵׂיבָה אֲנִי אֶסְבֹּל:",
    "72": "אֲנִי עָשִֽׂיתִי וַאֲנִי אֶשָּׂא",
    "73": "וַאֲנִי אֶסְבֹּל וַאֲמַלֵּט:"
   },
   "en": {
    "1": "It is our obligation to praise",
    "2": "the Master of all,",
    "3": "to ascribe greatness",
    "4": "to the Creator of the [world in the] beginning:",
    "5": "that He has not made us",
    "6": "like the nations of the lands,",
    "7": "and has not positioned us",
    "8": "like the families of the earth;",
    "9": "that He has not assigned",
    "10": "our portion like theirs,",
    "11": "nor our lot like that of all their multitudes.",
    "12": "For they prostrate themselves",
    "13": "to vanity and nothingness,",
    "14": "and pray to a god that cannot deliver.",
    "15": "But we bow, prostrate ourselves,",
    "16": "and offer thanks",
    "17": "before the Supreme King of Kings,",
    "18": "the Holy One blessed is He,",
    "19": "Who spreads the heavens,",
    "20": "and establishes the earth,",
    "21": "and the seat of His glory is in heaven above,",
    "22": "and the abode of His invincible might",
    "23": "is in the loftiest heights.",
    "24": "He is our God, there is nothing else.",
    "25": "Our King is true,",
    "26": "all else is insignificant,",
    "27": "as it is written in His Torah:",
    "28": "“And You shall know this day",
    "29": "and take into Your heart",
    "30": "that Adonoy is God",
    "31": "in the heavens above",
    "32": "and upon the earth below;",
    "33": "there is nothing else.”",
    "34": "We therefore put our hope in You,",
    "35": "Adonoy our God,",
    "36": "to soon behold the glory of Your might",
    "37": "in banishing idolatry from the earth,",
    "38": "and the false gods will be utterly exterminated",
    "39": "to perfect the world",
    "40": "as the kingdom of Shadai.",
    "41": "And all mankind will invoke Your Name,",
    "42": "to turn back to You,",
    "43": "all the wicked of the earth.",
    "44": "They will realize and know,",
    "45": "all the inhabitants of the world,",
    "46": "that to You, every knee must bend,",
    "47": "every tongue must swear [allegiance to You].",
    "48": "Before You, Adonoy, our God,",
    "49": "they will bow and prostrate themselves,",
    "50": "and to the glory of Your Name give honor.",
    "51": "And they will all accept [upon themselves]",
    "52": "the yoke of Your kingdom,",
    "53": "and You will reign over them, soon,",
    "54": "forever and ever.",
    "55": "For the kingdom is Yours,",
    "56": "and to all eternity You will reign in glory,",
    "57": "as it is written in Your Torah:",
    "58": "“Adonoy will reign forever and ever.”",
    "59": "And it is said:",
    "60": "“And Adonoy will be King",
    "61": "over the whole earth;",
    "62": "on that day Adonoy will be One",
    "63": "and His Name One.”",
    "64": "Do not fear sudden terror",
    "65": "nor the destruction of the wicked",
    "66": "when it comes.",
    "67": "Take counsel together and it will be foiled",
    "68": "speak the word and it will not stand",
    "69": "for God is with us.",
    "70": "To your old age I am [with you],",
    "71": "to your older years I will sustain you,",
    "72": "I have made you, and I will carry you,",
    "73": "I will sustain you and save you."
   }
  }
 }
}
