{
 "id": "weekday/mincha/chazzans-repetition:sefard",
 "refs": {
  "Weekday Siddur Sefard Linear, Mincha, Shemoneh Esrei": {
   "edition": "metsudah-sefard-weekday",
   "he": {
    "1": "כִּי שֵׁם יְהֹוָה אֶקְרָא",
    "2": "הָבוּ גֹֽדֶל לֵאלֹהֵֽינוּ:",
    "3": "אֲדֹנָי שְׂפָתַי תִּפְתָּח",
    "4": "וּפִי יַגִּיד תְּהִלָּתֶֽךָ:",
    "6": "בָּרוּךְ אַתָּה יְהֹוָה",
    "7": "אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ",
    "8": "אֱלֹהֵי אַבְרָהָם אֱלֹהֵי יִצְחָק",
    "9": "וֵאלֹהֵי יַעֲקֹב",
    "10": "הָאֵל",
    "11": "הַגָּדוֹל הַגִּבּוֹר וְהַנּוֹרָא",
    "12": "אֵל עֶלְיוֹן",
    "13": "גּוֹמֵל חֲסָדִים טוֹבִים",
    "14": "וְקוֹנֵה הַכֹּל",
    "15": "וְזוֹכֵר חַסְ֒דֵי אָבוֹת",
    "16": "וּמֵבִיא גוֹאֵל",
    "17": "לִבְנֵי בְנֵיהֶם",
    "18": "לְמַֽעַן שְׁמוֹ בְּאַהֲבָה:",
    "20": "זָכְ֒רֵֽנוּ לְחַיִּים",
    "21": "מֶֽלֶךְ חָפֵץ בַּחַיִּים",
    "22": "וְכָתְ֒בֵֽנוּ בְּסֵֽפֶר הַחַיִּים",
    "23": "לְמַעַנְ֒ךָ אֱלֹהִים חַיִּים:",
    "25": "מֶֽלֶךְ עוֹזֵר וּמוֹשִֽׁיעַ וּמָגֵן:",
    "26": "בָּרוּךְ אַתָּה יְהֹוָה",
    "27": "מָגֵן אַבְרָהָם:",
    "29": "אַתָּה גִבּוֹר לְעוֹלָם אֲדֹנָי",
    "30": "מְחַיֶּה מֵתִים אַתָּה",
    "31": "רַב לְהוֹשִֽׁיעַ:",
    "33": "מוֹרִיד הַטָּל",
    "35": "מַשִּׁיב הָרֽוּחַ",
    "36": "וּמוֹרִיד הַגֶּֽשֶׁם:",
    "38": "מְכַלְכֵּל חַיִּים בְּחֶֽסֶד",
    "39": "מְחַיֵּה מֵתִים בְּרַחֲמִים רַבִּים",
    "40": "סוֹמֵךְ נוֹפְ֒לִים",
    "41": "וְרוֹפֵא חוֹלִים",
    "42": "וּמַתִּיר אֲסוּרִים",
    "43": "וּמְ֒קַיֵּם אֱמוּנָתוֹ",
    "44": " לִישֵׁנֵי עָפָר,",
    "45": "מִי כָמֽוֹךָ בַּֽעַל גְּבוּרוֹת",
    "46": "וּמִי דּֽוֹמֶה לָּךְ",
    "47": "מֶֽלֶךְ מֵמִית וּמְ֒חַיֶּה",
    "48": "וּמַצְמִֽיחַ יְשׁוּעָה:",
    "50": "מִי כָמֽוֹךָ אָב הָרַחַמָן",
    "51": "זוֹכֵר יְצוּרָיו לְחַיִּים",
    "52": "בְּרַחֲמִים:",
    "54": "וְנֶאֱמָן אַתָּה",
    "55": "לְהַחֲיוֹת מֵתִים:",
    "56": "בָּרוּךְ אַתָּה יְהֹוָה",
    "57": "מְחַיֵּה הַמֵּתִים:",
    "61": "נַקְדִישָׁךְ וְנַעֲרִיצָךְ",
    "62": "כְּנֹֽעַם שִֽׂיחַ",
    "63": "סוֹד שַׂרְ֒פֵי קֽוֹדֶשׁ",
    "64": "הַמְּ֒שַׁלְּ֒שִׁים לְךָ קְדֻשָּׁה",
    "65": "כַּכָּתוּב עַל יַד נְבִיאֶֽךָ",
    "66": "וְקָרָא זֶה אֶל זֶה וְאָמַר:",
    "68": "קָדוֹשׁ קָדוֹשׁ קָדוֹשׁ",
    "69": "יְהֹוָה צְבָאוֹת",
    "70": "מְלֹא כָל הָאָֽרֶץ כְּבוֹדוֹ:",
    "72": "לְעֻמָּתָם מְשַׁבְּ֒חִים וְאוֹמְ֒רִים:",
    "74": "בָּרוּךְ כְּבוֹד יְהֹוָה",
    "75": "מִמְּ֒קוֹמוֹ:",
    "77": "וּבְ֒דִבְרֵי קָדְשְׁ֒ךָ כָּתוּב לֵאמֹר:",
    "79": "יִמְלֹךְ יְהֹוָה לְעוֹלָם",
    "80": "אֱלֹהַֽיִךְ צִיּוֹן לְדֹר וָדֹר:",
    "81": "הַלְ֒לוּיָהּ:",
    "82": "<b>קדושת השם</b>",
    "83": "אַתָּה קָדוֹשׁ וְשִׁמְךָ קָדוֹשׁ",
    "84": "וּקְ֒דוֹשִׁים",
    "85": "בְּכָל יוֹם יְהַלְ֒לֽוּךָ סֶּֽלָה:",
    "86": "כִּי אֵל מֶֽלֶךְ",
    "87": "גָּדוֹל וְקָדוֹשׁ אָֽתָּה:",
    "89": "בָּרוּךְ אַתָּה יְהֹוָה",
    "90": "הָאֵל הַקָּדוֹשׁ:",
    "92": "בָּרוּךְ אַתָּה יְהֹוָה",
    "93": "הַמֶּֽלֶךְ הַקָּדוֹשׁ:",
    "96": "אַתָּה חוֹנֵן לְאָדָם דַּֽעַת",
    "97": "וּמְ֒לַמֵּד לֶאֱנוֹשׁ בִּינָה:",
    "98": "חָנֵּֽנוּ מֵאִתְּ֒ךָ",
    "99": "חָכְמָה בִּינָה וָדָּֽעַת",
    "100": "בָּרוּךְ אַתָּה יְהֹוָה",
    "101": "חוֹנֵן הַדָּֽעַת:",
    "103": "הֲשִׁיבֵֽנוּ אָבִֽינוּ",
    "104": "לְתוֹרָתֶֽךָ",
    "105": "וְקָרְ֒בֵֽנוּ מַלְכֵּֽנוּ לַעֲבוֹדָתֶֽךָ",
    "106": "וְהַחֲזִירֵֽנוּ",
    "107": "בִּתְ֒שׁוּבָה שְׁלֵמָה לְפָנֶֽיךָ:",
    "108": "בָּרוּךְ אַתָּה יְהֹוָה",
    "109": "הָרוֹצֶה בִּתְ֒שׁוּבָה:",
    "111": "סְלַח לָֽנוּ אָבִֽינוּ כִּי חָטָֽאנוּ",
    "112": "מְחַל לָֽנוּ מַלְכֵּֽנוּ",
    "113": " כִּי פָשָֽׁעְנוּ,",
    "114": "כִּי אֵל טוֹב וְסַלָּח אָֽתָּה:",
    "115": "בָּרוּךְ אַתָּה יְהֹוָה",
    "116": "חַנּוּן הַמַּרְבֶּה לִסְלֽוֹחַ:",
    "118": "רְאֵה נָא בְעָנְיֵֽנוּ",
    "119": "וְרִֽיבָה רִיבֵֽנוּ",
    "120": "וּגְ֒אָלֵֽנוּ",
    "121": "גְאוּלָה שְׁלֵמָה מְהֵרָה",
    "122": "לְמַֽעַן שְׁמֶֽךָ",
    "123": "כִּי אֵל גּוֹאֵל חָזָק אָֽתָּה:",
    "124": "בָּרוּךְ אַתָּה יְהֹוָה",
    "125": "גּוֹאֵל יִשְׂרָאֵל:",
    "128": "רְפָאֵֽנוּ יְהֹוָה וְנֵרָפֵא",
    "129": "הוֹשִׁיעֵֽנוּ וְנִוָּשֵֽׁעָה",
    "130": "כִּי תְהִלָּתֵֽנוּ אָֽתָּה",
    "131": "וְהַעֲלֵה אֲרוּכָה וּמַרְפֵּא",
    "132": "לְכָל תַּחֲלוּאֵֽינוּ",
    "133": "וּלְ֒כָל מַכְאוֹבֵֽינוּ",
    "134": "וּלְ֒כָל מַכּוֹתֵֽינוּ",
    "135": "כִּי אֵל מֶֽלֶךְ",
    "136": "רוֹפֵא נֶאֱמָן וְרַחֲמָן אָֽתָּה:",
    "137": "בָּרוּךְ אַתָּה יְהֹוָה",
    "138": "רוֹפֵא חוֹלֵי עַמּוֹ יִשְׂרָאֵל:",
    "140": "בָּרֵךְ עָלֵֽינוּ יְהֹוָה אֱלֹהֵֽינוּ",
    "141": "אֶת הַשָּׁנָה הַזֹּאת",
    "142": "וְאֶת כָּל מִינֵי תְבוּאָתָהּ",
    "143": " לְטוֹבָה,",
    "144": "וְתֵן",
    "146": "בְּרָכָה",
    "148": "טַל וּמָטָר לִבְ֒רָכָה",
    "150": "עַל פְּנֵי הָאֲדָמָה",
    "151": "וְשַׂבְּ֒עֵֽנוּ מִטּוּבָהּ",
    "152": "וּבָרֵךְ שְׁנָתֵנוּ",
    "153": "כַּשָּׁנִים הַטּוֹבוֹת לִבְרָכָה",
    "154": "כִּי אֵל טוֹב",
    "155": "ומֵטִיב אַתָּה",
    "156": "וּמְ֒בָרֵךְ הַשָׁנִים",
    "157": "בָּרוּךְ אַתָּה יְהֹוָה",
    "158": "מְבָרֵךְ הַשָּׁנִים:",
    "160": "תְּקַע בְּשׁוֹפָר גָּדוֹל לְחֵרוּתֵֽנוּ",
    "161": "וְשָׂא נֵס לְקַבֵּץ גָּלֻיּוֹתֵֽינוּ",
    "162": "וְקַבְּ֒צֵֽנוּ יַֽחַד מְהֵרָה",
    "163": "מֵאַרְבַּע כַּנְ֒פוֹת הָאָֽרֶץ",
    "164": "לְאַרְצֵֽנוּ:",
    "165": "בָּרוּךְ אַתָּה יְהֹוָה",
    "166": "מְקַבֵּץ",
    "167": "נִדְחֵי עַמּוֹ יִשְׂרָאֵל:",
    "169": "הָשִֽׁיבָה שׁוֹפְ֒טֵֽינוּ כְּבָרִאשׁוֹנָה",
    "170": "וְיוֹעֲצֵֽינוּ כְּבַתְּ֒חִלָּה",
    "171": "וְהָסֵר מִמֶּֽנּוּ יָגוֹן וַאֲנָחָה",
    "172": "וּמְ֒לוֹךְ עָלֵֽינוּ מְהֵרָה",
    "173": "אַתָּה יְהֹוָה לְבַדְּ֒ךָ",
    "174": "בְּחֶֽסֶד וּבְ֒רַחֲמִים",
    "175": "וְצַדְּ֒קֵֽנוּ",
    "176": "בְּצֶֽדֶק וּבְ֒מִשְׁפָּט:",
    "178": "בָּרוּךְ אַתָּה יְהֹוָה",
    "179": "מֶֽלֶךְ אֹהֵב צְדָקָה וּמִשְׁפָּט:",
    "181": "בָּרוּךְ אַתָּה יְהֹוָה",
    "182": "הַמֶּֽלֶךְ הַמִּשְׁפָּט:",
    "185": "וְלַמַּלְשִׁינִים אַל תְּהִי תִקְוָה",
    "186": "וְכָל הָרִשְׁעָה כְּרֶגַע תֹּאבֵד",
    "187": " וְכָל אֹיְ֒בֶֽיךָ מְהֵרָה יִכָּרֵֽתוּ,",
    "188": "וְהַזֵּדִים מְהֵרָה תְעַקֵּר",
    "189": "וּתְ֒שַׁבֵּר וּתְ֒מַגֵּר וּתְ֒כַלֵם וְתַשְׁפִּילֵם",
    "190": "וְתַכְנִיעֵם בִּמְ֒הֵרָה בְיָמֵֽינוּ:",
    "191": "בָּרוּךְ אַתָּה יְהֹוָה",
    "192": "שׁוֹבֵר אֹיְ֒בִים",
    "193": "וּמַכְנִֽיעַ זֵדִים:",
    "195": "עַל הַצַּדִּיקִים וְעַל הַחֲסִידִים",
    "196": "וְעַל זִקְ֒נֵי שְׁאֵרִית",
    "197": "עַמְּ֒ךָ בֵּית יִשְׂרָאֵל",
    "198": "וְעַל פְּלֵיטַת (בֵּית) סוֹפְרֵיהֶם",
    "199": "וְעַל גֵּרֵי הַצֶּֽדֶק וְעָלֵֽינוּ",
    "200": "יֶהֱמוּ נָא רַחֲמֶֽיךָ",
    "201": "יְהֹוָה אֱלֹהֵֽינוּ",
    "202": "וְתֵן שָׂכָר טוֹב",
    "203": "לְכָל הַבּוֹטְ֒חִים בְּשִׁמְךָ בֶּאֱמֶת",
    "204": "וְשִׂים חֶלְקֵֽנוּ עִמָּהֶם",
    "205": "וּלְ֒עוֹלָם לֹא נֵבוֹשׁ",
    "206": "כִּי בְךָ בָטָֽחְנוּ",
    "207": "וְעַל חַסְדְּ֒ךָ הַגָּדוֹל",
    "208": "בֶּאֱמֶת נִשְׁעָֽנְנוּ:",
    "209": "בָּרוּךְ אַתָּה יְהֹוָה",
    "210": "מִשְׁעָן וּמִבְטָח לַצַּדִּיקִים:",
    "212": "וְלִירוּשָׁלַֽיִם עִירְ֒ךָ",
    "213": "בְּרַחֲמִים תָּשׁוּב",
    "214": "וְתִשְׁכּוֹן בְּתוֹכָהּ כַּאֲשֶׁר דִּבַּֽרְתָּ",
    "215": "וּבְ֒נֵה אוֹתָהּ בְּקָרוֹב בְּיָמֵֽינוּ",
    "216": "בִּנְיַן עוֹלָם",
    "217": " וְכִסֵּא דָוִד עַבְדֶּךָ,",
    "218": "מְהֵרָה לְתוֹכָהּ תָּכִין:",
    "220": "נַחֵם יְהֹוָה אֱלֹהֵֽינוּ",
    "221": "אֶת אֲבֵלֵי צִיּוֹן",
    "222": "וְאֶת אֲבֵלֵי יְרוּשָׁלָֽיִם.",
    "223": "וְאֶת הָעִיר הָאֲבֵלָה",
    "224": "וְהַחֲרֵבָה וְהַבְּ֒זוּיָה וְהַשּוֹמֵמָה.",
    "225": "הָאֲבֵלָה מִבְּ֒לִי בָנֶֽיהָ.",
    "226": "וְהַחֲרֵבָה מִמְּ֒עוֹנוֹתֶֽיהָ.",
    "227": "וְהַבְּ֒זוּיָה מִכְּ֒בוֹדָהּ.",
    "228": "וְהַשוֹמֵמָה מֵאֵין יוֹשֵׁב.",
    "229": "וְהִיא יוֹשֶֽׁבֶת וְרֹאשָׁהּ חָפוּי",
    "230": "כְּאִשָּׁה עֲקָרָה שֶׁלֹּא יָלָֽדָה.",
    "231": "וַיְבַלְּ֒עֽוּהָ לִיגְיוֹנוֹת.",
    "232": "וְיִירָשֽׁוּהָ עוֹבְ֒דֵי כוֹכָבִים.",
    "233": "וַיָטִּֽילוֹ אֶת עַמְּ֒ךָ יִשְׂרָאֵל",
    "234": "לֶחָֽרֶב.",
    "235": "וַיַּהַרְגוּ בְזָדוֹן",
    "236": "חֲסִידֵי עֶלְיוֹן.",
    "237": "עַל כֵּן צִיּוֹן בְּמַר תִבְכֶּה.",
    "238": "וִירוּשָׁלַֽיִם תִּתֵּן קוֹלָהּ.",
    "239": "לִבִּי לִבִּי",
    "240": "עַל חַלְלֵיהֶם.",
    "241": "מֵעַי מֵעַי",
    "242": "עַל חַלְלֵיהֶם.",
    "243": "כִּי אַתָּה יְהֹוָה בָּאֵשׁ הִצַּתָּהּ.",
    "244": "וּבָאֵשׁ אַתָּה עָתִיד לִבְנוֹתָהּ.",
    "245": "כָּאָמוּר",
    "246": "וַאֲנִי אֶהְיֶה לָהּ נְאֻם יְהֹוָה",
    "247": "חוֹמַת אֵשׁ סָבִיב",
    "248": "וּלְכָבוֹד אֶהְיֶה בְּתוֹכָהּ:",
    "249": "בָּרוּךְ אַתָּה יְהֹוָה",
    "250": "מְנַחֵם צִיּוֹן וּבוֹנֵה יְרוּשָׁלָֽיִם:",
    "252": "בָּרוּךְ אַתָּה יְהֹוָה",
    "253": "בּוֹנֵה יְרוּשָׁלָֽיִם:",
    "255": "אֶת צֶֽמַח דָּוִד עַבְדְּ֒ךָ",
    "256": "מְהֵרָה תַצְמִֽיחַ",
    "257": " וְקַרְנוֹ תָּרוּם בִּישׁוּעָתֶֽךָ,",
    "258": "כִּי לִישׁוּעָתְ֒ךָ קִוִּֽינוּ כָּל הַיּוֹם",
    "259": "וּמְ֒צַפִּים לִישׁוּעָה:",
    "260": "בָּרוּךְ אַתָּה יְהֹוָה",
    "261": "מַצְמִֽיחַ",
    "262": "קֶֽרֶן יְשׁוּעָה:",
    "264": "אָב הָרַחֲמָן",
    "265": "שְׁמַע קוֹלֵֽנוּ יְהֹוָה אֱלֹהֵֽינוּ",
    "266": "חוּס וְרַחֵם עָלֵֽינוּ",
    "267": "וְקַבֵּל",
    "268": " בְּרַחֲמִים וּבְ֒רָצוֹן אֶת תְּפִלָּתֵֽנוּ,",
    "269": "כִּי אֵל",
    "270": "שׁוֹמֵֽעַ תְּפִלּוֹת וְתַחֲנוּנִים אָֽתָּה",
    "271": "וּמִלְּ֒פָנֶֽיךָ מַלְכֵּֽנוּ",
    "272": " רֵיקָם אַל תְּשִׁיבֵֽנוּ,",
    "273": "חָנֵּֽנוּ וַעֲנֵֽנוּ",
    "274": "וּשְׁ֒מַע תְּפִלָתֵֽנוּ",
    "276": "עֲנֵֽנוּ יְהֹוָה עֲנֵֽנוּ",
    "277": "בְּיוֹם צוֹם תַּעֲנִיתֵֽנוּ.",
    "278": "כִּי בְצָרָה גְדוֹלָה אֲנָֽחְנוּ.",
    "279": "אַל תֵּֽפֶן אֶל רִשְׁעֵֽנוּ",
    "280": "וְאַל תַּסְתֵּר פָּנֶֽיךָ מִמֶּֽנּוּ",
    "281": "וְאַל תִּתְעַלַּם",
    "282": "מִתְּ֒חִנָּתֵֽנוּ",
    "283": "הֱיֵה נָא קָרוֹב לְשַׁוְעָתֵֽנוּ",
    "284": "יְהִי נָא חַסְדְּ֒ךָ לְנַחֲמֵֽנוּ",
    "285": "טֶֽרֶם נִקְרָא אֵלֶֽיךָ עֲנֵֽנוּ.",
    "286": "כַּדָּבָר שֶׁנֶּאֱמַר",
    "287": "וְהָיָה טֶֽרֶם יִקְרָֽאוּ",
    "288": "וַאֲנִי אֶעֱנֶה.",
    "289": "עוֹד הֵם מְדַבְּ֒רִים",
    "290": "וַאֲנִי אֶשְׁמָע.",
    "291": "כִּי אַתָּה יְהֹוָה",
    "292": "הָעוֹנֶה בְּעֵת צָרָה.",
    "293": "פּוֹדֶה וּמַצִּיל",
    "294": "בְּכָל עֵת צָרָה וְצוּקָה:",
    "296": "בָּרוּךְ אַתָּה יְהֹוָה",
    "297": "הָעוֹנֶה לְעַמּוֹ יִשְׂרָאֵל",
    "298": "בְּעֵת צָרָה:",
    "299": "כִּי אַתָּה שׁוֹמֵֽעַ תְּפִלַּת כָּל פֶּה",
    "300": "עַמְּ֒ךָ יִשְׂרָאֵל בְּרַחֲמִים:",
    "301": "בָּרוּךְ אַתָּה יְהֹוָה",
    "302": "שׁוֹמֵֽעַ תְּפִלָּה:",
    "304": "רְצֵה יְהֹוָה אֱלֹהֵֽינוּ",
    "305": "בְּעַמְּ֒ךָ יִשְׂרָאֵל",
    "306": " וְלִתְ֒פִלָּתָם שְׁעֵה,",
    "307": "וְהָשֵׁב אֶת הָעֲבוֹדָה",
    "308": "לִדְ֒בִיר בֵּיתֶֽךָ",
    "309": " וְאִשֵּׁי יִשְׂרָאֵל,",
    "310": "וּתְ֒פִלָּתָם בְּאַהֲבָה תְקַבֵּל",
    "311": "בְּרָצוֹן",
    "312": "וּתְ֒הִי לְרָצוֹן תָּמִיד",
    "313": "עֲבוֹדַת יִשְׂרָאֵל עַמֶּֽךָ:",
    "316": "אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ",
    "317": "יַעֲלֶה וְיָבֹא וְיַגִּֽיעַ",
    "318": "וְיֵרָאֶה וְיֵרָצֶה וְיִשָּׁמַע",
    "319": "וְיִפָּקֵד וְיִזָּכֵר",
    "320": "זִכְרוֹנֵֽנוּ וּפִקְ֒דוֹנֵֽנוּ",
    "321": "וְזִכְרוֹן אֲבוֹתֵֽינוּ",
    "322": "וְזִכְרוֹן מָשִֽׁיחַ",
    "323": "בֶּן דָּוִד עַבְדֶּֽךָ",
    "324": "וְזִכְרוֹן יְרוּשָׁלַֽיִם",
    "325": "עִיר קָדְשֶֽׁךָ",
    "326": "וְזִכְרוֹן כָּל עַמְּ֒ךָ",
    "327": " בֵּית יִשְׂרָאֵל לְפָנֶֽיךָ,",
    "328": "לִפְ֒לֵיטָה לְטוֹבָה",
    "329": "לְחֵן וּלְ֒חֶֽסֶד וּלְ֒רַחֲמִים",
    "330": "וּלְ֒חַיִּים טוֹבִים וּלְ֒שָׁלוֹם",
    "331": "בְּיוֹם",
    "332": "<small>לְר\"ח:</small> רֹאשׁ הַחֹֽדֶשׁ הַזֶּה",
    "333": "<small>לְפֶסַח:</small> חַג הַמַּצּוֹת הַזֶּה",
    "334": "<small>לְסֻכּוֹת:</small> חַג הַסֻּכּוֹת הַזֶּה",
    "335": "זָכְ֒רֵֽנוּ יְהֹוָה אֱלֹהֵֽינוּ",
    "336": " בּוֹ לְטוֹבָה,",
    "337": " וּפָקְ֒דֵֽנוּ בוֹ לִבְ֒רָכָה,",
    "338": " וְהוֹשִׁיעֵֽנוּ בוֹ לְחַיִּים טוֹבִים,",
    "339": "וּבִדְ֒בַר יְשׁוּעָה",
    "340": "וְרַחֲמִים",
    "341": " חוּס וְחָנֵּֽנוּ,",
    "342": " וְרַחֵם עָלֵֽינוּ וְהוֹשִׁיעֵֽנוּ,",
    "343": " כִּי אֵלֶֽיךָ עֵינֵֽינוּ,",
    "344": "כִּי אֵל",
    "345": "מֶֽלֶךְ חַנּוּן וְרַחוּם אָֽתָּה:",
    "347": "וְתֶחֱזֶֽינָה עֵינֵֽינוּ",
    "348": "בְּשׁוּבְ֒ךָ לְצִיּוֹן בְּרַחֲמִים:",
    "349": "בָּרוּךְ אַתָּה יְהֹוָה",
    "350": "הַמַּחֲזִיר שְׁכִינָתוֹ לְצִיּוֹן:",
    "353": "מוֹדִים אֲנַֽחְנוּ לָךְ",
    "354": "שָׁאַתָּה הוּא יְהֹוָה אֱלֹהֵֽינוּ",
    "355": "וֵאלֹהֵי אֲבוֹתֵֽינוּ לְעוֹלָם וָעֶד",
    "356": "צוּרֵֽנוּ צוּר חַיֵּֽינוּ",
    "357": "מָגֵן יִשְׁעֵֽנוּ",
    "358": "אַתָּה הוּא לְדוֹר וָדוֹר",
    "359": "נוֹדֶה לְּךָ",
    "360": "וּנְ֒סַפֵּר תְּהִלָּתֶֽךָ",
    "361": "עַל חַיֵּֽינוּ",
    "362": "הַמְּ֒סוּרִים בְּיָדֶֽךָ",
    "363": "וְעַל נִשְׁ֒מוֹתֵֽינוּ",
    "364": "הַפְּ֒קוּדוֹת לָךְ",
    "365": "וְעַל נִסֶּֽיךָ שֶׁבְּ֒כָל יוֹם עִמָּֽנוּ",
    "366": "וְעַל נִפְלְאוֹתֶֽיךָ וְטוֹבוֹתֶֽיךָ",
    "367": " שֶׁבְּ֒כָל עֵת,",
    "368": " עֶֽרֶב וָבֹֽקֶר וְצָהֳרָֽיִם,",
    "369": "הַטּוֹב",
    "370": "כִּי לֹא כָלוּ רַחֲמֶֽיךָ",
    "371": "וְהַמְ֒רַחֵם",
    "372": " כִּי לֹא תַֽמּוּ חֲסָדֶֽיךָ,",
    "373": "כִּי מֵעוֹלָם קִוִּֽינוּ לָךְ:",
    "375": "מוֹדִים אֲנַֽחְנוּ לָךְ",
    "376": "שָׁאַתָּה הוּא יְהֹוָה אֱלֹהֵֽינוּ",
    "377": "וֵאלֹהֵי אֲבוֹתֵֽינוּ",
    "378": "אֱלֹהֵי כָל בָּשָׂר",
    "379": "יוֹצְ֒רֵֽנוּ יוֹצֵר בְּרֵאשִׁית",
    "380": "בְּרָכוֹת וְהוֹדָאוֹת",
    "381": "לְשִׁמְךָ הַגָּדוֹל וְהַקָּדוֹשׁ",
    "382": "עַל שֶׁהֶחֱיִיתָֽנוּ וְקִיַּמְתָּֽנוּ",
    "383": "כֵּן תְּחַיֵּֽינוּ",
    "384": "וּתְ֒קַיְּ֒מֵֽנוּ",
    "385": "וְתֶאֱסוֹף גָּלֻיּוֹתֵֽינוּ",
    "386": "לְחַצְ֒רוֹת קָדְשֶֽׁךָ",
    "387": "לִשְׁמוֹר חֻקֶּֽיךָ",
    "388": "וְלַעֲשׂוֹת רְצוֹנֶֽךָ",
    "389": "וּלְ֒עָבְדְּ֒ךָ בְּלֵבָב שָׁלֵם",
    "390": " עַל שֶׁאָֽנוּ מוֹדִים לָךְ,",
    "391": "בָּרוּךְ אֵל",
    "392": "הַהוֹדָאוֹת:",
    "394": "וְעַל הַנִּסִּים",
    "395": "וְעַל הַפֻּרְקָן וְעַל הַגְּ֒בוּרוֹת",
    "396": "וְעַל הַתְּ֒שׁוּעוֹת וְעַל הַנִּפְלָאוֹת",
    "397": "וְעַל הַנֶּחָמוֹת וְעַל הַמִּלְחָמוֹת",
    "398": "שֶׁעָשִֽׂיתָ לַאֲבוֹתֵֽינוּ",
    "399": "בַּיָּמִים הָהֵם בִּזְּ֒מַן הַזֶּה:",
    "401": "בִּימֵי מַתִּתְיָֽהוּ",
    "402": "בֶּן יוֹחָנָן כֹּהֵן גָּדוֹל",
    "403": "חַשְׁמוֹנָאִי וּבָנָיו",
    "404": "כְּשֶׁעָמְ֒דָה מַלְכוּת יָוָן הָרְ֒שָׁעָה",
    "405": "עַל עַמְּ֒ךָ יִשְׂרָאֵל",
    "406": "לְהַשְׁכִּיחָם תּוֹרָתֶֽךָ",
    "407": "וּלְ֒הַעֲבִירָם",
    "408": " מֵחֻקֵּי רְצוֹנֶֽךָ,",
    "409": "וְאַתָּה בְּרַחֲמֶֽיךָ הָרַבִּים",
    "410": "עָמַֽדְתָּ לָהֶם בְּעֵת צָרָתָם",
    "411": "רַֽבְתָּ אֶת רִיבָם",
    "412": "דַּֽנְתָּ אֶת דִּינָם",
    "413": "נָקַֽמְתָּ אֶת נִקְ֒מָתָם",
    "414": "מָסַֽרְתָּ גִבּוֹרִים",
    "415": "בְּיַד חַלָּשִׁים",
    "416": "וְרַבִּים בְּיַד מְעַטִּים",
    "417": "וּטְ֒מֵאִים בְּיַד טְהוֹרִים",
    "418": "וּרְ֒שָׁעִים בְּיַד צַדִּיקִים",
    "419": "וְזֵדִים בְּיַד",
    "420": "עוֹסְ֒קֵי תוֹרָתֶֽךָ",
    "421": "וּלְ֒ךָ עָשִֽׂיתָ",
    "422": "שֵׁם גָּדוֹל וְקָדוֹשׁ בְּעוֹלָמֶֽךָ",
    "423": "וּלְ֒עַמְּ֒ךָ יִשְׂרָאֵל",
    "424": "עָשִֽׂיתָ תְּשׁוּעָה גְדוֹלָה",
    "425": "וּפֻרְקָן כְּהַיּוֹם הַזֶּה",
    "426": "וְאַחַר כַּךְ בָּֽאוּ בָנֶֽיךָ",
    "427": "לִדְ֒בִיר בֵּיתֶֽךָ",
    "428": "וּפִנּוּ אֶת הֵיכָלֶֽךָ",
    "429": "וְטִהֲרוּ אֶת מִקְדָּשֶֽׁךָ",
    "430": "וְהִדְלִֽיקוּ נֵרוֹת",
    "431": "בְּחַצְ֒רוֹת קָדְשֶֽׁךָ",
    "432": "וְקָבְ֒עוּ שְׁמוֹנַת יְמֵי חֲנֻכָּה אֵֽלּוּ",
    "433": "לְהוֹדוֹת וּלְ֒הַלֵּל לְשִׁמְךָ הַגָּדוֹל:",
    "435": "בִּימֵי מָרְדְּכַי וְאֶסְתֵּר",
    "436": "בְּשׁוּשַׁן הַבִּירָה",
    "437": "כְּשֶׁעָמַד עֲלֵיהֶם הָמָן הָרָשָׁע",
    "438": "בִּקֵּשׁ לְהַשְׁמִיד לַהֲרוֹג",
    "439": "וּלְ֒אַבֵּד אֶת כָּל הַיְ֒הוּדִים",
    "440": "מִנַּֽעַר וְעַד זָקֵן טַף וְנָשִׁים",
    "441": "בְּיוֹם אֶחָד בִּשְׁ֒לוֹשָׁה עָשָׂר",
    "442": "לְחֹֽדֶשׁ שְׁנֵים עָשָׂר",
    "443": "הוּא חֹֽדֶשׁ אֲדָר",
    "444": "וּשְׁ֒לָלָם לָבוֹז:",
    "445": "וְאַתָּה בְּרַחֲמֶֽיךָ הָרַבִּים",
    "446": "הֵפַֽרְתָּ אֶת עֲצָתוֹ",
    "447": "וְקִלְקַֽלְתָּ אֶת מַחֲשַׁבְתּוֹ",
    "448": "וַהֲשֵׁבֽוֹתָ לּוֹ גְּמוּלוֹ בְּרֹאשׁוֹ",
    "449": "וְתָלוּ אוֹתוֹ וְאֶת בָּנָיו",
    "450": "עַל הָעֵץ:",
    "451": "וְעַל כֻּלָּם",
    "452": "יִתְבָּרַךְ וְיִתְרוֹמַם וְיִתְנַשֵׂא",
    "453": "שִׁמְךָ מַלְכֵּֽנוּ",
    "454": "תָּמִיד לְעוֹלָם וָעֶד:",
    "456": "וּכְ֒תוֹב לְחַיִּים טוֹבִים",
    "457": "כָּל בְּנֵי בְרִיתֶֽךָ:",
    "459": "וְכֹל הַחַיִּים יוֹדֽוּךָ סֶּֽלָה",
    "460": "וִיהַלְ֒לוּ וְיבָרְ֒כוּ",
    "461": "אֶת שִׁמְךָ הַגָּדוֹל בְּאֱמֶת לְעוֹלָם",
    "462": "כִּי טוֹב",
    "463": "הָאֵל יְשׁוּעָתֵֽנוּ",
    "464": "וְעֶזְרָתֵֽנוּ סֶֽלָה",
    "465": "הָאֵל הַטּוֹב:",
    "466": "בָּרוּךְ אַתָּה יְהֹוָה",
    "467": "הַטּוֹב שִׁמְךָ",
    "468": "וּלְ֒ךָ נָאֶה לְהוֹדוֹת:",
    "471": "אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ בָּרְ֒כֵֽנוּ",
    "472": "בַבְּ֒רָכָה הַמְּ֒שֻׁלֶּֽשֶׁת בַּתּוֹרָה",
    "473": " הַכְּ֒תוּבָה עַל יְדֵי משֶׁה עַבְדֶּֽךָ,",
    "474": "הָאֲמוּרָה מִפִּי אַהֲרֹן",
    "475": "וּבָנָיו כֹּהֲנִים עַם קְדוֹשֶֽׁךָ",
    "476": "כָּאָמוּר:",
    "477": "יְבָרֶכְךָ יְהֹוָה וְיִשְׁמְ֒רֶֽךָ:",
    "478": "יָאֵר יְהֹוָה פָּנָיו אֵלֶֽיךָ",
    "479": "וִיחֻנֶּֽךָ:",
    "480": "יִשָּׂא יְהֹוָה פָּנָיו אֵלֶֽיךָ",
    "481": "וְיָשֵׂם לְךָ שָׁלוֹם:",
    "483": " אַדִּיר בַּמָּרוֹם שׁוֹכֵן בִּגְ֒בוּרָה,",
    "484": "אַתָּה שָׁלוֹם וְשִׁמְךָ שָׁלוֹם.",
    "485": "יְהִי רָצוֹן שֶׁתָּשִׂים עָלֵֽינוּ",
    "486": "וְעַל כָּל עַמְּ֒ךָ בֵּית יִשְׂרָאֵל",
    "487": "חַיִּים וּבְ֒רָכָה",
    "488": "לְמִשְׁמֶֽרֶת שָׁלוֹם:",
    "490": "שִׂים שָׁלוֹם טוֹבָה וּבְ֒רָכָה",
    "491": "חַיִים חֵן וָחֶֽסֶד וְרַחֲמִים",
    "492": " עָלֵֽינוּ וְעַל כָּל יִשְׂרָאֵל עַמֶּֽךָ,",
    "493": "בָּרְ֒כֵֽנוּ אָבִֽינוּ כֻּלָּֽנוּ כְּאֶחָד",
    "494": "בְּאוֹר פָּנֶֽיךָ",
    "495": "כִּי בְאוֹר פָּנֶֽיךָ",
    "496": "נָתַֽתָּ לָּֽנוּ יְהֹוָה אֱלֹהֵֽינוּ",
    "497": "תּוֹרַת חַיִּים וְאַהֲבַת חֶֽסֶד",
    "498": "וּצְ֒דָקָה וּבְ֒רָכָה וְרַחֲמִים",
    "499": " וְחַיִּים וְשָׁלוֹם,",
    "500": "וְטוֹב יִהְיֶה בְּעֵינֶֽיךָ",
    "501": "לְבָרְ֒כֵֽנוּ",
    "502": "וּלְ֒בָרֵךְ אֶת כָּל עַמְּ֒ךָ יִשְׂרָאֵל",
    "503": "בְּכָל עֵת וּבְכָל שָׁעָה",
    "504": "בִּשְׁ֒לוֹמֶֽךָ",
    "505": "(בְּרוֹב עוֹז וְשָׁלוֹם).",
    "507": "בְּסֵֽפֶר חַיִּים בְּרָכָה וְשָׁלוֹם",
    "508": "וּפַרְנָסָה טוֹבָה",
    "509": " וּגְ֒זֵרוֹת טוֹבוֹת, יְשׁוּעוֹת וְנֶחָמוֹת,",
    "510": "נִזָּכֵר וְנִכָּתֵב",
    "511": "לְפָנֶֽיךָ",
    "512": "אֲנַֽחְנוּ וְכָל עַמְּ֒ךָ בֵּית יִשְׂרָאֵל",
    "513": "לְחַיִּים טוֹבִים וּלְ֒שָׁלוֹם:",
    "515": "בָּרוּךְ אַתָּה יְהֹוָה",
    "516": "הַמְּ֒בָרֵךְ אֶת עַמּוֹ יִשְׂרָאֵל",
    "517": "בַּשָּׁלוֹם:",
    "518": "יִהְיוּ לְרָצוֹן",
    "519": "אִמְ֒רֵי פִי",
    "520": "וְהֶגְיוֹן לִבִּי לְפָנֶֽיךָ",
    "521": "יְהֹוָה צוּרִי וְגוֹאֲלִי:"
   },
   "en": {
    "1": "When I proclaim Adonoy's Name",
    "2": "attribute greatness to our God.",
    "3": "My Master, open my lips,",
    "4": "and my mouth will declare Your praise.",
    "6": "Blessed are You, Adonoy,",
    "7": "our God, and God of our fathers,",
    "8": "God of Abraham, God of Isaac,",
    "9": "and God of Jacob,",
    "10": "the Almighty,",
    "11": "the Great, the Powerful, the Awesome,",
    "12": "most high Almighty,",
    "13": "Who bestows beneficent kindness,",
    "14": "Who possesses everything,",
    "15": "Who remembers the piety of the Patriarchs,",
    "16": "and Who brings a redeemer",
    "17": "to their children's children,",
    "18": "for the sake of His Name, with love.",
    "19": "<small>(During the Ten Days of Penitence add:</small>",
    "20": "Remember us for life",
    "21": "King, Who desires life;",
    "22": "and inscribe us in the Book of Life,",
    "23": "for Your sake, Living God.)",
    "25": "King, Helper, and Deliverer and Shield.",
    "26": "Blessed are You, Adonoy,",
    "27": "Shield of Abraham.",
    "29": "You are mighty forever, my Master;",
    "30": "You are the Resurrector of the dead",
    "31": "the Powerful One to deliver us.",
    "32": "<small>From the Musaf of the first day of Pesach until the Musaf of Shemini Atzeres you should say:</small>",
    "33": "He causes the dew to descend.",
    "34": "<small>From the Musaf of Shemini Atzeres until the Musaf of the first day of Pesach you should say:</small>",
    "35": "Causer of the wind to blow",
    "36": "and of the rain to fall.",
    "38": "Sustainer of the living with kindliness,",
    "39": "Resurrector of the dead with great mercy,",
    "40": "Supporter of the fallen,",
    "41": "and Healer of the sick,",
    "42": "and Releaser of the imprisoned,",
    "43": "and Fulfiller of His faithfulness",
    "44": "to those who sleep in the dust.",
    "45": "Who is like You, Master of mighty deeds,",
    "46": "and who can be compared to You?",
    "47": "King Who causes death and restores life,",
    "48": "and causes deliverance to sprout forth.",
    "49": "<small>(During the Ten Days of Penitence add:</small>",
    "50": "Who is like You merciful Father,",
    "51": "Who remembers His creatures for life,",
    "52": "in His mercy.)",
    "54": "And You are faithful",
    "55": "to restore the dead to life.",
    "56": "Blessed are You, Adonoy,",
    "57": "Resurrector of the dead.",
    "58": "<small>(When the Chazzan repeats the Shemoneh Esrei, the Kedushah is said here)</small>",
    "60": "<small>The Congregation says and the Chazzan repeats:</small>",
    "61": "We will hallow and revere You",
    "62": "as [with] the sweet words",
    "63": "of the company of the holy Seraphim",
    "64": "who thrice repeat “holy” unto You,",
    "65": "as is written by the hand of Your prophet,",
    "66": "“And they called one to another, and said:",
    "67": "<small>Congregation says and Chazzan repeats:</small>",
    "68": "‘Holy, holy, holy,",
    "69": "is Adonoy of Hosts,",
    "70": "the fullness of all the earth is His glory.'”",
    "71": "<small>The Chazzan says:</small>",
    "72": "Facing them, they offer praise and say:",
    "73": "<small>Congregation says and Chazzan repeats:</small>",
    "74": "“Blessed is the glory of Adonoy",
    "75": "from its place”",
    "76": "<small>The Chazzan says:</small>",
    "77": "And in Your Holy Words it is written:",
    "78": "<small>Congregation says and Chazzan repeats:</small>",
    "79": "“Adonoy will reign forever;",
    "80": "Your God, Zion, throughout all generations!",
    "81": "Praise God.”",
    "82": "<b>DIVINE SANCTIFICATION</b>",
    "83": "You are holy and Your Name is holy",
    "84": "and holy beings",
    "85": "praise You every day, forever.",
    "86": "For a great and Almighty King—",
    "87": "great and holy—are You.",
    "88": "<small>During the Ten Days of Penitence, continue at the asterisk (*) below</small>",
    "89": "Blessed are You, Adonoy,",
    "90": "the Almighty, the Holy One.",
    "91": "<small>*During the Ten Days of Penitence:</small>",
    "92": "Blessed are You, Adonoy,",
    "93": "the King, the Holy One.",
    "96": "You favor man with perception",
    "97": "and teach mankind understanding.",
    "98": "Grant us from Your",
    "99": "wisdom, understanding and knowledge.",
    "100": "Blessed are You, Adonoy,",
    "101": "Grantor of perception.",
    "103": "Cause us to return, our Father,",
    "104": "to Your Torah",
    "105": "and bring us near, our King, to Your service;",
    "106": "and bring us back",
    "107": "in whole-hearted repentance before You",
    "108": "Blessed are You, Adonoy,",
    "109": "Who desires penitence.",
    "111": "Pardon us, our Father, for we have sinned,",
    "112": "forgive us, our King,",
    "113": "for we have transgressed;",
    "114": "for you are a good and forgiving almighty.",
    "115": "Blessed are You, Adonoy,",
    "116": "Gracious One, Who pardons abundantly.",
    "118": "Look, please, upon our affliction,",
    "119": "and defend our cause:",
    "120": "and redeem us",
    "121": "speedily with complete redemption",
    "122": "for the sake of Your Name;",
    "123": "because You are a Mighty Redeemer.",
    "124": "Blessed are You, Adonoy,",
    "125": "Redeemer of Israel.",
    "126": "<small>(On Fast Days, the Chazzan says “Answer us” and concludes, “Blessed are . . . Who responds at times of trouble.”)</small>",
    "128": "Heal us, Adonoy, and we will be healed,",
    "129": "deliver us and we will be delivered;",
    "130": "for You are our praise.",
    "131": "Grant a cure and healing",
    "132": "to all our sickness",
    "133": "and to all our pain",
    "134": "and to all our affliction",
    "135": "because You are the Almighty, King,",
    "136": "Who is a faithful and merciful Healer.",
    "137": "Blessed are You, Adonoy,",
    "138": "Healer of the sick of His people Israel.",
    "140": "Bless for us, Adonoy our God,",
    "141": "this year",
    "142": "and all the varieties of its produce",
    "143": "for good;",
    "144": "and bestow",
    "145": "<small>From the first say of Pesach until the evening service [Maariv] on December 4, or, on a civil leap year, December 5, we say the following line.</small>",
    "146": "blessing",
    "147": "<small>From the evening service [Maariv] on December 4, or, on a civil leap year, December 5, until the First day of Pesach, we say the following line.</small>",
    "148": "dew and rain for a blessing",
    "150": "upon the face of the earth;",
    "151": "satisfy us from its bounty",
    "152": "and bless our year",
    "153": "as other good years, for blessing,",
    "154": "for You are generous Almighty",
    "155": "who bestows goodness",
    "156": "and blesses the years.",
    "157": "Blessed are You, Adonoy,",
    "158": "Blesser of the years.",
    "160": "Sound the great <i>shofar</i> for our liberty,",
    "161": "and raise a banner to gather our exiles,",
    "162": "and gather us together quickly",
    "163": "from the four corners of the earth.",
    "164": "into our Land.",
    "165": "Blessed are You, Adonoy,",
    "166": "Gatherer",
    "167": "of the dispersed of His people Israel.",
    "169": "Restore our judges as before",
    "170": "and our counselors as at first.",
    "171": "Remove from us sorrow and sighing,",
    "172": "and reign over us quickly",
    "173": "You, Adonoy, alone",
    "174": "with kindness and compassion;",
    "175": "and make us righteous",
    "176": "with righteousness and justice,",
    "177": "<small>During the Ten Days of Penitence, continue at the asterisk (*) below</small>",
    "178": "Blessed are You, Adonoy,",
    "179": "King, Lover of righteousness and justice.",
    "180": "<small>*During the Ten Days of Penitence:</small>",
    "181": "Blessed are You, Adonoy,",
    "182": "the King of Justice.",
    "185": "For informers let there be no hope",
    "186": "and may all wickedness instantly perish",
    "187": "may all Your enemies be swiftly cut off,",
    "188": "and the insolent may You quickly uproot,",
    "189": "crush, rout, disgrace, humble",
    "190": "and subdue speedily in our days.",
    "191": "Blessed are You, Adonoy,",
    "192": "Crusher of enemies",
    "193": "and Subduer of the insolent.",
    "195": "Upon the righteous, upon the pious,",
    "196": "upon the elders of the remnant",
    "197": "of Your people the House of Israel,",
    "198": "upon the remnant of their scholars,",
    "199": "upon the true proselytes, and upon us,",
    "200": "may Your mercy be aroused,",
    "201": "Adonoy our God.",
    "202": "Grant bountiful reward",
    "203": "to all who trust in Your Name in truth;",
    "204": "and place our lot among them,",
    "205": "and may we never be put to shame,",
    "206": "for in You we have put our trust,",
    "207": "and on Your great compassion",
    "208": "we truly rely.",
    "209": "Blessed are You, Adonoy,",
    "210": "Support and Trust of the righteous.",
    "212": "And to Jerusalem, Your city,",
    "213": "return in mercy,",
    "214": "and dwell therein as You have spoken;",
    "215": "and rebuild it soon, in our days,",
    "216": "as an everlasting structure,",
    "217": "and the throne of David, Your servant",
    "218": "may You speedily establish therein.",
    "219": "<small><i>During Mincha services on the Ninth of Av, the following petition is added here:</i></small>",
    "220": "Adonoy, our God, console",
    "221": "the mourners of Zion",
    "222": "and the mourners of Jerusalem",
    "223": "and the city that is in mourning",
    "224": "and in ruins, despised and desolate.",
    "225": "Mourning because she is bereft of her children,",
    "226": "ruined of her dwellings,",
    "227": "despised in contrast to her former glory,",
    "228": "desolate without inhabitants,",
    "229": "she sits alone with her head covered",
    "230": "like a barren woman who never gave birth.",
    "231": "Legions have devoured her,",
    "232": "idolaters have deprived her of her inheritance;",
    "233": "they have put Your people Israel",
    "234": "to the sword",
    "235": "and have wantonly murdered",
    "236": "the pious ones of the Most High.",
    "237": "Therefore, Zion weeps bitterly,",
    "238": "and Jerusalem raises her voice,",
    "239": "“My heart, my heart",
    "240": "[grieves] for their slain,",
    "241": "my innards, my innards,",
    "242": "[ache] for their slain.",
    "243": "For you, Adonoy, set her afire,",
    "244": "and with fire You will ultimately rebuild her,",
    "245": "as it is said,",
    "246": "“I will be to her, says Adonoy,",
    "247": "a wall of fire around [her],",
    "248": "and I shall be for glory in her midst.”",
    "249": "Blessed are You, Adonoy,",
    "250": "Consoler of Zion and Builder of Jerusalem.",
    "251": "<small><i>Continue: “The sprout of David</i></small>",
    "252": "Blessed are You, Adonoy,",
    "253": "Builder of Jerusalem.",
    "255": "The sprout of David, Your servant,",
    "256": "speedily cause to flourish",
    "257": "and exalt his power with Your deliverance,",
    "258": "For Your deliverance we hope all day.",
    "259": "and watch for Your deliverance.",
    "260": "Blessed are You, Adonoy,",
    "261": "Who causes to sprout",
    "262": "the power of salvation.",
    "264": "Merciful Father",
    "265": "Hear our voice, Adonoy, our God;",
    "266": "spare us and have compassion on us,",
    "267": "and accept",
    "268": "our prayers compassionately and willingly,",
    "269": "for You are Almighty",
    "270": "Who hears prayers and supplications;",
    "271": "and from Your Presence, our King,",
    "272": "do not turn us away empty-handed,",
    "273": "be gracious and answer us",
    "274": "and hear our prayer",
    "275": "<small>On Fast days during Mincha, the following petition is added here:</small>",
    "276": "Answer us, Adonoy, answer us",
    "277": "on the day of our fasting,",
    "278": "for we are in great trouble.",
    "279": "Do not regard our wickedness,",
    "280": "do not conceal Your countenance from us,",
    "281": "and do not be unmindful",
    "282": "of our supplication.",
    "283": "Please be near to our cry,",
    "284": "let Your loving kindness console us.",
    "285": "Even before we call unto You, answer us,",
    "286": "as it is said:",
    "287": "“And it shall come to pass that before they call",
    "288": "I will answer;",
    "289": "while they are yet speaking,",
    "290": "I will hear.",
    "291": "For You, Adonoy,",
    "292": "are the One Who answers in time of trouble,",
    "293": "Who redeems and rescues",
    "294": "in all times of trouble and distress.",
    "295": "<small>Continue: “for You hear the prayers.” The Chazzan, however, concludes:</small>",
    "296": "Blessed are You, Adonoy,",
    "297": "Who answers His people Israel",
    "298": "in time of trouble.",
    "299": "for You hear the prayers of every mouth",
    "300": "of Your people, Israel, with compassion.",
    "301": "Blessed are You, Adonoy,",
    "302": "Who hears prayers.",
    "304": "Be pleased, Adonoy, our God,",
    "305": "with Your people Israel",
    "306": "and pay heed to their prayer;",
    "307": "and restore the service",
    "308": "to the Holy of Holies in Your abode,",
    "309": "and the fire-offerings of Israel;",
    "310": "and accept their prayer, lovingly",
    "311": "and willingly.",
    "312": "And may You always find pleasure",
    "313": "with the service of Your people, Israel.",
    "314": "<small>On regular weekdays continue, “And may our eyes”.</small>",
    "315": "<small>On Rosh Chodesh and on Chol HaMoed, the following prayer is added:</small>",
    "316": "Our God and God of our fathers,",
    "317": "may there ascend, come, and reach,",
    "318": "appear, be desired, and heard,",
    "319": "counted and recalled",
    "320": "our remembrance and reckoning;",
    "321": "the remembrance of our fathers;",
    "322": "the remembrance of the Mashiach",
    "323": "the son of David, Your servant;",
    "324": "the remembrance of Jerusalem,",
    "325": "city of Your Sanctuary;",
    "326": "and the remembrance of Your entire people,",
    "327": "the House of Israel, before You",
    "328": "for survival, for well-being,",
    "329": "for favor, kindliness, compassion,",
    "330": "for good life and peace",
    "331": "on this day of:",
    "332": "<i>Rosh Chodesh</i>",
    "333": "the <i>Festival of Matzos</i>",
    "334": "the <i>Festival of Sukkos</i>",
    "335": "Remember us Adonoy, our God,",
    "336": "on this day for well-being;",
    "337": "be mindful of us on this day for blessing,",
    "338": "and deliver us for good life.",
    "339": "In accord with the promise of deliverance",
    "340": "and compassion,",
    "341": "spare us and favor us,",
    "342": "have compassion on us and deliver us;",
    "343": "for to You our eyes are directed",
    "344": "because You are the Almighty",
    "345": "Who is King, Gracious, and Merciful.",
    "347": "And may our eyes behold",
    "348": "Your merciful return to Zion.",
    "349": "Blessed are You, Adonoy,",
    "350": "Who returns His Divine Presence to Zion.",
    "351": "<small><i>At the words, </i>We are thankful, <i>bend forward; at </i>Adonoy <i>return to an upright position.</i></small>",
    "353": "We are thankful to You",
    "354": "that You Adonoy are our God",
    "355": "and the God of our fathers forever;",
    "356": "Rock, Rock of our lives,",
    "357": "the Shield of our deliverance,",
    "358": "You are in every generation.",
    "359": "We will give thanks to You",
    "360": "and recount Your praise,",
    "361": "for our lives",
    "362": "which are committed into Your hand,",
    "363": "and for our souls",
    "364": "which are entrusted to You,",
    "365": "and for Your miracles of every day with us,",
    "366": "and for Your wonders and benefactions",
    "367": "at all times—",
    "368": "evening, morning and noon.",
    "369": "(You are) The Beneficent One—",
    "370": "for Your compassion is never withheld;",
    "371": "And (You are) the Merciful One—",
    "372": "for Your kindliness never ceases;",
    "373": "for we have always placed our hope in You.",
    "375": "We are thankful to You,",
    "376": "that You Adonoy are our God,",
    "377": "and God of our fathers,",
    "378": "God of all flesh,",
    "379": "Our Creator, Creator of the Beginning.",
    "380": "Blessings and thanksgivings",
    "381": "to Your great and holy Name",
    "382": "for keeping us alive, and sustaining us;",
    "383": "so may You always keep us alive",
    "384": "and sustain us,",
    "385": "and gather our exiles",
    "386": "to the Courtyards of Your Sanctuary",
    "387": "to observe Your statutes,",
    "388": "and to do Your will,",
    "389": "and to serve You wholeheartedly,",
    "390": "for we are thankful to You.",
    "391": "Blessed is the Almighty",
    "392": "to Whom all thanks are due.",
    "394": "[We thank You] for the miracles",
    "395": "for the redemption, for the mighty deeds,",
    "396": "for the deliverances, for the wonders",
    "397": "for the consolations and for the wars",
    "398": "that You performed for our fathers",
    "399": "in those days at this season.",
    "400": "<small>On Chanukah:</small>",
    "401": "In the days of Matisyahu,",
    "402": "son of Yochanan the High Priest,",
    "403": "the Hasmonean and his sons,",
    "404": "when the evil Greek kingdom rose up",
    "405": "against Your people Israel",
    "406": "to make them forget Your Torah",
    "407": "and to turn them away",
    "408": "from the statutes of Your will—",
    "409": "You, in Your abundant mercy,",
    "410": "stood by them in their time of distress,",
    "411": "You defended their cause,",
    "412": "You judged their grievances,",
    "413": "You avenged them.",
    "414": "You delivered the mighty",
    "415": "into the hands of the weak,",
    "416": "many into the hands of the few,",
    "417": "defiled people into the hands of the undefiled,",
    "418": "the wicked into the hands of the righteous,",
    "419": "and insolent [sinners] into the hands of",
    "420": "diligent students of Your Torah.",
    "421": "And You made Yourself",
    "422": "a great and sanctified name in Your world.",
    "423": "And for Your people, Israel,",
    "424": "You performed a great deliverance",
    "425": "and redemption unto this very day.",
    "426": "Afterwards, Your sons entered",
    "427": "the Holy of Holies of Your Abode,",
    "428": "cleaned Your Temple,",
    "429": "purified Your Sanctuary,",
    "430": "and kindled lights",
    "431": "in the Courtyards of Your Sanctuary,",
    "432": "and designated these eight days of Chanukah",
    "433": "to thank and praise Your great Name.",
    "434": "<small>On Purim:</small>",
    "435": "In the days of Mordechai and Esther",
    "436": "in Shushan the Capital [of Persia],",
    "437": "when the evil Haman rose up against them,",
    "438": "he sought to destroy, to kill,",
    "439": "and to annihilate all the Jews,",
    "440": "young and old, infants and women,",
    "441": "in one day, the thirteenth day",
    "442": "of the twelfth month,",
    "443": "which is the month of Adar,",
    "444": "and to plunder their wealth—",
    "445": "And You, in Your abundant mercy,",
    "446": "annulled his counsel,",
    "447": "frustrated his intention,",
    "448": "and brought his evil plan upon his own head,",
    "449": "and they hanged him and his sons",
    "450": "upon the gallows.",
    "451": "And for all the foregoing",
    "452": "blessed, exalted and extolled",
    "453": "your Name, our King",
    "454": "constantly, forever and ever.",
    "455": "<small>During the Ten Days of Penitence, add:</small>",
    "456": "Inscribe for a good life",
    "457": "all the children of Your covenant.",
    "459": "And all the living shall thank You forever",
    "460": "and praise and bless",
    "461": "Your great Name with sincerity forever;",
    "462": "for You are goodness—",
    "463": "the Almighty, Who is our deliverance",
    "464": "and our help forever—",
    "465": "the benevolent Almighty.",
    "466": "Blessed are You, Adonoy,",
    "467": "“The Beneficent” is Your Name",
    "468": "and You it is fitting to praise.",
    "471": "Our God, and God of our fathers, bless us",
    "472": "with the threefold blessing of the Torah,",
    "473": "written by the hand of Moses, Your servant,",
    "474": "pronounced from the mouth of Aaron",
    "475": "and his sons, the <i>kohanim,</i> Your holy people;",
    "476": "as it is said:",
    "477": "Adonoy bless you and guard you.",
    "478": "Adonoy shine His countenance upon you",
    "479": "and be gracious unto you.",
    "480": "Adonoy turn His countenance toward you",
    "481": "and grant you peace.",
    "482": "<small>After Birkas Kohanim the congregation says:</small>",
    "483": "Mighty One on high who dwells in might,",
    "484": "You are peace and Your Name is peace.",
    "485": "May it be Your will that You grant us",
    "486": "and all of Your people, the House of Israel",
    "487": "life and blessing",
    "488": "for a safeguard to peace.",
    "490": "Grant peace, goodness, and blessing,",
    "491": "life favor, kindness and compassion",
    "492": "upon us and upon all Israel, Your people.",
    "493": "Bless us, our Father, all of us as one",
    "494": "with the light of Your countenance.",
    "495": "For by the light of Your countenance",
    "496": "You gave us Adonoy our God,",
    "497": "a Torah of life and the love of kindliness,",
    "498": "righteousness, blessing, compassion,",
    "499": "life, and peace.",
    "500": "And may it be good in Your sight",
    "501": "to bless us",
    "502": "and to bless Your people Israel,",
    "503": "at all times and at every moment",
    "504": "with Your peace",
    "505": "(with much strength and peace).",
    "506": "<small>During the Ten Days of Penitence continue here:</small>",
    "507": "In the book of life, blessing, peace",
    "508": "and abundant maintenance,",
    "509": "good decrees, salvations and condolences,",
    "510": "may we be remembered and inscribed",
    "511": "before You;",
    "512": "we and all Your people, the House of Israel",
    "513": "for a good life and peace.",
    "515": "Blessed are You, Adonoy,",
    "516": "Who blesses His people Israel",
    "517": "with peace.",
    "518": "May they be acceptable",
    "519": "the words of my mouth",
    "520": "and the thoughts of my heart, before You",
    "521": "Adonoy, my Rock and my Redeemer."
   }
  }
 }
}
