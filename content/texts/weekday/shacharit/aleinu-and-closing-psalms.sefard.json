  "Weekday Siddur Sefard Linear, The Morning Prayers, Psalm of the Day": {
   "edition": "metsudah-sefard-weekday",
   "he": {
    "107": "הַיּוֹם יוֹם רִאשׁוֹן בַּשַּׁבָּת",
    "108": "שֶׁבּוֹ הָיוּ הַלְ֒וִיִּם אוֹמְ֒רִים",
    "109": "בְּבֵית הַמִּקְדָּשׁ:",
    "110": "לְדָוִד מִזְמוֹר",
    "111": "לַיהוָֹה הָאָֽרֶץ",
    "112": "וּמְ֒לוֹאָהּ",
    "113": "תֵּבֵל",
    "114": "וְיֽשְׁ֒בֵי בָהּ:",
    "115": "כִּי הוּא עַל יַמִּים יְסָדָהּ",
    "116": "וְעַל נְהָרוֹת יְכוֹנְ֒נֶֽהָ:",
    "117": "מִי יַעֲלֶה בְהַר יְהֹוָה",
    "118": "וּמִי יָקוּם",
    "119": "בִּמְ֒קוֹם קָדְשׁוֹ:",
    "120": "נְקִי כַפַּֽיִם וּבַר לֵבָב",
    "121": "אֲשֶׁר לֺא נָשָׂא לַשָּׁוְא נַפְשִׁי",
    "122": "וְלֺא נִשְׁבַּע לְמִרְמָה:",
    "123": "יִשָּׂא בְרָכָה מֵאֵת יְהֹוָה",
    "124": "וּצְ֒דָקָה",
    "125": "מֵאֱלֺהֵי יִשְׁעוֹ:",
    "126": "זֶה דּוֹר דּוֹרְ֒שָׁיו",
    "127": "מְבַקְ֒שֵׁי פָנֶֽיךָ",
    "128": "יַעֲקֹב סֶֽלָה:",
    "129": "שְׂאוּ שְׁעָרִים רָאשֵׁיכֶם",
    "130": "וְהִנָּשְׂ֒אוּ",
    "131": "פִּתְ֒חֵי עוֹלָם",
    "132": "וְיָבוֹא מֶֽלֶךְ הַכָּבוֹד:",
    "133": "מִי זֶה מֶֽלֶךְ הַכָּבוֹד",
    "134": "יְהֹוָה עִזּוּז וְגִבּוֹר",
    "135": "יְהֹוָה גִּבּוֹר מִלְחָמָה:",
    "136": "שְׂאוּ שְׁעָרִים רָאשֵׁיכֶם",
    "137": "וּשְׂ֒אוּ פִּתְ֒חֵי עוֹלָם",
    "138": "וְיָבוֹא מֶֽלֶךְ הַכָּבוֹד:",
    "139": "מִי הוּא זֶה מֶֽלֶךְ הַכָּבוֹד",
    "140": "יְהֹוָה צְבָאוֹת",
    "141": "הוּא מֶֽלֶךְ הַכָּבוֹד סֶֽלָה:",
    "144": "הַיּוֹם יוֹם שֵׁנִי בַּשַּׁבָּת",
    "145": "שֶׁבּוֹ הָיוּ הַלְ֒וִיִּם אוֹמְ֒רִים",
    "146": "בְּבֵית הַמִּקְדָּשׁ:",
    "147": "שִׁיר מִזְמוֹר לִבְנֵי קֹֽרַח:",
    "148": "גָּדוֹל יְהֹוָה וּמְהֻלָּל מְאֹד",
    "149": "בְּעִיר אֱלֺהֵֽינוּ",
    "150": "הַר קָדְשׁוֹ:",
    "151": "יְפֵה נוֹף",
    "152": "מְשׂוֹשׂ כָּל הָאָֽרֶץ הַר צִיּוֹן",
    "153": "יַרְכְּתֵי צָפוֹן",
    "154": "קִרְיַת מֶֽלֶךְ רָב:",
    "155": "אֱלֺהִים בְּאַרְמְנוֹתֶֽיהָ",
    "156": "נוֹדַע לְמִשְׂגָּב:",
    "157": "כִּי הִנֵּה הַמְּ֒לָכִים נוֹעֲדוּ",
    "158": "עָבְ֒רוּ יַחְדָּו:",
    "159": "הֵֽמָּה רָאוּ כֵּן תָּמָֽהוּ",
    "160": "נִבְהֲלוּ נֶחְפָּֽזוּ:",
    "161": "רְעָדָה אֲחָזָֽתַם שָׁם",
    "162": "חִיל כַּיּוֹלֵדָה:",
    "163": "בְּרֽוּחַ קָדִים",
    "164": "תְּשַׁבֵּר אֳנִיּוֹת תַּרְשִׁישׁ:",
    "165": "כַּאֲשֶׁר שָׁמַֽעְנוּ כֵּן רָאִֽינוּ",
    "166": "בְּעִיר יְהֹוָה צְבָאוֹת",
    "167": "בְּעִיר אֱלֺהֵֽינוּ",
    "168": "אֱלֺהִים יְכוֹנְ֒נֶֽהָ עַד עוֹלָם סֶֽלָה:",
    "169": "דִּמִּֽינוּ אֱלֺהִים חַסְדֶּֽךָ",
    "170": "בְּקֶֽרֶב הֵיכָלֶֽךָ:",
    "171": "כְּשִׁמְךָ אֱלֺהִים כֵּן תְּהִלָּתְ֒ךָ",
    "172": "עַל קַצְוֵי אֶֽרֶץ",
    "173": "צֶֽדֶק מָלְ֒אָה יְמִינֶֽךָ:",
    "174": "יִשְׂמַח הַר צִיּוֹן",
    "175": "תָּגֵֽלְנָה בְּנוֹת יְהוּדָה",
    "176": "לְמַֽעַן מִשְׁפָּטֶֽיךָ:",
    "177": "סֹֽבּוּ צִיּוֹן וְהַקִּיפֽוּהָ",
    "178": "סִפְ֒רוּ מִגְדָּלֶֽיהָ:",
    "179": "שִֽׁיתוּ לִבְּ֒כֶם לְחֵילָה",
    "180": "פַּסְּ֒גוּ אַרְמְ֒נוֹתֶֽיהָ",
    "181": "לְמַֽעַן תְּסַפְּ֒רוּ לְדוֹר אַחֲרוֹן:",
    "182": "כִּי זֶה אֱלֺהִים אֱלֺהֵֽינוּ",
    "183": "עוֹלָם וָעֶד",
    "184": "הוּא יְנַהֲגֵֽנוּ עַל מוּת:",
    "187": "הַיּוֹם יוֹם שְׁלִישִׁי בַּשַּׁבָּת",
    "188": "שֶׁבּוֹ הָיוּ הַלְ֒וִיִּם אוֹמְ֒רִים",
    "189": "בְּבֵית הַמִּקְדָּשׁ:",
    "190": "מִזְמוֹר לְאָסָף",
    "191": "אֱלֺהִים נִצָּב",
    "192": "בַּעֲדַת אֵל",
    "193": "בְּקֶֽרֶב אֱלֺהִים יִשְׁפֹּט:",
    "194": "עַד מָתַי תִּשְׁפְּטוּ עָֽוֶל",
    "195": "וּפְ֒נֵי רְשָׁעִים תִּשְׂ֒אוּ סֶֽלָה:",
    "196": "שִׁפְ֒טוּ דָל וְיָתוֹם",
    "197": "עָנִי וָרָשׁ הַצְדִּֽיקוּ:",
    "198": "פַּלְּ֒טוּ דַל וְאֶבְיוֹן",
    "199": "מִיַּד רְשָׁעִים הַצִּֽילוּ:",
    "200": "לֺא יָדְ֒עוּ וְלֺא יָבִֽינוּ",
    "201": "בַּחֲשֵׁכָה יִתְהַלָּֽכוּ",
    "202": "יִמּֽוֹטוּ כָּל מֽוֹסְ֒דֵי אָֽרֶץ:",
    "203": "אֲנִי אָמַֽרְתִּי אֱלֺהִים אַתֶּם",
    "204": "וּבְ֒נֵי עֶלְיוֹן כֻּלְּ֒כֶם:",
    "205": "אָכֵן כְּאָדָם תְּמוּתוּן",
    "206": "וּכְ֒אַחַד הַשָּׂרִים תִּפֹּֽלוּ:",
    "207": "קוּמָה אֱלֺהִים שָׁפְ֒טָה הָאָרֶץ",
    "208": "כִּי אַתָּה תִנְחַל בְּכָל הַגּוֹיִם:",
    "211": "הַיּוֹם יוֹם רְבִיעִי בַּשַּׁבָּת",
    "212": "שֶׁבּוֹ הָיוּ הַלְ֒וִיִּם אוֹמְ֒רִים",
    "213": "בְּבֵית הַמִּקְדָּשׁ:",
    "214": "אֵל נְקָמוֹת יְהֹוָה",
    "215": "אֵל נְקָמוֹת הוֹפִֽיעַ:",
    "216": "הִנָּשֵׂא שֹׁפֵט הָאָֽרֶץ",
    "217": "הָשֵׁב גְּמוּל עַל גֵּאִים:",
    "218": "עַד מָתַי רְשָׁעִים",
    "219": "יְהֹוָה",
    "220": "עַד מָתַי רְשָׁעִים יַעֲלֺֽזוּ:",
    "221": "יַבִּֽיעוּ יְדַבְּ֒רוּ עָתָק",
    "222": "יִתְאַמְּ֒רוּ כָּל פֹּֽעֲלֵי אָֽוֶן:",
    "223": "עַמְּ֒ךָ יְהֹוָה יְדַכְּ֒אוּ",
    "224": "וְנַחֲלָתְ֒ךָ יְעַנּוּ:",
    "225": "אַלְמָנָה וְגֵר יַהֲרֹֽגוּ",
    "226": "וִיתוֹמִים יְרַצֵּֽחוּ:",
    "227": "וַיֹּאמְ֒רוּ לֺא יִרְאֶה יָהּ",
    "228": "וְלֺא יָבִין אֱלֺהֵי יַעֲקֹב:",
    "229": "בִּֽינוּ",
    "230": "בֹּעֲרִים בָּעָם",
    "231": "וּכְ֒סִילִים מָתַי תַּשְׂכִּֽילוּ:",
    "232": "הֲנֹֽטַע אֹֽזֶן הֲלֺא יִשְׁמָע",
    "233": "אִם יוֹצֵר עַֽיִן הֲלֺא יַבִּיט:",
    "234": "הֲיֹסֵר גּוֹיִם",
    "235": "הֲלֺא יוֹכִֽיחַ",
    "236": "הַמְ֒לַמֵּד אָדָם דָּֽעַת:",
    "237": "יְהֹוָה יֹדֵֽעַ מַחְשְׁ֒בוֹת אָדָם",
    "238": "כִּי הֵֽמָּה הָֽבֶל:",
    "239": "אַשְׁרֵי הַגֶּֽבֶר",
    "240": "אֲשֶׁר תְּיַסְּ֒רֶֽנּוּ יָהּ",
    "241": "וּמִתּוֹרָתְ֒ךָ תְלַמְּ֒דֶֽנּוּ:",
    "242": "לְהַשְׁקִיט לוֹ מִֽימֵי רָע",
    "243": "עַד יִכָּרֶה לָרָשָׁע שָֽׁחַת:",
    "244": "כִּי לֺא יִטּשׁ יְהֹוָה עַמּוֹ",
    "245": "וְנַחֲלָתוֹ לֺא יַעֲזֹב:",
    "246": "כִּי עַד צֶֽדֶק יָשׁוּב מִשְׁפָּט",
    "247": "וְאַחֲרָיו כָּל יִשְׁ֒רֵי לֵב:",
    "248": "מִי יָקוּם לִי עִם מְרֵעִים",
    "249": "מִי יִתְיַצֵּב לִי",
    "250": "עִם פֹּֽעֲלֵי אָֽוֶן:",
    "251": "לוּלֵי יְהֹוָה עֶזְרָֽתָה לִּי",
    "252": "כִּמְ֒עַט",
    "253": "שָׁכְ֒נָה דוּמָה נַפְשִׁי:",
    "254": "אִם אָמַֽרְתִּי מָֽטָה רַגְלִי",
    "255": "חַסְדְּ֒ךָ יְהֹוָה יִסְעָדֵֽנִי:",
    "256": "בְּרֹב שַׂרְעַפַּי",
    "257": "בְּקִרְבִּי",
    "258": "תַּנְחוּמֶֽיךָ יְשַׁעַשְׁ֒עוּ נַפְשִׁי:",
    "259": "הַיְ֒חָבְרְךָ כִּסֵּא הַוּוֹת",
    "260": "יֹצֵר עָמָל עֲלֵי חֹק:",
    "261": "יָגֽוֹדּוּ עַל נֶֽפֶשׁ צַדִּיק",
    "262": "וְדָם נָקִי יַרְשִֽׁיעוּ:",
    "263": "וַיְ֒הִי יְהֹוָה לִי לְמִשְׂגָּב",
    "264": "וֵאלֺהַי לְצוּר מַחְסִי:",
    "265": "וַיָּֽשֶׁב עֲלֵיהֶם אֶת אוֹנָם",
    "266": "וּבְ֒רָעָתָם",
    "267": "יַצְמִיתֵם",
    "268": "יַצְמִיתֵם יְהֹוָה אֱלֺהֵֽינוּ:",
    "269": "לְכוּ נְרַנְּ֒נָה לַיהוָֹה",
    "270": "נָרִֽיעָה",
    "271": "לְצוּר יִשְׁעֵֽנוּ:",
    "272": "נְקַדְּ֒מָה פָנָיו בְּתוֹדָה",
    "273": "בִּזְמִרוֹת נָרִֽיעַ לוֹ:",
    "274": "כִּי אֵל גָּדוֹל יְהֹוָה",
    "275": "וּמֶֽלֶךְ גָּדוֹל עַל כָּל אֱלֺהִים:",
    "278": "הַיּוֹם יוֹם חֲמִישִׁי בַּשַּׁבָּת",
    "279": "שֶׁבּוֹ הָיוּ הַלְ֒וִיִּם אוֹמְ֒רִים",
    "280": "בְּבֵית הַמִּקְדָּשׁ:",
    "281": "לַמְנַצֵּֽחַ",
    "282": "עַל הַגִּתִּית לְאָסָף:",
    "283": "הַרְנִֽינוּ לֵאלֺהִים עֻזֵּנוּ",
    "284": "הָרִֽיעוּ לֵאלֺהֵי יַעֲקֹב:",
    "285": "שְׂאוּ זִמְרָה וּתְ֒נוּ תֹף",
    "286": "כִּנּוֹר נָעִים עִם נָֽבֶל:",
    "287": "תִּקְ֒עוּ בַחֹֽדֶשׁ שׁוֹפָר",
    "288": "בַּכֶּֽסֶה לְיוֹם חַגֵּֽנוּ:",
    "289": "כִּי חֹק לְיִשְׂרָאֵל הוּא",
    "290": "מִשְׁפָּט לֵאלֺהֵי יַעֲקֹב:",
    "291": "עֵדוּת בִּיהוֹסֵף שָׂמוֹ",
    "292": "בְּצֵאתוֹ עַל אֶֽרֶץ מִצְרָֽיִם",
    "293": "שְׂפַת לֺא יָדַֽעְתִּי אֶשְׁמָע:",
    "294": "הֲסִירֽוֹתִי מִסֵּֽבֶל שִׁכְמוֹ",
    "295": "כַּפָּיו מִדּוּד תַּעֲבֹֽרְ֒נָה:",
    "296": "בַּצָּרָה קָרָֽאתָ וָאֲחַלְּ֒צֶֽךָ",
    "297": "אֶעֶנְךָ",
    "298": "בְּסֵֽתֶר",
    "299": "רַֽעַם",
    "300": "אֶבְחָנְ֒ךָ עַל מֵי מְרִיבָה סֶֽלָה:",
    "301": "שְׁמַע עַמִּי וְאָעִֽידָה בָּךְ",
    "302": "יִשְׂרָאֵל אִם תִּשְׁמַע לִי:",
    "303": "לֺא יִהְיֶה בְךָ אֵל זָר",
    "304": "וְלֺא תִשְׁתַּחֲוֶה לְאֵל נֵכָר:",
    "305": "אָנֹכִי יְהֹוָה אֱלֺהֶֽיךָ",
    "306": "הַמַּעַלְ֒ךָ מֵאֶֽרֶץ מִצְרָֽיִם",
    "307": "הַרְחֶב פִּֽיךָ וַאֲמַלְ֒אֵֽהוּ:",
    "308": "וְלֺא שָׁמַע עַמִּי לְקוֹלִי",
    "309": "וְיִשְׂרָאֵל לֺא אָֽבָה לִי:",
    "310": "וָאֲשַׁלְּ֒חֵֽהוּ בִּשְׁרִירוּת לִבָּם",
    "311": "יֵלְ֒כוּ בְּמוֹעֲצוֹתֵיהֶם:",
    "312": "לוּ עַמִּי שֹׁמֵֽעַ לִי",
    "313": "יִשְׂרָאֵל בִּדְ֒רָכַי יְהַלֵּֽכוּ:",
    "314": "כִּמְ֒עַט אוֹיְ֒בֵיהֶם אַכְנִֽיעַ",
    "315": "וְעַל צָרֵיהֶם אָשִׁיב יָדִי:",
    "316": "מְשַׂנְ֒אֵי יְהֹוָה",
    "317": "יְכַחֲשׁוּ לוֹ",
    "318": "וִיהִי עִתָּם",
    "319": "לְעוֹלָם:",
    "320": "וַיַּאֲכִילֵֽהוּ",
    "321": "מֵחֵֽלֶב חִטָּה",
    "322": "וּמִצּוּר",
    "323": "דְּבַשׁ אַשְׂבִּיעֶֽךָּ:",
    "326": "הַיּוֹם יוֹם שִׁשִּׁי בַּשַּׁבָּת",
    "327": "שֶׁבּוֹ הָיוּ הַלְ֒וִיִּם אוֹמְ֒רִים",
    "328": "בְּבֵית הַמִּקְדָּשׁ:",
    "329": "יְהֹוָה מָלָךְ",
    "330": "גֵּאוּת לָבֵשׁ",
    "331": "לָבֵשׁ יְהֹוָה",
    "332": "עֹז הִתְאַזָּר",
    "333": "אַף תִּכּוֹן תֵּבֵל",
    "334": "בַּל תִּמּוֹט:",
    "335": "נָכוֹן כִּסְאֲךָ מֵאָז",
    "336": "מֵעוֹלָם אָֽתָּה:",
    "337": "נָשְׂ֒אוּ נְהָרוֹת יְהֹוָה",
    "338": "נָשְׂ֒אוּ נְהָרוֹת קוֹלָם",
    "339": "יִשְׂ֒אוּ נְהָרוֹת דָּכְיָם:",
    "340": "מִקֹּלוֹת מַֽיִם רַבִּים",
    "341": "אַדִּירִים מִשְׁבְּ֒רֵי יָם",
    "342": "אַדִּיר בַּמָּרוֹם יְהֹוָה:",
    "343": "עֵדֹתֶֽיךָ נֶאֶמְ֒נוּ מְאֹד",
    "344": "לְבֵיתְ֒ךָ נָאֲוָה קֹֽדֶשׁ",
    "345": "יְהֹוָה לְאֹֽרֶךְ יָמִים:",
    "347": "הוֹשִׁיעֵנוּ יְהֹוָה אֱלֹהֵינוּ",
    "348": "וְקַבְּצֵנוּ מִן הַגּוֹיִם",
    "349": "לְהוֹדוֹת לְשֵׁם קָדְשֶֽׁךָ",
    "350": "לְהִשְׁתַּבֵּֽחַ בִּתְהִלָּתֶֽךָ:",
    "351": "בָּרוּךְ יְהֹוָה אֱלֹהֵי יִשְׂרָאֵל",
    "352": "מִן־הָעוֹלָם וְעַד הָעֹלָם",
    "353": "וְאָמַר כָל־הָעָם אָמֵן",
    "354": "הַלְ֒לוּיָה.",
    "355": "בָּרוּךְ יְהֹוָה מִצִּיּוֹן",
    "356": "שֹׁכֵן יְרוּשָׁלָֽיִם",
    "357": "הַלְ֒לוּיָהּ:",
    "358": "בְּרוּךְ יְהֹוָה אֱלֹהִים",
    "359": "אֱלֹהֵי יִשְׂרָאֵל",
    "360": "עֹשֵׂה נִפְלָאוֹת לְבַדּוֹ:",
    "361": "וּבָרוּךְ שֵׁם כְּבוֹדוֹ לְעוֹלָם",
    "362": "וְיִמָּלֵא כְבוֹדוֹ אֶת־כָּל־הָאָרֶץ",
    "363": "אָמֵן וְאָמֵן:"
   },
   "en": {
    "106": "<small><i>On Sunday:</i></small>",
    "107": "Today is the first day of the week,",
    "108": "on which the Levites used to recite",
    "109": "in the Holy Temple:",
    "110": "A psalm of David:",
    "111": "the earth is Adonoy's",
    "112": "and the fullness thereof,",
    "113": "the inhabited world",
    "114": "and those who dwell in it.",
    "115": "For He founded it upon the seas,",
    "116": "and established it upon rivers.",
    "117": "Who may ascend the mountain of Adonoy,",
    "118": "and who may stand",
    "119": "in the place of His holiness?",
    "120": "The clean of hands and the pure of heart,",
    "121": "who has not borne My soul in vain,",
    "122": "and has not sworn deceitfully.",
    "123": "He will bear Adonoy's blessing",
    "124": "and righteousness",
    "125": "from the God of his deliverance.",
    "126": "This is the generation of those who seek Him,",
    "127": "the seekers of Your Presence,",
    "128": "[God of] Jacob, <i>Selah.</i>",
    "129": "Lift up your heads, gates,",
    "130": "and be uplifted",
    "131": "[you] entranceways to eternity,",
    "132": "so that the King of Glory may enter.",
    "133": "Who is this King of Glory?",
    "134": "Adonoy, strong and mighty;",
    "135": "Adonoy, the Mighty One in battle.",
    "136": "Lift up your heads, gates,",
    "137": "and lift, entranceways to eternity,",
    "138": "so that the King of Glory may enter.",
    "139": "Who is He, this King of Glory?",
    "140": "Adonoy of hosts,",
    "141": "He is the King of Glory, <i>Selah.</i>",
    "143": "<small><i>On Monday:</i></small>",
    "144": "Today is the second day of the week,",
    "145": "on which the Levites used to recite",
    "146": "in the Holy Temple:",
    "147": "A song, a psalm by the sons of Korach.",
    "148": "Adonoy is great and highly extolled",
    "149": "in the city of our God,",
    "150": "the mountain of His Sanctuary.",
    "151": "Beautiful in its panoramic vista,",
    "152": "the joy of all the earth is Mount Zion,",
    "153": "on the northern extremities (of Jerusalem);",
    "154": "the city of the great King.",
    "155": "God, in its palaces,",
    "156": "has become known as a Stronghold.",
    "157": "For behold, the kings assembled,",
    "158": "they passed by together.",
    "159": "They saw and were astounded,",
    "160": "they panicked and fled in haste.",
    "161": "Trembling siezed them there,",
    "162": "like the pangs of a woman in labor.",
    "163": "With an east wind",
    "164": "You smashed the ships of Tarshish.",
    "165": "As we heard, so we saw",
    "166": "in the city of Adonoy of hosts,",
    "167": "in the city of our God;",
    "168": "may God establish it for eternity, <i>Selah.</i>",
    "169": "We hoped, God, for Your lovingkindness",
    "170": "in the midst of Your Sanctuary.",
    "171": "As Your Name, God, so is Your praise—",
    "172": "to the ends of the earth;",
    "173": "Your right hand is full of righteousness.",
    "174": "Let Mount Zion rejoice,",
    "175": "let the daughters of Judah exult,",
    "176": "because of Your judgments.",
    "177": "Rally around Zion and encircle her,",
    "178": "count her towers.",
    "179": "Consider well her ramparts,",
    "180": "raise high her citadels,",
    "181": "that you may recount it to future generations.",
    "182": "That this is God, our God",
    "183": "forever and ever,",
    "184": "He will lead us like children.",
    "186": "<small><i>On Tuesday:</i></small>",
    "187": "Today is the third day of the week,",
    "188": "on which the Levites used to recite",
    "189": "in the Holy Temple:",
    "190": "A psalm of Assaf",
    "191": "God stands",
    "192": "in the congregation of the Almighty,",
    "193": "in the midst of the judges He gives judgement.",
    "194": "How long will you judge lawlessly",
    "195": "and show partiality to the wicked forever?",
    "196": "Render justice to the lowly and the orphan,",
    "197": "deal righteously with the poor and destitute.",
    "198": "Rescue the lowly and the needy,",
    "199": "save them from the hand of the wicked.",
    "200": "They neither know nor understand,",
    "201": "they walk along in darkness,",
    "202": "all the foundations of the earth are shaken.",
    "203": "I had said \"You are godlike beings,",
    "204": "all of you, sons of the Most High.\"",
    "205": "Nevertheless, you shall die like men,",
    "206": "and fall like one of the princes.",
    "207": "Arise, God, judge the earth,",
    "208": "for You will inherit all the nations.",
    "210": "<small><i>On Wednesday:</i></small>",
    "211": "Today is the fourth day of the week,",
    "212": "on which the Levites used to recite",
    "213": "in the Holy Temple:",
    "214": "Almighty of vengeance, Adonoy,",
    "215": "Almighty of vengeance, reveal Yourself.",
    "216": "Arise Judge of the earth,",
    "217": "repay the arrogant their just reward.",
    "218": "How long shall the wicked—",
    "219": "Adonoy—",
    "220": "how long shall the wicked exult?",
    "221": "They express, they speak with arrogance;",
    "222": "all the evildoers are boastful.",
    "223": "Adonoy, they crush Your people",
    "224": "and Your heritage they oppress.",
    "225": "The widow and stranger they kill,",
    "226": "and orphans they murder.",
    "227": "And they say, \"God does not see,",
    "228": "the God of Jacob is not concerned.\"",
    "229": "Consider,",
    "230": "[you] stupid [ones] among the people,—",
    "231": "and you fools when will you become wise?",
    "232": "He Who implanted the ear, does He not hear?",
    "233": "He Who formed the eye, does He not see?",
    "234": "He Who chastises nations,",
    "235": "does He not reprove—",
    "236": "He that teaches man knowledge?",
    "237": "Adonoy knows the thoughts of men,",
    "238": "that they are vanity.",
    "239": "Fortunate is the man",
    "240": "whom You chastise, God,",
    "241": "and whom You instruct from Your Torah.",
    "242": "To grant him tranquility from days of evil,",
    "243": "until the pit is dug for the wicked.",
    "244": "for Adonoy will not abandon His people",
    "245": "and His inheritance, He will not forsake.",
    "246": "For justice shall return unto righteousness,",
    "247": "and all the upright in heart will follow it.",
    "248": "Who will rise up for me against the wicked,",
    "249": "who will stand up for me",
    "250": "against the evildoers?",
    "251": "Had Adonoy not been my help,",
    "252": "in an instant",
    "253": "my soul would have dwelt in the silent grave.",
    "254": "If [Whenever] I said, my foot has slipped,",
    "255": "Your kindliness, Adonoy upheld me.",
    "256": "When (worrisome) thoughts multiply",
    "257": "within me,",
    "258": "Your consolations soothe my soul.",
    "259": "Can a tribunal of evil have accord with You—",
    "260": "[a tribunal] that makes iniquity into law?",
    "261": "They gang up against the life of the righteous,",
    "262": "and blood of the innocent they condemn.",
    "263": "Adonoy has been my stronghold,",
    "264": "my God the Rock of my refuge.",
    "265": "He turns their violence against them,",
    "266": "and with their own wickedness",
    "267": "destroys them;",
    "268": "Adonoy, my God, destroys them.",
    "269": "Come let us sing to Adonoy;",
    "270": "let us shout for joy",
    "271": "to the Rock of our Deliverance.",
    "272": "Let us greet Him with thanksgiving;",
    "273": "with song let us shout for joy to Him.",
    "274": "for a great Almighty is Adonoy;",
    "275": "a great King over all godlike beings.",
    "277": "<small><i>On Thursday:</i></small>",
    "278": "Today is the fifth day of the week,",
    "279": "on which the Levites used to recite",
    "280": "in the Holy Temple:",
    "281": "To Him Who grants victory—",
    "282": "upon the Gittis, a psalm of Assaf:",
    "283": "Sing joyously to God, our strength,",
    "284": "shout for joy to the God of Jacob.",
    "285": "Take up the hymn, sound the drum,",
    "286": "the pleasant harp and the lute.",
    "287": "Blow the <i>shofar</i> on the <i>Rosh Chodesh,</i>",
    "288": "at the appointed time for our festive day.",
    "289": "For it is a statute for Israel,",
    "290": "a [day of] judgement of the God of Jacob.",
    "291": "As a testimony for Yehosef, He ordained it",
    "292": "when he went out over the land of Egypt,",
    "293": "[where] an unfamiliar language I heard.",
    "294": "From the burden, I removed his shoulder,",
    "295": "his hands were removed from the cauldron.",
    "296": "In distress you called out, and I released you,",
    "297": "I answered you",
    "298": "[though you called] in secret",
    "299": "[I answered you] thunderously;",
    "300": "I tested you at the waters of Merivah. <i>Selah.</i>",
    "301": "Hear, My people, I will testify about you,",
    "302": "Israel, if you would just listen to Me.",
    "303": "Let no strange god be within you,",
    "304": "nor bow before a foreign god.",
    "305": "I am Adonoy, your God,",
    "306": "Who brought you up from the land of Egypt,",
    "307": "open your mouth wide, and I will fill it.",
    "308": "But My people did not heed My voice,",
    "309": "and Israel did not want Me.",
    "310": "So I sent them to follow their heart's desires,",
    "311": "let them follow their own devices.",
    "312": "If only My people would heed Me,",
    "313": "if Israel would walk in My ways.",
    "314": "I would immediately subdue their enemies,",
    "315": "and turn My hand against their tormentors.",
    "316": "Those who cause hate of Adonoy",
    "317": "deceive [pretend obedience to] Him,",
    "318": "but their time (of punishment)",
    "319": "will be forever.",
    "320": "But He would feed him (Israel)",
    "321": "from the cream of the wheat,",
    "322": "and from the rock,",
    "323": "I would sate you with honey.",
    "325": "<small><i>On Friday:</i></small>",
    "326": "Today is the sixth day of the week,",
    "327": "on which the Levites used to recite",
    "328": "in the Holy Temple:",
    "329": "Adonoy has begun His reign,",
    "330": "with majesty He has clothed Himself;",
    "331": "Adonoy clothed Himself,",
    "332": "with strength He has girded Himself;",
    "333": "He has firmly established the world,",
    "334": "so that it cannot be moved.",
    "335": "Your throne stands firm from of old,",
    "336": "You are from eternity.",
    "337": "The rivers have raised—Adonoy—",
    "338": "the rivers have raised their voice,",
    "339": "the rivers raise their raging waves.",
    "340": "More than the roar of many waters,",
    "341": "mightier than the breakers of the sea,",
    "342": "mighty on high are You \"Adonoy.\"",
    "343": "Your testimonies are extremely faithful;",
    "344": "holiness is becoming to Your House,",
    "345": "Adonoy,—for the length of days.",
    "347": "Deliver us, God of our deliverance;",
    "348": "gather us and save us from the nations",
    "349": "to give thanks to Your holy Name,",
    "350": "to be extolled in Your praise.",
    "351": "Blessed is Adonoy, the God of Israel",
    "352": "for all eternity,",
    "353": "and all the people said: \"Amen\"",
    "354": "Praise God.",
    "355": "Blessed is Adonoy from Zion,",
    "356": "Who dwells in Jerusalem.",
    "357": "Praise God.",
    "358": "Blessed is Adonoy, God,",
    "359": "God of Israel",
    "360": "Who alone performs wonders.",
    "361": "And blessed is the Name of His glory forever,",
    "362": "and may His glory fill the whole earth.",
    "363": "Amen and Amen!"
   }
  },
  "Weekday Siddur Sefard Linear, The Morning Prayers, Psalm from Rosh Chodesh Elul": {
   "edition": "metsudah-sefard-weekday",
   "he": {
    "3": "לְדָוִד",
    "4": "יְהֹוָה אוֹרִי וְיִשְׁעִי",
    "5": "מִמִּי אִירָא",
    "6": "יְהֹוָה מָעוֹז חַיַּי",
    "7": "מִמִּי אֶפְחָד:",
    "8": "בִּקְ֒רֹב עָלַי מְרֵעִים",
    "9": "לֶאֱכֹל אֶת בְּשָׂרִי",
    "10": "צָרַי וְאֹיְ֒בַי לִי",
    "11": "הֵֽמָּה כָשְׁ֒לוּ וְנָפָֽלוּ:",
    "12": "אִם תַּחֲנֶה עָלַי מַחֲנֶה",
    "13": "לֺא יִירָא לִבִּי",
    "14": "אִם תָּקוּם עָלַי מִלְחָמָה",
    "15": "בְּזֹאת אֲנִי בוֹטֵֽחַ:",
    "16": "אַחַת שָׁאַֽלְתִּי מֵאֵת יְהֹוָה",
    "17": "אוֹתָהּ אֲבַקֵּשׁ",
    "18": "שִׁבְתִּי בְּבֵית יְהֹוָה",
    "19": "כָּל יְמֵי חַיַּי",
    "20": "לַחֲזוֹת בְּנֹֽעַם יְהֹוָה",
    "21": "וּלְ֒בַקֵּר בְּהֵיכָלוֹ:",
    "22": "כִּי יִצְפְּ֒נֵֽנִי בְּסֻכֹּה",
    "23": "בְּיוֹם רָעָה",
    "24": "יַסְתִּרֵֽנִי בְּסֵֽתֶר אָהֳלוֹ",
    "25": "בְּצוּר יְרוֹמְ֒מֵֽנִי:",
    "26": "וְעַתָּה יָרוּם רֹאשִׁי",
    "27": "עַל אֹיְ֒בַי סְבִיבוֹתָי",
    "28": "וְאֶזְבְּחָה בְאָהֳלוֹ",
    "29": "זִבְחֵי תְרוּעָה",
    "30": "אָשִֽׁירָה וַאֲזַמְּ֒רָה לַיהוָֹה:",
    "31": "שְׁמַע יְהֹוָה קוֹלִי אֶקְרָא",
    "32": "וְחָנֵּֽנִי וַעֲנֵֽנִי:",
    "33": "לְךָ אָמַר לִבִּי",
    "34": "בַּקְּ֒שׁוּ פָנָי",
    "35": "אֶת פָּנֶֽיךָ יְהֹוָה אֲבַקֵּשׁ:",
    "36": "אַל תַּסְתֵּר פָּנֶֽיךָ מִמֶּֽנִּי",
    "37": "אַל תַּט בְּאַף עַבְדֶּֽךָ",
    "38": "עֶזְרָתִי הָיִֽיתָ",
    "39": "אַל תִּטְּ֒שֵֽׁנִי וְאַל תַּעַזְ֒בֵֽנִי",
    "40": "אֱלֺהֵי יִשְׁעִי:",
    "41": "כִּי אָבִי וְאִמִּי עֲזָבֽוּנִי",
    "42": "וַיהוָֹה יַאַסְ֒פֵֽנִי:",
    "43": "הוֹרֵֽנִי יְהֹוָה דַּרְכֶּֽךָ",
    "44": "וּנְ֒חֵֽנִי בְּאֹֽרַח מִישׁוֹר",
    "45": "לְמַֽעַן שׁוֹרְ֒רָי:",
    "46": "אַל תִּתְּ֒נֵֽנִי",
    "47": "בְּנֶֽפֶשׁ צָרָי",
    "48": "כִּי קָֽמוּ בִי עֵֽדֵי שֶֽׁקֶר",
    "49": "וִיפֵֽחַ חָמָס:",
    "50": "לוּלֵא הֶאֱמַֽנְתִּי לִרְאוֹת",
    "51": "בְּטוּב יְהֹוָה",
    "52": "בְּאֶֽרֶץ חַיִּים:",
    "53": "קַוּה אֶל יְהֹוָה",
    "54": "חֲזַק וְיַאֲמֵץ לִבֶּךָ",
    "55": "וְקַוּה אֶל יְהֹוָה:"
   },
   "en": {
    "3": "By David:",
    "4": "Adonoy is my light and my salvation,",
    "5": "whom shall I fear?",
    "6": "Adonoy is the strength of my life,",
    "7": "of whom shall I be afraid?",
    "8": "When evildoers approach me",
    "9": "to devour my flesh—",
    "10": "my tormentors and my foes",
    "11": "they stumble and fall.",
    "12": "If an army should encamp against me,",
    "13": "my heart would not fear;",
    "14": "if war were to rise against me,",
    "15": "in this I trust.",
    "16": "One thing I request of Adonoy,",
    "17": "[only] that shall I seek,",
    "18": "that I may dwell in the House of Adonoy",
    "19": "all the days of my life,",
    "20": "to behold the pleasantness of Adonoy,",
    "21": "and to meditate in His Sanctuary.",
    "22": "For He will hide me in His Tabernacle",
    "23": "on the day of distress,",
    "24": "He will conceal me in the shelter of His Tent,",
    "25": "upon a rock He will lift me.",
    "26": "And now my head is raised high",
    "27": "above my enemies around me;",
    "28": "and I will offer in His Tent,",
    "29": "sacrifices accompanied by trumpets of joy;",
    "30": "I will sing and chant to Adonoy.",
    "31": "Adonoy, hear my voice when I call;",
    "32": "be gracious to me and answer me.",
    "33": "Of You, my heart has said,",
    "34": "Seek My Presence;",
    "35": "Your Presence, Adonoy I will seek.",
    "36": "Conceal not Your Presence from me,",
    "37": "do not turn away Your servant in anger.",
    "38": "You have been my help;",
    "39": "neither cast me off nor abandon me,",
    "40": "God of my deliverance.",
    "41": "When my father and mother abandon me,",
    "42": "Adonoy will gather me up.",
    "43": "Adonoy, teach me Your way,",
    "44": "and lead me in the path of uprightness,",
    "45": "because of my watchers.",
    "46": "Do not deliver me",
    "47": "to the will of my tormentors,",
    "48": "for false witnesses have risen against me,",
    "49": "who breathe violence.",
    "50": "Had I not believed that I would see",
    "51": "the goodness of Adonoy",
    "52": "in the land of living.",
    "53": "Hope to Adonoy,",
    "54": "be strong and He will give you courage;",
    "55": "and hope to Adonoy.",
    "56": "<small>(Mourner's Kaddish.)</small>"
   }
  },
  "Weekday Siddur Sefard Linear, The Morning Prayers, Aleinu": {
   "edition": "metsudah-sefard-weekday",
   "he": {
    "148": "עָלֵֽינוּ לְשַׁבֵּֽחַ",
    "149": "לַאֲדוֹן הַכֹּל",
    "150": "לָתֵת גְּדֻלָּה",
    "151": "לְיוֹצֵר בְּרֵאשִׁית",
    "152": "שֶׁלֺּא עָשָֽׂנוּ",
    "153": "כְּגוֹיֵי הָאֲרָצוֹת",
    "154": "וְלֺא שָׂמָֽנוּ",
    "155": "כְּמִשְׁפְּחוֹת הָאֲדָמָה",
    "156": "שֶׁלֺּא שָׂם",
    "157": "חֶלְקֵֽנוּ כָּהֶם",
    "158": "וְגוֹרָלֵֽנוּ כְּכָל הֲמוֹנָם:",
    "159": "שֶׁהֵם מִשְׁתַּחֲוִים",
    "160": "לָהֶֽבֶל וָרִיק",
    "161": "וּמִתְפַּלְּ֒לִים אֶל אֵל לֹא יוֹשִֽׁיעַ,",
    "162": "וַאֲנַֽחְנוּ כּוֹרְ֒עִים וּמִשְׁתַּחֲוִים",
    "163": "וּמוֹדִים",
    "164": "לִפְנֵי מֶֽלֶךְ מַלְ֒כֵי הַמְּ֒לָכִים",
    "165": "הַקָּדוֹשׁ בָּרוּךְ הוּא,",
    "166": "שֶׁהוּא נוֹטֶה שָׁמַֽיִם",
    "167": "וְיוֹסֵד אָֽרֶץ,",
    "168": "וּמוֹשַׁב יְקָרוֹ בַּשָּׁמַֽיִם מִמַּֽעַל,",
    "169": "וּשְׁ֒כִינַת עֻזּוֹ",
    "170": "בְּגָבְ֒הֵי מְרוֹמִים,",
    "171": "הוּא אֱלֺהֵֽינוּ אֵין עוֹד,",
    "172": "אֱמֶת מַלְכֵּֽנוּ",
    "173": "אֶֽפֶס זוּלָתוֹ",
    "174": "כַּכָּתוּב בְּתוֹרָתוֹ",
    "175": "וְיָדַעְתָּ הַיּוֹם",
    "176": "וַהֲשֵׁבֹתָ אֶל לְבָבֶֽךָ",
    "177": "כִּי יְהֹוָה הוּא הָאֱלֺהִים",
    "178": "בַּשָּׁמַֽיִם מִמַּֽעַל",
    "179": "וְעַל הָאָֽרֶץ מִתָּֽחַת",
    "180": "אֵין עוֹד:",
    "181": "עַל כֵּן נְקַוּה לְךָ",
    "182": "יְהֹוָה אֱלֺהֵֽינוּ",
    "183": "לִרְאוֹת מְהֵרָה בְּתִפְאֶֽרֶת עֻזֶּֽךָ",
    "184": "לְהַעֲבִיר גִּלּוּלִים מִן הָאָֽרֶץ",
    "185": "וְהָאֱלִילִים כָּרוֹת יִכָּרֵתוּן",
    "186": "לְתַקֵּן עוֹלָם",
    "187": "בְּמַלְכוּת שַׁדַּי",
    "188": "וְכָל בְּנֵי בָשָׂר יִקְרְאוּ בִשְׁ֒מֶֽךָ,",
    "189": "לְהַפְנוֹת אֵלֶֽיךָ",
    "190": "כָּל רִשְׁ֒עֵי אָֽרֶץ,",
    "191": "יַכִּֽירוּ וְיֵדְ֒עוּ",
    "192": "כָּל יוֹשְׁ֒בֵי תֵבֵל",
    "193": "כִּי לְךָ תִכְרַע כָּל בֶּֽרֶךְ",
    "194": "תִּשָּׁבַע כָּל לָשׁוֹן:",
    "195": "לְפָנֶֽיךָ יְהֹוָה אֱלֺהֵֽינוּ",
    "196": "יִכְרְעוּ וְיִפֹּֽלוּ,",
    "197": "וְלִכְ֒בוֹד שִׁמְךָ יְקָר יִתֵּֽנוּ,",
    "198": "וִיקַבְּ֒לוּ כֻלָּם",
    "199": "אֶת עֹל מַלְכוּתֶֽךָ,",
    "200": "וְתִמְלֺךְ עֲלֵיהֶם מְהֵרָה",
    "201": "לְעוֹלָם וָעֶד,",
    "202": "כִּי הַמַּלְ֒כוּת שֶׁלְּ֒ךָ הִיא",
    "203": "וּלְ֒עֽוֹלְ֒מֵי עַד תִּמְלוֹךְ בְּכָבוֹד,",
    "204": "כַּכָּתוּב בְּתוֹרָתֶֽךָ",
    "205": "יְהֹוָה יִמְלֺךְ לְעֹלָם וָעֶד:",
    "206": "וְנֶאֱמַר",
    "207": "וְהָיָה יְהֹוָה לְמֶֽלֶךְ",
    "208": "עַל כָּל הָאָֽרֶץ",
    "209": "בַּיּוֹם הַהוּא יִהְיֶה יְהֹוָה אֶחָד",
    "210": "וּשְׁמוֹ אֶחָד:",
    "211": "אַל תִּירָא מִפַּחַד פִּתאֹם",
    "212": "וּמִשֹׁאַת רְשָׁעִים",
    "213": "כִּי תָבֹא",
    "214": "עֻֽצוּ עֵצָה וְתֻפָר",
    "215": "דַּבְּ֒רוּ דָבָר וְלֹא יָקוּם",
    "216": "כִּי עִמָּנוּ אֵל:",
    "217": "וְעַד זִקְנָה אֲנִי הוּא",
    "218": "וְעַד שֵׂיבָה אֲנִי אֶסְבֹּל:",
    "219": "אֲנִי עָשִֽׂיתִי וַאֲנִי אֶשָׂיא",
    "220": "וַאֲנִי אֶסְבֹּל וַאֲמַלֵּט:"
   },
   "en": {
    "148": "It is our obligation to praise",
    "149": "the Master of all,",
    "150": "to ascribe greatness",
    "151": "to the Creator of the [world in the] beginning:",
    "152": "that He has not made us",
    "153": "like the nations of the lands,",
    "154": "and has not positioned us",
    "155": "like the families of the earth;",
    "156": "that He has not assigned",
    "157": "our portion like theirs,",
    "158": "nor our lot like that of all their multitudes.",
    "159": "For they prostrate themselves",
    "160": "to vanity and nothingness,",
    "161": "and pray to a god that cannot deliver.",
    "162": "But we bow, prostrate ourselves,",
    "163": "and offer thanks",
    "164": "before the Supreme King of Kings,",
    "165": "the Holy One blessed is He,",
    "166": "Who spreads the heavens,",
    "167": "and establishes the earth,",
    "168": "and the seat of His glory is in heaven above,",
    "169": "and the abode of His invincible might",
    "170": "is in the loftiest heights.",
    "171": "He is our God, there is nothing else.",
    "172": "Our King is true,",
    "173": "all else is insignificant,",
    "174": "as it is written in His Torah:",
    "175": "And You shall know this day",
    "176": "and take into Your heart",
    "177": "that Adonoy is God",
    "178": "in the heavens above",
    "179": "and upon the earth below;",
    "180": "there is nothing else.",
    "181": "We therefore put our hope in You,",
    "182": "Adonoy our God,",
    "183": "to soon behold the glory of Your might",
    "184": "in banishing idolatry from the earth,",
    "185": "and the false gods will be utterly exterminated",
    "186": "to perfect the world",
    "187": "as the kingdom of Shadai.",
    "188": "And all mankind will invoke Your Name,",
    "189": "to turn back to You,",
    "190": "all the wicked of the earth.",
    "191": "They will realize and know,",
    "192": "all the inhabitants of the world,",
    "193": "that to You, every knee must bend,",
    "194": "every tongue must swear [allegiance to You].",
    "195": "Before You, Adonoy, our God,",
    "196": "they will bow and prostrate themselves,",
    "197": "and to the glory of Your Name give honor.",
    "198": "And they will all accept [upon themselves]",
    "199": "the yoke of Your kingdom,",
    "200": "and You will reign over them, soon,",
    "201": "forever and ever.",
    "202": "For the kingdom is Yours,",
    "203": "and to all eternity You will reign in glory,",
    "204": "as it is written in Your Torah:",
    "205": "Adonoy will reign forever and ever.",
    "206": "And it is said:",
    "207": "And Adonoy will be King",
    "208": "over the whole earth;",
    "209": "on that day Adonoy will be One",
    "210": "and His Name One.",
    "211": "Do not fear sudden terror",
    "212": "nor the destruction of the wicked",
    "213": "when it comes",
    "214": "take counsel together but it will be foiled",
    "215": "speak the word and it will not stand",
    "216": "for God is with us.",
    "217": "To Your old age I am [with You],",
    "218": "to Your older years I will sustain You,",
    "219": "I have made You, and I will carry You,",
    "220": "I will sustain You and save You."
   }
  }
 }
}
