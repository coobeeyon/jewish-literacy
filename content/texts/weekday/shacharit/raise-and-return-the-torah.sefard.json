{
 "id": "weekday/shacharit/raise-and-return-the-torah:sefard",
 "refs": {
  "Weekday Siddur Sefard Linear, The Morning Prayers, Berachah for Father of Bar Mitzvah": {
   "edition": "metsudah-sefard-weekday",
   "he": {
    "7": "וְזֹאת הַתּוֹרָה אֲשֶׁר שָׂם משֶׁה",
    "8": "לִפְנֵי בְּנֵי יִשְׂרָאֵל",
    "9": "עַל פִּי יְהֹוָה בְּיַד משֶׁה:",
    "10": "עֵץ חַיִּים הִיא",
    "11": "לַמַּחֲזִיקִים בָּהּ",
    "12": "וְתוֹמְ֒כֶֽיהָ מְאֻשָּׁר:",
    "13": "דְּרָכֶֽיהָ דַּרְ֒כֵי נֹֽעַם",
    "14": "וְכָל נְתִיבוֹתֶֽיהָ שָׁלוֹם:",
    "15": "אֹֽרֶךְ יָמִים בִּימִינָהּ",
    "16": "בִּשְׂ֒מֹאלָהּ עֽשֶׁר וְכָבוֹד:",
    "17": "יְהֹוָה חָפֵץ",
    "18": "לְמַֽעַן צִדְקוֹ",
    "19": "יַגְדִּיל תּוֹרָה וְיַאְדִּיר:",
    "21": "יְהִי רָצוֹן",
    "22": "מִלִּפְנֵי אָבִֽינוּ שֶׁבַּשָּׁמַֽיִם",
    "23": "לְכוֹנֵן אֶת בֵּית חַיֵּֽינוּ",
    "24": "וּלְ֒הָשִׁיב אֶת שְׁכִינָתוֹ בְּתוֹכֵֽנוּ",
    "25": "בִּמְ֒הֵרָה בְיָמֵֽינוּ וְנֹאמַר אָמֵן:",
    "26": "יְהִי רָצוֹן",
    "27": "מִלִּפְנֵי אָבִֽינוּ שֶׁבַּשָּׁמַֽיִם",
    "28": "לְרַחֵם עָלֵֽינוּ",
    "29": "וְעַל פְּלֵטָתֵֽנוּ",
    "30": "וְלִמְנֹֽעַ מַשְׁחִית וּמַגֵּפָה מֵעָלֵֽינוּ",
    "31": "וּמֵעַל כָּל עַמּוֹ בֵּית יִשְׂרָאֵל",
    "32": "וְנֹאמַר אָמֵן:",
    "33": "יְהִי רָצוֹן",
    "34": "מִלִּפְנֵי אָבִֽינוּ שֶׁבַּשָּׁמַֽיִם",
    "35": "לְקַיֵּם בָּֽנוּ חַכְ֒מֵי יִשְׂרָאֵל",
    "36": "הֵם וּנְ֒שֵׁיהֶם",
    "37": "וּבְ֒נֵיהֶם וּבְ֒נוֹתֵיהֶם",
    "38": "וְתַלְמִידֵיהֶם",
    "39": "וְתַלְמִידֵי תַלְמִידֵיהֶם",
    "40": "בְּכָל מְקוֹמוֹת מֹושְׁ֒בוֹתֵיהֶם",
    "41": "וְנֹאמַר אָמֵן:",
    "42": "יְהִי רָצוֹן",
    "43": "מִלִּפְנֵי אָבִֽינוּ שֶׁבַּשָּׁמַֽיִם",
    "44": "שֶׁנִּשְׁמַע וְנִתְבַּשֵּׂר",
    "45": "בְּשׂוֹרוֹת טוֹבוֹת",
    "46": "יְשׁוּעוֹת וְנֶחָמוֹת",
    "47": "וִיקַבֵּץ נִדָּחֵֽינוּ",
    "48": "מֵאַרְבַּע כַּנְ֒פוֹת הָאָֽרֶץ",
    "49": "וְנֹאמַר אָמֵן:",
    "50": "אַחֵֽינוּ",
    "51": "כָּל בֵּית יִשְׂרָאֵל",
    "52": "הַנְּ֒תוּנִים בַּצָּרָה וּבַשִּׁבְיָה",
    "53": "הָעוֹמְ֒דִים בֵּין בַּיָּם וּבֵין בַּיַּבָּשָׁה",
    "54": "הַמָּקוֹם יְרַחֵם עֲלֵיהֶם",
    "55": "וְיוֹצִיאֵם מִצָּרָה לִרְ֒וָחָה",
    "56": "וּמֵאֲפֵלָה לְאוֹרָה",
    "57": "וּמִשִּׁעְבּוּד לִגְ֒אֻלָּה",
    "58": "הַשְׁתָּא בַּעֲגָלָא וּבִזְמַן קָרִיב",
    "59": "וְנֹאמַר אָמֵן:"
   },
   "en": {
    "7": "This is the Torah which Moses placed",
    "8": "before the children of Israel",
    "9": "at Adonoy's command by the hand of Moses.",
    "10": "It is a tree of life",
    "11": "to those who grasp to it,",
    "12": "and those who support it are fortunate.",
    "13": "Its ways are ways of pleasantness,",
    "14": "and all its paths are peace.",
    "15": "Long life is at its right,",
    "16": "at its left, riches and honor.",
    "17": "Adonoy desired,",
    "18": "for the sake of His righteousness,",
    "19": "to make the Torah great and to glorify it.",
    "20": "<small><i>On those Mondays and Thursdays when Tachanun is said, before returning the Torah to the Ark, the Chazzan recites:</i></small>",
    "21": "May it be the will",
    "22": "of our Father in heaven",
    "23": "to establish the House of our lives",
    "24": "and restore His Divine Presence to our midst,",
    "25": "speedily in our days, and let us say Amein.",
    "26": "May it be the will",
    "27": "of our Father in heaven",
    "28": "to have compassion upon us",
    "29": "and upon our remnant,",
    "30": "and to keep destruction and plague from us,",
    "31": "and from all His people, the House of Israel;",
    "32": "and let us say Amein.",
    "33": "May it be the will",
    "34": "of our Father in heaven",
    "35": "to preserve among us the sages of Israel,",
    "36": "them, their wives,",
    "37": "their sons and their daughters,",
    "38": "their disciples,",
    "39": "and the disciples of their disciples,",
    "40": "wherever they live;",
    "41": "and let us say Amein.",
    "42": "May it be the will",
    "43": "of our Father in heaven",
    "44": "that we may hear and receive",
    "45": "good tidings",
    "46": "[of] deliverance and consolation;",
    "47": "may He gather our dispersed",
    "48": "from the four corners of the earth;",
    "49": "and let us say Amein.",
    "50": "[As for] our brethren,",
    "51": "the entire House of Israel",
    "52": "who [still] remain in distress and captivity,",
    "53": "whether on sea or on land,",
    "54": "may God have compassion on them,",
    "55": "and bring them from distress to relief,",
    "56": "from darkness to light,",
    "57": "from servitude to redemption,",
    "58": "at this moment, speedily, very soon;",
    "59": "and let us say Amein."
   }
  },
  "Weekday Siddur Sefard Linear, The Morning Prayers, Ashrei U'va L'Tzion": {
   "edition": "metsudah-sefard-weekday",
   "he": {
    "240": "<b>יְהַלְ֒לוּ אֶת־שֵׁם יְהֹוָה</b>",
    "241": "<b>כִּי־נִשְׂגָּב שְׁמוֹ לְבַדּוֹ:</b>",
    "243": "הוֹדוֹ עַל־אֶֽרֶץ וְשָׁמָֽיִם:",
    "244": "וַיָּֽרֶם קֶֽרֶן לְעַמּוֹ",
    "245": "תְּהִלָּה לְכָל־חֲסִידָיו",
    "246": "לִבְנֵי יִשְׂרָאֵל",
    "247": "עַם קְרֹבוֹ",
    "248": "הַלְ֒לוּיָהּ:",
    "249": "לְדָוִד מִזְמוֹר",
    "250": "לַיהוָֹה הָאָֽרֶץ",
    "251": "וּמְ֒לוֹאָהּ",
    "252": "תֵּבֵל",
    "253": "וְיֽשְׁ֒בֵי בָהּ:",
    "254": "כִּי־הוּא עַל־יַמִּים יְסָדָהּ",
    "255": "וְעַל־נְהָרוֹת יְכוֹנְ֒נֶֽהָ:",
    "256": "מִי־יַעֲלֶה בְהַר־יְהֹוָה",
    "257": "וּמִי יָקוּם",
    "258": "בִּמְ֒קוֹם קָדְשׁוֹ:",
    "259": "נְקִי כַפַּֽיִם וּבַר־לֵבָב",
    "260": "אֲשֶׁר לֺא־נָשָׂא לַשָּׁוְא נַפְשִׁי",
    "261": "וְלֺא נִשְׁבַּע לְמִרְמָה:",
    "262": "יִשָּׂא בְרָכָה מֵאֵת יְהֹוָה",
    "263": "וּצְ֒דָקָה",
    "264": "מֵאֱלֺהֵי יִשְׁעוֹ:",
    "265": "זֶה דּוֹר דּוֹרְ֒שָׁיו",
    "266": "מְבַקְ֒שֵׁי פָנֶֽיךָ",
    "267": "יַעֲקֹב סֶֽלָה:",
    "268": "שְׂאוּ שְׁעָרִים רָאשֵׁיכֶם",
    "269": "וְהִנָּשְׂ֒אוּ",
    "270": "פִּתְ֒חֵי עוֹלָם",
    "271": "וְיָבוֹא מֶֽלֶךְ הַכָּבוֹד:",
    "272": "מִי זֶה מֶֽלֶךְ הַכָּבוֹד",
    "273": "יְהֹוָה עִזּוּז וְגִבּוֹר",
    "274": "יְהֹוָה גִּבּוֹר מִלְחָמָה:",
    "275": "שְׂאוּ שְׁעָרִים רָאשֵׁיכֶם",
    "276": "וּשְׂ֒אוּ פִּתְ֒חֵי עוֹלָם",
    "277": "וְיָבוֹא מֶֽלֶךְ הַכָּבוֹד:",
    "278": "מִי הוּא זֶה מֶֽלֶךְ הַכָּבוֹד",
    "279": "יְהֹוָה צְבָאוֹת",
    "280": "הוּא מֶֽלֶךְ הַכָּבוֹד סֶֽלָה:",
    "282": "וּבְ֒נֻחֹה יֹאמַר",
    "283": "שׁוּבָה יְהֹוָה",
    "284": "רִבְ֒בוֹת אַלְ֒פֵי יִשְׂרָאֵל:",
    "285": "קוּמָה יְהֹוָה לִמְ֒נוּחָתֶֽךָ",
    "286": "אַתָּה וַאֲרוֹן עֻזֶּֽךָ:",
    "287": "כֹּהֲנֶֽיךָ",
    "288": "יִלְבְּ֒שׁוּ צֶֽדֶק",
    "289": "וַחֲסִידֶֽיךָ יְרַנֵּֽנוּ:",
    "290": "בַּעֲבוּר דָּוִד עַבְדֶּֽךָ",
    "291": "אַל תָּשֵׁב פְּנֵי מְשִׁיחֶֽךָ:",
    "292": "כִּי לֶֽקַח טוֹב נָתַֽתִּי לָכֶם",
    "293": "תּוֹרָתִי אַל תַּעֲזֹֽבוּ:",
    "294": "עֵץ חַיִּים הִיא לַמַּחֲזִיקִים בָּהּ",
    "295": "וְתוֹמְ֒כֶֽיהָ מְאֻשָּׁר:",
    "296": "דְּרָכֶֽיהָ דַּרְ֒כֵי נֹֽעַם",
    "297": "וְכָל נְתִיבוֹתֶֽיהָ שָׁלוֹם:",
    "298": "הֲשִׁיבֵֽנוּ יְהֹוָה אֵלֶֽיךָ",
    "299": "וְנָשׁוּבָה",
    "300": "חַדֵּשׁ יָמֵֽינוּ כְּקֶֽדֶם:"
   },
   "en": {
    "239": "<small><i>On Mondays, Thursdays and other days when the Torah is read, as the Sefer Torah is returned to the Ark the Chazzan takes the Torah and says:</i></small>",
    "240": "<b>They will praise the Name of Adonoy</b>",
    "241": "<b>for His Name alone is exalted.</b>",
    "242": "<small><i>Chazzan and congregation:</i></small>",
    "243": "His majesty is over the earth and the skies.",
    "244": "He will raise the might of His people,",
    "245": "[which is] praise for all His pious ones,",
    "246": "for the children of Israel,",
    "247": "the people near to Him.",
    "248": "Praise God.",
    "249": "A psalm of David:",
    "250": "the earth is Adonoy's",
    "251": "and the fullness thereof,",
    "252": "the inhabited world",
    "253": "and those who dwell in it.",
    "254": "For He founded it upon the seas,",
    "255": "and established it upon rivers.",
    "256": "Who may ascend the mountain of Adonoy,",
    "257": "and who may stand",
    "258": "in the place of His holiness?",
    "259": "The clean of hands and the pure of heart,",
    "260": "who has not borne My soul in vain,",
    "261": "and has not sworn deceitfully.",
    "262": "He will bear Adonoy's blessing",
    "263": "and righteousness",
    "264": "from the God of his deliverance.",
    "265": "This is the generation of those who seek Him,",
    "266": "and seekers of Your Presence,",
    "267": "[God of] Jacob, <i>selah.</i>",
    "268": "Lift up your heads, gates,",
    "269": "and be uplifted",
    "270": "[you] entranceways to eternity,",
    "271": "so that the King of Glory may enter.",
    "272": "Who is this King of Glory?",
    "273": "Adonoy, strong and mighty;",
    "274": "Adonoy, the Mighty One in battle.",
    "275": "Lift up your heads, gates,",
    "276": "and lift, entranceways to eternity,",
    "277": "so that the King of Glory may enter.",
    "278": "Who is He, this King of Glory?",
    "279": "Adonoy of hosts,",
    "280": "He is the King of Glory, <i>selah.</i>",
    "281": "<small><i>As the Torah is returned to the Ark the following is said:</i></small>",
    "282": "And when it rested, he would say:",
    "283": "Return, Adonoy,",
    "284": "to the myriads and thousands of Israel.",
    "285": "Arise, Adonoy unto Your resting place,",
    "286": "You and the Ark of Your strength.",
    "287": "Let Your priests",
    "288": "clothe themselves in righteousness,",
    "289": "and let Your devoted ones sing in joy.",
    "290": "For the sake of David, Your servant,",
    "291": "do not reject Your anointed.",
    "292": "For I have given you good instruction,",
    "293": "do not forsake My Torah.",
    "294": "It is a tree of life to those who grasp it,",
    "295": "and those who support it are fortunate.",
    "296": "Its ways are ways of pleasantness",
    "297": "and all its paths are peace.",
    "298": "Cause us to return to you, Adonoy,",
    "299": "and we shall return;",
    "300": "renew our days as of old."
   }
  }
 }
}
