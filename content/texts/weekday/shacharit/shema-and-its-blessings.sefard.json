{
 "id": "weekday/shacharit/shema-and-its-blessings:sefard",
 "refs": {
  "Weekday Siddur Sefard Linear, The Morning Prayers, The Blessings of Shema": {
   "edition": "metsudah-sefard-weekday",
   "he": {
    "11": "<b>בָּרוּךְ</b> אַתָּה יְהֹוָה",
    "12": "אֱלֹהֵֽינוּ מֶֽלֶךְ הָעוֹלָם",
    "13": "יוֹצֵר אוֹר",
    "14": "וּבוֹרֵא חֽשֶׁךְ",
    "15": "עֹשֶׂה שָׁלוֹם",
    "16": "וּבוֹרֵא אֶת הַכֹּל:",
    "17": "<b>הַמֵּאִיר</b> לָאָֽרֶץ",
    "18": "וְלַדָּרִים עָלֶֽיהָ",
    "19": "בְּרַחֲמִים,",
    "20": "וּבְטוּבוֹ",
    "21": "מְחַדֵּשׁ בְּכָל יוֹם תָּמִיד",
    "22": "מַעֲשֵׂה בְרֵאשִׁית:",
    "23": "מָה־רַבּוּ מַעֲשֶֽׂיךָ יְהֹוָה,",
    "24": "כֻּלָּם בְּחָכְמָה עָשִֽׂיתָ,",
    "25": "מָלְ֒אָה הָאָֽרֶץ קִנְיָנֶֽךָ:",
    "26": "הַמֶּֽלֶךְ הַמְּ֒רוֹמָם לְבַדּוֹ מֵאָז,",
    "27": "הַמְּ֒שֻׁבָּח וְהַמְּ֒פֹאָר",
    "28": "וְהַמִּתְנַשֵּׂא",
    "29": "מִימוֹת עוֹלָם:",
    "30": "אֱלֹהֵי עוֹלָם",
    "31": "בְּרַחֲמֶֽיךָ הָרַבִּים",
    "32": "רַחֵם עָלֵֽינוּ",
    "33": "אֲדוֹן עֻזֵּֽנוּ",
    "34": "צוּר מִשְׂגַּבֵּֽנוּ",
    "35": "מָגֵן יִשְׁעֵֽנוּ",
    "36": "מִשְׂגָּב בַּעֲדֵֽנוּ:",
    "37": "אֵל בָּרוּךְ גְּדוֹל דֵּעָה,",
    "38": "הֵכִין וּפָעַל זָהֳרֵי חַמָּה,",
    "39": "טוֹב יָצַר",
    "40": "כָּבוֹד לִשְׁמוֹ,",
    "41": "מְאוֹרוֹת נָתַן",
    "42": "סְבִיבוֹת עֻזּוֹ,",
    "43": "פִּנּוֹת צְבָאָיו קְדוֹשִׁים",
    "44": "רוֹמְ֒מֵי שַׁדַּי,",
    "45": "תָּמִיד מְסַפְּ֒רִים כְּבוֹד אֵל",
    "46": "וּקְ֒דֻשָּׁתוֹ:",
    "47": "תִּתְבָּרֵךְ יְהֹוָה אֱלֹהֵֽינוּ",
    "48": "בַּשָּׁמַֽיִם מִמַּֽעַל וְעַל הַאָֽרֶץ מִתָּֽחַת",
    "49": "עַל כָּל שֶֽׁבַח מַעֲשֵׂה יָדֶֽיךָ",
    "50": "וְעַל מְאֽוֹרֵי אוֹר",
    "51": "שֶׁעָשִֽׂיתָ",
    "52": "הֵֽמָּה יְפָאֲרֽוּךָ סֶּֽלָה:",
    "53": "<b>תִּתְבָּרֵךְ</b> לָנֶצַח צוּרֵֽנוּ מַלְכֵּֽנוּ",
    "54": "וְגוֹאֲלֵֽנוּ, בּוֹרֵא קְדוֹשִׁים ",
    "55": "יִשְׁתַּבַּח שִׁמְךָ לָעַד מַלְכֵּֽנוּ,",
    "56": "יוֹצֵר מְשָׁרְ֒תִים,",
    "57": "וַאֲשֶׁר מְשָׁרְ֒תָיו",
    "58": "כֻּלָּם עוֹמְ֒דִים בְּרוּם עוֹלָם",
    "59": "וּמַשְׁמִיעִים בְּיִרְאָה יַֽחַד בְּקוֹל",
    "60": "דִּבְרֵי אֱלֹהִים חַיִּים",
    "61": "וּמֶֽלֶךְ עוֹלָם:",
    "62": "כֻּלָם אֲהוּבִים",
    "63": "כֻּלָּם בְּרוּרִים",
    "64": "כֻּלָּם גִּבּוֹרִים",
    "65": "כֻּלָּם קְדוֹשִׁים",
    "66": "וְכֻלָּם עֹשִׂים",
    "67": "בְּאֵימָה וּבְיִרְאָה",
    "68": "רְצוֹן קוֹנָם:",
    "69": "וְכֻלָּם פּוֹתְ֒חִים אֶת פִּיהֶם",
    "70": "בִּקְדֻשָּׁה וּבְטָהֳרָה",
    "71": "בְּשִׁירָה וּבְזִמְרָה",
    "72": "וּמְבָרְ֒כִין וּמְשַׁבְּ֒חִין וּמְפָאֲרִין",
    "73": "וּמַעֲרִיצִין וּמַקְדִּישִׁין",
    "74": "וּמַמְלִיכִין:",
    "75": "<b>אֶת שֵׁם</b> הָאֵל הַמֶּֽלֶךְ",
    "76": "הַגָּדוֹל הַגִּבּוֹר וְהַנּוֹרָא",
    "77": "קָדוֹשׁ הוּא:",
    "78": "וְכֻלָּם מְקַבְּ֒לִים עֲלֵיהֶם",
    "79": "עֹל מַלְכוּת שָׁמַֽיִם",
    "80": "זֶה מִזֶּה,",
    "81": "וְנוֹתְ֒נִים בְּאַהֲבָה רְשׁוּת זֶה לָזֶה",
    "82": "לְהַקְדִּישׁ לְיוֹצְ֒רָם",
    "83": "בְּנַֽחַת רֽוּחַ",
    "84": "בְּשָׂפָה בְרוּרָה וּבִנְעִימָה,",
    "85": "קְדֻשָּׁה כֻּלָּם כְּאֶחָד עוֹנִים בְּאֵימָה",
    "86": "וְאוֹמְ֒רִים בְּיִרְאָה",
    "87": "<b>קָדוֹשׁ קָדוֹשׁ, קָדוֹשׁ</b>",
    "88": "<b>יְהֹוָה צְבָאוֹת.</b>",
    "89": "<b>מְלֹא כָל־הָאָֽרֶץ כְּבוֹדוֹ:</b>",
    "90": "וְהָאוֹפַנִּים וְחַיּוֹת הַקֹּֽדֶשׁ",
    "91": "בְּרַֽעַשׁ גָּדוֹל מִתְנַשְּׂ֒אִים",
    "92": "לְעֻמַּת שְׂרָפִים",
    "93": "לְעֻמָּתָם מְשַׁבְּ֒חִים וְאוֹמְ֒רִים:",
    "94": "<b>בָּרוּךְ כְּבוֹד־יְהֹוָה</b>",
    "95": "<b>מִמְּ֒קוֹמוֹ:</b>",
    "96": "<b>לָאֵל</b> בָּרוּךְ",
    "97": "נְעִימוֹת יִתֵּֽנוּ,",
    "98": "לַמֶּֽלֶךְ אֵל",
    "99": "חַי וְקַיָּם",
    "100": "זְמִירוֹת יֹאמֵֽרוּ",
    "101": "וְתִשְׁבָּחוֹת יַשְׁמִֽיעוּ,",
    "102": "כִּי הוּא לְבַדּוֹ מָרוֹם וְקָדוֹשׁ",
    "103": "פּוֹעֵל גְּבוּרוֹת",
    "104": "עֹשֶׂה חֲדָשׁוֹת",
    "105": "בַּֽעַל מִלְחָמוֹת",
    "106": "זוֹרֵֽעַ צְדָקוֹת",
    "107": "מַצְמִֽיחַ יְשׁוּעוֹת",
    "108": "בּוֹרֵא רְפוּאוֹת",
    "109": "נוֹרָא תְהִלּוֹת אֲדוֹן הַנִּפְלָאוֹת:",
    "110": "הַמְ֒חַדֵּשׁ בְּטוּבוֹ",
    "111": "בְּכָל יוֹם תָּמִיד",
    "112": "מַעֲשֵׂה בְרֵאשִׁית:",
    "113": "כָּאָמוּר",
    "114": "לְעֹשֵׂה אוֹרִים גְּדֹלִים",
    "115": "כִּי לְעוֹלָם חַסְדּוֹ:",
    "116": "(וְהִתְקִין מְאוֹרוֹת",
    "117": "מְשַׂמֵּֽחַ עוֹלָמוֹ אֲשֶׁר בָּרָא.)",
    "118": "אוֹר חָדָשׁ עַל צִיּוֹן תָּאִיר",
    "119": "וְנִזְכֶּה כֻלָּֽנוּ בִּמְהֵרָה",
    "120": "לְאוֹרוֹ:",
    "121": "בָּרוּךְ אַתָּה יְהֹוָה",
    "122": "יוֹצֵר הַמְּ֒אוֹרוֹת:",
    "124": "<b>אַהֲבַת עוֹלָם</b> אֲהַבְתָּֽנוּ",
    "125": "יְהֹוָה אֱלֹהֵֽינוּ",
    "126": "חֶמְלָה גְדוֹלָה וִיתֵרָה",
    "127": "חָמַֽלְתָּ עָלֵֽינוּ:",
    "128": "אָבִֽינוּ מַלְכֵּֽנוּ",
    "129": "בַּעֲבוּר שִׁמְךָ הַגָּדוֹל",
    "130": "וּבַעֲבוּר אֲבוֹתֵֽינוּ",
    "131": "שֶׁבָּטְ֒חוּ בְךָ",
    "132": "וַתְּ֒לַמְּ֒דֵם חֻקֵּי חַיִּים",
    "133": "לַעֲשׂוֹת רְצוֹנְ֒ךָ",
    "134": "בְּלֵבָב שָׁלֵם",
    "135": "כֵּן תְּחָנֵּֽנוּ וּתְלַמְּ֒דֵֽנוּ:",
    "136": "אָבִֽינוּ אָב הָרַחֲמָן",
    "137": "הַמְרַחֵם",
    "138": "רַחֵם עָלֵֽינוּ",
    "139": "וְתֵן בְּלִבֵּֽנוּ בִּינָה",
    "140": "לְהָבִין",
    "141": "וּלְהַשְׂכִּיל",
    "142": "לִשְׁמֹֽעַ לִלְמוֹד וּלְ֒לַמֵּד",
    "143": "לִשְׁמֹר וְלַעֲשׂוֹת וּלְקַיֵּם",
    "144": "אֶת־כָּל דִּבְרֵי־תַלְמוּד תּוֹרָתֶֽךָ",
    "145": "בְּאַהֲבָה:",
    "146": "וְהָאֵר עֵינֵֽינוּ בְּתוֹרָתֶֽךָ",
    "147": "וְדַבֵּק לִבֵּֽנוּ",
    "148": "בְּמִצְוֹתֶֽיךָ",
    "149": "וְיַחֵד לְבָבֵֽנוּ",
    "150": "לְאַהֲבָה וּלְיִרְאָה אֶת שְׁמֶֽךָ,",
    "151": "לְמַֽעַן לֹא נֵבוֹשׁ",
    "152": "וְלֹא נִכָּלֵם וְלֹא נִכָּשֵׁל",
    "153": "לְעוֹלָם וָעֶד,",
    "154": "כִּי בְשֵׁם קָדְשְׁ֒ךָ",
    "155": "הַגָּדוֹל הַגִּבּוֹר וְהַנּוֹרָא",
    "156": "בָּטָֽחְנוּ",
    "157": "נָגִֽילָה וְנִשְׂמְ֒חָה בִּישׁוּעָתֶֽךָ:",
    "158": "וְרַחֲמֶֽיךָ יְהֹוָה אֶלֹהֵֽינוּ",
    "159": "וַחֲסָדֶֽיךָ הָרַבִּים",
    "160": "אַל יַעַזְבֽוּנוּ נֶֽצַח סֶֽלָה וָעֶד:",
    "161": "מַהֵר וְהָבֵא עָלֵֽינוּ",
    "162": "בְּרָכָה וְשָׁלוֹם מְהֵרָה",
    "163": "מֵאַרְבַּע כַּנְפוֹת כָּל הָאָֽרֶץ",
    "164": "וּשְׁבוֹר עוֹל הַגּוֹיִם",
    "165": "מֵעַל צַוָּארֵֽנוּ",
    "166": "וְתוֹלִיכֵֽנוּ מְהֵרָה",
    "167": "קוֹמְ֒מִיּוּת לְאַרְצֵֽנוּ:",
    "168": "כִּי אֵל",
    "169": "פּוֹעֵל יְשׁוּעוֹת אָֽתָּה",
    "170": "וּבָֽנוּ בָחַֽרְתָּ",
    "171": "מִכָּל־עַם וְלָשׁוֹן",
    "172": "וְקֵרַבְתָּֽנוּ מַלְכֵּֽנוּ",
    "173": "לְשִׁמְךָ הַגָּדוֹל סֶֽלָה בֶּאֱמֶת בְּאַהֲבָה",
    "174": "לְהוֹדוֹת לְךָ",
    "175": "וּלְיַחֶדְךָ בְּאַהֲבָה",
    "176": "וּלְאַהֲבָה אֶת שְׁמֶֽךָ:",
    "177": "בָּרוּךְ אַתָּה יְהֹוָה",
    "178": "הַבּוֹחֵר בְּעַמּוֹ יִשְׂרָאֵל בְּאַהֲבָה:"
   },
   "en": {
    "11": "Blessed are You, Adonoy",
    "12": "our God, King of the Universe,",
    "13": "Former of light,",
    "14": "Creator of darkness,",
    "15": "Maker of peace,",
    "16": "Creator of all things.",
    "17": "He illuminates the earth",
    "18": "[and provides light] for those who dwell on it",
    "19": "with compassion;",
    "20": "and in His goodness",
    "21": "renews every day, continually,",
    "22": "the work of creation.",
    "23": "How many are Your works, Adonoy;",
    "24": "You made them all with wisdom,",
    "25": "the earth is full of Your possessions.",
    "26": "The King Who alone is exalted from then,",
    "27": "Who is praised and glorified",
    "28": "and uplifted,",
    "29": "from the beginning of time.",
    "30": "Eternal God,",
    "31": "in Your abundant mercy,",
    "32": "have compassion on us,",
    "33": "Master, Who is our strength,",
    "34": "Rock, Who is our stronghold",
    "35": "Shield, of our deliverance,",
    "36": "[Be] a stronghold for us.",
    "37": "The blessed Almighty, great in knowledge,",
    "38": "prepared and made the rays of the sun.",
    "39": "[The] Good [One] created [everything]",
    "40": "for the glory of His Name:",
    "41": "the luminaries He set",
    "42": "around His strength (His throne).",
    "43": "The chiefs of His hosts are holy beings,",
    "44": "the exalters of Shadai",
    "45": "continually recount the glory of the Almighty",
    "46": "and His holiness.",
    "47": "Be Blessed, Adonoy, our God,",
    "48": "in the heavens above and on earth below",
    "49": "for the excellent works of Your hands,",
    "50": "and for the light-giving luminaries",
    "51": "which You formed;",
    "52": "they will glorify You forever.",
    "53": "Be blessed eternally our Former, our King,",
    "54": "and our Redeemer—Creator of holy beings.",
    "55": "Praised be Your Name forever, our King,",
    "56": "Who forms ministering angels;",
    "57": "and Whose ministering angels",
    "58": "all stand at the height of the Universe,",
    "59": "and proclaim with reverence, in unison aloud",
    "60": "the words of the living God,",
    "61": "King of the Universe.",
    "62": "All of them are beloved,",
    "63": "all of them are pure,",
    "64": "all of them are mighty;",
    "65": "all are holy",
    "66": "and all of them perform",
    "67": "with awe and reverence",
    "68": "the will of their Possessor.",
    "69": "And they all open their mouths",
    "70": "in holiness and purity,",
    "71": "with song and music,",
    "72": "and they bless, and praise, and glorify,",
    "73": "and revere, and sanctify,",
    "74": "and proclaim the sovereignty of—",
    "75": "the Name of the Almighty, the King,",
    "76": "the Great, the Mighty, the awesome One;",
    "77": "holy is He.",
    "78": "And they all take upon themselves",
    "79": "the yoke of Divine sovereignty",
    "80": "one from the other,",
    "81": "and lovingly give leave to one another",
    "82": "to sanctify their Former",
    "83": "in a spirit of serenity",
    "84": "with clear speech and pleasantness,",
    "85": "all exclaim Kedushah in unison, with awe,",
    "86": "and reverently exclaim:",
    "87": "Holy, holy, holy",
    "88": "is Adonoy of Hosts,",
    "89": "the fullness of all the earth is His glory.",
    "90": "And the Ofanim and the holy Chayos,",
    "91": "with a mighty sound rise",
    "92": "toward the Serafim.",
    "93": "Facing them, they offer praise and say,",
    "94": "Blessed is the glory of Adonoy",
    "95": "from His place.",
    "96": "To the Blessed Almighty,",
    "97": "they offer pleasant melodies;",
    "98": "to the King, the Almighty,",
    "99": "[Who is] living and enduring,",
    "100": "they utter hymns",
    "101": "and make praises heard.",
    "102": "For He alone, exalted and holy",
    "103": "is the Performer of mighty deeds,",
    "104": "Maker of new things;",
    "105": "Master of battles,",
    "106": "Sower of acts of righteousness,",
    "107": "Causer of deliverance to sprout forth;",
    "108": "Creator of cures.",
    "109": "Awesome in praise, Master of wonders,",
    "110": "He renews in His goodness,",
    "111": "each day, continuously,",
    "112": "the work of creation,",
    "113": "as it is said: \"[Give thanks to Him]",
    "114": "Who makes the great luminaries,\"",
    "115": "for His kindness is everlasting.\"",
    "116": "(and He fashioned the luminaries,",
    "117": "bringing joy to the world He created)",
    "118": "Shine a new light upon Zion,",
    "119": "and may we all soon be privileged",
    "120": "to [enjoy] its brightness.",
    "121": "Blessed are You, Adonoy,",
    "122": "Former of the luminaries.",
    "124": "[With] everlasting love You have loved us",
    "125": "Adonoy, our God;",
    "126": "[With] great and abundant pity",
    "127": "have You pitied us.",
    "128": "Our Father, our King!",
    "129": "for the sake of your great Name",
    "130": "and for the sake of our forefathers",
    "131": "who trusted in You,",
    "132": "and whom You taught statutes of life,",
    "133": "carry out your will",
    "134": "with a perfect heart,",
    "135": "so too, be gracious to us and teach us.",
    "136": "Our Father, merciful Father,",
    "137": "Who acts with compassion",
    "138": "have compassion on us",
    "139": "and put into our hearts",
    "140": "[comprehension] to understand",
    "141": "and to be intellectually creative,",
    "142": "to listen, to learn, and to teach,",
    "143": "to preserve, to practice, and to fulfill",
    "144": "all the words of instruction in Your Torah",
    "145": "with love.",
    "146": "And enlighten our eyes in Your Torah,",
    "147": "and cause our hearts to hold fast",
    "148": "to Your commandments,",
    "149": "and unify our hearts",
    "150": "to love and fear Your Name;",
    "151": "and may we not be subject to shame,",
    "152": "disgrace or stumbling",
    "153": "forever",
    "154": "for in Your holy Name—",
    "155": "great, mighty and awesome—",
    "156": "have we trusted;",
    "157": "may we exult and rejoice in Your deliverance.",
    "158": "And may Your mercy Adonoy our God,",
    "159": "and Your abundant kindness",
    "160": "never forsake us.",
    "161": "Hasten and bring upon us",
    "162": "blessing and peace quickly",
    "163": "from the four corners of the earth",
    "164": "break the yoke of the nations",
    "165": "from our neck",
    "166": "and speedily lead us",
    "167": "upright to our land.",
    "168": "Because, You are the Almighty,",
    "169": "Who performs acts of deliverance,",
    "170": "and You have chosen us",
    "171": "from among all peoples and tongues,",
    "172": "and You have brought us near our king",
    "173": "to Your great Name, forever in truth;",
    "174": "with love, that we may give thanks to You,",
    "175": "and proclaim Your Oneness, with love.",
    "176": "and love Your Name.",
    "177": "Blessed are You, Adonoy,",
    "178": "Who chooses His people Israel with love."
   }
  },
  "Weekday Siddur Sefard Linear, The Morning Prayers, Recitation of Shema": {
   "edition": "metsudah-sefard-weekday",
   "he": {
    "4": "אֵל מֶֽלֶךְ נֶאֱמָן:",
    "5": "<b>שְׁמַע יִשְׂרָאֵל</b>",
    "6": "<b>יְהֹוָה אֱלֹהֵֽינוּ</b>",
    "7": "<b>יְהֹוָה אֶחָד:</b>",
    "9": "<small>בָּרוּךְ שֵׁם כְּבוֹד מַלְכוּתוֹ</small>",
    "10": "<small>לְעוֹלָם וָעֶד:</small>",
    "11": "וְאָהַבְתָּ אֵת יְהֹוָה אֱלֹהֶֽיךָ",
    "12": "בְּכָל֯־לְ֯בָבְךָ",
    "13": "וּבְכָל־נַפְשְׁךָ",
    "14": "וּבְכָל־מְאֹדֶֽךָ:",
    "15": "וְהָיוּ הַדְּ֒בָרִים הָאֵֽלֶּה",
    "16": "אֲשֶׁר֯ אָ֯נֹכִי מְצַוְּךָ הַיּוֹם",
    "17": "עַל֯־לְ֯בָבֶֽךָ:",
    "18": "וְשִׁנַּנְתָּם",
    "19": "לְבָנֶֽיךָ",
    "20": "וְדִבַּרְתָּ בָּם",
    "21": "בְּשִׁבְתְּ֒ךָ בְּבֵיתֶֽךָ",
    "22": "וּבְלֶכְתְּ֒ךָ בַדֶּֽרֶךְ",
    "23": "וּבְשָׁכְבְּ֒ךָ וּבְקוּמֶֽךָ:",
    "24": "וּקְשַׁרְתָּם לְאוֹת",
    "25": "עַל֯־יָ֯דֶֽךָ",
    "26": "וְהָיוּ לְטֹטָפֹת",
    "27": "בֵּין עֵינֶֽיךָ:",
    "28": "וּכְתַבְתָּם",
    "29": "עַל־מְזֻזוֹת בֵּיתֶֽךָ",
    "30": "וּבִשְׁעָרֶֽיךָ:",
    "31": "<b>וְהָיָה</b>",
    "32": "אִם־שָׁמֹֽעַ תִּשְׁמְ֒עוּ אֶל־מִצְוֹתַי",
    "33": "אֲשֶׁר֯ אָ֯נֹכִי מְצַוֶּה אֶתְכֶם הַיּוֹם",
    "34": "לְאַהֲבָה אֶת־יְהֹוָה אֱלֹהֵיכֶם",
    "35": "וּלְעָבְדוֹ",
    "36": "בְּכָל֯־לְ֯בַבְכֶם",
    "37": "וּבְכָל־נַפְשְׁ֒כֶם:",
    "38": "וְנָתַתִּי מְטַר֯־אַ֯רְצְ֒כֶם",
    "39": "בְּעִתּוֹ֯",
    "40": "י֯וֹרֶה",
    "41": "וּמַלְקוֹשׁ",
    "42": "וְאָסַפְתָּ דְגָנֶֽךָ",
    "43": "וְתִירשְׁ֒ךָ וְיִצְהָרֶֽךָ:",
    "44": "וְנָתַתִּי עֵֽשֶׂב֯",
    "45": "בְּ֯שָׂדְ֒ךָ לִבְהֶמְתֶּֽךָ",
    "46": "וְאָכַלְתָּ וְשָׂבָֽעְתָּ:",
    "47": "הִשָּׁמְ֒רוּ לָכֶם פֶּן֯־יִ֯פְתֶּה לְבַבְכֶם",
    "48": "וְסַרְתֶּם",
    "49": "וַעֲבַדְתֶּם אֱלֹהִים֯ אֲ֯חֵרִים",
    "50": "וְהִשְׁתַּחֲוִיתֶם לָהֶם:",
    "51": "וְחָרָה אַף־יְהֹוָה בָּכֶם",
    "52": "וְעָצַר֯ אֶ֯ת־הַשָּׁמַֽיִם",
    "53": "וְלֹּא֯־יִ֯הְיֶה מָטָר",
    "54": "וְהָאֲדָמָה לֹא תִתֵּן אֶת֯־יְ֯בוּלָהּ",
    "55": "וַאֲבַדְתֶּם֯ מְ֯הֵרָה",
    "56": "מֵעַל הָאָֽרֶץ הַטֹּבָה",
    "57": "אֲשֶׁר֯ יְ֯הֹוָה נֹתֵן לָכֶם:",
    "58": "וְשַׂמְתֶּם֯ אֶ֯ת־דְּבָרַי֯ אֵֽ֯לֶּה",
    "59": "עַל֯־לְ֯בַבְכֶם וְעַל־נַפְשְׁ֒כֶם",
    "60": "וּקְשַׁרְתֶּם֯ אֹ֯תָם לְאוֹת",
    "61": "עַל֯־יֶ֯דְכֶם",
    "62": "וְהָיוּ לְטוֹטָפֹת",
    "63": "בֵּין עֵינֵיכֶם:",
    "64": "וְלִמַּדְתֶּם֯ אֹ֯תָם אֶת־בְּנֵיכֶם",
    "65": "לְדַבֵּר בָּם",
    "66": "בְּשִׁבְתְּ֒ךָ בְּבֵיתֶֽךָ",
    "67": "וּבְלֶכְתְּ֒ךָ בַדֶּֽרֶךְ",
    "68": "וּבְשָׁכְבְּ֒ךָ וּבְקוּמֶֽךָ:",
    "69": "וּכְתַבְתָּם",
    "70": "עַל־מְזוּזוֹת בֵּיתֶֽךָ",
    "71": "וּבִשְׁעָרֶֽיךָ:",
    "72": "לְמַֽעַן֯ יִ֯רְבּוּ יְמֵיכֶם",
    "73": "וִימֵי בְנֵיכֶם",
    "74": "עַל הָאֲדָמָה",
    "75": "אֲשֶׁר נִשְׁבַּע יְהֹוָה לַאֲבֹתֵיכֶם",
    "76": "לָתֵת לָהֶם",
    "77": "כִּימֵי הַשָּׁמַֽיִם עַל־הָאָֽרֶץ:",
    "78": "<b>וַֽיֹּאמֶר֯</b> יְ֯הֹוָה֯ אֶ֯ל־משֶׁה לֵּאמֹר:",
    "79": "דַּבֵּר֯ אֶ֯ל־בְּנֵי יִשְׂרָאֵל",
    "80": "וְאָמַרְתָּ אֲלֵהֶם",
    "81": "וְעָשׂוּ לָהֶם צִיצִת",
    "82": "עַל־כַּנְ֒פֵי בִגְ֒דֵיהֶם",
    "83": "לְדֹרֹתָם",
    "84": "וְנָתְ֒נוּ עַל־צִיצִת",
    "85": "הַכָּנָף֯",
    "86": "פְּ֯תִיל תְּכֵֽלֶת:",
    "87": "וְהָיָה לָכֶם לְצִיצִת",
    "88": "וּרְאִיתֶם֯ אֹ֯תוֹ",
    "89": "וּזְכַרְתֶּם֯",
    "90": "אֶ֯ת־כָּל־מִצְוֹת֯ יְ֯הֹוָה",
    "91": "וַעֲשִׂיתֶם֯ אֹ֯תָם",
    "92": "וְלֹא תָתֽוּרוּ אַחֲרֵי לְבַבְכֶם",
    "93": "וְאַחֲרֵי עֵינֵיכֶם",
    "94": "אֲשֶׁר֯־אַ֯תֶּם זֹנִים֯ אַ֯חֲרֵיהֶם:",
    "95": "לְמַֽעַן תִּזְכְּ֒רוּ",
    "96": "וַעֲשִׂיתֶם֯ אֶ֯ת־כָּל־מִצְוֹתָי",
    "97": "וִהְיִיתֶם קְדשִׁים לֵאלֹהֵיכֶם:",
    "98": "אֲנִי יְהֹוָה אֱלֹהֵיכֶם֯",
    "99": "אֲ֯שֶׁר הוֹצֵֽאתִי אֶתְכֶם֯",
    "100": "מֵ֯אֶֽרֶץ מִצְרַֽיִם",
    "101": "לִהְיוֹת לָכֶם לֵאלֹהִים֯",
    "102": "אֲ֯נִי יְהֹוָה אֱלֹהֵיכֶם֯:",
    "104": "אֱ֯מֶת",
    "106": "<b>יְהֹוָה אֱלֹהֵיכֶם֯ אֱ֯מֶת:</b>",
    "108": "<b>וְיַצִּיב</b>",
    "109": "וְנָכוֹן וְקַיָּם",
    "110": "וְיָשָׁר וְנֶאֱמָן",
    "111": "וְאָהוּב וְחָבִיב",
    "112": "וְנֶחְמָד וְנָעִים",
    "113": "וְנוֹרָא וְאַדִּיר",
    "114": "וּמְתֻקָּן וּמְקֻבָּל",
    "115": "וְטוֹב וְיָפֶה",
    "116": "הַדָּבָר הַזֶּה עָלֵֽינוּ לְעוֹלָם וָעֶד:",
    "117": "אֱמֶת",
    "118": "אֱלֹהֵי עוֹלָם מַלְכֵּֽנוּ",
    "119": "צוּר יַעֲקֹב",
    "120": "מָגֵן יִשְׁעֵֽנוּ,",
    "121": "לְדֹר וָדֹר",
    "122": "הוּא קַיָּם וּשְׁמוֹ קַיָּם",
    "123": "וְכִסְאוֹ נָכוֹן",
    "124": "וּמַלְכוּתוֹ וֶאֱמוּנָתוֹ",
    "125": "לָעַד קַיָּֽמֶת:",
    "126": "וּדְבָרָיו חָיִים וְקַיָּמִים",
    "127": "נֶאֱמָנִים וְנֶחֱמָדִים",
    "128": "לָעַד וּלְעוֹלְ֒מֵי עוֹלָמִים,",
    "129": "עַל אֲבוֹתֵֽינוּ וְעָלֵֽינוּ",
    "130": "עַל בָּנֵֽינוּ וְעַל דּוֹרוֹתֵֽינוּ",
    "131": "וְעַל כָּל דּוֹרוֹת",
    "132": "זֶֽרַע יִשְׂרָאֵל עֲבָדֶֽיךָ:",
    "133": "<b>עַל הָרִאשׁוֹנִים</b> וְעַל הָאַחֲרוֹנִים",
    "134": "דָּבָר טוֹב וְקַיָּם לְעוֹלָם וָעֶד,",
    "135": "אֱמֶת וֶאֱמוּנָה",
    "136": "חוֹק וְלֹא יַעֲבֹר:",
    "137": "אֱמֶת שָׁאַתָּה הוּא יְהֹוָה",
    "138": "אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ",
    "139": "מַלְכֵּֽנוּ מֶֽלֶךְ אֲבוֹתֵֽינוּ",
    "140": "גֹּאֲלֵֽנוּ גֹּאֵל אֲבוֹתֵֽינוּ",
    "141": "יוֹצְ֒רֵֽנוּ צוּר יְשׁוּעָתֵֽנוּ",
    "142": "פּוֹדֵֽנוּ וּמַצִּילֵֽנוּ",
    "143": "מֵעוֹלָם הוּא שְׁמֶֽךָ",
    "144": "וְאֵין לָֽנוּ עוֹד אֱלֹהִים",
    "145": "זוּלָתֶֽךָ סֶֽלָה:",
    "146": "<b>עֶזְרַת</b> אֲבוֹתֵֽינוּ",
    "147": "אַתָּה הוּא מֵעוֹלָם",
    "148": "מָגֵן וּמוֹשִֽׁיעַ",
    "149": "לָהֶם וְלִבְנֵיהֶם אַחֲרֵיהֶם",
    "150": "בְּכָל דּוֹר וָדוֹר:",
    "151": "בְּרוּם עוֹלָם",
    "152": "מוֹשָׁבֶֽךָ",
    "153": "וּמִשְׁפָּטֶֽיךָ וְצִדְקָתְךָ",
    "154": "עַד אַפְסֵי אָֽרֶץ:",
    "155": "אֶמֶת אַשְׁרֵי אִישׁ",
    "156": "שֶׁיִּשְׁמַע לְמִצְוֹתֶֽיךָ",
    "157": "וְתוֹרָתְ֒ךָ וּדְבָרְ֒ךָ",
    "158": "יָשִׂים עַל לִבּוֹ:",
    "159": "אֱמֶת אַתָּה הוּא אָדוֹן לְעַמֶּֽךָ",
    "160": "וּמֶֽלֶךְ גִּבּוֹר לָרִיב רִיבָם",
    "161": "לאָבוֹת וּבָנִים:",
    "162": "אֱמֶת אַתָּה הוּא רִאשׁוֹן",
    "163": "וְאַתָּה הוּא אַחֲרוֹן",
    "164": "וּמִבַּלְעָדֶֽיךָ",
    "165": "אֵין לָֽנוּ מֶֽלֶךְ גּוֹאֵל וּמוֹשִֽׁיעַ:",
    "166": "אֱמֶת מִמִּצְרַֽיִם גְּאַלְתָּֽנוּ",
    "167": "יְהֹוָה אֱלֹהֵֽינוּ",
    "168": "וּמִבֵּית עֲבָדִים פְּדִיתָֽנוּ:",
    "169": "כָּל בְּכוֹרֵיהֶם הָרָֽגְתָּ",
    "170": "וּבְכוֹרְ֒ךָ יִשְׂרָאֵל גָּאָֽלְתָּ",
    "171": "וְיַם סוּף בָּקַֽעְתָּ",
    "172": "וְזֵדִים טִבַּֽעְתָּ",
    "173": "וִידִידִים הֶעֱבַֽרְתָּ",
    "174": "וַיְכַסּוּ מַֽיִם צָרֵיהֶם",
    "175": "אֶחָד מֵהֶם לֹא נוֹתָר:",
    "176": "עַל זֹאת שִׁבְּ֒חוּ אֲהוּבִים",
    "177": "וְרוֹמְ֒מוּ לָאֵל",
    "178": "וְנָתְ֒נוּ יְדִידִים",
    "179": "זְמִירוֹת שִׁירוֹת וְתִשְׁבָּחוֹת",
    "180": "בְּרָכוֹת וְהוֹדָאוֹת",
    "181": "לְמֶּֽלֶךְ אֵל",
    "182": "חַי וְקַיָּם:",
    "183": "רָם וְנִשָּׂא",
    "184": "גָּדוֹל וְנוֹרָא",
    "185": "מַשְׁפִּיל גֵּאִים עֲדֵי אָֽרֶץ",
    "186": "וּמַגְבִּֽיהַּ שְׁפָלִים עֲדֵי מָרוֹם",
    "187": "מוֹצִיא אֲסִירִים",
    "188": "וּפוֹדֶה עֲנָוִים",
    "189": "וְעוֹזֵר דַּלִּים",
    "190": "וְעוֹנֶה לְעַמּוֹ יִשְׂרָאֵל",
    "191": "בְּעֵת שַׁוְּ֒עָם אֵלָיו:",
    "192": "תְּהִלּוֹת לְאֵל עֶלְיוֹן",
    "193": "גֹּאֲלָם",
    "194": "בָּרוּךְ הוּא וּמְבֹרָךְ,",
    "195": "משֶׁה וּבְנֵי יִשְׂרָאֵל",
    "196": "לְךָ עָנוּ שִׁירָה בְּשִׂמְחָה רַבָּה",
    "197": "וְאָמְ֒רוּ כֻלָּם:",
    "198": "<b>מִי כָמֹֽכָה</b> בָּאֵלִם יְהֹוָה",
    "199": "מִי כָּמֹֽכָה",
    "200": "נֶאְדָּר בַּקֹּֽדֶשׁ",
    "201": "נוֹרָא תְהִלֹּת עֹֽשֵׂה פֶֽלֶא:",
    "202": "<b>שִׁירָה</b> חֲדָשָׁה שִׁבְּ֒חוּ גְאוּלִים",
    "203": "לְשִׁמְךָ הַגָּדוֹל עַל שְׂפַת הַיָּם",
    "204": "יַֽחַד כֻּלָּם",
    "205": "הוֹדוּ",
    "206": "וְהִמְלִֽיכוּ",
    "207": "וְאָמְרוּ:",
    "208": "יְהֹוָה יִמְלֹךְ לְעוֹלָם וָעֶד:",
    "209": "צוּר יִשְׂרָאֵל",
    "210": "קֽוּמָה בְּעֶזְרַת יִשְׂרָאֵל",
    "211": "וּפְדֵה",
    "212": "כִנְאֻמֶֽךָ יְהוּדָה וְיִשְׂרָאֵל,",
    "213": "גֹּאֲלֵֽנוּ",
    "214": "יְהֹוָה צְבָאוֹת שְׁמוֹ",
    "215": "קְדוֹשׁ יִשְׂרָאֵל:",
    "216": "בָּרוּךְ אַתָּה יְהֹוָה",
    "217": "גָּאַל יִשְׂרָאֵל:"
   },
   "en": {
    "3": "<small><i>The following three words should be said when praying without a minyan:</i></small>",
    "4": "(Almighty, faithful King)",
    "5": "<b>Hear, Israel:</b>",
    "6": "<b>Adonoy is our God,</b>",
    "7": "<b>Adonoy is One.</b>",
    "8": "<small><i>The following two lines are to be said silently:</i></small>",
    "9": "Blessed [is His] Name, Whose glorious kingdom",
    "10": "is forever and ever.",
    "11": "And you shall love Adonoy your God",
    "12": "with all your heart",
    "13": "and with all your soul",
    "14": "and with all your possessions.",
    "15": "And these words",
    "16": "which I command you today,",
    "17": "shall be upon your heart.",
    "18": "And you shall teach them sharply",
    "19": "to your children.",
    "20": "And you shall discuss them",
    "21": "when you sit in your house,",
    "22": "and when you travel on the road,",
    "23": "and when you lie down and when you rise.",
    "24": "And you shall bind them for a sign",
    "25": "upon your hand,",
    "26": "and they shall be for <i>totafos</i>",
    "27": "between your eyes.",
    "28": "And you shall write them",
    "29": "upon the doorposts of your house",
    "30": "and upon your gateways.",
    "31": "And it will be—",
    "32": "if you vigilantly obey My commandments",
    "33": "which I command you this day,",
    "34": "to love Adonoy your God,",
    "35": "and serve Him",
    "36": "with your entire hearts",
    "37": "and with your entire souls—",
    "38": "that I will give rain for your land",
    "39": "in its proper time,",
    "40": "the early (autumn) rain",
    "41": "and the late (spring) rain;",
    "42": "and you will harvest your grain",
    "43": "and your wine and your oil.",
    "44": "And I will put grass",
    "45": "in your fields for your cattle,",
    "46": "and you will eat and be satisfied.",
    "47": "Beware lest your hearts be swayed",
    "48": "and you turn astray,",
    "49": "and you worship alien gods",
    "50": "and bow to them.",
    "51": "And Adonoy's fury will blaze among you,",
    "52": "and He will close off the heavens",
    "53": "and there will be no rain",
    "54": "and the earth will not yield its produce;",
    "55": "and you will perish swiftly",
    "56": "from the good land",
    "57": "which Adonoy gives you.",
    "58": "Place these words of Mine",
    "59": "upon your hearts and upon your souls,—",
    "60": "and bind them for a sign",
    "61": "upon your hands,",
    "62": "and they shall be for <i>totafos</i>",
    "63": "between your eyes.",
    "64": "And you shall teach them to your sons,",
    "65": "to speak them",
    "66": "when you sit in your house,",
    "67": "and when you travel on the road,",
    "68": "and when you lie down and when you rise.",
    "69": "And you shall write them",
    "70": "upon the doorposts of your house",
    "71": "and upon your gateways.",
    "72": "In order that your days be prolonged,",
    "73": "and the days of your children,",
    "74": "upon the land",
    "75": "which Adonoy swore to your fathers",
    "76": "to give them [for as long]",
    "77": "as the heavens are above the earth.",
    "78": "And Adonoy spoke to Moses saying:",
    "79": "Speak to the children of Israel,",
    "80": "and tell them",
    "81": "to make for themselves fringes",
    "82": "on the corners of their garments",
    "83": "throughout their generations;",
    "84": "and they will place with the fringes",
    "85": "of each corner",
    "86": "a thread of blue.",
    "87": "And it will be to you for fringes,",
    "88": "and you will look upon it",
    "89": "and you will remember",
    "90": "all the commandments of Adonoy,",
    "91": "and you will perform them;",
    "92": "and you will not turn aside after your hearts",
    "93": "and after your eyes",
    "94": "which cause you to go astray.",
    "95": "In order that you will remember",
    "96": "and perform all My commandments;",
    "97": "and you will be holy unto your God.",
    "98": "I am Adonoy, your God,",
    "99": "Who brought you out",
    "100": "of the land of Egypt",
    "101": "to be your God:",
    "102": "I am Adonoy, your God—",
    "104": "—is true—",
    "106": "Adonoy, your God, is true.",
    "108": "—and firm,",
    "109": "certain and enduring,",
    "110": "upright and faithful,",
    "111": "beloved and cherished,",
    "112": "desired and pleasant,",
    "113": "awesome and mighty,",
    "114": "correct and acceptable,",
    "115": "good and beautiful",
    "116": "is this [affirmation] to us for all eternity.",
    "117": "It is true,",
    "118": "that the God of the Universe, is our King,",
    "119": "the Stronghold of Jacob",
    "120": "is the Shield of our deliverance.",
    "121": "Throughout the generations",
    "122": "He endures and His Name endures,",
    "123": "and His throne is confirmed;",
    "124": "and His sovereignty and His faithfulness",
    "125": "endure forever.",
    "126": "His words are alive and enduring,",
    "127": "faithful and desirable",
    "128": "forever and to all eternity;",
    "129": "for our fathers and for us,",
    "130": "for our children and for our generations,",
    "131": "and for all generations",
    "132": "of the seed of Israel, Your servants.",
    "133": "Upon the first and upon the last, [generations]",
    "134": "[it is] a matter that is good and everlasting.",
    "135": "It is true and faithful,",
    "136": "a Law that will never be abrogated.",
    "137": "Truly you Adonoy, are",
    "138": "our God, and the God of our fathers,",
    "139": "our King the King of our fathers,",
    "140": "our Redeemer, Redeemer of our fathers,",
    "141": "our Former, Rock of our deliverance;",
    "142": "our Liberator and our Saver",
    "143": "which is Your Name from old,",
    "144": "and we have no other God",
    "145": "besides You, ever.",
    "146": "The help of our fathers",
    "147": "You have always been.",
    "148": "A Shield and a Deliverer",
    "149": "to them and their children after them",
    "150": "in every generation.",
    "151": "The heights of the universe,",
    "152": "is Your habitation,",
    "153": "and Your judgments and Your righteousness",
    "154": "[reach] to the ends of the earth.",
    "155": "Truly fortunate is man",
    "156": "who heeds Your commandments;",
    "157": "and Your Torah and Your word",
    "158": "he takes to his heart.",
    "159": "Truly, You are the Master of Your people",
    "160": "and a mighty King to defend their cause.",
    "161": "for the fathers and [their] sons:",
    "162": "Truly, You are First",
    "163": "and You are Last,",
    "164": "and besides You",
    "165": "we have no king, redeemer, or deliverer.",
    "166": "Truly Your redeemed us from Egypt.",
    "167": "Adonoy, our God,",
    "168": "from the house of bondage You liberated us.",
    "169": "All their firstborn You slew,",
    "170": "and Israel, Your firstborn, You redeemed.",
    "171": "The Sea of Reeds, You split",
    "172": "and the wicked, You drowned.",
    "173": "You caused the beloved ones to pass through,",
    "174": "while the waters covered their enemies;",
    "175": "not one of them remained.",
    "176": "Because of this, the beloved ones praised",
    "177": "and exalted the Almighty;",
    "178": "and the beloved ones offered",
    "179": "hymns, songs, and praises,",
    "180": "blessings and thanksgiving",
    "181": "to the King, the Almighty,",
    "182": "[Who is] living and enduring.",
    "183": "(He is) exalted and uplifted,",
    "184": "great and awesome;",
    "185": "He humbles the haughty to the ground.",
    "186": "and raises the lowly, to the heights.",
    "187": "He frees the captives",
    "188": "and redeems the humble,",
    "189": "(and) helps the impoverished,",
    "190": "and He answers His people Israel",
    "191": "when they cry out to Him.",
    "192": "Praises to the most high Almighty",
    "193": "their redeemer,",
    "194": "blessed is He, and He is blessed.",
    "195": "Moses and the Children of Israel",
    "196": "sang a song to You with great joy,",
    "197": "and they all proclaimed:",
    "198": "Who is like You among the mighty, Adonoy!",
    "199": "Who is like You—",
    "200": "[You are] adorned in holiness,",
    "201": "awesome in praise, performing wonders!",
    "202": "With a new song the redeemed people praised",
    "203": "Your great Name at the seashore!",
    "204": "All of them in unison",
    "205": "gave thanks",
    "206": "and proclaimed Your sovereignty,",
    "207": "and said:",
    "208": "Adonoy will reign forever and ever.",
    "209": "Rock of Israel,",
    "210": "arise to the aid of Israel,",
    "211": "and liberate",
    "212": "Judah and Israel as You promised.",
    "213": "Our Redeemer—",
    "214": "‘Adonoy of hosts' is His Name,",
    "215": "the Holy One of Israel",
    "216": "Blessed are You, Adonoy,",
    "217": "Who redeemed Israel."
   }
  }
 }
}
