{
 "id": "weekday/shacharit/mourners-or-rabbis-kaddish:sefard",
 "refs": {
  "Weekday Siddur Sefard Linear, The Morning Prayers, Mourner's Kaddish": {
   "edition": "metsudah-sefard-weekday",
   "he": {
    "2": "<b>יִתְגַּדַּל</b> וְיִתְקַדַּשׁ שְׁמֵהּ רַבָּא",
    "3": "בְּעָלְ֒מָא דִּי בְרָא",
    "4": "כִרְעוּתֵהּ",
    "5": "וְיַמְלִיךְ מַלְכוּתֵהּ",
    "6": "וְיַצְמַח פּוּרְ֒קָנֵהּ",
    "7": "וִיקָרֵב (קֵץ) מְשִׁיחֵהּ",
    "8": "בְּחַיֵּיכוֹן וּבְיוֹמֵיכוֹן",
    "9": "וּבְחַיֵּי",
    "10": "דְכָל בֵּית יִשְׂרָאֵל,",
    "11": "בַּעֲגָלָא וּבִזְמַן קָרִיב",
    "12": "וְאִמְרוּ אָמֵן:",
    "13": "<b>יְהֵא שְׁמֵהּ רַבָּא מְבָרַךְ</b>",
    "14": "<b>לְעָלַם וּלְעָלְ֒מֵי עָלְ֒מַיָּא</b>:",
    "15": "יִתְבָּרַךְ וְיִשְׁתַּבַּח",
    "16": "וְיִתְפָּאַר וְיִתְרוֹמַם וְיִתְנַשֵּׂא",
    "17": "וְיִתְהַדָּר וְיִתְעַלֶּה וְיִתְהַלָּל",
    "18": "שְׁמֵהּ דְקוּדְשָׁא, בְּרִיךְ הוּא ",
    "19": "לְעֵֽלָּא (<small>בעשי\"ת</small> וּלְ֒עֵֽלָּא מִכָּל) ",
    "20": "מִן כָּל בִּרְכָתָא וְשִׁירָתָא,",
    "21": "תֻּשְׁבְּחָתָא וְנֶחֱמָתָא,",
    "22": "דַּאֲמִירָן בְּעָלְ֒מָא, וְאִמְרוּ אָמֵן,",
    "23": "יְהֵא שְׁלָמָא רַבָּא מִן שְׁמַיָּא",
    "24": "וְחַיִּים",
    "25": "עָלֵֽינוּ וְעַל כָּל יִשְׂרָאֵל",
    "26": "וְאִמְרוּ אָמֵן:",
    "27": "עוֹשֶׂה שָׁלוֹם",
    "28": "(<small>בעשי\"ת</small> הַשָּׁלוֹם)",
    "29": "בִּמְרוֹמָיו",
    "30": "הוּא יַעֲשֶׂה שָׁלוֹם",
    "31": "עָלֵינוּ וְעַל כָּל יִשְׂרָאֵל",
    "32": "וְאִמְרוּ אָמֵן"
   },
   "en": {
    "2": "Exalted and sanctified be His great Name",
    "3": "in the world which He created",
    "4": "according to His will",
    "5": "and may He rule His kingdom",
    "6": "bring forth His redemption",
    "7": "and hasten the coming if His Messiah",
    "8": "in your lifetime and in your days,",
    "9": "and in the lifetime",
    "10": "of the entire House of Israel,",
    "11": "speedily and in the near future—",
    "12": "and say Amein.",
    "13": "May His great Name be blessed",
    "14": "forever and for all eternity.",
    "15": "Blessed and praised,",
    "16": "glorified, and exalted and uplifted,",
    "17": "honored and elevated and extolled",
    "18": "be the Name of the Holy One, blessed is He;",
    "19": "above (<i>Ten Days of Penitence:</i> far above)",
    "20": "all the blessings and hymns,",
    "21": "praises and consolations",
    "22": "which we utter in the world—and say Amein.",
    "23": "May there be abundant peace from heaven",
    "24": "and life",
    "25": "for us and for all Israel,",
    "26": "—and say Amein.",
    "27": "He Who makes peace",
    "28": "(<i>Ten Days of Penitence:</i> the peace)",
    "29": "in His high heavens",
    "30": "may He, make peace",
    "31": "for us and for all Israel,",
    "32": "and say, Amen."
   }
  }
 }
}
