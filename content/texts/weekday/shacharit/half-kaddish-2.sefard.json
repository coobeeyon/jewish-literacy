{
 "id": "weekday/shacharit/half-kaddish-2:sefard",
 "refs": {
  "Weekday Siddur Sefard Linear, The Morning Prayers, Vehu Rachum": {
   "edition": "metsudah-sefard-weekday",
   "he": {
    "346": "<b>יִתְגַּדַּל</b> וְיִתְקַדַּשׁ שְׁמֵהּ רַבָּא",
    "347": "בְּעָלְ֒מָא דִּי בְרָא",
    "348": "כִרְעוּתֵהּ",
    "349": "וְיַמְלִיךְ מַלְכוּתֵהּ",
    "350": "וְיַצְמַח פּוּרְקָנֵהּ",
    "351": "וִיקָרֵב (קֵץ) מְשִׁיחֵהּ",
    "352": "בְּחַיֵּיכוֹן וּבְיוֹמֵיכוֹן",
    "353": "וּבְחַיֵּי",
    "354": "דְכָל בֵּית יִשְׂרָאֵל,",
    "355": "בַּעֲגָלָא וּבִזְמַן קָרִיב",
    "356": "וְאִמְרוּ אָמֵן:",
    "357": "<b>יְהֵא שְׁמֵהּ רַבָּא מְבָרַךְ</b>",
    "358": "לְעָלַם וּלְעָלְ֒מֵי עָלְ֒מַיָּא:",
    "359": "יִתְבָּרַךְ וְיִשְׁתַּבַּח",
    "360": "וְיִתְפָּאַר וְיִתְרוֹמַם וְיִתְנַשֵּׂא",
    "361": "וְיִתְהַדָּר וְיִתְעַלֶּה וְיִתְהַלָּל",
    "362": "שְׁמֵהּ דְקוּדְשָׁא, בְּרִיךְ הוּא ",
    "363": "לְעֵֽלָּא (<small>בעשי\"ת</small> וּלְ֒עֵֽלָּא מִכָּל) ",
    "364": "מִן כָּל בִּרְכָתָא וְשִׁירָתָא,",
    "365": "תֻּשְׁבְּחָתָא וְנֶחֱמָתָא,",
    "366": "דַּאֲמִירָן בְּעָלְ֒מָא, וְאִמְרוּ אָמֵן:"
   },
   "en": {
    "345": "<small>The <i>Chazzan</i> recites the Half Kaddish</small>",
    "346": "Exalted and sanctified be His great Name",
    "347": "in the world which He created",
    "348": "according to His will",
    "349": "and may He rule His kingdom",
    "350": "bring forth His redemption",
    "351": "and hasten the coming if His Messiah",
    "352": "in your lifetime and in your days,",
    "353": "and in the lifetime",
    "354": "of the entire House of Israel,",
    "355": "speedily and in the near future—",
    "356": "and say Amein.",
    "357": "May His great Name be blessed",
    "358": "forever and for all eternity.",
    "359": "Blessed and praised,",
    "360": "glorified, and exalted and uplifted,",
    "361": "honored and elevated and extolled",
    "362": "be the Name of the Holy One, blessed is He;",
    "363": "above (<i>Ten Days of Penitence:</i> far above)",
    "364": "all the blessings and hymns,",
    "365": "praises and consolations",
    "366": "which we utter in the world—and say Amein."
   }
  }
 }
}
