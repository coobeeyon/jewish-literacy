{
 "id": "weekday/shacharit/tachanun:sefard",
 "refs": {
  "Weekday Siddur Sefard Linear, The Morning Prayers, Tachanun": {
   "edition": "metsudah-sefard-weekday",
   "he": {
    "3": "<b>אֱלֺהֵֽינוּ</b> וֵאלֺהֵי אֲבוֹתֵֽינוּ",
    "4": "תָּבֹא לְפָנֶֽיךָ תְּפִלָּֽתֵֽנוּ,",
    "5": "וְאַל־תִּתְעַלַּם מִתְּ֒חִנָּתֵֽנוּ",
    "6": "שֶׁאֵין אָֽנוּ עַזֵּי פָנִים",
    "7": "וּקְשֵׁי עֹֽרֶף",
    "8": "לוֹמַר לְפָנֶֽיךָ",
    "9": "יְהֹוָה אֱלֺהֵֽינוּ וֵאלֺהֵי אֲבוֹתֵֽינוּ",
    "10": "צַדִּיקִים אֲנַֽחְנוּ וְלֺא חָטָֽאנוּ",
    "11": "אֲבָל אֲנַֽחְנוּ וַאֲבוֹתֵֽינוּ חָטָֽאנוּ:",
    "12": "<b>אָשַֽׁמְנוּ.</b>",
    "13": "בָּגַֽדְנוּ.",
    "14": "גָּזַֽלְנוּ. דִּבַּֽרְנוּ דֹּֽפִי.",
    "15": "הֶעֱוִֽינוּ.",
    "16": "וְהִרְשַֽׁעְנוּ.",
    "17": "זַֽדְנוּ.",
    "18": "חָמַֽסְנוּ.",
    "19": "טָפַֽלְנוּ שֶֽׁקֶר.",
    "20": "יָעַֽצְנוּ רָע.",
    "21": "כִּזַּֽבְנוּ. לַֽצְנוּ.",
    "22": "מָרַֽדְנוּ.",
    "23": "נִאַֽצְנוּ.",
    "24": "סָרַֽרְנוּ.",
    "25": "עָוִֽינוּ.",
    "26": "פָּשַֽׁעְנוּ.",
    "27": "צָרַֽרְנוּ.",
    "28": "קִשִּֽׁינוּ עֹֽרֶף.",
    "29": "רָשַֽׁעְנוּ.",
    "30": "שִׁחַֽתְנוּ.",
    "31": "תִּעַֽבְנוּ.",
    "32": "תָּעִֽינוּ.",
    "33": "תִּעְתָּֽעְנוּ:",
    "34": "סַֽרְנוּ",
    "35": "מִמִּצְוֹתֶֽיךָ",
    "36": "וּמִמִּשְׁפָּטֶֽיךָ הַטּוֹבִים",
    "37": "וְלֺא שָֽׁוָה לָֽנוּ.",
    "38": "וְאַתָּה צַדִּיק",
    "39": "עַל כָּל הַבָּא עָלֵֽינוּ.",
    "40": "כִּי אֱמֶת עָשִֽׂיתָ",
    "41": "וַאֲנַֽחְנוּ הִרְשָֽׁעְנוּ:",
    "42": "אֵל אֶֽרֶךְ־אַפַּֽיִם אַתָּה.",
    "43": "וּבַֽעַל הָרַחֲמִים נִקְרֵֽאתָ.",
    "44": "וְדֶֽרֶךְ תְּשׁוּבָה",
    "45": "הוֹרֵֽיתָ:",
    "46": "גְּדֻלַּת רַחֲמֶֽיךָ וַחֲסָדֶֽיךָ.",
    "47": "תִּזְכֺּר הַיּוֹם וּבְכָל־יוֹם",
    "48": "לְזֶֽרַע יְדִידֶֽיךָ:",
    "49": "תֵּֽפֶן אֵלֵֽינוּ בְּרַחֲמִים.",
    "50": "כִּי אַתָּה הוּא בַּֽעַל הָרַחֲמִים:",
    "51": "בְּתַחֲנוּן וּבִתְ֒פִלָּה",
    "52": "פָּנֶֽיךָ נְקַדֵּם.",
    "53": "כְּהוֹדַֽעְתָּ",
    "54": "לֶעָנָיו מִקֶּֽדֶם:",
    "55": "מֵחֲרוֹן אַפְּ֒ךָ שׁוּב.",
    "56": "כְּמוֹ בְּתוֹרָתְ֒ךָ כָּתוּב:",
    "57": "וּבְ֒צֵל כְּנָפֶֽיךָ",
    "58": "נֶחֱסֶה וְנִתְלוֹנָן.",
    "59": "כְּיוֹם",
    "60": "וַיֵֽרֶד יְהֺוָה בֶּעָנָן:",
    "61": "תַּעֲבֺר עַל־פֶּֽשַׁע",
    "62": "וְתִמְחֶה אָשָׁם.",
    "63": "כְּיוֹם",
    "64": "וַַיִּתְיַצֵּב עִמּוֹ שָׁם:",
    "65": "תַּאֲזִין שַׁוְעָתֵֽנוּ",
    "66": "וְתַקְשִׁיב מֶֽנוּ מַאֲמַר.",
    "67": "כְּיוֹם",
    "68": "וַיִּקְרָא בְשֵׁם יְהֹוָה,",
    "69": "וְשָׁם נֶאֱמַר:",
    "71": "וַיַּעֲבֹר יְהֺוָה עַל פָּנָיו",
    "72": "וַיִּקְרָא:",
    "73": "יְהֺוָה יְהֺוָה",
    "74": "אֵל רַחוּם וְחַנּוּן",
    "75": "אֶֽרֶךְ אַפַּֽיִם",
    "76": "וְרַב־חֶֽסֶד וֶאֱמֶת:",
    "77": "נֹצֵר חֶֽסֶד",
    "78": "לָאֲלָפִים",
    "79": "נֹשֵׂא עָוֹן וָפֶֽשַׁע",
    "80": "וְחַטָּאָה",
    "81": "וְנַקֵּה:",
    "82": "וְסָלַחְתָּ לַעֲוֺנֵֽנוּ וּלְ֒חַטָּאתֵֽנוּ",
    "83": "וּנְ֒חַלְתָּֽנוּ:",
    "84": "סְלַח־לָֽנוּ אָבִֽינוּ כִּי־חָטָֽאנוּ.",
    "85": "מְחַל־לָֽנוּ מַלְכֵּֽנוּ כִּי־פָשָֽׁעְנוּ:",
    "86": "כִּי־אַתָּה אֲדֺנָי",
    "87": "טוֹב וְסַלָּח",
    "88": "וְרַב־חֶֽסֶד",
    "89": "לְכָל־קוֹרְ֒אֶֽיךָ:",
    "91": "וַיֹּֽאמֶר דָּוִד אֶל־גָּד",
    "92": "צַר־לִי מְאֹד",
    "93": "נִפְּ֒לָה־נָּא בְיַד־יְהֹוָה",
    "94": "כִּי־רַבִּים רַחֲמָיו",
    "95": "וּבְ֒יַד־אָדָם אַל־אֶפֹּֽלָה:",
    "96": "רַחוּם וְחַנּוּן",
    "97": "חָטָֽאתִי לְפָנֶֽיךָ",
    "98": "יְהֹוָה מָלֵא רַחֲמִים",
    "99": "רַחֵם עָלַי",
    "100": "וְקַבֵּל תַּחֲנוּנָי:",
    "101": "יְהֹוָה אַל־בְּאַפְּ֒ךָ תוֹכִיחֵֽנִי",
    "102": "וְאַל־בַּחֲמָתְ֒ךָ תְיַסְּ֒רֵֽנִי:",
    "103": "חָנֵּֽנִי יְהֹוָה",
    "104": "כִּי אֻמְלַל אָֽנִי",
    "105": "רְפָאֵֽנִי יְהֹוָה כִּי נִבְהֲלוּ עֲצָמָי:",
    "106": "וְנַפְשִׁי נִבְהֲלָה מְאֹד",
    "107": "וְאַתָּה יְהֹוָה עַד־מָתָי:",
    "108": "שׁוּבָה יְהֹוָה חַלְּ֒צָה נַפְשִׁי",
    "109": "הוֹשִׁיעֵֽנִי",
    "110": "לְמַֽעַן חַסְדֶּֽךָ:",
    "111": "כִּי אֵין בַּמָּֽוֶת זִכְרֶךָ",
    "112": "בִּשְׁ֒אוֹל מִי־יוֹדֶה לָּךְ:",
    "113": "יָגַֽעְתִּי־בְּאַנְחָתִי",
    "114": "אַשְׂחֶה בְכָל־לַֽיְלָה מִטָּתִי",
    "115": "בְּדִמְעָתִי עַרְשִׂי אַמְסֶה:",
    "116": "עָשְׁ֒שָׁה מִכַּֽעַס עֵינִי",
    "117": "עָתְ֒קָה בְּכָל־צוֹרְ֒רָי:",
    "118": "סֽוּרוּ מִמֶּֽנִּי כָּל־פֹּֽעֲלֵי אָוֶן",
    "119": "כִּי־שָׁמַע יְהֹוָה",
    "120": "קוֹל בִּכְיִי:",
    "121": "שָׁמַע יְהֹוָה תְּחִנָּתִי",
    "122": "יְהֹוָה תְּפִלָּתִי יִקָּח:",
    "123": "יֵבֽשׁוּ וְיִבָּהֲלוּ מְאֹד",
    "124": "כָּל־אֹיְ֒בָי",
    "125": "יָשֻֽׁבוּ",
    "126": "יֵבֽשׁוּ רָֽגַע:"
   },
   "en": {
    "3": "Our God and God of our fathers,",
    "4": "let our prayer come before you",
    "5": "and do not ignore our supplication.",
    "6": "For we are not so brazen-faced",
    "7": "and stiff-necked",
    "8": "to say to you,",
    "9": "Adonoy, our God, and God of our fathers,",
    "10": "We are righteous and have not sined.",
    "11": "But, indeed, we and our fathers have sinned.",
    "12": "We have trespassed [against God and man, and we are devastated by our guilt];",
    "13": "We have betrayed [God and man, we have been ungrateful for the good done to us];",
    "14": "We have stolen; We have slandered.",
    "15": "We have caused others to sin;",
    "16": "We have caused others to commit sins for which they are called רְשָׁעִים, wicked;",
    "17": "We have sinned with malicious intent;",
    "18": "We have forcibly taken other's possessions even though we paid for them;",
    "19": "We have added falsehood upon falsehood; we have joined with evil individuals or groups.",
    "20": "We have given harmful advice;",
    "21": "We have deceived; We have mocked;",
    "22": "We have rebelled against God and His Torah;",
    "23": "We have caused God to be angry with us;",
    "24": "We have turned away from God's Torah;",
    "25": "We have sinned deliberately;",
    "26": "We have been negligent in our performance of the commandments;",
    "27": "We have caused our friends grief;",
    "28": "We have been stiff-necked, refusing to admit that the cause of our suffering is our own sins.",
    "29": "We have committed sins for which we are called רָשָׁע [raising a hand to hit someone].",
    "30": "We have committed sins which are the result of moral corruption;",
    "31": "We have committed sins which the Torah refers to as abominations;",
    "32": "We have gone astray;",
    "33": "We have led others astray.",
    "34": "We have turned away",
    "35": "from Your commandments",
    "36": "and from Your good laws,",
    "37": "and we have gained nothing from it.",
    "38": "And You are the Righteous One",
    "39": "in all [punishment] that has come upon us;",
    "40": "for You have acted truthfully",
    "41": "and we have acted wickedly.",
    "42": "You are Almighty, Slow to anger,",
    "43": "Lord of Mercy, You are called,",
    "44": "and the way of repentance,",
    "45": "You have taught us.",
    "46": "The greatness of Your mercy and kindness,",
    "47": "remember this day and every day",
    "48": "for the descendants of Your loved ones.",
    "49": "Turn to us with compassion",
    "50": "for You are the Lord of Mercy.",
    "51": "With supplication and prayer",
    "52": "we approach Your Presence,",
    "53": "as You made know",
    "54": "to [Moses,] the modest one of old.",
    "55": "From Your fierce anger turn,",
    "56": "as it is written in Your Torah:",
    "57": "In the shadow of Your wings,",
    "58": "may we be sheltered and lodged,",
    "59": "as on the day [of which it is said:]",
    "60": "When Adonoy descended in the cloud.",
    "61": "Remove [our] transgression,",
    "62": "and blot out [our] iniquity,",
    "63": "as on the day [of which it is said:]",
    "64": "And He stood with him there.",
    "65": "Give ear to our cry",
    "66": "and listen to our speech,",
    "67": "as on the day [of which it is said:]",
    "68": "And He proclaimed in the Name, Adonoy",
    "69": "And there it is said:",
    "70": "<small><i>Congregation and Chazzan:</i></small>",
    "71": "And Adonoy passed before him [Moses]",
    "72": "and proclaimed:",
    "73": "Adonoy, Adonoy,",
    "74": "Almighty, Merciful, Gracious,",
    "75": "Slow to Anger,",
    "76": "and Abundant in Kindness and Truth.",
    "77": "Keeper of kindness",
    "78": "for thousands of generations,",
    "79": "Endurer of iniquity and transgression,",
    "80": "and sin,",
    "81": "and Acquitter of those who repent.",
    "82": "And pardon our iniquity and our sin,",
    "83": "and take us for Your inheritance.",
    "84": "Pardon us,our Father, for we have sinned,",
    "85": "forgive us, our King, for we have transgressed.",
    "86": "For You, my Master,",
    "87": "are good and forgiving,",
    "88": "and abounding in kindness",
    "89": "to all who call upon You.",
    "90": "<small>The following supplication is recited while resting your brow on your arm.</small>",
    "91": "And David said to Gad (II Samuel 24:14),",
    "92": "I am greatly distressed;",
    "93": "let us fall into the hand of Adonoy",
    "94": "for His mercies are great,",
    "95": "but into the hand of man let me not fall.\"",
    "96": "Merciful and gracious One,",
    "97": "I have sinned before You;",
    "98": "Adonoy, full of mercy,",
    "99": "have compassion upon me",
    "100": "and accept my supplications.",
    "101": "Adonoy, do not rebuke me with Your anger,",
    "102": "nor chastise me with Your rage.",
    "103": "Be gracious unto me, Adonoy,",
    "104": "for I am desolate,",
    "105": "heal me Adonoy, for my bones are terrified.",
    "106": "My soul, [too,] is utterly terrified,",
    "107": "and You Adonoy, how long?",
    "108": "Return Adonoy, free my soul,",
    "109": "deliver me",
    "110": "for the sake of Your lovingkindness.",
    "111": "For in death there is no mention of You;",
    "112": "in the lower world who will thank You.",
    "113": "I am worn out with my sighing,",
    "114": "every night I cause my bed to float;",
    "115": "with my tears, I melt my couch.",
    "116": "My eye is dimmed from anger,",
    "117": "it has aged because of my tormentors.",
    "118": "Depart from me, all you evildoers,",
    "119": "for Adonoy has heard",
    "120": "the voice of my weeping.",
    "121": "Adonoy has heard my supplication,",
    "122": "Adonoy will (also) accept my prayer.",
    "123": "Ashamed and utterly terrified",
    "124": "will all my foes be,",
    "125": "they will return",
    "126": "and be instantaneously ashamed."
   }
  },
  "Weekday Siddur Sefard Linear, The Morning Prayers, Vehu Rachum": {
   "edition": "metsudah-sefard-weekday",
   "he": {
    "6": "וְהוּא רַחוּם",
    "7": "יְכַפֵּר עָוֺן וְלֹא־יַשְׁחִית",
    "8": "וְהִרְבָּה לְהָשִׁיב אַפּוֹ",
    "9": "וְלֹא־יָעִיר כָּל־חֲמָתוֹ:",
    "10": "אַתָּה יְהֹוָה",
    "11": "לֺא תִכְלָא רַחֲמֶֽיךָ מִמֶּֽנּוּ",
    "12": "חַסְדְּ֒ךָ וַאֲמִתְּ֒ךָ",
    "13": "תָּמִיד יִצְ֒רֽוּנוּ:",
    "14": "הוֹשִׁיעֵֽנוּ יְהֹוָה אֱלֺהֵֽינוּ",
    "15": "וְקַבְּ֒צֵֽנוּ מִן־הַגּוֹיִם",
    "16": "לְהוֹדוֹת לְשֵׁם קָדְשֶֽׁךָ",
    "17": "לְהִשְׁתַּבֵּֽחַ בִּתְ֒הִלָּתֶֽךָ:",
    "18": "אִם־עֲוֺנוֹת תִּשְׁמָר־יָהּ",
    "19": "אֲדֹנָי מִי יַעֲמֹד:",
    "20": "כִּי־עִמְּ֒ךָ הַסְּ֒לִיחָה",
    "21": "לְמַֽעַן תִּוּרֵא:",
    "22": "לֺא כַחֲטָאֵֽינוּ תַּעֲשֶׂה־לָּֽנוּ",
    "23": "וְלֹא כַעֲוֺנֹתֵֽינוּ תִּגְמֹל עָלֵֽינוּ:",
    "24": "אִם־עֲוֺנֵֽינוּ עָֽנוּ בָֽנוּ",
    "25": "יְהֹוָה",
    "26": "עֲשֵׂה לְמַֽעַן שְׁמֶֽךָ:",
    "27": "זְכָר־רַחֲמֶֽיךָ יְהֹוָה",
    "28": "וַחֲסָדֶֽיךָ",
    "29": "כִּי",
    "30": "מֵעוֹלָם הֵֽמָּה:",
    "31": "יַעֲנֵֽנוּ יְהֹוָה בְּיוֹם צָרָה",
    "32": "יְשַׂגְּ֒בֵֽנוּ שֵׁם אֱלֺהֵי יַעֲקֹב:",
    "33": "יְהֹוָה הוֹשִֽׁיעָה",
    "34": "הַמֶּֽלֶךְ יַעֲנֵֽנוּ בְיוֹם־קָרְאֵֽנוּ:",
    "35": "אָבִֽינוּ מַלְכֵּֽנוּ חָנֵּֽנוּ וַעֲנֵֽנוּ",
    "36": "כִּי אֵין בָּֽנוּ מַעֲשִׂים",
    "37": "עֲשֵׂה עִמָּֽנוּ צְדָקָה",
    "38": "כְּרוֹב רַחֲמֶֽיךָ",
    "39": "וְהוֹשִׁיעֵֽנוּ לְמַֽעַן שְׁמֶֽךָ:",
    "40": "אֲדוֹנֵֽינוּ אֱלֺהֵֽינוּ",
    "41": "שְׁמַע קוֹל תַּחֲנוּנֵֽינוּ",
    "42": "וּזְ֒כָר־לָֽנוּ",
    "43": "אֶת־בְּרִית אֲבוֹתֵֽינוּ",
    "44": "וְהוֹשִׁיעֵֽנוּ לְמַֽעַן שְׁמֶֽךָ:",
    "45": "וְעַתָּה אֲדֹנָי אֱלֺהֵֽינוּ",
    "46": "אֲשֶׁר הוֹצֵֽאתָ אֶת־עַמְּ֒ךָ",
    "47": "מֵאֶֽרֶץ מִצְרַֽיִם בְּיָד חֲזָקָה",
    "48": "וַתַּֽעַשׂ־לְךָ שֵׁם כַּיּוֹם הַזֶּה",
    "49": "חָטָֽאנוּ רָשָֽׁעְנוּ:",
    "50": "אֲדֹנָי כְּכָל־צִדְ֒קֹתֶֽיךָ",
    "51": "יָֽשָׁב־נָא אַפְּ֒ךָ וַחֲמָתְ֒ךָ",
    "52": "מֵעִירְ֒ךָ יְרוּשָׁלַֽםִ",
    "53": "הַר־קָדְשֶֽׁךָ",
    "54": "כִּי בַחֲטָאֵֽינוּ",
    "55": "וּבַעֲוֺנוֹת אֲבֹתֵֽינוּ",
    "56": "יְרוּשָׁלַֽםִ וְעַמְּ֒ךָ",
    "57": "לְחֶרְפָּה",
    "58": "לְכָל־סְבִיבֹתֵֽינוּ:",
    "59": "וְעַתָּה שְׁמַע אֱלֺהֵֽינוּ",
    "60": "אֶל־תְּפִלַּת עַבְדְּךָ",
    "61": "וְאֶל־תַּחֲנוּנָיו",
    "62": "וְהָאֵר פָּנֶֽיךָ",
    "63": "עַל־מִקְדָּשְׁ֒ךָ הַשָּׁמֵם",
    "64": "לְמַֽעַן אֲדֹנָי:",
    "65": "הַטֵּה אֱלֺהַי אָזְנְךָ וּשְׁ֒מָע",
    "66": "פְּקַח עֵינֶֽיךָ",
    "67": "וּרְ֒אֵה שֹׁמְ֒מוֹתֵֽינוּ",
    "68": "וְהָעִיר אֲשֶׁר־נִקְרָא שִׁמְךָ עָלֶֽיהָ",
    "69": "כִּי לֺא עַל־צִדְ֒קֹתֵֽינוּ",
    "70": "אֲנַֽחְנוּ מַפִּילִים תַּחֲנוּנֵֽינוּ לְפָנֶֽיךָ",
    "71": "כִּי עַל־רַחֲמֶֽיךָ הָרַבִּים:",
    "72": "אֲדֹנָי שְׁמָֽעָה אֲדֹנָי סְלָֽחָה",
    "73": "אֲדֹנָי הַקְשִֽׁיבָה וַעֲשֵׂה",
    "74": "אַל־תְּאַחַר:",
    "75": "לְמַעַנְ֒ךָ אֱלֺהַי",
    "76": "כִּי־שִׁמְךָ נִקְרָא",
    "77": "עַל־עִירְ֒ךָ וְעַל־עַמֶּֽךָ:",
    "78": "אָבִֽינוּ אָב הָרַחֲמָן",
    "79": "הַרְאֵֽנוּ אוֹת לְטוֹבָה",
    "80": "וְקַבֵּץ נְפוּצוֹתֵֽינוּ",
    "81": "מֵאַרְבַּע כַּנְ֒פוֹת הָאָֽרֶץ:",
    "82": "יַכִּֽירוּ וְיֵדְ֒עוּ כָּל־הַגּוֹיִם",
    "83": "כִּי אַתָּה יְהֹוָה אֱלֺהֵֽינוּ:",
    "84": "וְעַתָּה יְהֹוָה אָבִֽינוּ אָֽתָּה",
    "85": "אֲנַֽחְנוּ הַחֹֽמֶר וְאַתָּה יֹצְ֒רֵֽנוּ",
    "86": "וּמַעֲשֵׂה יָדְ֒ךָ כֻּלָּֽנוּ:",
    "87": "הוֹשִׁיעֵֽנוּ לְמַֽעַן שְׁמֶֽךָ",
    "88": "אָבִֽינוּ מַלְכֵּֽנוּ",
    "89": "צוּרֵֽנוּ וְגוֹאֲלֵֽנוּ:",
    "90": "חֽוּסָה יְהֹוָה עַל־עַמֶּֽךָ",
    "91": "וְאַל־תִּתֵּן נַחֲלָתְ֒ךָ",
    "92": "לְחֶרְפָּה",
    "93": "לִמְשָׁל־בָּם גּוֹיִם:",
    "94": "לָֽמָּה יֹאמְ֒רוּ בָעַמִּים",
    "95": "אַיֵּה (נָא) אֱלֺהֵיהֶם:",
    "96": "יָדַֽעְנוּ יְהֺוָה כִּי חָטָֽאנוּ",
    "97": "וְאֵין מִי יַעֲמֹד בַּעֲדֵֽנוּ",
    "98": "אֶלָּא שִׁמְךָ הַגָּדוֹל יַעֲמָד־לָֽנוּ",
    "99": "בְּעֵת צָרָה:",
    "100": "יָדַֽעְנוּ כִּי אֵין בָּֽנוּ מַעֲשִׂים",
    "101": "צְדָקָה עֲשֵׂה עִמָּֽנוּ",
    "102": "לְמַֽעַן שְׁמֶֽךָ:",
    "103": "כְּרַחֵם אָב עַל־בָּנִים",
    "104": "כֵּן תְּרַחֵם יְהֹוָה עָלֵֽינוּ",
    "105": "וְהוֹשִׁיעֵֽנוּ",
    "106": "לְמַֽעַן שְׁמֶֽךָ:",
    "107": "חֲמוֹל עַל עַמֶּֽךָ",
    "108": "רַחֵם עַל נַחֲלָתֶֽךָ",
    "109": "חֽוּסָה־נָּא כְּרוֹב רַחֲמֶֽיךָ",
    "110": "חָנֵּֽנוּ מַלְכֵּֽנוּ וַעֲנֵֽנוּ",
    "111": "כִּי לְךָ יְהֹוָה הַצְּ֒דָקָה",
    "112": "עֹשֵׂה נִפְלָאוֹת בְּכָל עֵת:",
    "113": "הַבֶּט־נָא",
    "114": "רַחֶם־נָא",
    "115": "וְהוֹשִֽׁיעָה־נָא צֹאן מַרְעִיתֶֽךָ",
    "116": "וְאַל יִמְשָׁל־בָּֽנוּ קֶֽצֶף",
    "117": "כִּי לְךָ יְהֹוָה הַיְ֒שׁוּעָה:",
    "118": "בְּךָ תוֹחַלְתֵּֽנוּ אֱלֽוֹהַּ סְלִיחוֹת",
    "119": "אָנָּא סְלַח־נָא",
    "120": "כִּי אֵל טוֹב וְסַלָּח אָֽתָּה:",
    "121": "אָנָּא",
    "122": "מֶֽלֶךְ חַנוּן וְרַחוּם",
    "123": "זְכוֹר וְהַבֵּט",
    "124": "לִבְ֒רִית בֵּין הַבְּ֒תָרִים",
    "125": "וְתֵרָאֶה לְפָנֶֽיךָ",
    "126": "עֲקֵדַת יָחִיד",
    "127": "וּלְ֒מַֽעַן יִשְׂרָאֵל אָבִֽינוּ:",
    "128": "אַל־תַּעַזְ֒בֵֽנוּ אָבִֽינוּ",
    "129": "וְאַל־תִּטְּ֒שֵֽׁנוּ מַלְכֵּֽנוּ",
    "130": "וְאַל־תִּשְׁכָּחֵֽנוּ יוֹצְ֒רֵֽנוּ",
    "131": "וְאַל־תַּֽעַשׁ עִמָּֽנוּ כָּלָה",
    "132": "בְּגָלוּתֵֽנוּ",
    "133": "כִּי אֵל",
    "134": "מֶֽלֶךְ חַנּוּן וְרַחוּם אָֽתָּה:",
    "135": "אֵין כָּמֽוֹךָ",
    "136": "חַנּוּן וְרַחוּם",
    "137": "יְהֹוָה אֱלֺהֵֽינוּ",
    "138": "אֵין כָּמֽוֹךָ",
    "139": "אֵל אֶֽרֶךְ אַפַּֽיִם",
    "140": "וְרַב חֶֽסֶד וֶאֱמֶת:",
    "141": "הוֹשִׁיעֵֽנוּ וְרַחֲמֵֽנוּ",
    "142": "בְּרַחֲמֶֽיךָ הָרַבִּים",
    "143": "מֵרַֽעַשׁ וּמֵרֺֽגֶז הַצִּילֵֽנוּ:",
    "144": "זְכֺר לַעֲבָדֶֽיךָ",
    "145": "לְאַבְרָהָם לְיִצְחָק וּלְ֒יַעֲקֹב",
    "146": "אַל־תֵּֽפֶן",
    "147": "אֶל־קְשִׁי הָעָם הַזֶּה",
    "148": "וְאֶל־רִשְׁעוֹ וְאֶל־חַטָּאתוֹ:",
    "149": "שׁוּב מֵחֲרוֹן אַפֶּֽךָ",
    "150": "וְהִנָּחֵם",
    "151": "עַל־הָרָעָה",
    "152": "לְעַמֶּֽךָ:",
    "153": "וְהָסֵר מִמֶּֽנּוּ מַכַּת הַמָּֽוֶת",
    "154": "כִּי רַחוּם אָֽתָּה:",
    "155": "כִּי כֵן דַּרְכֶּֽךָ",
    "156": "עֹשֶׂה חֶֽסֶד חִנָּם",
    "157": "בְּכָל־דּוֹר וָדוֹר:",
    "158": "חֽוּסָה יְהֹוָה עַל־עַמֶּֽךָ",
    "159": "וְהַצִּילֵֽנוּ מִזַּעְמֶֽךָ:",
    "160": "וְהָסֵר מִמֶּֽנּוּ מַכַּת הַמַּגֵּפָה",
    "161": "וּגְ֒זֵרָה קָשָׁה",
    "162": "כִּי אַתָּה שׁוֹמֵר יִשְׂרָאֵל:",
    "163": "לְךָ אֲדֹנָי הַצְּ֒דָקָה",
    "164": "וְלָֽנוּ בּֽשֶׁת הַפָּנִים:",
    "165": "מַה־נִּתְאוֹנֵן",
    "166": "וּמַה־נֹּאמַר",
    "167": "מַה־נְּדַבֵּר",
    "168": "וּמַה־נִּצְטַּדָּק:",
    "169": "נַחְפְּשָׂה דְרָכֵֽינוּ",
    "170": "וְנַחְקֺֽרָה",
    "171": "וְנָשֽׁוּבָה אֵלֶֽיךָ",
    "172": "כִּי יְמִינְ֒ךָ פְשׁוּטָה",
    "173": "לְקַבֵּל שָׁבִים:",
    "174": "אָֽנָּא יְהֹוָה הוֹשִֽׁיעָה נָּא",
    "175": "אָֽנָּא יְהֹוָה הַצְלִיחָה נָא:",
    "176": "אָֽנָּא יְהֹוָה",
    "177": "עֲנֵֽנוּ בְיוֹם קָרְאֵֽנוּ:",
    "178": "לְךָ יְהֹוָה חִכִּֽינוּ",
    "179": "לְךָ יְהֹוָה קִוּינוּ",
    "180": "לְךָ יְהֹוָה נְיַחֵל",
    "181": "אַל תֶּחֱשֶׁה",
    "182": "וּתְ֒עַנֵּֽנוּ",
    "183": "כִּי נָאֲמוּ גוֹיִם אָבְ֒דָה תִקְוָתָם:",
    "184": "כָּל־בֶּֽרֶךְ לְךָ תִכְרַע",
    "185": "וְכָל־קוֹמָה",
    "186": "לְפָנֶֽיךָ לְבַד תִּשְׁתַּחֲוֶה:",
    "187": "הַפּוֹתֵֽחַ יָד",
    "188": "בִּתְ֒שׁוּבָה",
    "189": "לְקַבֵּל פּוֹשְׁ֒עִים וְחַטָּאִים",
    "190": "נִבְהֲלָה נַפְשֵֽׁנוּ מֵרוֹב עִצְּ֒בוֹנֵֽנוּ",
    "191": "אַל־תִּשְׁכָּחֵֽנוּ נֶֽצַח",
    "192": "קֽוּמָה וְהוֹשִׁיעֵֽנוּ:",
    "193": "אַל־תִּשְׁפּוֹךְ חֲרוֹנְ֒ךָ עָלֵֽינוּ",
    "194": "כִּי אֲנַֽחְנוּ עַמְּ֒ךָ",
    "195": "בְּנֵי בְרִיתֶֽךָ:",
    "196": "אֵל הַבִּֽיטָה",
    "197": "דַּל כְּבוֹדֵֽנוּ בַּגּוֹיִם",
    "198": "וְשִׁקְּ֒צֽוּנוּ",
    "199": "כְּטֻמְאַת הַנִּדָּה:",
    "200": "עַד־מָתַי עֻזְּ֒ךָ בַּשְּׁ֒בִי",
    "201": "וְתִפְאַרְתְּ֒ךָ בְּיַד־צָר:",
    "202": "עוֹרְ֒רָה גְבוּרָתְ֒ךָ וְהוֹשִׁעֵֽנוּ",
    "203": "לְמַֽעַן שְׁמֶֽךָ:",
    "204": "אַל־יִמְעֲטוּ לְפָנֶֽיךָ תְּלָאוֹתֵֽינוּ:",
    "205": "מַהֵר יְקַדְּ֒מֽוּנוּ רַחֲמֶֽיךָ",
    "206": "בְּעֵת צָרוֹתֵֽינוּ,",
    "207": "לֺא לְמַעֲנֵֽנוּ",
    "208": "אֶלָּא לְמַעַנְ֒ךָ פְעַל,",
    "209": "וְאַל תַּשְׁחִית",
    "210": "אֶת־זֵֽכֶר שְׁאֵרִיתֵֽנוּ,",
    "211": "כִּי לְךָ מְיַחֲלוֹת עֵינֵֽינוּ",
    "212": "כִּי אֵל",
    "213": "מֶֽלֶךְ חַנוּן וְרַחוּם אָֽתָּה:",
    "214": "וּזְ֒כוֹר עֵדוּתֵֽנוּ",
    "215": "בְּכָל־יוֹם תָּמִיד אוֹמְ֒רִים",
    "216": "פַּעֲמַֽיִם בְּאַהֲבָה:",
    "217": "שְׁמַע יִשְׂרָאֵל",
    "218": "יְהֹוָה אֱלֺהֵֽינוּ",
    "219": "יְהֹוָה אֶחָד:",
    "220": "יְהֹוָה אֱלֺהֵי יִשְׂרָאֵל",
    "221": "שׁוּב מֵחֲרוֹן אַפֶּֽךָ",
    "222": "וְהִנָּחֵם",
    "223": "עַל־הָרָעָה",
    "224": "לְעַמֶּֽךָ:",
    "225": "הַבֵּט מִשָּׁמַֽיִם וּרְ֒אֵה",
    "226": "כִּי הָיִֽינוּ",
    "227": "לַֽעַג וָקֶֽלֶס",
    "228": "בַּגּוֹיִם:",
    "229": "נֶחְשַֽׁבְנוּ כַּצֹּאן",
    "230": "לָטֶֽבַח יוּבָל,",
    "231": "לַהֲרוֹג וּלְ֒אַבֵּד",
    "232": "וּלְ֒מַכָּה וּלְ֒חֶרְפָּה:",
    "233": "וּבְכָל־זֹאת",
    "234": "שִׁמְךָ לֺא שָׁכָֽחְנוּ",
    "235": "נָא אַל־תִּשְׁכָּחֵֽנוּ:",
    "236": "יְהֹוָה אֱלֺהֵי יִשְׂרָאֵל",
    "237": "שׁוּב מֵחֲרוֹן אַפֶּֽךָ",
    "238": "וְהִנָּחֵם",
    "239": "עַל־הָרָעָה לְעַמֶּֽךָ:",
    "240": "זָרִים אוֹמְ֒רִים",
    "241": "אֵין תּוֹחֶֽלֶת וְתִקְוָה:",
    "242": "חוֹן אוֹם",
    "243": "לְשִׁמְךָ מְקַוּה:",
    "244": "טָהוֹר, יְשׁוּעָתֵֽנוּ קָרְ֒בָה,",
    "245": "יָגַֽעְנוּ וְלֺא הֽוּנַח־לָֽנוּ:",
    "246": "רַחֲמֶֽיךָ",
    "247": "יִכְבְּ֒שׁוּ אֶת־כַּעַסְ֒ךָ מֵעָלֵֽינוּ:",
    "248": "אָנָּא שׁוּב מֵחֲרוֹנְ֒ךָ",
    "249": "וְרַחֵם סְגֻלָּה",
    "250": "אֲשֶׁר בָּחָֽרְתָּ:",
    "251": "יְהֹוָה אֱלֺהֵי יִשְׂרָאֵל",
    "252": "שׁוּב מֵחֲרוֹן אַפֶּֽךָ",
    "253": "וְהִנָּחֵם",
    "254": "עַל־הָרָעָה לְעַמֶּֽךָ:",
    "255": "חֽוּסָה יְהֹוָה עָלֵֽינוּ בְּרַחֲמֶֽיךָ,",
    "256": "וְאַל תִּתְּ֒נֵֽנוּ בִּידֵי אַכְזָרִים:",
    "257": "לָֽמָּה יֹאמְ֒רוּ הַגּוֹיִם",
    "258": "אַיֵּה־נָא אֱלֺהֵיהֶם",
    "259": "לְמַעַנְ֒ךָ עֲשֵׂה עִמָּֽנוּ חֶֽסֶד",
    "260": "וְאַל תְּאַחַר:",
    "261": "אָנָּא שׁוּב מֵחֲרוֹנְ֒ךָ",
    "262": "וְרַחֵם סְגֻלָּה",
    "263": "אֲשֶׁר בָּחָֽרְתָּ:",
    "264": "יְהֹוָה אֱלֺהֵי יִשְׂרָאֵל",
    "265": "שׁוּב מֵחֲרוֹן אַפֶּֽךָ",
    "266": "וְהִנָּחֵם",
    "267": "עַל־הָרָעָה לְעַמֶּֽךָ:",
    "268": "קוֹלֵֽנוּ תִשְׁמַע וְתָחוֹן",
    "269": "וְאַל־תִּטְּ֒שֵֽׁנוּ",
    "270": "בְּיַד אֹיְ֒בֵֽינוּ",
    "271": "לִמְחוֹת אֶת־שְׁמֵֽנוּ:",
    "272": "זְכוֹר",
    "273": "אֲשֶׁר נִשְׁבַּֽעְתָּ לַאֲבוֹתֵֽינוּ,",
    "274": "כְּכוֹכְ֒בֵי הַשָּׁמַֽיִם",
    "275": "אַרְבֶּה אֶת־זַרְעֲכֶם",
    "276": "וְעַתָּה נִשְׁאַֽרְנוּ מְעַט מֵהַרְבֵּה:",
    "277": "וּבְכָל־זֹאת",
    "278": "שִׁמְךָ לֺא שָׁכָֽחְנוּ",
    "279": "נָא אַל תִּשְׁכָּחֵֽנוּ:",
    "280": "יְהֹוָה אֱלֺהֵי יִשְׂרָאֵל",
    "281": "שׁוּב מֵחֲרוֹן אַפֶּֽךָ",
    "282": "וְהִנָּחֵם",
    "283": "עַל־הָרָעָה לְעַמֶּֽךָ:",
    "284": "עָזְ֒רֵֽנוּ אֱלֺהֵי יִשְׁעֵֽנוּ",
    "285": "עַל־דְּבַר כְּבוֹד־שְׁמֶֽךָ",
    "286": "וְהַצִּילֵֽנוּ וְכַפֵּר עַל־חַטֹּאתֵֽינוּ",
    "287": "לְמַֽעַן שְׁמֶֽךָ:",
    "288": "יְהֹוָה אֱלֺהֵי יִשְׂרָאֵל",
    "289": "שׁוּב מֵחֲרוֹן אַפֶּֽךָ",
    "290": "וְהִנָּחֵם",
    "291": "עַל־הָרָעָה לְעַמֶּֽךָ:",
    "292": "שׁוֹמֵר יִשְׂרָאֵל",
    "293": "שְׁמוֹר שְׁאֵרִית יִשְׂרָאֵל",
    "294": "וְאַל יֹאבַד יִשְׂרָאֵל",
    "295": "הָאֹמְ֒רִים שְׁמַע יִשְׂרָאֵל:",
    "296": "שׁוֹמֵר גּוֹי אֶחָד",
    "297": "שְׁמוֹר שְׁאֵרִית עַם אֶחָד",
    "298": "וְאַל יֹאבַד גּוֹי אֶחָד",
    "299": "הַמְ֒יַחֲדִים שִׁמְךָ",
    "300": "יְהֹוָה אֱלֺהֵֽינוּ יְהֹוָה אֶחָד:",
    "301": "שׁוֹמֵר גּוֹי קָדוֹשׁ",
    "302": "שְׁמוֹר שְׁאֵרִית עַם קָדוֹשׁ",
    "303": "וְאַל יֹאבַד גּוֹי קָדוֹשׁ",
    "304": "הַמְ֒שַׁלְּ֒שִׁים בְּשָׁלשׁ קְדֻשּׁוֹת",
    "305": "לְקָדוֹשׁ:",
    "306": "מִתְרַצֶּה בְּרַחֲמִים",
    "307": "וּמִתְפַּיֵּס בְּתַחֲנוּנִים",
    "308": "הִתְרַצֶּה וְהִתְפַּיֵּס",
    "309": "לְדוֹר עָנִי",
    "310": "כִּי אֵין עוֹזֵר:",
    "311": "אָבִֽינוּ מַלְכֵּֽנוּ",
    "312": "חָנֵּֽנוּ וַעֲנֵֽנוּ",
    "313": "כִּי אֵין בָּֽנוּ מַעֲשִׂים",
    "314": "עֲשֵׂה עִמָּֽנוּ צְדָקָה וָחֶֽסֶד",
    "315": "וְהוֹשִׁיעֵֽנוּ:",
    "316": "וַאֲנַֽחְנוּ לֺא נֵדַע מַה נַּעֲשֶׂה",
    "317": "כִּי עָלֶֽיךָ עֵינֵֽינוּ:",
    "318": "זְכֹר רַחֲמֶֽיךָ יְהֹוָה",
    "319": "וַחֲסָדֶֽיךָ",
    "320": "כִּי",
    "321": "מֵעוֹלָם הֵֽמָּה:",
    "322": "יְהִי חַסְדְּ֒ךָ יְהֹוָה עָלֵֽינוּ",
    "323": "כַּאֲשֶׁר יִחַֽלְנוּ לָךְ:",
    "324": "אַל תִּזְכָּר לָֽנוּ עֲוֹנוֹת רִאשׁוֹנִים",
    "325": "מַהֵר יְקַדְּ֒מֽוּנוּ רַחֲמֶֽיךָ",
    "326": "כִּי דַלּֽוֹנוּ מְאֹד:",
    "327": "עֶזְרֵֽנוּ בְּשֵׁם יְהֹוָה",
    "328": "עֹשֵׂה שָׁמַֽיִם וְאָֽרֶץ:",
    "329": "חָנֵּֽנוּ יְהֹוָה חָנֵּֽנוּ",
    "330": "כִּי־רַב שָׂבַֽעְנוּ בוּז:",
    "331": "בְּרֺֽגֶז",
    "332": "רַחֵם תִּזְכּוֹר:",
    "333": "בְּרֹֽגֶז",
    "334": "עַקֵדָה תִּזְכּוֹר,",
    "335": "בְּרֹֽגֶז",
    "336": "תְּמִימוֹת תִּזְכּוֹר:",
    "337": "יְהֹוָה הוֹשִֽׁיעָה,",
    "338": "הַמֶּֽלֶךְ יַעֲנֵֽנוּ בְיוֹם קָרְאֵֽנוּ:",
    "339": "כִּי הוּא יָדַע יִצְרֵֽנוּ",
    "340": "זָכוּר כִּי עָפָר אֲנָֽחְנוּ:",
    "341": "עָזְ֒רֵֽנוּ אֱלֺהֵי יִשְׁעֵֽנוּ",
    "342": "עַל־דְּבַר כְּבוֹד־שְׁמֶֽךָ",
    "343": "וְהַצִּילֵֽנוּ וְכַפֵּר עַל־חַטֹּאתֵֽינוּ",
    "344": "לְמַֽעַן שְׁמֶֽךָ:"
   },
   "en": {
    "1": "<small><i>The following prayers are added on Mondays and Thursday. On other days, continue \"Guardian of Israel. . .\":</i></small>",
    "6": "And He, the merciful One,",
    "7": "will atone iniquity, and will not destroy,",
    "8": "He frequently withdraws His anger,",
    "9": "and does not arouse all His rage.",
    "10": "You, Adonoy,",
    "11": "do not withhold Your mercy from us;",
    "12": "may Your kindness and truth",
    "13": "always protect us.",
    "14": "Deliver us, Adonoy, our God,",
    "15": "and gather us from among the nations",
    "16": "to give thanks to Your holy Name",
    "17": "to be extolled in Your praise.",
    "18": "If You, God, should preserve iniquities,",
    "19": "my Master, who could survive?",
    "20": "But with You there is forgiveness,",
    "21": "[in order] that You may be feared.",
    "22": "Do not deal with us according to our sins",
    "23": "nor repay us according to our iniquities.",
    "24": "If our iniquities testify against us,",
    "25": "Adonoy,",
    "26": "act [mercifully] for Your Name's sake.",
    "27": "Remember Your mercies Adonoy,",
    "28": "and Your kindnesses,",
    "29": "for",
    "30": "they are from the beginning of the world.",
    "31": "Adonoy will answer us on the day of distress,",
    "32": "the Name of the God of Jacob will fortify us.",
    "33": "Adonoy, deliver [us];",
    "34": "the King will answer us on the day we call.",
    "35": "Our Father, our King, favor us and answer us,",
    "36": "for we have no [good] deeds;",
    "37": "deal charitably with us",
    "38": "according to Your abundant mercy",
    "39": "and deliver us for the sake of Your Name.",
    "40": "Our Master, our God,",
    "41": "heed our supplications;",
    "42": "and remember unto us",
    "43": "the covenant of our fathers,",
    "44": "and deliver us for Your Name's sake.",
    "45": "And now, my Master, our God,",
    "46": "who brought out Your people,",
    "47": "from the land of Egypt with a mighty hand,",
    "48": "and made for Yourself a name to this day;'",
    "49": "we have sinned, we have acted wickedly.",
    "50": "My Master, with all Your righteousness",
    "51": "turn away Your anger and Your rage",
    "52": "from Your city, Jerusalem,",
    "53": "Your holy mountain;",
    "54": "for because of our sins",
    "55": "and the iniquities of our fathers,",
    "56": "Jerusalem and Your people",
    "57": "are [held] in contempt",
    "58": "by all who surround us.",
    "59": "And now, listen our God,",
    "60": "to the prayers of Your servant",
    "61": "and to his supplications;",
    "62": "and let Your radiant countenance shine",
    "63": "upon Your desolate Sanctuary",
    "64": "for Your sake, my Master.",
    "65": "Incline Your ear, my God, and hear;",
    "66": "open Your eyes",
    "67": "and behold our desolate places",
    "68": "and the city which is called by Your Name,",
    "69": "for it is not on account of our righteousness",
    "70": "that we let fall our supplications before You,",
    "71": "but because of Your great mercy.",
    "72": "My Master, hear! my Master, forgive!",
    "73": "my Master, listen and take action,",
    "74": "do not delay!",
    "75": "For Your sake, my God,",
    "76": "for Your Name is proclaimed",
    "77": "over Your city and Your people.",
    "78": "Our Father, merciful Father,",
    "79": "show us a sign for good",
    "80": "and gather our dispersed [people]",
    "81": "from the four corners of the earth,",
    "82": "[so that] all nations will recognize and know",
    "83": "that You, Adonoy, are our God.",
    "84": "And now, Adonoy, You are our Father;",
    "85": "we are the clay and You are our Former;",
    "86": "and we are all the work of Your hand.",
    "87": "Deliver us, for Your Name's sake",
    "88": "our Father, our King,",
    "89": "our Rock and our Redeemer.",
    "90": "Adonoy, spare Your people,",
    "91": "and let not Your heritage",
    "92": "be [an object] of contempt",
    "93": "for nations to rule over.",
    "94": "Why should they say among the peoples,",
    "95": "Where is their God?",
    "96": "Adonoy, we know that we have sinned,",
    "97": "and there is none to stand up in our behalf;",
    "98": "let Your great Name, then, stand up for us",
    "99": "at the time of distress.",
    "100": "We know that we have no [good] deeds,",
    "101": "[therefore] deal charitably with us",
    "102": "for Your Name's sake.",
    "103": "As a father has compassion on his children,",
    "104": "so do You have compassion on us, Adonoy,",
    "105": "and [therefore] deliver us",
    "106": "for Your Name's sake.",
    "107": "Have pity on Your people,",
    "108": "have compassion on Your heritage,",
    "109": "spare us with Your great mercy;",
    "110": "favor us. our King, and answer us,",
    "111": "for righteousness is Yours, Adonoy,",
    "112": "Who performs wonders at all times.",
    "113": "Look, we beseech You,",
    "114": "speedily have compassion",
    "115": "and deliver the sheep of Your pasture;",
    "116": "let wrath not prevail over us,",
    "117": "for, Adonoy, deliverance is Yours.",
    "118": "Our hope rests with You, God of forgiveness;",
    "119": "please forgive [us],",
    "120": "for You Almighty, are good, and forgiving.",
    "121": "We beseech You,",
    "122": "gracious and compassionate King,",
    "123": "remember and look",
    "124": "to the Covenant between the divided pieces,",
    "125": "and let appear before You",
    "126": "the binding [upon the Altar] of the only son,",
    "127": "and for the sake of Israel, our father.",
    "128": "Do not abandon us our father,",
    "129": "do not cast us off our King,",
    "130": "do not forget us our Creator,",
    "131": "and do not bring destruction upon us",
    "132": "in our exile",
    "133": "for You are the Almighty",
    "134": "who is King, gracious and merciful.",
    "135": "There is none like You,",
    "136": "gracious and merciful",
    "137": "Adonoy, our God;",
    "138": "there is none like You,",
    "139": "Almighty, slow to anger,",
    "140": "abundant in kindliness and truth.",
    "141": "Deliver us, and have mercy on us",
    "142": "with Your great mercy,",
    "143": "save us from storm and rage.",
    "144": "Remember Your servants,",
    "145": "Abraham, Isaac, and Jacob;",
    "146": "do not consider",
    "147": "the stubbornness of this people,",
    "148": "their wickedness, and their sinfulness.",
    "149": "Turn from Your fierce anger",
    "150": "and let Your mind be changed",
    "151": "concerning the evil",
    "152": "[intended] for Your people.",
    "153": "Remove from us the scourge of death,",
    "154": "for You are merciful;",
    "155": "for such is Your way—",
    "156": "to bestow undeserved kindness",
    "157": "in every generation.",
    "158": "Spare Your people, Adonoy,",
    "159": "and save us from Your wrath;",
    "160": "remove from us the scourge of plague,",
    "161": "and harsh decree,",
    "162": "for You are the Guardian of Israel.",
    "163": "Righteousness is Yours, my Master,",
    "164": "while shame is ours.",
    "165": "How can we complain?",
    "166": "What can we say?",
    "167": "What can we speak?",
    "168": "and how can we justify ourselves?",
    "169": "Let us search into our ways",
    "170": "and examine them,",
    "171": "and return to You;",
    "172": "for Your right hand is extended",
    "173": "to receive those who repent.",
    "174": "We beseech You Adonoy!—deliver us.",
    "175": "We beseech You Adonoy!—grant us success;",
    "176": "We beseech You Adonoy! —",
    "177": "answer us on the day we call.",
    "178": "For You, Adonoy, we have waited,",
    "179": "For You, Adonoy, we have hoped,",
    "180": "For You, Adonoy, we yearn.",
    "181": "Do not be silent,",
    "182": "and do not allow us to be tormented;",
    "183": "for the nations have said, \"Their hope is lost.\"",
    "184": "Let every knee bend to You",
    "185": "and all who stand erect",
    "186": "prostrate themselves before You",
    "187": "You Who opens Your hand",
    "188": "to [accept] repentance,",
    "189": "to receive transgressors and sinners:",
    "190": "our soul is terrified from our great sorrow—",
    "191": "forget us not forever;",
    "192": "arise and deliver us.",
    "193": "Do not pour out Your wrath upon us,",
    "194": "for we are Your people,",
    "195": "the children of Your covenant.",
    "196": "Almighty, look!",
    "197": "Our glory has sunk low among the nations,",
    "198": "and they abominate us",
    "199": "like the impurity of the <i>nidah.</i>",
    "200": "How long will Your strength be in captivity,",
    "201": "and Your glory, in the hand of the foe?",
    "202": "Arouse Your might and deliver us",
    "203": "for the sake of Your Name,",
    "204": "let our sufferings not seem trivial to You.",
    "205": "May Your mercy come swiftly toward us",
    "206": "in time of our distress;",
    "207": "not for our sake,",
    "208": "but do it for Your sake,",
    "209": "and do not obliterate",
    "210": "the remembrance of our remnant,",
    "211": "for our eyes look hopefully to You,",
    "212": "for You are the Almighty",
    "213": "Who is King, Gracious, and Merciful.",
    "214": "Remember our testimony",
    "215": "every day we proclaim",
    "216": "twice a day with love:",
    "217": "Hear Israel,",
    "218": "Adonoy is our God,",
    "219": "Adonoy is One.",
    "220": "Adonoy, God of Israel,",
    "221": "turn from Your fierce anger,",
    "222": "and let Your mind be changed",
    "223": "concerning the evil intended",
    "224": "for Your people.",
    "225": "Look from heaven and behold",
    "226": "that we have become",
    "227": "[an object] of scorn and derision",
    "228": "among the nations;",
    "229": "we are considered as the sheep",
    "230": "led to the slaughter",
    "231": "to be slain and destroyed,",
    "232": "tortured and humiliated.",
    "233": "And yet despite all this,",
    "234": "we have not forgotten Your Name;",
    "235": "please, do not forget us.",
    "236": "Adonoy, God of Israel,",
    "237": "turn from Your fierce anger,",
    "238": "and let Your mind be changed",
    "239": "concerning the evil intended for Your people.",
    "240": "Strangers say:",
    "241": "there is no hope or expectation [for us.]",
    "242": "Be gracious to the people",
    "243": "who place their hope in Your Name.",
    "244": "Pure One, bring our deliverance near;",
    "245": "we are weary and no relief is granted us.",
    "246": "May Your mercy",
    "247": "suppress Your anger from us.",
    "248": "We beseech You, turn from Your anger,",
    "249": "and have compassion on the treasured people",
    "250": "whom You have chosen.",
    "251": "Adonoy, God of Israel,",
    "252": "turn from Your fierce anger,",
    "253": "and let Your mind be changed",
    "254": "concerning the evil intended for Your people.",
    "255": "Adonoy, in Your mercy, spare us,",
    "256": "do not discard us in the hands of cruel foes.",
    "257": "Why should the nations say:",
    "258": "Where now is their God?",
    "259": "For Your sake, deal kindly with us",
    "260": "and do not delay.",
    "261": "We beseech You, turn from Your anger,",
    "262": "and have compassion on the treasured people",
    "263": "whom You have chosen.",
    "264": "Adonoy, God of Israel,",
    "265": "turn from Your fierce anger,",
    "266": "and let Your mind be changed",
    "267": "concerning the evil intended for Your people.",
    "268": "Hear our voice and be gracious,",
    "269": "do not cast us off",
    "270": "into the hands of our enemies",
    "271": "to obliterate our name.",
    "272": "Remember",
    "273": "what You have sworn to our fathers:",
    "274": "Like the stars of the heavens",
    "275": "will I multiply your descendants,",
    "276": "and now, we are left only a few out of many.",
    "277": "And yet despite all this,",
    "278": "we have not forgotten Your Name;",
    "279": "please, do not forget us.",
    "280": "Adonoy, God of Israel,",
    "281": "turn from Your fierce anger,",
    "282": "and let Your mind be changed",
    "283": "concerning the evil intended for Your people.",
    "284": "Help us, God of our deliverance",
    "285": "for the sake of the glory of Your Name;",
    "286": "save us and atone our sins",
    "287": "for the sake of Your Name.",
    "288": "Adonoy, God of Israel,",
    "289": "turn from Your fierce anger,",
    "290": "and let Your mind be changed",
    "291": "concerning the evil intended for Your people.",
    "292": "Guardian of Israel,",
    "293": "guard the remnant of Israel,",
    "294": "and let not Israel perish,",
    "295": "who say, \"Hear Israel.\"",
    "296": "Guardian of the unique nation,",
    "297": "guard the remnant of the unique people,",
    "298": "and let not the unique nation perish,",
    "299": "who proclaim the Oneness of Your Name,",
    "300": "[saying:] Adonoy is our God, Adonoy is One.",
    "301": "Guardian of the holy nation,",
    "302": "guard the remnant of the holy people",
    "303": "and let not the holy nation perish",
    "304": "who repeat the threefold sanctification",
    "305": "to the Holy One.",
    "306": "You Who are appeased by pleas for mercy,",
    "307": "and conciliated by supplications,",
    "308": "be appeased and conciliated",
    "309": "to an afflicted generation,",
    "310": "for there is none else to help.",
    "311": "Our Father, our King!",
    "312": "be gracious to us and answer us",
    "313": "for we have no [good] deeds,",
    "314": "deal with us charitably and kindly",
    "315": "and deliver us.",
    "316": "As for us, we know not what to do;",
    "317": "but our eyes are upon You.",
    "318": "Remember Your mercies, Adonoy,",
    "319": "and kindnesses",
    "320": "for",
    "321": "they are from the beginning of the world.",
    "322": "Adonoy! may Your kindness be upon us,",
    "323": "as we have waited for You.",
    "324": "Remember not the sins of our ancestors;",
    "325": "let Your mercy come swiftly toward us,",
    "326": "for we have been brought very low.",
    "327": "Help us for the Name of Adonoy",
    "328": "Creator of Heaven and earth.",
    "329": "Be gracious to us, Adonoy, be gracious to us",
    "330": "for we are saturated with humiliation.",
    "331": "[Even] in anger",
    "332": "remember to have compassion.",
    "333": "[Even] in anger",
    "334": "remember the binding of Isaac.",
    "335": "Even in anger",
    "336": "remember the uprightness of Jacob",
    "337": "Adonoy deliver [us]",
    "338": "the King will answer us on the day we call.",
    "339": "For He knows of what we are made;",
    "340": "He is mindful that we are but dust.",
    "341": "Help us, God of our deliverance,",
    "342": "for the sake of the glory of Your Name;",
    "343": "save us and atone our sins,",
    "344": "for the sake of Your Name."
   }
  }
 }
