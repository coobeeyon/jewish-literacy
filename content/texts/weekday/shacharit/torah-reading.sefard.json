{
 "id": "weekday/shacharit/torah-reading:sefard",
 "refs": {
  "Weekday Siddur Sefard Linear, The Morning Prayers, Reading of the Torah": {
   "edition": "metsudah-sefard-weekday",
   "he": {
    "5": "אֵל אֶֽרֶךְ אַפַּֽיִם",
    "6": "וּמָלֵא רַחֲמִים,",
    "7": "אַל־תַּסְתֵּר פָּנֶֽיךָ מִמֶּֽנוּ:",
    "8": "חֽוּסָה יְהֹוָה עַל־יִשְׂרָאֵל עַמֶּֽךָ",
    "9": "וְהַצִּילֵֽנוּ מִכָּל־רָע:",
    "10": "חָטָֽאנוּ לְךָ אָדוֹן,",
    "11": "סְלַח נָא",
    "12": "כְּרוֹב רַחֲמֶֽיךָ",
    "13": "אֵל:",
    "16": "וַיְהִי בִּנְ֒סֹֽעַ הָאָרֹן",
    "17": "וַיּֽאמֶר משֶׁה קוּמָה יְהֹוָה",
    "18": "וְיָפֻֽצוּ אֹיְ֒בֶֽיךָ",
    "19": "וְיָנֻֽסוּ מְשַׂנְאֶֽיךָ מִפָּנֶֽיךָ:",
    "20": "כִּי מִצִּיּוֹן תֵּצֵא תוֹרָה",
    "21": "וּדְ֒בַר יְהֹוָה מִירוּשָׁלָֽםִ:",
    "22": "בָּרוּךְ שֶׁנָּתַן תּוֹרָה",
    "23": "לְעַמּוֹ יִשְׂרָאֵל בִּקְ֒דֻשָּׁתוֹ:",
    "25": "בְּרִיךְ שְׁמֵהּ",
    "26": "דְּמָרֵא עָלְ֒מָא",
    "27": "בְּרִיךְ כִּתְרָךְ וְאַתְרָךְ,",
    "28": "יְהֵא רְעוּתָךְ",
    "29": "עִם עַמָּךְ יִשְׂרָאֵל לְעָלָם,",
    "30": "וּפֻרְקַן יְמִינָךְ",
    "31": "אַחֲזֵי לְעַמָּךְ בְּבֵית מַקְדְּ֒שָׁךְ",
    "32": "וּלְ֒אַמְטוּיֵי לָנָא מִטּוּב נְהוֹרָךְ",
    "33": "וּלְ֒קַבֵּל צְלוֹתָֽנָא בְּרַחֲמִין,",
    "34": "יְהֵא רַעֲוָא קֳדָמָךְ",
    "35": "דְּתוֹרִיךְ לָן חַיִּין בְּטִיבוּתָא,",
    "36": "וְלֶהֱוֵי אֲנָא פְקִידָא",
    "37": "בְּגוֹ צַדִּיקַיָּא,",
    "38": "לְמִרְחַם עָלַי",
    "39": "וּלְ֒מִנְטַר יָתִי וְיַת כָּל דִּי לִי",
    "40": "וְדִי לְעַמָּךְ יִשְׂרָאֵל,",
    "41": "אַנְתְּ הוּא",
    "42": "זָן לְכֹלָּא וּמְ֒פַרְנֵס לְכֹלָּא,",
    "43": "אַנְתְּ הוּא שַׁלִּיט עַל כֹּלָּא,",
    "44": "אַנְתְּ הוּא דְּשַׁלִּיט עַל מַלְ֒כַיָּא",
    "45": "וּמַלְכוּתָא דִּילָךְ הִיא,",
    "46": "אֲנָא עַבְדָּא",
    "47": "דְקוּדְשָׁא בְּרִיךְ הוּא",
    "48": "דְּסָגִֽידְנָא קַמֵּהּ",
    "49": "וּמִקַּמֵּהּ דִּיקַר אוֹרַיְ֒תֵהּ",
    "50": "בְּכָל עִדָּן וְעִדָּן,",
    "51": "לָא עַל אֱנָשׁ רָחִיצְנָא,",
    "52": "וְלָא עַל בַּר אֱלָהִין סָמִיכְנָא,",
    "53": "אֶלָּא בֶּאֱלָהָא דִשְׁ֒מַיָּא,",
    "54": "דְּהוּא אֱלָהָא קְשׁוֹט,",
    "55": "וְאוֹרַיְ֒תֵהּ קְשׁוֹט,",
    "56": "וּנְ֒בִיאוֹהִי קְשׁוֹט,",
    "57": "וּמַסְגֵּא לְמֶעְבַּד",
    "58": "טַבְוָן וּקְ֒שׁוֹט,",
    "59": "בֵּהּ אֲנָא רָחִיץ",
    "60": "וְלִשְׁ֒מֵהּ קַדִּישָׁא יַקִּירָא",
    "61": "אֲנָא אֵמַר תֻּשְׁבְּחָן,",
    "62": "יְהֵא רַעֲוָא קֳדָמָךְ",
    "63": "דְּתִפְתַּח לִבָּאִי בְּאוֹרַיְתָא,",
    "64": "וְתַשְׁלִים מִשְׁאֲלִין דְּלִבָּאִי,",
    "65": "וְלִבָּא דְכָל עַמָּךְ יִשְׂרָאֵל,",
    "66": "לְטַב וּלְ֒חַיִּין וְלִשְׁ֒לָם:",
    "68": "<b>גַּדְּ֒לוּ לַיהוָֹה אִתִּי</b>",
    "69": "<b>וּנְ֒רוֹמְ֒מָה שְׁמוֹ יַחְדָּו:</b>",
    "71": "לְךָ יְהֹוָה הַגְּ֒דֻלָּה וְהַגְּ֒בוּרָה",
    "72": "וְהַתִּפְאֶֽרֶת וְהַנֵּֽצַח וְהַהוֹד",
    "73": "כִּי כֹל בַּשָּׁמַֽיִם וּבָאָֽרֶץ",
    "74": "לְךָ יְהֹוָה הַמַּמְלָכָה",
    "75": "וְהַמִּתְנַשֵּׂא לְכֹל לְרֹאשׁ:",
    "76": "רוֹמְ֒מוּ יְהֹוָה אֱלֺהֵֽינוּ",
    "77": "וְהִשְׁתַּחֲווּ לַהֲדֹם רַגְלָיו",
    "78": "קָדוֹשׁ הוּא:",
    "79": "רוֹמְ֒מוּ יְהֹוָה אֱלֺהֵֽינוּ",
    "80": "וְהִשְׁתַּחֲווּ",
    "81": "לְהַר קָדְשׁוֹ",
    "82": "כִּי קָדוֹשׁ יְהֹוָה אֱלֺהֵֽינוּ:",
    "83": "אָב הָרַחֲמִים הוּא יְרַחֵם",
    "84": "עַם עֲמוּסִים,",
    "85": "וְיִזְכֹּר",
    "86": "בְּרִית אֵיתָנִים,",
    "87": "וְיַצִּיל נַפְ֒שׁוֹתֵֽינוּ",
    "88": "מִן הַשָּׁעוֹת הָרָעוֹת,",
    "89": "וְיִגְעַר בְּיֵֽצֶר הָרָע",
    "90": "מִן הַנְּ֒שׂוּאִים,",
    "91": "וְיָחוֹן אוֹתָֽנוּ",
    "92": "לִפְ֒לֵטַת עוֹלָמִים,",
    "93": "וִימַלֵּא מִשְׁאֲלוֹתֵֽינוּ",
    "94": "בְּמִדָּה טוֹבָה",
    "95": "יְשׁוּעָה וְרַחֲמִים:",
    "97": "וְתִגָּלֶה וְתֵרָאֶה מַלְכוּתוֹ",
    "98": "עָלֵֽינוּ בִּזְ֒מַן קָרוֹב",
    "99": "וְיָחוֹן פְּלֵטָתֵֽנוּ",
    "100": "וּפְ֒לֵטַת עַמּוֹ",
    "101": "בֵּית יִשְׂרָאֵל",
    "102": "לְחֵן וּלְ֒חֶֽסֶד",
    "103": "וּלְ֒רַחֲמִים וּלְ֒רָצוֹן",
    "104": "וְנֹאמַר אָמֵן,",
    "105": "הַכֹּל הָבוּ גֹֽדֶל לֵאלֺהֵֽינוּ",
    "106": "וּתְ֒נוּ כָבוֹד לַתּוֹרָה,",
    "107": "כֹּהֵן קְרָב,",
    "108": "יַעֲמֹד (פב\"פ) הַכֹּהֵן,",
    "109": "בָּרוּךְ שֶׁנָּתַן תּוֹרָה",
    "110": "לְעַמּוֹ יִשְׂרָאֵל בִּקְ֒דֻשָּׁתוֹ:",
    "112": "וְאַתֶּם הַדְּ֒בֵקִים בַּיהוָֹה אֱלֺהֵיכֶם",
    "113": "חַיִּים כֻּלְּ֒כֶם הַיּוֹם:",
    "115": "בָּרְ֒כוּ אֶת יְהֹוָה הַמְּ֒בֹרָךְ:",
    "117": "בָּרוּךְ יְהֹוָה הַמְּ֒בֹרָךְ",
    "118": "לְעוֹלָם וָעֶד:",
    "120": "בָּרוּךְ אַתָּה יְהֹוָה",
    "121": "אֱלֺהֵֽינוּ מֶֽלֶךְ הָעוֹלָם",
    "122": "אֲשֶׁר בָּֽחַר בָּֽנוּ מִכָּל הָעַמִּים",
    "123": "וְנָֽתַן לָֽנוּ אֶת תּוֹרָתוֹ:",
    "124": "בָּרוּךְ אַתָּה יְהֹוָה",
    "125": "נוֹתֵן הַתּוֹרָה:",
    "127": "בָּרוּךְ אַתָּה יְהֹוָה",
    "128": "אֱלֺהֵֽינוּ מֶֽלֶךְ הָעוֹלָם",
    "129": "אֲשֶׁר נָֽתַן לָֽנוּ תּוֹרַת אֱמֶת",
    "130": "וְחַיֵּי עוֹלָם נָטַע בְּתוֹכֵֽנוּ:",
    "131": "בָּרוּךְ אַתָּה יְהֹוָה",
    "132": "נוֹתֵן הַתּוֹרָה:"
   },
   "en": {
    "5": "Almighty who is slow to anger",
    "6": "and full of compassion,",
    "7": "do not hide Your presence from us.",
    "8": "Adonoy, spare Your people",
    "9": "and save us from all evil.",
    "10": "We have sinned against You, Master,",
    "11": "forgive us, please,",
    "12": "in keeping with Your abundant mercy,",
    "13": "Almighty.",
    "15": "<small><i>When the Holy Ark is opened, the following is said:</i></small>",
    "16": "Whenever the Ark traveled,",
    "17": "Moses would say: \"Rise, Adonoy",
    "18": "and let Your enemies be scattered,",
    "19": "and those who hate You, flee before You.\"",
    "20": "For from Zion will go forth the Torah,",
    "21": "and the word of Adonoy from Jerusalem.",
    "22": "Blessed is He Who gave the Torah",
    "23": "to His people Israel in His holiness.",
    "25": "Blessed is the Name",
    "26": "of the Master of the universe.",
    "27": "Blessed is Your crown and Your place.",
    "28": "May Your good will [be]",
    "29": "with Your people Israel forever.",
    "30": "The redemption of Your right hand",
    "31": "show Your people in Your Holy Temple.",
    "32": "Bestow on us Your excellent light,",
    "33": "and accept our prayer with compassion.",
    "34": "May it be Your will",
    "35": "to prolong our lives in well-being.",
    "36": "Let me be counted",
    "37": "among the righteous,",
    "38": "so that You will have compassion on me",
    "39": "and protect me and all that is mine,",
    "40": "and all that belongs to Your people, Israel.",
    "41": "You are He",
    "42": "Who nourishes all and maintains all;",
    "43": "You are He Who rules over all;",
    "44": "You are He Who rules over kings,",
    "45": "and the kingdom is Yours.",
    "46": "I am a servant",
    "47": "of the Holy One, blessed is He,",
    "48": "I bow before Him",
    "49": "and before the honor of His Torah",
    "50": "at all times.",
    "51": "Not in man do I put my trust,",
    "52": "nor do I rely on any angel;",
    "53": "but only in the God of heaven,",
    "54": "Who is the true God,",
    "55": "Whose Torah is truth,",
    "56": "Whose prophets are true,",
    "57": "and Who performs many deeds",
    "58": "of goodness and truth.",
    "59": "In Him I put my trust",
    "60": "and to His holy, honored Name",
    "61": "I utter praises.",
    "62": "May it be Your will",
    "63": "to open my heart to Torah,",
    "64": "and to fulfill the desires of my heart,",
    "65": "and of the heart of Your people Israel,",
    "66": "for goodness, for life, and for peace.",
    "67": "<small><i>The Chazzan says:</i></small>",
    "68": "<b>Declare the greatness of Adonoy, with me.</b>",
    "69": "<b>and let us exalt His Name together.</b>",
    "70": "<small><i>The Congregation responds:</i></small>",
    "71": "Yours, Adonoy, is the greatness, the might,",
    "72": "the glory, the victory, and the beauty,",
    "73": "for everything in heaven and on earth",
    "74": "[is Yours]; Yours, Adonoy, is the kingdom,",
    "75": "and You are uplifted over all rulers.",
    "76": "Exalt Adonoy, our God,",
    "77": "and prostrate yourselves at His footstool,",
    "78": "Holy is He.",
    "79": "Exalt Adonoy, Our God,",
    "80": "and prostrate yourselves",
    "81": "at His holy mountain",
    "82": "for Adonoy, our God, is holy.",
    "83": "May the Father of mercy have compassion",
    "84": "on the people borne by Him,",
    "85": "and may He remember",
    "86": "the covenant with the patriarchs;",
    "87": "may He rescue our souls",
    "88": "from evil times;",
    "89": "and may He rebuke the evil impulse",
    "90": "from those who have been carried by Him;",
    "91": "and may He graciously grant us",
    "92": "eternal survival;",
    "93": "and fulfill our requests",
    "94": "in beneficent measure,",
    "95": "[for] deliverance and compassion.",
    "96": "<small><i>When the Torah is unrolled, the Reader says:</i></small>",
    "97": "May His sovereignty be revealed and visible",
    "98": "to us, soon;",
    "99": "and may He be gracious to our remnant",
    "100": "and the remnant of His people,",
    "101": "the House of Israel",
    "102": "[granting them] favor, kindness,",
    "103": "compassion and goodwill.",
    "104": "And let us say Amein.",
    "105": "Let all ascribe greatness to our God,",
    "106": "and give honor to the Torah.",
    "107": "Let the Kohein come forward.",
    "108": "Arise, ______ son of _____, the Kohein,",
    "109": "Blessed is He Who gave the Torah",
    "110": "to His people, Israel, in His holiness.",
    "111": "<small><i>The Congregation responds:</i></small>",
    "112": "And you who cling to Adonoy, Your God,",
    "113": "are all alive today.",
    "114": "<small><i>The Kohein walks up to the Torah and says:</i></small>",
    "115": "Blessed Adonoy, who is blessed.",
    "116": "<small><i>The Congregation responds and the Kohein repeats:</i></small>",
    "117": "Blessed is Adonoy, Who is blessed,",
    "118": "forever and ever.",
    "119": "<small><i>The Kohein says:</i></small>",
    "120": "Blessed are You, Adonoy",
    "121": "our God, King of the Universe,",
    "122": "Who chose us from among all the peoples",
    "123": "and gave us His Torah.",
    "124": "Blessed are You, Adonoy,",
    "125": "Giver of the Torah.",
    "126": "<small><i>After the Torah is read, the Kohein says:</i></small>",
    "127": "Blessed are You, Adonoy",
    "128": "our God, King of the Universe",
    "129": "Who gave us the Torah of truth,",
    "130": "and implanted eternal life within us.",
    "131": "Blessed are You, Adonoy,",
    "132": "Giver of the Torah."
   }
  },
  "Weekday Siddur Sefard Linear, The Morning Prayers, Birchas Hagomeil": {
   "edition": "metsudah-sefard-weekday",
   "he": {
    "2": "בָּרוּךְ אַתָּה יְהֹוָה",
    "3": "אֱלֺהֵֽינוּ מֶֽלֶךְ הָעוֹלָם",
    "4": "הַגּוֹמֵל לְחַיָּבִים טוֹבוֹת",
    "5": "שֶׁגְּ֒מָלַֽנִי כָּל טוֹב:",
    "7": "מִי שֶׁגְּ֒מָלְ֒ךָ טוֹב",
    "8": "הוּא יִגְמָלְ֒ךָ כָּל־טוֹב",
    "9": "סֶֽלָה:"
   },
   "en": {
    "2": "Blessed are You, Adonoy",
    "3": "our God, King of the Universe,",
    "4": "Who bestows goodness upon the guilty,",
    "5": "Who has bestowed every goodness upon me.",
    "6": "<small><i>The congregation responds:</i></small>",
    "7": "He Who has bestowed goodness upon you,",
    "8": "may He bestow every goodness upon you,",
    "9": "forever."
   }
  }
 }
}
