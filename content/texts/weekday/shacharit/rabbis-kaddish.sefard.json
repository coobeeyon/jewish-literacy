{
 "id": "weekday/shacharit/rabbis-kaddish:sefard",
 "refs": {
  "Weekday Siddur Sefard Linear, The Morning Prayers, Kaddish d'Rabanan": {
   "edition": "metsudah-sefard-weekday",
   "he": {
    "4": "<b>יִתְגַּדַּל</b> וְיִתְקַדַּשׁ שְׁמֵהּ רַבָּא",
    "5": "בְּעָלְ֒מָא דִּי בְרָא",
    "6": "כִרְעוּתֵהּ",
    "7": "וְיַמְלִיךְ מַלְכוּתֵהּ",
    "8": "וְיַצְמַח פּוּרְקָנֵהּ",
    "9": "וִיקָרֵב (קֵץ) מְשִׁיחֵהּ.",
    "10": "בְּחַיֵּיכוֹן וּבְיוֹמֵיכוֹן",
    "11": "וּבְחַיֵּי",
    "12": "דְכָל בֵּית יִשְׂרָאֵל,",
    "13": "בַּעֲגָלָא וּבִזְמַן קָרִיב",
    "14": "וְאִמְרוּ אָמֵן",
    "15": "<b>יְהֵא שְׁמֵהּ רַבָּא מְבָרַךְ</b>",
    "16": "<b>לְעָלַם וּלְעָלְ֒מֵי עָלְ֒מַיָּא</b>",
    "17": "יִתְבָּרַךְ וְיִשְׁתַּבַּח",
    "18": "וְיִתְפָּאַר וְיִתְרוֹמַם וְיִתְנַשֵּׂא",
    "19": "וְיִתְהַדָּר וְיִתְעַלֶּה וְיִתְהַלָּל",
    "20": "שְׁמֵהּ דְקוּדְשָׁא, בְּרִיךְ הוּא ",
    "21": "לְעֵֽלָּא (<small>בעשי\"ת</small> וּלְעֵֽלָּא מִכָּל) ",
    "22": "מִן כָּל בִּרְכָתָא וְשִׁירָתָא,",
    "23": "תֻּשְׁבְּחָתָא וְנֶחֱמָתָא,",
    "24": "דַּאֲמִירָן בְּעָלְ֒מָא, וְאִמְרוּ אָמֵן: ",
    "25": "עַל יִשְׂרָאֵל וְעַל רַבָּנָן",
    "26": "וְעַל תַלְמִידֵיהוֹן",
    "27": "וְעַל כָּל תַּלְמִידֵי תַלְמִידֵיהוֹן,",
    "28": "וְעַל כָּל מָאן דְּעָסְ֒קִין בְּאוֹרַיְתָא,",
    "29": "דִּי בְאַתְרָא הָדֵין",
    "30": "וְדִי בְכָל אֲתַר וַאֲתַר,",
    "31": "יְהֵא לְהוֹן וּלְכוֹן",
    "32": "שְׁלָמָא רַבָּא חִנָּא וְחִסְדָּא",
    "33": "וְרַחֲמִין וְחַיִּין אֲרִיכִין",
    "34": "וּמְזוֹנָא רְוִיחֵי וּפוּרְקָנָא",
    "35": "מִן קֳדָם אֲבוּהוֹן",
    "36": "דְבִשְׁמַיָּא וְאַרְעָא",
    "37": "וְאִמְרוּ אָמֵן:",
    "38": "יְהֵא שְׁלָמָא רַבָּא מִן שְׁמַיָּא",
    "39": "וְחַיִּים טוֹבִים",
    "40": "עָלֵֽינוּ וְעַל כָּל יִשְׂרָאֵל",
    "41": "וְאִמְרוּ אָמֵן:",
    "42": "עוֹשֶׂה שָׁלוֹם",
    "43": "(<small>בעשי\"ת</small> הַשָּׁלוֹם)",
    "44": "בִּמְרוֹמָיו",
    "45": "הוּא בְּרַחֲמָיו יַעֲשֶׂה שָׁלוֹם",
    "46": "עָלֵֽינוּ וְעַל כָּל יִשְׂרָאֵל",
    "47": "וְאִמְרוּ אָמֵן:"
   },
   "en": {
    "4": "Exalted and sanctified be His great Name",
    "5": "in the world which He created",
    "6": "according to His will",
    "7": "and may He rule His kingdom",
    "8": "bring forth His redemption",
    "9": "and hasten the coming of His Mashiach.",
    "10": "In your lifetime and in your days,",
    "11": "and in the lifetime",
    "12": "of the entire House of Israel,",
    "13": "speedily and in the near future—",
    "14": "and say Amein.",
    "15": "May His great Name be blessed",
    "16": "forever and for all eternity.",
    "17": "Blessed and praised,",
    "18": "glorified, and exalted and uplifted,",
    "19": "honored and elevated and extolled",
    "20": "be the Name of the Holy One, blessed is He;",
    "21": "above (<i>Ten Days of Penitence:</i> far above)",
    "22": "all the blessings and hymns,",
    "23": "praises and consolations",
    "24": "which we utter in the world—and say Amein.",
    "25": "Upon Israel, and upon our Sages,",
    "26": "and upon their disciples,",
    "27": "and upon all the disciples of their disciples,",
    "28": "and upon all those who engage in Torah study",
    "29": "in this land",
    "30": "and in every land.",
    "31": "May there be unto them and unto you",
    "32": "abundant peace, favor, kindness,",
    "33": "compassion, long life,",
    "34": "ample sustenance and redemption",
    "35": "from their Father",
    "36": "Who is in heaven and on earth,",
    "37": "—and say Amein.",
    "38": "May there be abundant peace from heaven",
    "39": "and a good life",
    "40": "for us and for all Israel,",
    "41": "—and say Amein.",
    "42": "He Who makes peace",
    "43": "(<i>Ten Days of Penitence:</i> the peace)",
    "44": "in His high heavens",
    "45": "may He, in His mercy, make peace",
    "46": "for us and for all Israel,",
    "47": "—and say Amein."
   }
  }
 }
}
