{
 "id": "weekday/shacharit/full-kaddish-titkabel:sefard",
 "refs": {
  "Weekday Siddur Sefard Linear, The Morning Prayers, Ashrei U'va L'Tzion": {
   "edition": "metsudah-sefard-weekday",
   "he": {
    "203": "<b>יִתְגַּדַּל</b> וְיִתְקַדַּשׁ שְׁמֵהּ רַבָּא",
    "204": "בְּעָלְ֒מָא דִּי בְרָא",
    "205": "כִרְעוּתֵהּ",
    "206": "וְיַמְלִיךְ מַלְכוּתֵהּ",
    "207": "וְיַצְמַח פּוּרְ֒קָנֵהּ",
    "208": "וִיקָרֵב (קֵץ) מְשִׁיחֵהּ",
    "209": "בְּחַיֵּיכוֹן וּבְיוֹמֵיכוֹן",
    "210": "וּבְחַיֵּי",
    "211": "דְכָל בֵּית יִשְׂרָאֵל,",
    "212": "בַּעֲגָלָא וּבִזְמַן קָרִיב",
    "213": "וְאִמְרוּ אָמֵן:",
    "214": "<b>יְהֵא שְׁמֵהּ רַבָּא מְבָרַךְ</b>",
    "215": "<b>לְעָלַם וּלְעָלְ֒מֵי עָלְ֒מַיָּא</b>:",
    "216": "יִתְבָּרַךְ וְיִשְׁתַּבַּח",
    "217": "וְיִתְפָּאַר וְיִתְרוֹמַם וְיִתְנַשֵּׂא",
    "218": "וְיִתְהַדָּר וְיִתְעַלֶּה וְיִתְהַלָּל",
    "219": "שְׁמֵהּ דְקוּדְשָׁא, בְּרִיךְ הוּא ",
    "220": "לְעֵֽלָּא (<small>בעשי\"ת</small> וּלְ֒עֵֽלָּא מִכָּל) ",
    "221": "מִן כָּל בִּרְכָתָא וְשִׁירָתָא,",
    "222": "תֻּשְׁבְּחָתָא וְנֶחֱמָתָא,",
    "223": "דַּאֲמִירָן בְּעָלְ֒מָא, וְאִמְרוּ אָמֵן,",
    "224": "תִּתְקַבֵּל",
    "225": "צְלוֹתְ֒הוֹן וּבָעוּתְ֒הוֹן",
    "226": "דְּכָל בֵּית יִשְׂרָאֵל",
    "227": "קֳדָם אֲבוּהוֹן דִּי בִשְׁ֒מַיָּא",
    "228": "וְאִמְרוּ אָמֵן:",
    "229": "יְהֵא שְׁלָמָא רַבָּא מִן שְׁמַיָּא",
    "230": "וְחַיִּים",
    "231": "עָלֵֽינוּ וְעַל כָּל יִשְׂרָאֵל",
    "232": "וְאִמְרוּ אָמֵן:",
    "233": "עוֹשֶׂה שָׁלוֹם",
    "234": "(<small>בעשי\"ת</small> הַשָּׁלוֹם)",
    "235": "בִּמְרוֹמָיו",
    "236": "הוּא יַעֲשֶׂה שָׁלוֹם",
    "237": "עָלֵינוּ וְעַל כָּל יִשְׂרָאֵל",
    "238": "וְאִמְרוּ אָמֵן"
   },
   "en": {
    "202": "<small><i>On regular weekdays the Chazzan recites the following Kaddish:</i></small>",
    "203": "Exalted and sanctified be His great Name",
    "204": "in the world which He created",
    "205": "according to His will",
    "206": "and may He rule His kingdom",
    "207": "bring forth His redemption",
    "208": "and hasten the coming if His Messiah",
    "209": "in your lifetime and in your days,",
    "210": "and in the lifetime",
    "211": "of the entire House of Israel,",
    "212": "speedily and in the near future—",
    "213": "and say Amein.",
    "214": "May His great Name be blessed",
    "215": "forever and for all eternity.",
    "216": "Blessed and praised,",
    "217": "glorified, and exalted and uplifted,",
    "218": "honored and elevated and extolled",
    "219": "be the Name of the Holy One, blessed is He;",
    "220": "above (<i>Ten Days of Penitence:</i> far above)",
    "221": "all the blessings and hymns,",
    "222": "praises and consolations",
    "223": "which we utter in the world—and say Amein.",
    "224": "May there be acceptance",
    "225": "of the prayers and supplications",
    "226": "of the entire House of Israel",
    "227": "before their Father in heaven.",
    "228": "And say, Amein.",
    "229": "May there be abundant peace from heaven",
    "230": "and life",
    "231": "for us and for all Israel,",
    "232": "—and say Amein.",
    "233": "He Who makes peace",
    "234": "(<i>Ten Days of Penitence:</i> the peace)",
    "235": "in His high heavens",
    "236": "may He, make peace",
    "237": "for us and for all Israel,",
    "238": "and say, Amen."
   }
  }
 }
}
