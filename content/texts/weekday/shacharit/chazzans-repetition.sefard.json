{
 "id": "weekday/shacharit/chazzans-repetition:sefard",
 "refs": {
  "Weekday Siddur Sefard Linear, The Morning Prayers, Shemoneh Esrei": {
   "edition": "metsudah-sefard-weekday",
   "he": {
    "1": "אֲדֹנָי שְׂפָתַי תִּפְתָּח",
    "2": "וּפִי יַגִּיד תְּהִלָּתֶֽךָ:",
    "4": "<b>בָּרוּךְ</b> אַתָּה יְהֹוָה",
    "5": "אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ",
    "6": "אֱלֹהֵי אַבְרָהָם אֱלֹהֵי יִצְחָק",
    "7": "וֵאלֹהֵי יַעֲקֹב",
    "8": "הָאֵל",
    "9": "הַגָּדוֹל הַגִּבּוֹר וְהַנּוֹרָא",
    "10": "אֵל עֶלְיוֹן",
    "11": "גּוֹמֵל חֲסָדִים טוֹבִים",
    "12": "וְקוֹנֵה הַכֹּל",
    "13": "וְזוֹכֵר חַסְדֵי אָבוֹת",
    "14": "וּמֵבִיא גוֹאֵל",
    "15": "לִבְנֵי בְנֵיהֶם",
    "16": "לְמַֽעַן שְׁמוֹ בְּאַהֲבָה:",
    "18": "<small>זָכְרֵֽנוּ לְחַיִּים</small>",
    "19": "<small>מֶֽלֶךְ חָפֵץ בַּחַיִּים</small>",
    "20": "<small>וְכָתְבֵֽנוּ בְּסֵֽפֶר הַחַיִּים</small>",
    "21": "<small>לְמַעַנְךָ אֱלֹהִים חַיִּים:</small>",
    "23": "מֶֽלֶךְ עוֹזֵר וּמוֹשִֽׁיעַ וּמָגֵן:",
    "24": "בָּרוּךְ אַתָּה יְהֹוָה",
    "25": "מָגֵן אַבְרָהָם:",
    "27": "<b>אַתָּה גִבּוֹר</b> לְעוֹלָם אֲדֹנָי",
    "28": "מְחַיֶּה מֵתִים אַתָּה",
    "29": "רַב לְהוֹשִֽׁיעַ:",
    "31": "מוֹרִיד הַטָּל",
    "33": "מַשִּׁיב הָרֽוּחַ",
    "34": "וּמוֹרִיד הַגֶּֽשֶׁם:",
    "36": "מְכַלְכֵּל חַיִּים בְּחֶֽסֶד",
    "37": "מְחַיֵּה מֵתִים בְּרַחֲמִים רַבִּים",
    "38": "סוֹמֵךְ נוֹפְ֒לִים",
    "39": "וְרוֹפֵא חוֹלִים",
    "40": "וּמַתִּיר אֲסוּרִים",
    "41": "וּמְקַיֵּם אֱמוּנָתוֹ",
    "42": "לִישֵׁנֵי עָפָר,",
    "43": "מִי כָמֽוֹךָ בַּֽעַל גְּבוּרוֹת",
    "44": "וּמִי דּֽוֹמֶה לָּךְ",
    "45": "מֶֽלֶךְ מֵמִית וּמְחַיֶּה",
    "46": "וּמַצְמִֽיחַ יְשׁוּעָה:",
    "48": "<small>מִי כָמֽוֹךָ אָב הָרַחַמָן</small>",
    "49": "<small>זוֹכֵר יְצוּרָיו לְחַיִּים</small>",
    "50": "<small>בְּרַחֲמִים:</small>",
    "52": "וְנֶאֱמָן אַתָּה",
    "53": "לְהַחֲיוֹת מֵתִים:",
    "54": "בָּרוּךְ אַתָּה יְהֹוָה",
    "55": "מְחַיֵּה הַמֵּתִים:",
    "59": "<b>נַקְדִישָׁךְ</b> וְנַעֲרִיצָךְ",
    "60": "כְּנֹֽעַם שִֽׂיחַ",
    "61": "סוֹד שַׂרְפֵי קֽוֹדֶשׁ",
    "62": "הַמְּ֒שַׁלְּ֒שִׁים לְךָ קְדֻשָּׁה",
    "63": "כַּכָּתוּב עַל יַד נְבִיאֶֽךָ",
    "64": "וְקָרָא זֶה אֶל זֶה וְאָמַר:",
    "66": "<b>קָדוֹשׁ קָדוֹשׁ קָדוֹשׁ</b>",
    "67": "<b>יְהֹוָה צְבָאוֹת</b>",
    "68": "<b>מְלֹא כָל הָאָֽרֶץ כְּבוֹדוֹ:</b>",
    "70": "לְעֻמָּתָם מְשַׁבְּ֒חִים וְאוֹמְ֒רִים:",
    "72": "<b>בָּרוּךְ כְּבוֹד יְהֹוָה</b>",
    "73": "<b>מִמְּ֒קוֹמוֹ:</b>",
    "75": "וּבְדִבְרֵי קָדְשְׁךָ כָּתוּב לֵאמֹר:",
    "77": "<b>יִמְלֹךְ יְהֹוָה לְעוֹלָם</b>",
    "78": "<b>אֱלֹהַֽיִךְ צִיּוֹן לְדֹר וָדֹר:</b>",
    "79": "הַלְ֒לוּיָהּ:",
    "80": "<b>קדושת השם</b>",
    "81": "<b>אַתָּה קָדוֹשׁ</b> וְשִׁמְךָ קָדוֹשׁ",
    "82": "וּקְדוֹשִׁים",
    "83": "בְּכָל יוֹם יְהַלְ֒לֽוּךָ סֶּֽלָה:",
    "84": "כִּי אֵל מֶֽלֶךְ",
    "85": "גָּדוֹל וְקָדוֹשׁ אָֽתָּה:",
    "87": "בָּרוּךְ אַתָּה יְהֹוָה",
    "88": "הָאֵל הַקָּדוֹשׁ:",
    "90": "<small>בָּרוּךְ אַתָּה יְהֹוָה</small>",
    "91": "<small>הַמֶּֽלֶךְ הַקָּדוֹשׁ:</small>",
    "94": "<b>אַתָּה חוֹנֵן</b> לְאָדָם דַּֽעַת",
    "95": "וּמְלַמֵּד לֶאֱנוֹשׁ בִּינָה:",
    "96": "חָנֵּֽנוּ מֵאִתְּ֒ךָ",
    "97": "חָכְמָה בִּינָה וָדָּעַת",
    "98": "בָּרוּךְ אַתָּה יְהֹוָה",
    "99": "חוֹנֵן הַדָּֽעַת:",
    "101": "<b>הֲשִׁיבֵֽנוּ</b> אָבִֽינוּ",
    "102": "לְתוֹרָתֶֽךָ",
    "103": "וְקָרְ֒בֵֽנוּ מַלְכֵּֽנוּ לַעֲבוֹדָתֶֽךָ",
    "104": "וְהַחֲזִירֵֽנוּ",
    "105": "בִּתְשׁוּבָה שְׁלֵמָה לְפָנֶֽיךָ:",
    "106": "בָּרוּךְ אַתָּה יְהֹוָה",
    "107": "הָרוֹצֶה בִּתְשׁוּבָה:",
    "109": "<b>סְלַח לָֽנוּ</b> אָבִֽינוּ כִּי חָטָֽאנוּ",
    "110": "מְחַל לָֽנוּ מַלְכֵּֽנוּ",
    "111": "כִּי פָשָֽׁעְנוּ",
    "112": "כִּי אֵל טוֹב וְסַלָח אָֽתָּה:",
    "113": "בָּרוּךְ אַתָּה יְהֹוָה",
    "114": "חַנּוּן הַמַּרְבֶּה לִסְלֽוֹחַ:",
    "116": "<b>רְאֵה</b> נָא בְעָנְיֵֽנוּ",
    "117": "וְרִֽיבָה רִיבֵֽנוּ",
    "118": "וּגְאָלֵֽנוּ",
    "119": "גְאוּלָה שְׁלֵמָה מְהֵרָה",
    "120": "לְמַֽעַן שְׁמֶֽךָ",
    "121": "כִּי אֵל גּוֹאֵל חָזָק אָֽתָּה:",
    "122": "בָּרוּךְ אַתָּה יְהֹוָה",
    "123": "גּוֹאֵל יִשְׂרָאֵל:",
    "126": "<b>רְפָאֵֽנוּ</b> יְהֹוָה וְנֵרָפֵא",
    "127": "הוֹשִׁיעֵֽנוּ וְנִוּשֵֽׁעָה",
    "128": "כִּי תְהִלָּתֵֽנוּ אָֽתָּה",
    "129": "וְהַעֲלֵה אֲרוּכָה וּמַרְפֵּא",
    "130": "לְכָל תַּחֲלוּאֵֽינוּ",
    "131": "וּלְכָל מַכְאוֹבֵֽינוּ",
    "132": "וּלְכָל מַכּוֹתֵֽינוּ",
    "145": "כִּי אֵל מֶֽלֶךְ",
    "146": "רוֹפֵא נֶאֱמָן וְרַחֲמָן אָֽתָּה:",
    "147": "בָּרוּךְ אַתָּה יְהֹוָה",
    "148": "רוֹפֵא חוֹלֵי עַמּוֹ יִשְׂרָאֵל:",
    "150": "<b>בָּרֵךְ</b> עָלֵֽינוּ יְהֹוָה אֱלֹהֵֽינוּ",
    "151": "אֶת־הַשָּׁנָה הַזֹּאת",
    "152": "וְאֶת־כָּל־מִינֵי תְבוּאָתָהּ",
    "153": "לְטוֹבָה,",
    "154": "וְתֵן",
    "156": "בְּרָכָה",
    "158": "טַל וּמָטָר לִבְרָכָה*",
    "159": "עַל־פְּנֵי הָאֲדָמָה",
    "160": "וְשַׂבְּ֒עֵֽנוּ מִטּוּבֶֽךָ",
    "161": "כִּי אֵל טוֹב",
    "162": "ומֵטִיב אַתָּה",
    "163": "וּמְבָרֵךְ הַשָׁנִים",
    "164": "בָּרוּךְ אַתָּה יְהֹוָה",
    "165": "מְבָרֵךְ הַשָּׁנִים:",
    "168": "<b>תְּקַע</b> בְּשׁוֹפָר גָּדוֹל לְחֵרוּתֵֽנוּ",
    "169": "וְשָׂא נֵס לְקַבֵּץ גָּלֻיּוֹתֵֽינוּ",
    "170": "וְקַבְּ֒צֵֽנוּ יַֽחַד מְהֵרָה",
    "171": "מֵאַרְבַּע כַּנְפוֹת הָאָֽרֶץ",
    "172": "לְאַרְצֵֽנוּ:",
    "173": "בָּרוּךְ אַתָּה יְהֹוָה",
    "174": "מְקַבֵּץ",
    "175": "נִדְחֵי עַמּוֹ יִשְׂרָאֵל:",
    "177": "<b>הָשִֽׁיבָה</b> שׁוֹפְ֒טֵֽינוּ כְּבָרִאשׁוֹנָה",
    "178": "וְיוֹעֲצֵֽינוּ כְּבַתְּ֒חִלָּה",
    "179": "וְהָסֵר מִמֶּֽנּוּ יָגוֹן וַאֲנָחָה",
    "180": "וּמְלוֹךְ עָלֵֽינוּ מְהֵרָה",
    "181": "אַתָּה יְהֹוָה לְבַדְּ֒ךָ",
    "182": "בְּחֶֽסֶד וּבְרַחֲמִים",
    "183": "וְצַדְּ֒קֵֽנוּ",
    "184": "בְּצֶֽדֶק וּבְמִשְׁפָּט:",
    "186": "בָּרוּךְ אַתָּה יְהֹוָה",
    "187": "מֶֽלֶךְ אֹהֵב צְדָקָה וּמִשְׁפָּט:",
    "189": "<small>בָּרוּךְ אַתָּה יְהֹוָה</small>",
    "190": "<small>הַמֶּֽלֶךְ הַמִּשְׁפָּט:</small>",
    "193": "<b>וְלַמַּלְשִׁינִים</b> אַל תְּהִי תִקְוָה",
    "194": "וְכָל הָרִשְׁעָה כְּרֶגַע תֺּאבֵד",
    "195": "וְכָל־אֹיְ֒בֶֽיךָ מְהֵרָה יִכָּרֵֽתוּ,",
    "196": "וְהַזֵּדִים",
    "197": "מְהֵרָה תְעַקֵּר וּתְשַׁבֵּר וּתְמַגֵּר",
    "198": "וּתְכַלֵם וְתַשְׁפִּילֵם",
    "199": "וְתַכְנִיעֵם בִּמְהֵרָה בְיָמֵֽינוּ:",
    "200": "בָּרוּךְ אַתָּה יְהֹוָה",
    "201": "שׁוֹבֵר אֹיְ֒בִים",
    "202": "וּמַכְנִֽיעַ זֵדִים:",
    "204": "<b>עַל־הַצַּדִּיקִים</b> וְעַל־הַחֲסִידִים",
    "205": "וְעַל־זִקְנֵי עַמְּ֒ךָ",
    "206": "בֵּית יִשְׂרָאֵל",
    "207": "וְעַל־פְּלֵיטַת (בֵּית) סוֹפְ֒רֵיהֶם",
    "208": "וְעַל־גֵּרֵי הַצֶּֽדֶק וְעָלֵֽינוּ",
    "209": "יֶהֱמוּ נָא רַחֲמֶֽיךָ",
    "210": "יְהֹוָה אֱלֹהֵֽינוּ",
    "211": "וְתֵן שָׂכָר טוֹב",
    "212": "לְכָל־הַבּוֹטְ֒חִים בְּשִׁמְךָ בֶּאֱמֶת",
    "213": "וְשִׂים חֶלְקֵֽנוּ עִמָּהֶם",
    "214": "וּלְעוֹלָם לֹא נֵבוֹשׁ",
    "215": "כִּי בְךָ בָטָֽחְנוּ:",
    "216": "בָּרוּךְ אַתָּה יְהֹוָה",
    "217": "מִשְׁעָן וּמִבְטָח לַצַּדִּיקִים:",
    "219": "<b>וְלִירוּשָׁלַֽיִם</b> עִירְ֒ךָ",
    "220": "בְּרַחֲמִים תָּשׁוּב",
    "221": "וְתִשְׁכּוֹן בְּתוֹכָהּ כַּאֲשֶׁר דִּבַּֽרְתָּ",
    "222": "וּבְנֵה אוֹתָהּ בְּקָרוֹב בְּיָמֵֽינוּ",
    "223": "בִּנְיַן עוֹלָם",
    "224": "וְכִסֵּא דָוִד עַבְדֶּךָ,",
    "225": "מְהֵרָה לְתוֹכָהּ תָּכִין:",
    "226": "בָּרוּךְ אַתָּה יְהֹוָה",
    "227": "בּוֹנֵה יְרוּשָׁלָֽיִם:",
    "229": "<b>אֶת־צֶֽמַח</b> דָּוִד עַבְדְּ֒ךָ",
    "230": "מְהֵרָה תַצְמִֽיחַ",
    "231": "וְקַרְנוֹ תָּרוּם בִּישׁוּעָתֶֽךָ,",
    "232": "כִּי לִישׁוּעָתְ֒ךָ קִוּינוּ כָּל הַיּוֹם",
    "233": "וּמְצַפִּים לִישׁוּעָה:",
    "234": "בָּרוּךְ אַתָּה יְהֹוָה",
    "235": "מַצְמִֽיחַ",
    "236": "קֶֽרֶן יְשׁוּעָה:",
    "238": "<b>אָב הָרַחֲמָן</b>",
    "239": "שְׁמַע קוֹלֵֽנוּ יְהֹוָה אֱלֹהֵֽינוּ",
    "240": "חוּס וְרַחֵם עָלֵֽינוּ",
    "241": "וְקַבֵּל",
    "242": "בְּרַחֲמִים וּבְרָצוֹן אֶת תְּפִלָּתֵֽנוּ,",
    "243": "כִּי אֵל",
    "244": "שׁוֹמֵֽעַ תְּפִלּוֹת וְתַחֲנוּנִים אָֽתָּה",
    "245": "וּמִלְּ֒פָנֶֽיךָ מַלְכֵּֽנוּ",
    "246": "רֵיקָם אַל תְּשִׁיבֵֽנוּ,",
    "247": "חָנֵּֽנוּ וַעֲנֵֽנוּ",
    "248": "וּשְׁמַע תְּפִלָתֵֽנוּ*",
    "249": "כִּי אַתָּה שׁוֹמֵֽעַ תְּפִלַּת כָּל פֶּה",
    "250": "עַמְּ֒ךָ יִשְׂרָאֵל בְּרַחֲמִים:",
    "251": "בָּרוּךְ אַתָּה יְהֹוָה",
    "252": "שׁוֹמֵֽעַ תְּפִלָּה:",
    "256": "<b>רְצֵה</b> יְהֹוָה אֱלֹהֵֽינוּ",
    "257": "בְּעַמְּ֒ךָ יִשְׂרָאֵל",
    "258": "וְלִתְפִלָּתָם שְׁעֵה,",
    "259": "וְהָשֵׁב אֶת הָעֲבוֹדָה",
    "260": "לִדְבִיר בֵּיתֶֽךָ",
    "261": "וְאִשֵּׁי יִשְׂרָאֵל,",
    "262": "וּתְפִלָּתָם בְּאַהֲבָה תְקַבֵּל",
    "263": "בְּרָצוֹן",
    "264": "וּתְהִי לְרָצוֹן תָּמִיד",
    "265": "עֲבוֹדַת יִשְׂרָאֵל עַמֶּֽךָ:",
    "267": "<b>אֱלֹהֵֽינוּ</b> וֵאלֹהֵי אֲבוֹתֵֽינוּ",
    "268": "יַעֲלֶה וְיָבֹא וְיַגִּֽיעַ",
    "269": "וְיֵרָאֶה וְיֵרָצֶה וְיִשָּׁמַע",
    "270": "וְיִפָּקֵד וְיִזָּכֵר",
    "271": "זִכְרוֹנֵֽנוּ וּפִקְדוֹנֵֽנוּ",
    "272": "וְזִכְרוֹן אֲבוֹתֵֽינוּ",
    "273": "וְזִכְרוֹן מָשִֽׁיחַ",
    "274": "בֶּן דָּוִד עַבְדֶּֽךָ",
    "275": "וְזִכְרוֹן יְרוּשָׁלַֽיִם",
    "276": "עִיר קָדְשֶֽׁךָ",
    "277": "וְזִכְרוֹן כָּל עַמְּ֒ךָ",
    "278": "בֵּית יִשְׂרָאֵל לְפָנֶֽיךָ,",
    "279": "לִפְלֵיטָה לְטוֹבָה",
    "280": "לְחֵן וּלְחֶֽסֶד וּלְרַחֲמִים",
    "281": "וּלְחַיִּים טוֹבִים וּלְשָׁלוֹם",
    "282": "בְּיוֹם",
    "283": "<small>לר\"ח:</small> רֹאשׁ הַחֹֽדֶשׁ הַזֶּה ",
    "284": "<small>לפסח:</small> חַג הַמַּצּוֹת הַזֶּה",
    "285": "<small>לסכות:</small> חַג הַסֻּכּוֹת הַזֶּה",
    "286": "זָכְרֵֽנוּ יְהֹוָה אֱלֹהֵֽינוּ",
    "287": "בּוֹ לְטוֹבָה,",
    "288": "וּפָקְדֵֽנוּ בוֹ לִבְרָכָה,",
    "289": "וְהוֹשִׁיעֵֽנוּ בוֹ לְחַיִּים טוֹבִים,",
    "290": "וּבִדְבַר יְשׁוּעָה",
    "291": "וְרַחֲמִים",
    "292": "חוּס וְחָנֵּֽנוּ,",
    "293": "וְרַחֵם עָלֵֽינוּ וְהוֹשִׁיעֵֽנוּ,",
    "294": "כִּי אֵלֶֽיךָ עֵינֵֽינוּ,",
    "295": "כִּי אֵל",
    "296": "מֶֽלֶךְ חַנּוּן וְרַחוּם אָֽתָּה:",
    "301": "וְתֶחֱזֶֽינָה עֵינֵֽינוּ",
    "302": "בְּשׁוּבְ֒ךָ לְצִיּוֹן בְּרַחֲמִים:",
    "303": "בָּרוּךְ אַתָּה יְהֹוָה",
    "304": "הַמַּחֲזִיר שְׁכִינָתוֹ לְצִיּוֹן:",
    "307": "<b>מוֹדִים</b> אֲנַֽחְנוּ לָךְ",
    "308": "שָׁאַתָּה הוּא יְהֹוָה אֱלֹהֵֽינוּ",
    "309": "וֵאלֹהֵי אֲבוֹתֵֽינוּ לְעוֹלָם וָעֶד",
    "310": "צוּר חַיֵּֽינוּ",
    "311": "מָגֵן יִשְׁעֵֽנוּ",
    "312": "אַתָּה הוּא לְדוֹר וָדוֹר",
    "313": "נוֹדֶה לְּךָ",
    "314": "וּנְסַפֵּר תְּהִלָּתֶֽךָ",
    "315": "עַל חַיֵּֽינוּ",
    "316": "הַמְּ֒סוּרִים בְּיָדֶֽךָ",
    "317": "וְעַל־נִשְׁמוֹתֵֽינוּ",
    "318": "הַפְּ֒קוּדוֹת לָךְ",
    "319": "וְעַל־נִסֶּֽיךָ שֶׁבְּ֒כָל־יוֹם עִמָּֽנוּ",
    "320": "וְעַל־נִפְלְ֒אוֹתֶֽיךָ וְטוֹבוֹתֶֽיךָ",
    "321": "שֶׁבְּ֒כָל־עֵת,",
    "322": "עֶֽרֶב וָבֹֽקֶר וְצָהֳרָֽיִם,",
    "323": "הַטּוֹב",
    "324": "כִּי לֹא־כָלוּ רַחֲמֶֽיךָ",
    "325": "וְהַמְרַחֵם",
    "326": "כִּי לֹא־תַֽמּוּ חֲסָדֶֽיךָ,",
    "327": "כִּי מֵעוֹלָם קִוּינוּ לָךְ:",
    "329": "<small><b>מוֹדִים</b> אֲנַֽחְנוּ לָךְ</small>",
    "330": "<small>שָׁאַתָּה הוּא יְהֹוָה אֱלֹהֵֽינוּ</small>",
    "331": "<small>וֵאלֹהֵי אֲבוֹתֵֽינוּ</small>",
    "332": "<small>אֱלֹהֵי כָל בָּשָׂר</small>",
    "333": "<small>יוֹצְ֒רֵֽנוּ יוֹצֵר בְּרֵאשִׁית</small>",
    "334": "<small>בְּרָכוֹת וְהוֹדָאוֹת</small>",
    "335": "<small>לְשִׁמְךָ הַגָּדוֹל וְהַקָּדוֹשׁ</small>",
    "336": "<small>עַל שֶׁהֶחֱיִיתָֽנוּ וְקִיַּמְתָּֽנוּ</small>",
    "337": "<small>כֵּן תְּחַיֵּֽינוּ</small>",
    "338": "<small>וּתְקַיְּ֒מֵֽנוּ</small>",
    "339": "<small>וְתֶאֱסוֹף גָּלֻיּוֹתֵֽינוּ</small>",
    "340": "<small>לְחַצְרוֹת קָדְשֶֽׁךָ</small>",
    "341": "<small>לִשְׁמוֹר חֻקֶּֽיךָ</small>",
    "342": "<small>וְלַעֲשׂוֹת רְצוֹנֶֽךָ</small>",
    "343": "<small>וּלְעָבְדְּ֒ךָ בְּלֵבָב שָׁלֵם</small>",
    "344": "<small>עַל שֶׁאָֽנוּ מוֹדִים לָךְ,</small>",
    "345": "<small>בָּרוּךְ אֵל</small>",
    "346": "<small>הַהוֹדָאוֹת:</small>",
    "348": "<b>וְעַל הַנִּסִּים</b>",
    "349": "וְעַל הַפֻּרְקָן וְעַל הַגְּ֒בוּרוֹת",
    "350": "וְעַל הַתְּ֒שׁוּעוֹת וְעַל הַנִּפְלָאוֹת",
    "351": "וְעַל הַנֶּחָמוֹת וְעַל הַמִּלְחָמוֹת",
    "352": "שֶׁעָשִֽׂיתָ לַאֲבוֹתֵֽינוּ",
    "353": "בַּיָּמִים הָהֵם בִּזְּ֒מַן הַזֶּה:",
    "355": "<b>בִּימֵי מַתִּתְיָֽהוּ</b>",
    "356": "בֶּן יוֹחָנָן כֹּהֵן גָּדוֹל",
    "357": "חַשְׁמוֹנָאִי וּבָנָיו",
    "358": "כְּשֶׁעָמְ֒דָה מַלְכוּת יָוָן הָרְ֒שָׁעָה",
    "359": "עַל־עַמְּ֒ךָ יִשְׂרָאֵל",
    "360": "לְהַשְׁכִּיחָם תּוֹרָתֶֽךָ",
    "361": "וּלְהַעֲבִירָם",
    "362": "מֵחֻקֵּי רְצוֹנֶֽךָ,",
    "363": "וְאַתָּה בְּרַחֲמֶֽיךָ הָרַבִּים",
    "364": "עָמַֽדְתָּ לָהֶם בְּעֵת צָרָתָם",
    "365": "רַֽבְתָּ אֶת־רִיבָם",
    "366": "דַּֽנְתָּ אֶת־דִּינָם",
    "367": "נָקַֽמְתָּ אֶת־נִקְמָתָם",
    "368": "מָסַֽרְתָּ גִבּוֹרִים",
    "369": "בְּיַד חַלָּשִׁים",
    "370": "וְרַבִּים בְּיַד מְעַטִּים",
    "371": "וּטְמֵאִים בְּיַד טְהוֹרִים",
    "372": "וּרְשָׁעִים בְּיַד צַדִּיקִים",
    "373": "וְזֵדִים בְּיַד",
    "374": "עוֹסְ֒קֵי תוֹרָתֶֽךָ",
    "375": "וּלְךָ עָשִֽׂיתָ",
    "376": "שֵׁם גָּדוֹל וְקָדוֹשׁ בְּעוֹלָמֶֽךָ",
    "377": "וּלְעַמְּ֒ךָ יִשְׂרָאֵל",
    "378": "עָשִֽׂיתָ תְּשׁוּעָה גְדוֹלָה",
    "379": "וּפֻרְקָן כְּהַיּוֹם הַזֶּה",
    "380": "וְאַחַר־כַּךְ בָּֽאוּ בָנֶֽיךָ",
    "381": "לִדְבִיר בֵּיתֶֽךָ",
    "382": "וּפִנּוּ אֶת־הֵיכָלֶֽךָ",
    "383": "וְטִהֲרוּ אֶת־מִקְדָּשֶֽׁךָ",
    "384": "וְהִדְלִֽיקוּ נֵרוֹת",
    "385": "בְּחַצְרוֹת קָדְשֶֽׁךָ",
    "386": "וְקָבְ֒עוּ שְׁמוֹנַת יְמֵי חֲנֻכָּה אֵֽלּוּ",
    "387": "לְהוֹדוֹת וּלְהַלֵּל לְשִׁמְךָ הַגָּדוֹל:",
    "389": "<b>בִּימֵי מָרְדְּ֒כַי וְאֶסְתֵּר</b>",
    "390": "בְּשׁוּשַׁן הַבִּירָה",
    "391": "כְּשֶׁעָמַד עֲלֵיהֶם הָמָן הָרָשָׁע",
    "392": "בִּקֵּשׁ לְהַשְׁמִיד לַהֲרוֹג",
    "393": "וּלְאַבֵּד אֶת־כָּל־הַיְּ֒הוּדִים",
    "394": "מִנַּֽעַר וְעַד־זָקֵן טַף וְנָשִׁים",
    "395": "בְּיוֹם אֶחָד בִּשְׁלוֹשָׁה עָשָׂר",
    "396": "לְחֹֽדֶשׁ שְׁנֵים־עָשָׂר",
    "397": "הוּא־חֹֽדֶשׁ אֲדָר",
    "398": "וּשְׁלָלָם לָבוֹז:",
    "399": "וְאַתָּה בְּרַחֲמֶֽיךָ הָרַבִּים",
    "400": "הֵפַֽרְתָּ אֶת־עֲצָתוֹ",
    "401": "וְקִלְקַֽלְתָּ אֶת־מַחֲשַׁבְתּוֹ",
    "402": "וַהֲשֵׁבֽוֹתָ לּוֹ גְּמוּלוֹ בְּרֹאשׁוֹ",
    "403": "וְתָלוּ אוֹתוֹ וְאֶת־בָּנָיו",
    "404": "עַל־הָעֵץ:",
    "405": "<b>וְעַל־כֻּלָּם</b>",
    "406": "יִתְבָּרַךְ וְיִתְרוֹמַם וְיִתְנַשֵׂא",
    "407": "שִׁמְךָ מַלְכֵּֽנוּ",
    "408": "תָּמִיד לְעוֹלָם וָעֶד:",
    "410": "<small>וּכְתוֹב לְחַיִּים טוֹבִים</small>",
    "411": "<small>כָּל בְּנֵי בְרִיתֶֽךָ:</small>",
    "413": "<b>וְכֹל הַחַיִּים</b> יוֹדֽוּךָ סֶּֽלָה",
    "414": "וִיהַלְ֒לוּ וְיבָרְ֒כוּ",
    "415": "אֶת־שִׁמְךָ הַגָּדוֹל בְּאֱמֶת לְעוֹלָם",
    "416": "כִּי טוֹב",
    "417": "הָאֵל יְשׁוּעָתֵֽנוּ",
    "418": "וְעֶזְרָתֵֽנוּ סֶֽלָה",
    "419": "הָאֵל הַטּוֹב:",
    "420": "בָּרוּךְ אַתָּה יְהֹוָה",
    "421": "הַטּוֹב שִׁמְךָ",
    "422": "וּלְךָ נָאֶה לְהוֹדוֹת:",
    "425": "אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ בָּרְ֒כֵֽנוּ",
    "426": "בַבְּ֒רָכָה הַמְּ֒שֻׁלֶּֽשֶׁת בַּתּוֹרָה",
    "427": "הַכְּ֒תוּבָה עַל יְדֵי משֶׁה עַבְדֶּֽךָ,",
    "428": "הָאֲמוּרָה מִפִּי אַהֲרֹן",
    "429": "וּבָנָיו כֹּהֲנִים עַם קְדוֹשֶֽׁךָ",
    "430": "כָּאָמוּר:",
    "431": "יְבָרֶכְ֒ךָ יְהֹוָה וְיִשְׁמְ֒רֶֽךָ:",
    "432": "יָאֵר יְהֹוָה פָּנָיו אֵלֶֽיךָ",
    "433": "וִיחֻנֶּֽךָּ:",
    "434": "יִשָּׂא יְהֹוָה פָּנָיו אֵלֶֽיךָ",
    "435": "וְיָשֵׂם לְךָ שָׁלוֹם:",
    "437": "<small>אַדִּיר בַּמָּרוֹם שׁוֹכֵן בִּגְ֒בוּרָה,</small>",
    "438": "<small>אַתָּה שָׁלוֹם וְשִׁמְךָ שָׁלוֹם.</small>",
    "439": "<small>יְהִי רָצוֹן שֶׁתָּשִׂים עָלֵֽינוּ</small>",
    "440": "<small>וְעַל כָּל עַמְּ֒ךָ בֵּית יִשְׂרָאֵל</small>",
    "441": "<small>חַיִּים וּבְרָכָה</small>",
    "442": "<small>לְמִשְׁמֶֽרֶת שָׁלוֹם:</small>",
    "444": "<b>שִׂים שָׁלוֹם</b> טוֹבָה וּבְרָכָה",
    "445": "חַיִים חֵן וָחֶֽסֶד וְרַחֲמִים",
    "446": "עָלֵֽינוּ וְעַל כָּל־יִשְׂרָאֵל עַמֶּֽךָ,",
    "447": "בָּרְ֒כֵֽנוּ אָבִֽינוּ כֻּלָּֽנוּ כְּאֶחָד",
    "448": "בְּאוֹר פָּנֶֽיךָ",
    "449": "כִּי בְאוֹר פָּנֶֽיךָ",
    "450": "נָתַֽתָּ לָּֽנוּ יְהֹוָה אֱלֹהֵֽינוּ",
    "451": "תּוֹרַת חַיִּים וְאַהֲבַת חֶֽסֶד",
    "452": "וּצְדָקָה וּבְרָכָה וְרַחֲמִים",
    "453": "וְחַיִּים וְשָׁלוֹם,",
    "454": "וְטוֹב יִהְיֶה בְּעֵינֶֽיךָ",
    "455": "לְבָרְ֒כֵֽנוּ",
    "456": "וּלְבָרֵךְ אֶת־כָּל־עַמְּ֒ךָ יִשְׂרָאֵל",
    "457": "בְּכָל־עֵת וּבְכָל־שָׁעָה",
    "458": "בִּשְׁלוֹמֶֽךָ",
    "459": "(בְּרוֹב עוֹז וְשָׁלוֹם).",
    "461": "<small>בְּסֵֽפֶר חַיִּים בְּרָכָה וְשָׁלוֹם</small>",
    "462": "<small>וּפַרְנָסָה טוֹבָה</small>",
    "463": "<small>וּגְזֵרוֹת טוֹבוֹת, יְשׁוּעוֹת וְנֶחָמוֹת,</small>",
    "464": "<small>נִזָּכֵר וְנִכָּתֵב</small>",
    "465": "<small>לְפָנֶֽיךָ</small>",
    "466": "<small>אֲנַֽחְנוּ וְכָל עַמְּ֒ךָ בֵּית־יִשְׂרָאֵל</small>",
    "467": "<small>לְחַיִּים טוֹבִים וּלְשָׁלוֹם:</small>",
    "469": "בָּרוּךְ אַתָּה יְהֹוָה",
    "470": "הַמְבָרֵךְ אֶת־עַמּוֹ יִשְׂרָאֵל",
    "471": "בַּשָּׁלוֹם:",
    "472": "יִהְיוּ לְרָצוֹן",
    "473": "אִמְ֒רֵי פִי",
    "474": "וְהֶגְיוֹן לִבִּי לְפָנֶֽיךָ",
    "475": "יְהֹוָה צוּרִי וְגוֹאֲלִי:"
   },
   "en": {
    "1": "My Master, open my lips,",
    "2": "and my mouth will declare Your praise.",
    "4": "Blessed are You, Adonoy,",
    "5": "our God, and God of our fathers,",
    "6": "God of Abraham, God of Isaac,",
    "7": "and God of Jacob,",
    "8": "the Almighty,",
    "9": "the Great, the Powerful, the Awesome,",
    "10": "most high Almighty,",
    "11": "Who bestows beneficent kindness,",
    "12": "Who possesses everything,",
    "13": "Who remembers the piety of the Patriarchs,",
    "14": "and Who brings a redeemer",
    "15": "to their children's children,",
    "16": "for the sake of His Name, with love.",
    "17": "<small><i>(During the Ten Days of Penitence add:</i></small>",
    "18": "Remember us for life",
    "19": "King, Who desires life;",
    "20": "and inscribe us in the Book of Life,",
    "21": "for Your sake, Living God.)",
    "23": "King, Helper, and Deliverer and Shield.",
    "24": "Blessed are You, Adonoy,",
    "25": "Shield of Abraham.",
    "27": "You are mighty forever, my Master;",
    "28": "You are the Resurrector of the dead",
    "29": "the Powerful One to deliver us.",
    "30": "<small><i>From the Musaf of the first day of Pesach until the Musaf of Shemini Atzeres one should say:</i></small>",
    "31": "He causes the dew to descend.",
    "32": "<small><i>From the Musaf of </i>Shemini Atzeres<i> until the </i>Musaf<i> of the first day of Pesach you should say:</i></small>",
    "33": "Causer of the wind to blow",
    "34": "and of the rain to fall.",
    "36": "Sustainer of the living with kindliness,",
    "37": "Resurrector of the dead with great mercy,",
    "38": "Supporter of the fallen,",
    "39": "and Healer of the sick,",
    "40": "and Releaser of the imprisoned,",
    "41": "and Fulfiller of His faithfulness",
    "42": "to those who sleep in the dust.",
    "43": "Who is like You, Master of mighty deeds,",
    "44": "and who can be compared to You?",
    "45": "King Who causes death and restores life,",
    "46": "and causes deliverance to sprout forth.",
    "47": "<small><i>(During the Ten Days of Penitence add:</i></small>",
    "48": "Who is like You merciful Father,",
    "49": "Who remembers His creatures for life,",
    "50": "in His mercy)",
    "52": "And You are faithful",
    "53": "to restore the dead to life.",
    "54": "Blessed are You, Adonoy,",
    "55": "Resurrector of the dead.",
    "56": "<small>(When the Chazzan repeats the Shemoneh Esrei, the Kedushah is said here)</small>",
    "58": "<small><i>The Congregation says and the Chazzan repeats:</i></small>",
    "59": "We will hallow and revere You",
    "60": "as [with] the sweet words",
    "61": "of the company of the holy Seraphim",
    "62": "who thrice repeat \"holy\" unto You,",
    "63": "as is written by the hand of Your prophet,",
    "64": "And they called one to another, and said:",
    "65": "<small><i>Congregation says and Chazzan repeats:</i></small>",
    "66": "‘Holy, holy, holy,",
    "67": "is Adonoy of Hosts,",
    "68": "the fullness of all the earth is His glory.'\"",
    "69": "<small><i>The Chazzan says:</i></small>",
    "70": "Those facing them say \"Boruch...\"",
    "71": "<small><i>Congregation says and Chazzan repeats:</i></small>",
    "72": "Blessed is the glory of Adonoy",
    "73": "from its place",
    "74": "<small><i>The Chazzan says:</i></small>",
    "75": "And in Your Holy Words it is written:",
    "76": "<small><i>Congregation says and Chazzan repeats:</i></small>",
    "77": "Adonoy will reign forever;",
    "78": "Your God, Zion, throughout all generations!",
    "79": "Praise God.",
    "80": "<b>DIVINE SANCTIFICATION</b>",
    "81": "You are holy and Your Name is holy",
    "82": "and holy beings",
    "83": "praise You every day, forever.",
    "84": "For a great and Almighty King—",
    "85": "great and holy—are You.",
    "86": "<small>During the Ten Days of Penitence, continue at the asterisk (*) below</small>",
    "87": "Blessed are You, Adonoy,",
    "88": "the Almighty, the Holy One.",
    "89": "<small><i>*During the Ten Days of Penitence:</i></small>",
    "90": "Blessed are You, Adonoy,",
    "91": "the King, the Holy One.",
    "94": "You favor man with perception",
    "95": "and teach mankind understanding.",
    "96": "Grant us from Your",
    "97": "wisdom, understanding and knowledge.",
    "98": "Blessed are You, Adonoy,",
    "99": "Grantor of perception.",
    "101": "Cause us to return, our Father,",
    "102": "to Your Torah",
    "103": "and bring us near, our King, to Your service;",
    "104": "and bring us back",
    "105": "in whole-hearted repentance before You",
    "106": "Blessed are You, Adonoy,",
    "107": "Who desires penitence.",
    "109": "Pardon us, our Father, for we have sinned,",
    "110": "forgive us, our King,",
    "111": "for we have transgressed;",
    "112": "for you are a good and forgiving almighty.",
    "113": "Blessed are You, Adonoy,",
    "114": "Gracious One, Who pardons abundantly.",
    "116": "Look, please, upon our affliction,",
    "117": "and defend our cause:",
    "118": "and redeem us",
    "119": "speedily with complete redemption",
    "120": "for the sake of Your Name;",
    "121": "because You are a Mighty Redeemer.",
    "122": "Blessed are You, Adonoy,",
    "123": "Redeemer of Israel.",
    "124": "<small>(On Fast Days, the Chazzan says \"Answer us\" and concludes, \"Blessed are ... Who responds at times of trouble.\") </small>",
    "126": "Heal us, Adonoy, and we will be healed,",
    "127": "deliver us and we will be delivered;",
    "128": "for You are our praise.",
    "129": "Grant a cure and healing",
    "130": "to all our sickness",
    "131": "and to all our pain",
    "132": "and to all our affliction",
    "145": "because You are the Almighty, King,",
    "146": "Who is a faithful and merciful Healer.",
    "147": "Blessed are You, Adonoy,",
    "148": "Healer of the sick of His people Israel.",
    "150": "Bless for us, Adonoy our God,",
    "151": "this year",
    "152": "and all the varieties of its produce",
    "153": "for good;",
    "154": "and bestow",
    "155": "<small>From the first say of Pesach until the evening service [<i>Maariv</i>] on December 4, or, on a civil leap year, December 5, we say the following line.</small>",
    "156": "blessing",
    "157": "<small>From the evening service [<i>Maariv</i>] on December 4, or, on a civil leap year, December 5, until the First day of Pesach, we say the following line.</small>",
    "158": "dew and rain for a blessing*",
    "159": "upon the face of the earth;",
    "160": "satisfy us from Your bounty",
    "161": "for you are generous Almighty",
    "162": "who bestows goodness",
    "163": "and blesses the years.",
    "164": "Blessed are You, Adonoy,",
    "165": "Blesser of the years.",
    "168": "Sound the great <i>shofar</i> for our liberty,",
    "169": "and raise a banner to gather our exiles,",
    "170": "and gather us together quickly",
    "171": "from the four corners of the earth.",
    "172": "into our Land.",
    "173": "Blessed are You, Adonoy,",
    "174": "Gatherer",
    "175": "of the dispersed of His people Israel.",
    "177": "Restore our judges as before",
    "178": "and our counselors as at first.",
    "179": "Remove from us sorrow and sighing,",
    "180": "and reign over us quickly",
    "181": "You, Adonoy, alone",
    "182": "with kindness and compassion;",
    "183": "and make us righteous",
    "184": "with righteousness and justice,",
    "185": "<small>During the Ten Days of Penitence, continue at the asterisk (*) below</small>",
    "186": "Blessed are You, Adonoy,",
    "187": "King, Lover of righteousness and justice.",
    "188": "<small><i>*During the Ten Days of Penitence:</i></small>",
    "189": "Blessed are You, Adonoy,",
    "190": "the King of Justice.",
    "193": "For informers let there be no hope",
    "194": "and may all wickedness instantly perish",
    "195": "may all Your enemies be swiftly cut off,",
    "196": "and the insolent",
    "197": "may You quickly uproot, crush, rout,",
    "198": "disgrace and humbled",
    "199": "and subdue speedily in our days.",
    "200": "Blessed are You, Adonoy,",
    "201": "Crusher of enemies",
    "202": "and Subduer of the insolent.",
    "204": "Upon the righteous, upon the pious,",
    "205": "upon the elders of Your people",
    "206": "the House of Israel,",
    "207": "upon the remnant of their scholars,",
    "208": "upon the true proselytes, and upon us,",
    "209": "may Your mercy be aroused,",
    "210": "Adonoy our God.",
    "211": "Grant bountiful reward",
    "212": "to all who trust in Your Name in truth;",
    "213": "and place our lot among them,",
    "214": "and may we never be put to shame,",
    "215": "for in You we have put our trust.",
    "216": "Blessed are You, Adonoy,",
    "217": "Support and Trust of the righteous.",
    "219": "And to Jerusalem, Your city,",
    "220": "return in mercy,",
    "221": "and dwell therein as You have spoken;",
    "222": "and rebuild it soon, in our days,",
    "223": "as an everlasting structure,",
    "224": "and the throne of David, Your servant",
    "225": "may You speedily establish therein.",
    "226": "Blessed are You, Adonoy,",
    "227": "Builder of Jerusalem.",
    "229": "The sprout of David, Your servant,",
    "230": "speedily cause to flourish",
    "231": "and exalt his power with Your deliverance,",
    "232": "For Your deliverance we hope all day.",
    "233": "and watch for Your deliverance.",
    "234": "Blessed are You, Adonoy,",
    "235": "Who causes to sprout",
    "236": "the power of salvation.",
    "238": "Merciful Father",
    "239": "Hear our voice, Adonoy, our God;",
    "240": "spare us and have compassion on us,",
    "241": "and accept",
    "242": "our prayers compassionately and willingly,",
    "243": "for You are Almighty",
    "244": "Who hears prayers and supplications;",
    "245": "and from Your Presence, our King,",
    "246": "do not turn us away empty-handed,",
    "247": "be gracious and answer us",
    "248": "and hear our prayer*",
    "249": "for You hear the prayers of every mouth",
    "250": "of Your people, Israel, with compassion.",
    "251": "Blessed are You, Adonoy,",
    "252": "Who hears prayers.",
    "256": "Be pleased, Adonoy, our God,",
    "257": "with Your people Israel",
    "258": "and pay need to their prayer;",
    "259": "and restore the service",
    "260": "to the Holy of Holies in Your abode,",
    "261": "and the fire-offerings of Israel;",
    "262": "and accept their prayer, lovingly",
    "263": "and willingly.",
    "264": "And may You always find pleasure",
    "265": "with the service of Your people, Israel.",
    "266": "<small><i>On regular weekdays continue, \"And may our eyes\". On Rosh Chodesh and on Chol HaMoed, the following prayer is added:</i></small>",
    "267": "Our God and God of our fathers,",
    "268": "may there ascend, come, and reach,",
    "269": "appear, be desired, and heard,",
    "270": "counted and recalled",
    "271": "our remembrance and reckoning;",
    "272": "the remembrance of our fathers;",
    "273": "the remembrance of the Messiah",
    "274": "the son of David, Your servant;",
    "275": "the remembrance of Jerusalem,",
    "276": "city of Your Sanctuary;",
    "277": "and the remembrance of Your entire people,",
    "278": "the House of Israel, before You",
    "279": "for survival, for well-being,",
    "280": "for favor, kindliness, compassion,",
    "281": "for good life and peace",
    "282": "on this day of:",
    "283": "<i>Rosh Chodesh</i>",
    "284": "the <i>Festival of Matzos</i>",
    "285": "the <i>Festival of Sukkos</i>",
    "286": "Remember us Adonoy, our God,",
    "287": "on this day for well-being;",
    "288": "be mindful of us on this day for blessing,",
    "289": "and deliver us for good life.",
    "290": "In accord with the promise of deliverance",
    "291": "and compassion,",
    "292": "spare us and favor us,",
    "293": "have compassion on us and deliver us;",
    "294": "for to You our eyes are directed",
    "295": "because You are the Almighty",
    "296": "Who is King, Gracious, and Merciful.",
    "301": "And may our eyes behold",
    "302": "Your merciful return to Zion.",
    "303": "Blessed are You, Adonoy,",
    "304": "Who returns His Divine Presence to Zion.",
    "305": "<small>At the words, <i>We are thankful,</i> bend forward; at <i>Adonoy</i> return to an upright position.</small>",
    "307": "We are thankful to You",
    "308": "that You Adonoy are our God",
    "309": "and the God of our fathers forever;",
    "310": "Rock of our lives,",
    "311": "the Shield of our deliverance,",
    "312": "You are in every generation.",
    "313": "We will give thanks to You",
    "314": "and recount Your praise,",
    "315": "for our lives",
    "316": "which are committed into Your hand,",
    "317": "and for our souls",
    "318": "which are entrusted to You,",
    "319": "and for Your miracles of every day with us,",
    "320": "and for Your wonders and benefactions",
    "321": "at all times—",
    "322": "evening, morning and noon.",
    "323": "(You are) The Beneficent One—",
    "324": "for Your compassion is never withheld;",
    "325": "And (You are) the Merciful One—",
    "326": "for Your kindliness never ceases;",
    "327": "for we have always placed our hope in You.",
    "329": "We are thankful to You,",
    "330": "that You Adonoy are our God,",
    "331": "and God of our fathers,",
    "332": "God of all flesh,",
    "333": "Our Creator, Creator of the Beginning.",
    "334": "Blessings and thanksgivings",
    "335": "to Your great and holy Name",
    "336": "for keeping us alive, and sustaining us;",
    "337": "so may You always keep us alive",
    "338": "and sustain us,",
    "339": "and gather our exiles",
    "340": "to the Courtyards of Your Sanctuary",
    "341": "to observe Your statutes,",
    "342": "and to do Your will,",
    "343": "and to serve You wholeheartedly,",
    "344": "for we are thankful to You.",
    "345": "Blessed is the Almighty",
    "346": "to Whom all thanks are due.",
    "348": "[We thank You] for the miracles",
    "349": "for the redemption, for the mighty deeds,",
    "350": "for the deliverances, for the wonders",
    "351": "for the consolations and for the wars",
    "352": "that You performed for our fathers",
    "353": "in those days at this season.",
    "354": "<small><i>On Chanukah:</i></small>",
    "355": "In the days of Matisyahu,",
    "356": "son of Yochanan the High Priest,",
    "357": "the Hasmonean and his sons,",
    "358": "when the evil Greek kingdom rose up",
    "359": "against Your people Israel",
    "360": "to make them forget Your Torah",
    "361": "and to turn them away",
    "362": "from the statutes of Your will—",
    "363": "You, in Your abundant mercy,",
    "364": "stood by them in their time of distress,",
    "365": "You defended their cause,",
    "366": "You judged their grievances,",
    "367": "You avenged them.",
    "368": "You delivered the mighty",
    "369": "into the hands of the weak,",
    "370": "many into the hands of the few,",
    "371": "defiled people into the hands of the undefiled,",
    "372": "the wicked into the hands of the righteous,",
    "373": "and insolent [sinners] into the hands of",
    "374": "diligent students of Your Torah.",
    "375": "And You made Yourself",
    "376": "a great and sanctified name in Your world.",
    "377": "And for Your people, Israel,",
    "378": "You performed a great deliverance",
    "379": "and redemption unto this very day.",
    "380": "Afterwards, Your sons entered",
    "381": "the Holy of Holies of Your Abode,",
    "382": "cleaned Your Temple,",
    "383": "purified Your Sanctuary,",
    "384": "and kindled lights",
    "385": "in the Courtyards of Your Sanctuary,",
    "386": "and designated these eight days of Chanukah",
    "387": "to thank and praise Your great Name.",
    "388": "<small><i>On Purim:</i></small>",
    "389": "In the days of Mordechai and Esther",
    "390": "in Shushan the Capital [of Persia],",
    "391": "when the evil Haman rose up against them,",
    "392": "he sought to destroy, to kill,",
    "393": "and to annihilate all the Jews,",
    "394": "young and old, infants and women,",
    "395": "in one day, the thirteenth day",
    "396": "of the twelfth month,",
    "397": "which is the month of Adar,",
    "398": "and to plunder their wealth—",
    "399": "And You, in Your abundant mercy,",
    "400": "annulled his counsel,",
    "401": "frustrated his intention,",
    "402": "and brought his evil plan upon his own head,",
    "403": "and they hanged him and his sons",
    "404": "upon the gallows.",
    "405": "And for all the foregoing",
    "406": "blessed, exalted and extolled",
    "407": "your Name, our King",
    "408": "constantly, forever and ever.",
    "409": "<small><i>During the Ten Days of Penitence, add:</i></small>",
    "410": "Inscribe for a good life",
    "411": "all the children of Your covenant.",
    "413": "And all the living shall thank You forever",
    "414": "and praise and bless",
    "415": "Your great Name with sincerity forever;",
    "416": "for You are goodness—",
    "417": "the Almighty, Who is our deliverance",
    "418": "and our help forever—",
    "419": "the benevolent Almighty.",
    "420": "Blessed are You, Adonoy,",
    "421": "The Beneficent is Your Name",
    "422": "and You it is fitting to praise.",
    "423": "<small>To be said by the Chazzan</small>",
    "425": "Our God, and God of our fathers, bless us",
    "426": "with the threefold blessing of the Torah,",
    "427": "written by the hand of Moses, Your servant,",
    "428": "pronounced from the mouth of Aaron",
    "429": "and his sons, the <i>kohanim,</i> Your holy people;",
    "430": "as it is said:",
    "431": "Adonoy bless you and guard you.",
    "432": "Adonoy shine His countenance upon you",
    "433": "and be gracious unto you.",
    "434": "Adonoy turn His countenance toward you",
    "435": "and grant you peace.",
    "436": "<small><i>After Birkas Kohanim the congregation says:</i></small>",
    "437": "Mighty One on high who dwells in might,",
    "438": "You are peace and Your Name is peace.",
    "439": "May it be Your will that You grant us",
    "440": "and all of Your people, the House of Israel",
    "441": "life and blessing",
    "442": "for a safeguard to peace.",
    "444": "Grant peace, goodness, and blessing,",
    "445": "life favor, kindness and compassion",
    "446": "upon us and upon all Israel, Your people.",
    "447": "Bless us, our Father, all of us as one",
    "448": "with the light of Your countenance.",
    "449": "For by the light of Your countenance",
    "450": "You gave us Adonoy our God,",
    "451": "a Torah of life and the love of kindliness,",
    "452": "righteousness, blessing, compassion,",
    "453": "life, and peace.",
    "454": "And may it be good in Your sight",
    "455": "to bless us",
    "456": "and to bless Your people Israel,",
    "457": "at all times and at every moment",
    "458": "with Your peace",
    "459": "(with much strength and peace).",
    "460": "<small><i>During the Ten Days of Penitence continue here:</i></small>",
    "461": "In the book of life, blessing, peace",
    "462": "and abundant maintenance,",
    "463": "good decrees, salvations and condolences,",
    "464": "may we be remembered and inscribed",
    "465": "before You;",
    "466": "we and all Your people, the House of Israel",
    "467": "for a good life and peace.",
    "469": "Blessed are You, Adonoy,",
    "470": "Who blesses His people Israel",
    "471": "with peace.",
    "472": "May they be acceptable",
    "473": "the words of my mouth",
    "474": "and the thoughts of my heart, before You",
    "475": "Adonoy, my Rock and my Redeemer."
   }
  }
 }
