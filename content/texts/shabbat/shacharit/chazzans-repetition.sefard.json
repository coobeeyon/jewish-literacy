{
 "id": "shabbat/shacharit/chazzans-repetition:sefard",
 "refs": {
  "Shabbat Siddur Sefard Linear, The Morning Prayers, Amidah for Shabbos Morning": {
   "edition": "metsudah-sefard-shabbat",
   "he": {
    "2": "אֲדֹנָי שְׂפָתַי תִּפְתָּח",
    "3": "וּפִי יַגִּיד תְּהִלָּתֶֽךָ:",
    "4": "בָּרוּךְ אַתָּה יְהֹוָה",
    "5": "אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ",
    "6": "אֱלֹהֵי אַבְרָהָם אֱלֹהֵי יִצְחָק",
    "7": "וֵאלֹהֵי יַעֲקֹב",
    "8": "הָאֵל",
    "9": "הַגָּדוֹל הַגִּבּוֹר וְהַנּוֹרָא",
    "10": "אֵל עֶלְיוֹן",
    "11": "גּוֹמֵל חֲסָדִים טוֹבִים",
    "12": "וְקוֹנֵה הַכֹּל",
    "13": "וְזוֹכֵר חַסְדֵי אָבוֹת",
    "14": "וּמֵבִיא גוֹאֵל",
    "15": "לִבְנֵי בְנֵיהֶם",
    "16": "לְמַֽעַן שְׁמוֹ בְּאַהֲבָה:",
    "18": "<small>זָכְרֵֽנוּ לְחַיִּים</small>",
    "19": "<small>מֶֽלֶךְ חָפֵץ בַּחַיִּים</small>",
    "20": "<small>וְכָתְבֵֽנוּ בְּסֵֽפֶר הַחַיִּים</small>",
    "21": "<small>לְמַעַנְךָ אֱלֹהִים חַיִּים:</small>",
    "23": "מֶֽלֶךְ עוֹזֵר וּמוֹשִֽׁיעַ וּמָגֵן:",
    "24": "בָּרוּךְ אַתָּה יְהֹוָה",
    "25": "מָגֵן אַבְרָהָם:",
    "27": "אַתָּה גִבּוֹר לְעוֹלָם אֲדֹנָי",
    "28": "מְחַיֶּה מֵתִים אַתָּה",
    "29": "רַב לְהוֹשִֽׁיעַ:",
    "31": "<b>מוֹרִיד הַטָּל</b>",
    "33": "<b>מַשִּׁיב הָרֽוּחַ</b>",
    "34": "<b>וּמוֹרִיד הַגֶּֽשֶׁם:</b>",
    "36": "מְכַלְכֵּל חַיִּים בְּחֶֽסֶד",
    "37": "מְחַיֵּה מֵתִים בְּרַחֲמִים רַבִּים",
    "38": "סוֹמֵךְ נוֹפְ֒לִים",
    "39": "וְרוֹפֵא חוֹלִים",
    "40": "וּמַתִּיר אֲסוּרִים",
    "41": "וּמְקַיֵּם אֱמוּנָתוֹ",
    "42": "לִישֵׁנֵי עָפָר.",
    "43": "מִי כָמֽוֹךָ בַּֽעַל גְּבוּרוֹת",
    "44": "וּמִי דּֽוֹמֶה לָּךְ",
    "45": "מֶֽלֶךְ מֵמִית וּמְחַיֶּה",
    "46": "וּמַצְמִֽיחַ יְשׁוּעָה:",
    "48": "<small>מִי כָמֽוֹךָ אַב הָרַחֲמִים</small>",
    "49": "<small>זוֹכֵר יְצוּרָיו לְחַיִּים</small>",
    "50": "<small>בְּרַחֲמִים:</small>",
    "52": "וְנֶאֱמָן אַתָּה",
    "53": "לְהַחֲיוֹת מֵתִים:",
    "54": "בָּרוּךְ אַתָּה יְהֹוָה",
    "55": "מְחַיֵּה הַמֵּתִים:",
    "60": "נַקְדִישָׁךְ וְנַעֲרִיצָךְ",
    "61": "כְּנֹֽעַם שִֽׂיחַ",
    "62": "סוֹד שַׂרְ֒פֵי קֽוֹדֶשׁ",
    "63": "הַמְּ֒שַׁלְּ֒שִׁים לְךָ קְדֻשָּׁה",
    "64": "כַּכָּתוּב עַל יַד נְבִיאֶֽךָ",
    "65": "וְקָרָא זֶה אֶל זֶה וְאָמַר:",
    "66": "<b>קָדוֹשׁ קָדוֹשׁ קָדוֹשׁ</b>",
    "67": "<b>יְהֹוָה צְבָאוֹת</b>",
    "68": "<b>מְלֹא כָל הָאָֽרֶץ כְּבוֹדוֹ:</b>",
    "69": "לְעֻמָּתָם מְשַׁבְּ֒חִים וְאוֹמְ֒רִים:",
    "70": "❖אָז בְּקוֹל רַֽעַשׁ גָּדוֹל",
    "71": "אַדִּיר וְחָזָק",
    "72": "מַשְׁמִיעִים קוֹל",
    "73": "מִתְנַשְּׂ֒אִים לְעֻמַּת שְׂרָפִים.",
    "74": "לְעֻמָּתָם מְשַׁבְּ֒חִים וְאוֹמְ֒רִים:",
    "76": "<b>בָּרוּךְ כְּבוֹד יְהֹוָה</b>",
    "77": "<b>מִמְּ֒קוֹמוֹ:</b>",
    "78": "❖מִמְּ֒קוֹמְךָ מַלְכֵּֽנוּ תוֹפִֽיעַ",
    "79": "וְתִמְלוֹךְ עָלֵֽינוּ",
    "80": "כִּי מְחַכִּים אֲנַֽחְנוּ לָךְ.",
    "81": "מָתַי תִּמְלוֹךְ בְּצִיּוֹן",
    "82": "בְּקָרוֹב בְּיָמֵֽינוּ",
    "83": "לְעוֹלָם וָעֶד תִּשְׁכּוֹן.",
    "84": "תִּתְגַּדַּל וְתִתְקַדַּשׁ",
    "85": "בְּתוֹךְ יְרוּשָׁלַֽםִ עִירְ֒ךָ",
    "86": "לְדוֹר וָדוֹר וּלְנֵֽצַח נְצָחִים.",
    "87": "וְעֵינֵֽינוּ תִרְאֶֽינָה מַלְכוּתֶֽךָ",
    "88": "כַּדָּבָר הָאָמוּר בְּשִׁירֵי עֻזֶּֽךָ",
    "89": "עַל יְדֵי דָוִד",
    "90": "מְשִֽׁיחַ צִדְקֶֽךָ:",
    "92": "<b>יִמְלֹךְ יְהֹוָה לְעוֹלָם</b>",
    "93": "<b>אֱלֹהַֽיִךְ צִיּוֹן לְדֹר וָדֹר</b>",
    "94": "<b>הַלְ֒לוּיָהּ:</b>",
    "95": "<b>קדושת השם</b>",
    "96": "אַתָּה קָדוֹשׁ וְשִׁמְךָ קָדוֹשׁ",
    "97": "וּקְדוֹשִׁים",
    "98": "בְּכָל יוֹם יְהַלְ֒לֽוּךָ סֶּֽלָה:",
    "100": "בָּרוּךְ אַתָּה יְהֹוָה",
    "101": "הָאֵל הַקָּדוֹשׁ:",
    "102": "<small>בָּרוּךְ אַתָּה יְהֹוָה</small>",
    "103": "<small>הַמֶּֽלֶךְ הַקָּדוֹשׁ:</small>",
    "106": "יִשְׂמַח משֶׁה",
    "107": "בְּמַתְּ֒נַת חֶלְקוֹ.",
    "108": "כִּי עֶֽבֶד נֶאֱמָן קָרָֽאתָ־לּוֹ.",
    "109": "כְּלִיל תִּפְאֶֽרֶת",
    "110": "בְּרֹאשׁוֹ נָתַֽתָּ לוֹ",
    "111": "בְּעָמְדוֹ לְפָנֶֽיךָ עַל־הַר סִינָי.",
    "112": "וּשְׁנֵי לוּחוֹת אֲבָנִים",
    "113": "הוֹרִיד בְּיָדוֹ",
    "114": "וְכָתוּב בָּהֶם",
    "115": "שְׁמִירַת שַׁבָּת.",
    "116": "וְכֵן כָּתוּב בְּתוֹרָתֶֽךָ:",
    "117": "וְשָׁמְ֒רוּ בְנֵי־יִשְׂרָאֵל",
    "118": "אֶת־הַשַּׁבָּת.",
    "119": "לַעֲשׂוֹת אֶת־הַשַּׁבָּת לְדֹרֹתָם",
    "120": "בְּרִית עוֹלָם:",
    "121": "בֵּינִי",
    "122": "וּבֵין בְּנֵי יִשְׂרָאֵל",
    "123": "אוֹת הִיא לְעֹלָם.",
    "124": "כִּי־שֵֽׁשֶׁת יָמִים עָשָׂה יְהֹוָה",
    "125": "אֶת־הַשָּׁמַֽיִם וְאֶת־הָאָֽרֶץ",
    "126": "וּבַיּוֹם הַשְּׁ֒בִיעִי",
    "127": "שָׁבַת וַיִּנָּפַשׁ:",
    "128": "וְלֹא נְתַתּוֹ יְהֹוָה אֱלֹהֵֽינוּ",
    "129": "לְגוֹיֵי הָאֲרָצוֹת.",
    "130": "וְלֹא הִנְחַלְתּוֹ",
    "131": "מַלְכֵּֽנוּ",
    "132": "לְעוֹבְ֒דֵי פְסִילִים.",
    "133": "וְגַם בִּמְנוּחָתוֹ",
    "134": "לֹא יִשְׁכְּ֒נוּ עֲרֵלִים.",
    "135": "כִּי לְיִשְׂרָאֵל עַמְּ֒ךָ",
    "136": "נְתַתּוֹ בְּאַהֲבָה.",
    "137": "לְזֶֽרַע יַעֲקֹב",
    "138": "אֲשֶׁר בָּם בָּחָרְתָּ:",
    "139": "יִשְׂמְחוּ בְמַלְכוּתְ֒ךָ",
    "140": "שׁוֹמְ֒רֵי שַׁבָּת",
    "141": "וְקוֹרְ֒אֵי עוֹנֶג.",
    "142": "עַם מְקַדְּ֒שֵׁי שְׁבִיעִי",
    "143": "כֻּלָּם יִשְׂבְּ֒עוּ",
    "144": "וְיִתְעַנְּ֒גוּ מִטּוּבֶֽךָ.",
    "145": "וּבַשְּׁ֒בִיעִי רָצִֽיתָ בּוֹ",
    "146": "וְקִדַּשְׁתּוֹ.",
    "147": "חֶמְדַּת יָמִים אוֹתוֹ קָרָֽאתָ.",
    "148": "זֵֽכֶר לְמֲַשֵׂה בְרֵאשִׁית:",
    "149": "אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ",
    "150": "רְצֵה בִמְנוּחָתֵֽנוּ.",
    "151": "קַדְּ֒שֵֽׁנוּ בְּמִצְוֹתֶֽיךָ",
    "152": "וְתֵן חֶלְקֵֽנוּ בְּתוֹרָתֶֽךָ",
    "153": "שַׂבְּ֒עֵֽנוּ מִטּוּבֶֽךָ.",
    "154": "וְשַׂמְּ֒חֵֽנוּ בִּישׁוּעָתֶֽךָ.",
    "155": "וְטַהֵר לִבֵּֽנוּ לְעָבְדְּ֒ךָ בֶּאֱמֶת.",
    "156": "וְהַנְחִילֵֽנוּ",
    "157": "יְהֹוָה אֱלֹהֵֽינוּ",
    "158": "בְּאַהֲבָה וּבְרָצוֹן",
    "159": "שַׁבַּת קָדְשֶֽׁךָ.",
    "160": "וְיָנֽוּחוּ בוֹ יִשְׂרָאֵל",
    "161": "מְקַדְּ֒שֵׁי שְׁמֶֽךָ:",
    "162": "בָּרוּךְ אַתָּה יְהֹוָה",
    "163": "מְקַדֵּשׁ הַשַּׁבָּת:",
    "165": "רְצֵה יְהֹוָה אֱלֹהֵֽינוּ",
    "166": "בְּעַמְּ֒ךָ יִשְׂרָאֵל וּבִתְפִלָּתָם.",
    "167": "וְהָשֵׁב אֶת הָעֲבוֹדָה",
    "168": "לִדְבִיר בֵּיתֶֽךָ",
    "169": "וְאִשֵּׁי יִשְׂרָאֵל.",
    "170": "וּתְפִלָּתָם בְּאַהֲבָה תְקַבֵּל בְּרָצוֹן",
    "171": "וּתְהִי לְרָצוֹן תָּמִיד",
    "172": "עֲבוֹדַת יִשְׂרָאֵל עַמֶּֽךָ:",
    "175": "אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ",
    "176": "יַעֲלֶה וְיָבֹא וְיַגִּֽיעַ",
    "177": "וְיֵרָאֶה וְיֵרָצֶה וְיִשָּׁמַע",
    "178": "וְיִפָּקֵד וְיִזָּכֵר",
    "179": "זִכְרוֹנֵֽנוּ וּפִקְדוֹנֵֽנוּ",
    "180": "וְזִכְרוֹן אֲבוֹתֵֽינוּ",
    "181": "וְזִכְרוֹן מָשִֽׁיחַ",
    "182": "בֶּן דָּוִד עַבְדֶּֽךָ",
    "183": "וְזִכְרוֹן יְרוּשָׁלַֽםִ",
    "184": "עִיר קָדְשֶֽׁךָ",
    "185": "וְזִכְרוֹן כָּל עַמְּ֒ךָ",
    "186": "בֵּית יִשְׂרָאֵל לְפָנֶֽיךָ.",
    "187": "לִפְלֵיטָה לְטוֹבָה",
    "188": "לְחֵן וּלְחֶֽסֶד וּלְרַחֲמִים",
    "189": "לְחַיִּים וּלְשָׁלוֹם",
    "190": "בְּיוֹם",
    "191": "<small>לר\"ח:</small> רֹאשׁ הַחֹֽדֶשׁ הַזֶּה ",
    "192": "<small>לפסח:</small> חַג הַמַּצּוֹת הַזֶּה",
    "193": "<small>לסכות:</small> חַג הַסֻּכּוֹת הַזֶּה",
    "194": "זָכְרֵֽנוּ יְהֹוָה אֱלֹהֵֽינוּ",
    "195": "בּוֹ לְטוֹבָה.",
    "196": "וּפָקְדֵֽנוּ בוֹ לִבְרָכָה.",
    "197": "וְהוֹשִׁיעֵֽנוּ בוֹ לְחַיִּים.",
    "198": "וּבִדְבַר יְשׁוּעָה",
    "199": "וְרַחֲמִים",
    "200": "חוּס וְחָנֵּֽנוּ.",
    "201": "וְרַחֵם עָלֵֽינוּ וְהוֹשִׁיעֵֽנוּ.",
    "202": "כִּי אֵלֶֽיךָ עֵינֵֽינוּ.",
    "203": "כִּי אֵל",
    "204": "מֶֽלֶךְ חַנּוּן וְרַחוּם אָֽתָּה:",
    "206": "וְתֶחֱזֶֽינָה עֵינֵֽינוּ",
    "207": "בְּשׁוּבְ֒ךָ לְצִיּוֹן בְּרַחֲמִים.",
    "208": "בָּרוּךְ אַתָּה יְהֹוָה",
    "209": "הַמַּחֲזִיר שְׁכִינָתוֹ לְצִיּוֹן:",
    "212": "מוֹדִים אֲנַֽחְנוּ לָךְ",
    "213": "שָׁאַתָּה הוּא יְהֹוָה אֱלֹהֵֽינוּ",
    "214": "וֵאלֹהֵי אֲבוֹתֵֽינוּ לְעוֹלָם וָעֶד",
    "215": "צוּר חַיֵּֽינוּ",
    "216": "מָגֵן יִשְׁעֵֽנוּ",
    "217": "אַתָּה הוּא לְדוֹר וָדוֹר",
    "218": "נוֹדֶה לְּךָ",
    "219": "וּנְסַפֵּר תְּהִלָּתֶֽךָ",
    "220": "עַל חַיֵּֽינוּ",
    "221": "הַמְּ֒סוּרִים בְּיָדֶֽךָ",
    "222": "וְעַל נִשְׁמוֹתֵֽינוּ הַפְּ֒קוּדוֹת לָךְ",
    "223": "וְעַל נִסֶּֽיךָ שֶׁבְּ֒כָל יוֹם עִמָּֽנוּ",
    "224": "וְעַל נִפְלְ֒אוֹתֶֽיךָ וְטוֹבוֹתֶֽיךָ",
    "225": "שֶׁבְּ֒כָל עֵת.",
    "226": "עֶֽרֶב וָבֹֽקֶר וְצָהֳרָֽיִם.",
    "227": "הַטּוֹב",
    "228": "כִּי לֹא כָלוּ רַחֲמֶֽיךָ",
    "229": "וְהַמְ֒רַחֵם",
    "230": "כִּי לֹא תַֽמּוּ חֲסָדֶֽיךָ.",
    "231": "מֵעוֹלָם קִוִּֽינוּ לָךְ:",
    "233": "מוֹדִים אֲנַֽחְנוּ לָךְ",
    "234": "שָׁאַתָּה הוּא יְהֹוָה אֱלֹהֵֽינוּ",
    "235": "וֵאלֹהֵי אֲבוֹתֵֽינוּ",
    "236": "אֱלֹהֵי כָל בָּשָׂר",
    "237": "יוֹצְ֒רֵֽנוּ יוֹצֵר בְּרֵאשִׁית",
    "238": "בְּרָכוֹת וְהוֹדָאוֹת",
    "239": "לְשִׁמְךָ הַגָּדוֹל וְהַקָּדוֹשׁ",
    "240": "עַל שֶׁהֶחֱיִיתָֽנוּ וְקִיַּמְתָּֽנוּ",
    "241": "כֵּן תְּחַיֵּֽינוּ",
    "242": "וּתְקַיְּ֒מֵֽנוּ",
    "243": "וְתֶאֱסוֹף גָּלֻיּוֹתֵֽינוּ",
    "244": "לְחַצְרוֹת קָדְשֶֽׁךָ",
    "245": "לִשְׁמוֹר חֻקֶּֽיךָ",
    "246": "וְלַעֲשׂוֹת רְצוֹנֶֽךָ",
    "247": "וּלְעָבְדְּ֒ךָ בְּלֵבָב שָׁלֵם",
    "248": "עַל שֶׁאָֽנוּ מוֹדִים לָךְ.",
    "249": "בָּרוּךְ אֵל",
    "250": "הַהוֹדָאוֹת:",
    "252": "וְעַל הַנִּסִּים",
    "253": "וְעַל הַפֻּרְקָן וְעַל הַגְּ֒בוּרוֹת",
    "254": "וְעַל הַתְּ֒שׁוּעוֹת וְעַל הַמִּלְחָמוֹת",
    "255": "שֶׁעָשִֽׂיתָ לַאֲבוֹתֵֽינוּ",
    "256": "בַּיָּמִים הָהֵם בַּזְּ֒מַן הַזֶּה:",
    "257": "בִּימֵי מַתִּתְיָֽהוּ",
    "258": "בֶּן יוֹחָנָן כֹּהֵן גָּדוֹל",
    "259": "חַשְׁמוֹנַאי וּבָנָיו",
    "260": "כְּשֶׁעָמְ֒דָה מַלְכוּת יָוָן הָרְ֒שָׁעָה",
    "261": "עַל עַמְּ֒ךָ יִשְׂרָאֵל",
    "262": "לְהַשְׁכִּיחָם תּוֹרָתֶֽךָ",
    "263": "וּלְהַעֲבִירָם",
    "264": "מֵחֻקֵּי רְצוֹנֶֽךָ.",
    "265": "וְאַתָּה בְּרַחֲמֶֽיךָ הָרַבִּים",
    "266": "עָמַֽדְתָּ לָהֶם בְּעֵת צָרָתָם",
    "267": "רַֽבְתָּ אֶת רִיבָם",
    "268": "דַּֽנְתָּ אֶת דִּינָם",
    "269": "נָקַֽמְתָּ אֶת נִקְמָתָם",
    "270": "מָסַֽרְתָּ גִבּוֹרִים",
    "271": "בְּיַד חַלָּשִׁים",
    "272": "וְרַבִּים בְּיַד מְעַטִּים",
    "273": "וּטְמֵאִים בְּיַד טְהוֹרִים",
    "274": "וּרְשָׁעִים בְּיַד צַדִּיקִים",
    "275": "וְזֵדִים בְּיַד",
    "276": "עוֹסְ֒קֵי תוֹרָתֶֽךָ",
    "277": "וּלְךָ עָשִֽׂיתָ",
    "278": "שֵׁם גָּדוֹל וְקָדוֹשׁ בְּעוֹלָמֶֽךָ",
    "279": "וּלְעַמְּ֒ךָ יִשְׂרָאֵל",
    "280": "עָשִֽׂיתָ תְּשׁוּעָה גְדוֹלָה",
    "281": "וּפֻרְקָן כְּהַיּוֹם הַזֶּה",
    "282": "וְאַחַר כַּךְ בָּֽאוּ בָנֶֽיךָ",
    "283": "לִדְבִיר בֵּיתֶֽךָ",
    "284": "וּפִנּוּ אֶת הֵיכָלֶֽךָ",
    "285": "וְטִהֲרוּ אֶת מִקְדָּשֶֽׁךָ",
    "286": "וְהִדְלִֽיקוּ נֵרוֹת",
    "287": "בְּחַצְרוֹת קָדְשֶֽׁךָ",
    "288": "וְקָבְ֒עוּ שְׁמוֹנַת יְמֵי חֲנֻכָּה אֵֽלּוּ",
    "289": "לְהוֹדוֹת וּלְהַלֵּל לְשִׁמְךָ הַגָּדוֹל:",
    "290": "וְעַל כֻּלָּם",
    "291": "יִתְבָּרַךְ וְיִתְרוֹמַם וְיִתְנַשֵׂא",
    "292": "שִׁמְ֒ךָ מַלְכֵּֽנוּ",
    "293": "תָּמִיד לְעוֹלָם וָעֶד:",
    "295": "<small>וּכְתֹב לְחַיִּים טוֹבִים</small>",
    "296": "<small>כָּל בְּנֵי בְרִיתֶֽךָ:</small>",
    "298": "וְכֹל הַחַיִּים יוֹדֽוּךָ סֶּֽלָה",
    "299": "וִיהַלְ֒לוּ וְיבָרְ֒כוּ",
    "300": "אֶת שִׁמְ֒ךָ הַגָּדוֹל בְּאֱמֶת לְעוֹלָם",
    "301": "כִּי טוֹב",
    "302": "הָאֵל יְשׁוּעָתֵֽנוּ",
    "303": "וְעֶזְרָתֵֽנוּ סֶֽלָה",
    "304": "הָאֵל הַטּוֹב:",
    "305": "בָּרוּךְ אַתָּה יְהֹוָה",
    "306": "הַטּוֹב שִׁמְ֒ךָ",
    "307": "וּלְ֒ךָ נָאֶה לְהוֹדוֹת:",
    "310": "אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ בָּרְ֒כֵֽנוּ",
    "311": "בַבְּ֒רָכָה הַמְּ֒שֻׁלֶּֽשֶׁת בַּתּוֹרָה",
    "312": "הַכְּ֒תוּבָה עַל יְדֵי משֶׁה עַבְדֶּֽךָ,",
    "313": "הָאֲמוּרָה מִפִּי אַהֲרֹן",
    "314": "וּבָנָיו כֹּהֲנִים עַם קְדוֹשֶֽׁךָ",
    "315": "כָּאָמוּר:",
    "316": "יְבָרֶכְךָ יְהֹוָה וְיִשְׁמְ֒רֶֽךָ:",
    "317": "יָאֵר יְהֹוָה פָּנָיו אֵלֶֽיךָ",
    "318": "וִיחֻנֶּֽךָ:",
    "319": "יִשָּׂא יְהֹוָה פָּנָיו אֵלֶֽיךָ",
    "320": "וְיָשֵׂם לְךָ שָׁלוֹם:",
    "322": "אַדִּיר בַּמָּרוֹם שׁוֹכֵן בִּגְ֒בוּרָה,",
    "323": "אַתָּה שָׁלוֹם וְשִׁמְ֒ךָ שָׁלוֹם.",
    "324": "יְהִי רָצוֹן שֶׁתָּשִׂים עָלֵֽינוּ",
    "325": "וְעַל כָּל עַמְּ֒ךָ בֵּית יִשְׂרָאֵל",
    "326": "חַיִּים וּבְ֒רָכָה",
    "327": "לְמִשְׁמֶֽרֶת שָׁלוֹם:",
    "329": "שִׂים שָׁלוֹם טוֹבָה וּבְ֒רָכָה",
    "330": "חַיִים חֵן וָחֶֽסֶד וְרַחֲמִים",
    "331": "עָלֵֽינוּ וְעַל כָּל יִשְׂרָאֵל עַמֶּֽךָ,",
    "332": "בָּרְ֒כֵֽנוּ אָבִֽינוּ כֻּלָּֽנוּ כְּאֶחָד",
    "333": "בְּאוֹר פָּנֶֽיךָ",
    "334": "כִּי בְאוֹר פָּנֶֽיךָ",
    "335": "נָתַֽתָּ לָּֽנוּ יְהֹוָה אֱלֹהֵֽינוּ",
    "336": "תּוֹרַת חַיִּים וְאַהֲבַת חֶֽסֶד",
    "337": "וּצְ֒דָקָה וּבְ֒רָכָה וְרַחֲמִים",
    "338": "וְחַיִּים וְשָׁלוֹם,",
    "339": "וְטוֹב יִהְיֶה בְּעֵינֶֽיךָ",
    "340": "לְבָרְ֒כֵֽנוּ",
    "341": "וּלְ֒בָרֵךְ אֶת כָּל עַמְּ֒ךָ יִשְׂרָאֵל",
    "342": "בְּכָל עֵת וּבְכָל שָׁעָה",
    "343": "בִּשְׁ֒לוֹמֶֽךָ",
    "344": "(בְּרוֹב עוֹז וְשָׁלוֹם).",
    "346": "<small>בְּסֵֽפֶר חַיִּים בְּרָכָה וְשָׁלוֹם</small>",
    "347": "<small>וּפַרְנָסָה טוֹבָה</small>",
    "348": "<small> וּגְ֒זֵרוֹת טוֹבוֹת, יְשׁוּעוֹת וְנֶחָמוֹת,</small>",
    "349": "<small>נִזָּכֵר וְנִכָּתֵב</small>",
    "350": "<small>לְפָנֶֽיךָ</small>",
    "351": "<small>אֲנַֽחְנוּ וְכָל עַמְּ֒ךָ בֵּית יִשְׂרָאֵל</small>",
    "352": "<small>לְחַיִּים טוֹבִים וּלְ֒שָׁלוֹם:</small>",
    "354": "בָּרוּךְ אַתָּה יְהֹוָה",
    "355": "הַמְּ֒בָרֵךְ אֶת עַמּוֹ יִשְׂרָאֵל",
    "356": "בַּשָּׁלוֹם:",
    "357": "יִהְיוּ לְרָצוֹן",
    "358": "אִמְ֒רֵי פִי",
    "359": "וְהֶגְיוֹן לִבִּי לְפָנֶֽיךָ",
    "360": "יְהֹוָה צוּרִי וְגוֹאֲלִי:"
   },
   "en": {
    "2": "My Master, open my lips,",
    "3": "and my mouth will declare Your praise.",
    "4": "Blessed are You, Adonoy,",
    "5": "our God, and God of our fathers,",
    "6": "God of Abraham, God of Isaac,",
    "7": "and God of Jacob,",
    "8": "the Almighty,",
    "9": "the Great, the Powerful, the Awesome,",
    "10": "most high Almighty,",
    "11": "Who bestows beneficent kindness,",
    "12": "Who possesses everything,",
    "13": "Who remembers the piety of the Patriarchs,",
    "14": "and Who brings a redeemer",
    "15": "to their children's children,",
    "16": "for the sake of His Name, with love.",
    "17": "<small>(Between Rosh Hashanah and Yom Kippur, add:</small>",
    "18": "Remember us for life",
    "19": "King, Who desires life;",
    "20": "and inscribe us in the Book of Life,",
    "21": "for Your sake, Living God.)",
    "23": "King, Helper, and Deliverer and Shield.",
    "24": "Blessed are You, Adonoy,",
    "25": "Shield of Abraham.",
    "27": "You are mighty forever, my Master;",
    "28": "You are the Resurrector of the dead",
    "29": "the powerful One to deliver us.",
    "30": "<small>From theMusaf<i>of the first day of Pesach until the</i>Musaf<i>of Shemini Atzeres you should say:</i></small>",
    "31": "He causes the dew to descend.",
    "32": "<small>(From theMusaf<i>of Shemini Atzeres until the</i>Musaf<i> of the first day of Pesach you should say:</i></small>",
    "33": "Causer of the wind to blow",
    "34": "and of the rain to fall.)",
    "36": "Sustainer of the living with kindliness,",
    "37": "Resurrector of the dead with great mercy,",
    "38": "Supporter of the fallen,",
    "39": "and Healer of the sick,",
    "40": "and Releaser of the imprisoned,",
    "41": "and Fulfiller of His faithfulness",
    "42": "to those who sleep in the dust.",
    "43": "Who is like You, Master of mighty deeds,",
    "44": "and who can be compared to You?",
    "45": "King Who causes death and restores life,",
    "46": "and causes deliverance to sprout forth.",
    "47": "<small>(Between Rosh Hashanah and Yom Kippur, add:</small>",
    "48": "Who is like You merciful Father,",
    "49": "Who remembers His creatures for life,",
    "50": "in His mercy.)",
    "52": "And You are faithful",
    "53": "to restore the dead to life.",
    "54": "Blessed are You, Adonoy,",
    "55": "Resurrector of the dead.",
    "56": "<small>When praying silently, continue “You are holy” on page 000.</small>",
    "57": "<small>When the Chazzan repeats the Shemoneh Esrei, the Kedushah is said here.</small>",
    "59": "<small>The Congregation says and the Chazzan repeats:</small>",
    "60": "We will hallow and revere You",
    "61": "as [with] the sweet words",
    "62": "of the company of the holy Seraphim",
    "63": "who thrice repeat “holy” unto You,",
    "64": "as is written by the hand of Your prophet,",
    "65": "“And they called to one another and said:",
    "66": "‘Holy, holy, holy",
    "67": "is Adonoy of hosts,",
    "68": "the fullness of all the earth is His glory.'”",
    "69": "Facing them, they offer praise and say:",
    "70": "Then, with the sound of great rushing,",
    "71": "mighty and strong,",
    "72": "they make their voice heard,",
    "73": "raising themselves up toward the Serafim,",
    "74": "Facing them, they offer praise and say:",
    "75": "<small>Congregation says and Chazzan repeats</small>",
    "76": "“Blessed is the glory of Adonoy",
    "77": "from its place.”",
    "78": "From Your place, our King, You will appear",
    "79": "and reign over us,",
    "80": "for we yearn for You—",
    "81": "When will You reign in Zion?",
    "82": "Soon, in our days,",
    "83": "forever may You dwell [there].",
    "84": "You will be exalted and sanctified",
    "85": "within Jerusalem, Your city",
    "86": "for all generations and for all eternity.",
    "87": "May our eyes behold Your kingship,",
    "88": "as it is said in the songs of Your might",
    "89": "by David,",
    "90": "the anointed of Your righteousness:",
    "91": "<small>Congregation says and Chazzan repeats:</small>",
    "92": "“Adonoy will reign forever;",
    "93": "Your God, Zion, throughout all generations!",
    "94": "Praise God.”",
    "95": "<b>DIVINE SANCTIFICATION</b>",
    "96": "You are holy and Your Name is holy",
    "97": "and holy beings",
    "98": "praise You every day, forever.",
    "99": "<small>Between Rosh Hashanah and Yom Kippur continue at the asterisk (*) below.</small>",
    "100": "Blessed are You, Adonoy,",
    "101": "the Almighty, the Holy One.",
    "102": "*Blessed are You, Adonoy,",
    "103": "the King, the Holy One.",
    "106": "Moses will rejoice",
    "107": "with the gift that was his portion,",
    "108": "for a faithful servant You called him.",
    "109": "A crown of glory",
    "110": "upon his head You placed",
    "111": "when he stood before You on Mount Sinai;",
    "112": "and two tablets of stone",
    "113": "he brought down in his hand,",
    "114": "upon which is written",
    "115": "[the command] to preserve the Sabbath,",
    "116": "and so it is written in Your Torah:",
    "117": "“And the Children of Israel shall preserve",
    "118": "the Sabbath,",
    "119": "to maintain the Sabbath for their generations",
    "120": "as an everlasting covenant.",
    "121": "Between Me",
    "122": "and between the Children of Israel,",
    "123": "it is a sign for all time",
    "124": "that in six days Adonoy made",
    "125": "the heavens and the earth,",
    "126": "and on the seventh day",
    "127": "He abstained from work, and rested.”",
    "128": "And You, Adonoy, our God, did not give it",
    "129": "to the nations of the lands;",
    "130": "nor did You give it as an inheritance",
    "131": "our King,",
    "132": "to worshippers of idols,",
    "133": "nor in its rest",
    "134": "do the uncircumcised dwell.",
    "135": "For only to Israel, Your people,",
    "136": "did You give it in love—",
    "137": "to the seed of Jacob",
    "138": "whom You chose.",
    "139": "They shall rejoice in Your kingship—",
    "140": "those who preserve the Sabbath",
    "141": "and call it a delight.",
    "142": "The people who sanctify the seventh [day]",
    "143": "will all be satisfied",
    "144": "and delighted from Your goodness.",
    "145": "And in the seventh [day], You took pleasure",
    "146": "and You hallowed it.",
    "147": "“Most desirable of days,” You called it—",
    "148": "a commemoration of the work of creation.",
    "149": "Our God, and God of our fathers,",
    "150": "be pleased with our rest,",
    "151": "sanctify us with Your commandments",
    "152": "and give us our share in Your Torah;",
    "153": "satisfy us from Your goodness",
    "154": "and gladden us with Your deliverance,",
    "155": "and purify our hearts to serve You in truth.",
    "156": "And give us as our inheritance,",
    "157": "Adonoy our God,",
    "158": "in love and in pleasure",
    "159": "Your holy Sabbath;",
    "160": "and may Israel rest thereon—",
    "161": "the sanctifiers of Your Name—",
    "162": "Blessed are You Adonoy,",
    "163": "Sanctifier of the Sabbath.",
    "165": "Be pleased, Adonoy, our God,",
    "166": "with Your people Israel and their prayer,",
    "167": "and restore the service",
    "168": "to the Holy of Holies in Your abode,",
    "169": "and the fire-offerings of Israel;",
    "170": "and accept their prayer, lovingly and willingly.",
    "171": "And may You always find pleasure",
    "172": "with the service of Your people, Israel.",
    "173": "<small>On a regular Shabbos, continue, “And may our eyes,” on p. 000</small>",
    "174": "<small>(On Rosh Chodesh and on Chol HaMoed, the following prayer is added:</small>",
    "175": "Our God and God of our fathers,",
    "176": "may there ascend, come, and reach,",
    "177": "appear, be desired, and heard,",
    "178": "counted and recalled",
    "179": "our remembrance and reckoning;",
    "180": "the remembrance of our fathers;",
    "181": "the remembrance of the Messiah",
    "182": "the son of David, Your servant;",
    "183": "the remembrance of Jerusalem,",
    "184": "city of Your Sanctuary;",
    "185": "and the remembrance of Your entire people,",
    "186": "the House of Israel, before You,",
    "187": "for survival, for well-being,",
    "188": "for favor, kindliness, compassion,",
    "189": "for life and peace",
    "190": "on this day of:",
    "191": "<i>Rosh Chodesh</i>",
    "192": "the <i>Festival of Matzos</i>",
    "193": "the <i>Festival of Sukkos</i>",
    "194": "Remember us Adonoy, our God",
    "195": "on this day for well-being;",
    "196": "be mindful of us on this day for blessing,",
    "197": "and deliver us for life.",
    "198": "In accord with the promise of deliverance",
    "199": "and compassion,",
    "200": "spare us and favor us,",
    "201": "have compassion on us and deliver us;",
    "202": "for to You our eyes are directed",
    "203": "because You are the Almighty",
    "204": "Who is King, Gracious, and Merciful.",
    "206": "And may our eyes behold",
    "207": "Your merciful return to Zion.",
    "208": "Blessed are You, Adonoy,",
    "209": "Who returns His Divine Presence to Zion.",
    "211": "<small>At the words, We are thankful,<i>bend forward; <i>at</i> Adonoy <i>return to an upright position.</i></i></small>",
    "212": "We are thankful to You",
    "213": "that You Adonoy are our God",
    "214": "and the God of our fathers forever;",
    "215": "Rock of our lives,",
    "216": "the Shield of our deliverance,",
    "217": "You are in every generation.",
    "218": "We will give thanks to You",
    "219": "and recount Your praise,",
    "220": "for our lives",
    "221": "which are committed into Your hand.",
    "222": "And for our souls which are entrusted to You,",
    "223": "and for Your miracles of every day with us",
    "224": "and for Your wonders and benefactions",
    "225": "at all times—",
    "226": "evening, morning and noon.",
    "227": "(You are) The Beneficent One—",
    "228": "for Your compassion is never withheld;",
    "229": "And (You are) the Merciful One—",
    "230": "for Your kindliness never ceases;",
    "231": "we have always placed our hope in You.",
    "233": "We are thankful to You,",
    "234": "that You Adonoy are our God",
    "235": "and God of our fathers,",
    "236": "God of all flesh,",
    "237": "Our Creator, Creator of the Beginning.",
    "238": "Blessings and thanksgivings",
    "239": "to Your great and holy Name",
    "240": "for keeping us alive, and sustaining us;",
    "241": "so may You always keep us alive",
    "242": "and sustain us,",
    "243": "and gather our exiles",
    "244": "to the Courtyards of Your Sanctuary",
    "245": "to observe Your statutes",
    "246": "and to do Your will,",
    "247": "and to serve You wholeheartedly",
    "248": "for we are thankful to You.",
    "249": "Blessed is the Almighty",
    "250": "to Whom all thanks are due.",
    "251": "<small>On Chanukah the following prayer is added. If you omitted it, see page 000.</small>",
    "252": "[We thank You] for the miracles",
    "253": "for the redemption, for the mighty deeds,",
    "254": "for the deliverances, and for the wars",
    "255": "that You performed for our fathers",
    "256": "in those days at this season.",
    "257": "In the days of Matisyahu,",
    "258": "son of Yochanan the High Priest,",
    "259": "the Hasmonean and his sons.",
    "260": "When the evil Greek kingdom rose up",
    "261": "against Your people Israel",
    "262": "to make them forget Your Torah",
    "263": "and to turn them away",
    "264": "from the statutes of Your will—",
    "265": "You, in Your abundant mercy",
    "266": "stood by them in their time of distress,",
    "267": "You defended their cause,",
    "268": "You judged their grievances,",
    "269": "You avenged them.",
    "270": "You delivered the mighty",
    "271": "into the hands of the weak,",
    "272": "many into the hands of the few,",
    "273": "defiled people into the hands of the undefiled,",
    "274": "the wicked into the hands of the righteous,",
    "275": "and insolent [sinners] into the hands of",
    "276": "diligent students of Your Torah.",
    "277": "And You made Yourself",
    "278": "a great and sanctified Name in Your world.",
    "279": "And for Your people, Israel,",
    "280": "You performed a great deliverance",
    "281": "and redemption unto this very day.",
    "282": "Afterwards, Your sons entered",
    "283": "the Holy of Holies of Your Abode,",
    "284": "cleaned Your Temple,",
    "285": "purified Your Sanctuary,",
    "286": "and kindled lights",
    "287": "in the Courtyards of Your Sanctuary,",
    "288": "and designated these eight days of Chanukah",
    "289": "to thank and praise Your great Name.",
    "290": "And for all the foregoing",
    "291": "blessed, exalted and extolled",
    "292": "your Name, our King",
    "293": "constantly, forever and ever.",
    "294": "<small>(Between Rosh Hashanah and Yom Kippur, add:</small>",
    "295": "Inscribe for a good life",
    "296": "all the children of Your covenant.)",
    "298": "And all the living shall thank You forever",
    "299": "and praise and bless",
    "300": "Your great Name with sincerity forever;",
    "301": "for You are goodness—",
    "302": "the Almighty, Who is our deliverance",
    "303": "and our help forever—",
    "304": "the benevolent Almighty.",
    "305": "Blessed are You, Adonoy,",
    "306": "“The Beneficent” is Your Name",
    "307": "and You it is fitting to praise.",
    "308": "<small>To be said by the Chazzan</small>",
    "310": "Our God, and God of our fathers, bless us",
    "311": "with the threefold blessing of the Torah,",
    "312": "written by the hand of Moses, Your servant,",
    "313": "pronounced from the mouth of Aaron",
    "314": "and his sons, the <i>kohanim,</i> Your holy people;",
    "315": "as it is said:",
    "316": "Adonoy bless you and guard you.",
    "317": "Adonoy shine His countenance upon you",
    "318": "and be gracious unto you.",
    "319": "Adonoy turn His countenance toward you",
    "320": "and grant you peace.",
    "321": "<small>After Birkas Kohanim the congregation says:</small>",
    "322": "Mighty One on high who dwells in might,",
    "323": "You are peace and Your Name is peace.",
    "324": "May it be Your will that You grant us",
    "325": "and all of Your people, the House of Israel",
    "326": "life and blessing",
    "327": "for a safeguard to peace.",
    "329": "Grant peace, goodness, and blessing,",
    "330": "life favor, kindness and compassion",
    "331": "upon us and upon all Israel, Your people.",
    "332": "Bless us, our Father, all of us as one",
    "333": "with the light of Your countenance.",
    "334": "For by the light of Your countenance",
    "335": "You gave us Adonoy our God,",
    "336": "a Torah of life and the love of kindliness,",
    "337": "righteousness, blessing, compassion,",
    "338": "life, and peace.",
    "339": "And may it be good in Your sight",
    "340": "to bless us",
    "341": "and to bless Your people Israel,",
    "342": "at all times and at every moment",
    "343": "with Your peace",
    "344": "(with much strength and peace).",
    "345": "<small>*(Between Rosh Hashanah and Yom Kippur, continue here:)</small>",
    "346": "In the book of life, blessing, peace",
    "347": "and abundant maintenance,",
    "348": "good decrees, salvations and condolences,",
    "349": "may we be remembered and inscribed",
    "350": "before You;",
    "351": "we and all Your people, the House of Israel",
    "352": "for a good life and peace.",
    "354": "Blessed are You, Adonoy,",
    "355": "Who blesses His people Israel",
    "356": "with peace.",
    "357": "May they be acceptable",
    "358": "the words of my mouth",
    "359": "and the thoughts of my heart, before You",
    "360": "Adonoy, my Rock and my Redeemer."
   }
  }
 }
}
