{
 "id": "shabbat/shacharit/full-kaddish:sefard",
 "refs": {
  "Shabbat Siddur Sefard Linear, The Morning Prayers, Amidah for Shabbos Morning": {
   "edition": "metsudah-sefard-shabbat",
   "he": {
    "413": "יִתְגַּדַּל וְיִתְקַדַּשׁ שְׁמֵהּ רַבָּא",
    "414": "בְּעָלְמָא דִּי בְרָא",
    "415": "כִרְעוּתֵהּ",
    "416": "וְיַמְלִיךְ מַלְכוּתֵהּ",
    "417": "וְיַצְמַח פּוּרְקָנֵהּ",
    "418": "וִיקָרֵב (קֵץ) מְשִׁיחֵהּ.",
    "419": "בְּחַיֵּיכוֹן וּבְיוֹמֵיכוֹן",
    "420": "וּבְחַיֵּי",
    "421": "דְכָל בֵּית יִשְׂרָאֵל.",
    "422": "בַּעֲגָלָא וּבִזְמַן קָרִיב",
    "423": "וְאִמְרוּ אָמֵן:",
    "424": "יְהֵא שְׁמֵהּ רַבָּא מְבָרַךְ",
    "425": "לְעָלַם וּלְעָלְמֵי עָלְמַיָּא:",
    "426": "יִתְבָּרַךְ וְיִשְׁתַּבַּח",
    "427": "וְיִתְפָּאַר וְיִתְרוֹמַם וְיִתְנַשֵּׂא",
    "428": "וְיִתְהַדָּר וְיִתְעַלֶּה וְיִתְהַלָּל",
    "429": "שְׁמֵהּ דְקֻדְשָׁא. בְּרִיךְ הוּא",
    "430": "לְעֵֽלָּא (<small>בעשי\"ת</small> וּלְעֵֽלָּא מִכָּל) ",
    "431": "מִן כָּל בִּרְכָתָא וְשִׁירָתָא.",
    "432": "תֻּשְׁבְּ֒חָתָא וְנֶחֱמָתָא.",
    "433": "דַּאֲמִירָן בְּעָלְמָא. וְאִמְרוּ אָמֵן:",
    "434": "תִּתְקַבֵּל",
    "435": "צְלוֹתְ֒הוֹן וּבָעוּתְ֒הוֹן",
    "436": "דְּכָל בֵּית יִשְׂרָאֵל",
    "437": "קֳדָם אֲבוּהוֹן דִּי בִשְׁמַיָּא",
    "438": "וְאִמְרוּ אָמֵן:",
    "439": "יְהֵא שְׁלָמָא רַבָּא מִן שְׁמַיָּא",
    "440": "וְחַיִּים",
    "441": "עָלֵֽינוּ וְעַל כָּל יִשְׂרָאֵל",
    "442": "וְאִמְרוּ אָמֵן:",
    "443": "עוֹשֶׂה שָׁלוֹם בִּמְרוֹמָיו",
    "444": "הוּא יַעֲשֶׂה שָׁלוֹם",
    "445": "עָלֵֽינוּ וְעַל כָּל יִשְׂרָאֵל",
    "446": "וְאִמְרוּ אָמֵן:"
   },
   "en": {
    "411": "<small>On Shabbos-Rosh Chodesh, on Yom Tov, on Shabbos-Chol HaMoed, and on Shabbos-Chanukah, say Hallel on page 000.</small>",
    "412": "<small>On a regular Shabbos the Chazzan recites the following Kaddish:</small>",
    "413": "Exalted and sanctified be His great Name",
    "414": "in the world which He created",
    "415": "according to His will",
    "416": "and may He rule His kingdom",
    "417": "bring forth His redemption",
    "418": "and hasten the coming of His Mashiach",
    "419": "in your lifetime and in your days,",
    "420": "and in the lifetime",
    "421": "of the entire House of Israel,",
    "422": "speedily and in the near future—",
    "423": "and say Amein.",
    "424": "May His great Name be blessed",
    "425": "forever and for all eternity.",
    "426": "Blessed and praised,",
    "427": "glorified, and exalted and uplifted,",
    "428": "honored and elevated and extolled",
    "429": "be the Name of the Holy One, blessed is He;",
    "430": "above (<i>Shabbos Shuva:</i> far above)",
    "431": "all the blessings and hymns,",
    "432": "praises and consolations",
    "433": "which we utter in the world—and say Amein.",
    "434": "May there be acceptance",
    "435": "of the prayers and supplications",
    "436": "of the entire House of Israel",
    "437": "before their Father in heaven.",
    "438": "And say, Amein.",
    "439": "May there be abundant peace from heaven",
    "440": "and life",
    "441": "for us and for all Israel,",
    "442": "—and say Amein.",
    "443": "He Who makes peace in His high heavens",
    "444": "may He, make peace",
    "445": "for us and for all Israel,",
    "446": "—and say Amein."
   }
  }
 }
}
