{
 "id": "shabbat/shacharit/morning-shema-and-its-blessings:sefard",
 "refs": {
  "Shabbat Siddur Sefard Linear, The Morning Prayers, Yishtabach": {
   "edition": "metsudah-sefard-shabbat",
   "he": {
    "88": "בָּרוּךְ אַתָּה יְהֹוָה",
    "89": "אֱלֹהֵֽינוּ מֶֽלֶךְ הָעוֹלָם",
    "90": "יוֹצֵר אוֹר",
    "91": "וּבוֹרֵא חֽשֶׁךְ",
    "92": "עֹשֶׂה שָׁלוֹם",
    "93": "וּבוֹרֵא אֶת הַכֹּל:",
    "95": "הַכֹּל יוֹדֽוּךָ. וְהַכֹּל יְשַׁבְּ֒חֽוּךָ.",
    "96": "וְהַכֹּל יֹאמְ֒רוּ",
    "97": "אֵין־קָדוֹשׁ כַּיהוֹה.",
    "98": "הַכֹּל יְרוֹמְ֒מֽוּךָ סֶּֽלָה",
    "99": "יוֹצֵר הַכֹּל.",
    "100": "הָאֵל הַפּוֹתֵֽחַ בְּכָל יוֹם",
    "101": "דַּלְתוֹת שַׁעֲרֵי מִזְרָח.",
    "102": "וּבוֹקֵֽעַ חַלּוֹנֵי רָקִֽיעַ.",
    "103": "מוֹצִיא חַמָּה מִמְּ֒קוֹמָהּ",
    "104": "וּלְבָנָה מִמְּ֒כוֹן שִׁבְתָּהּ.",
    "105": "וּמֵאִיר לְעוֹלָם כֻּלּוֹ",
    "106": "וּלְיוֹשְׁ֒בָיו",
    "107": "שֶׁבָּרָא",
    "108": "בְּמִדַּת הָרַחֲמִים.",
    "109": "הַמֵּאִיר לָאָֽרֶץ",
    "110": "וְלַדָּרִים עָלֶֽיהָ",
    "111": "בְּרַחֲמִים.",
    "112": "וּבְטוּבוֹ",
    "113": "מְחַדֵּשׁ בְּכָל־יוֹם תָּמִיד",
    "114": "מַעֲשֵׂה בְרֵאשִׁית.",
    "115": "מָה־רַבּוּ מַעֲשֶֽׂיךָ יְהֹוָה.",
    "116": "כֻּלָּם בְּחָכְמָה עָשִֽׂיתָ.",
    "117": "מָלְ֒אָה הָאָֽרֶץ קִנְיָנֶֽךָ:",
    "118": "הַמֶּֽלֶךְ הַמְּ֒רוֹמָם לְבַדּוֹ מֵאָז.",
    "119": "הַמְּ֒שֻׁבָּח וְהַמְּ֒פוֹאָר וְהַמִּתְנַשֵּׂא",
    "120": "מִימוֹת עוֹלָם.",
    "121": "אֱלֹהֵי עוֹלָם",
    "122": "בְּרַחֲמֶֽיךָ הָרַבִּים",
    "123": "רַחֵם עָלֵֽינוּ.",
    "124": "אֲדוֹן עֻזֵּֽנוּ.",
    "125": "צוּר מִשְׂגַּבֵּֽנוּ.",
    "126": "מָגֵן יִשְׁעֵֽנוּ.",
    "127": "מִשְׂגָּב בַּעֲדֵֽנוּ.",
    "128": "אֵין עֲרוֹךְ לְךָ.",
    "129": "וְאֵין זוּלָתֶֽךָ.",
    "130": "אֶֽפֶס בִּלְתֶּֽךָ",
    "131": "וּמִי דוֹמֶה לָךְ.",
    "132": "❖אֵין עֲרוֹךְ לְךָ",
    "133": "יְהֹוָה אֱלֹהֵֽינוּ",
    "134": "בָּעוֹלָם הַזֶּה.",
    "135": "וְאֵין זוּלָתְ֒ךָ מַלְכֵּֽנוּ",
    "136": "לְחַיֵּי הָעוֹלָם הַבָּא.",
    "137": "אֶֽפֶס בִּלְתְּ֒ךָ",
    "138": "גּוֹאֲלֵֽנוּ",
    "139": "לִימוֹת הַמָּשִֽׁיחַ.",
    "140": "וְאֵין דוֹמֶה לְךָ",
    "141": "מוֹשִׁיעֵֽנוּ",
    "142": "לִתְחִיַּת הַמֵּתִים:"
   },
   "en": {
    "88": "Blessed are You, Adonoy",
    "89": "our God, King of the Universe,",
    "90": "Former of light,",
    "91": "Creator of darkness,",
    "92": "Maker of peace,",
    "93": "and Creator of all things.",
    "94": "<small>When Yom Tov occurs on weekdays, continue “He illuminates” on page 000.</small>",
    "95": "All will thank You, all will praise You,",
    "96": "and all will proclaim:",
    "97": "“There is none holy like Adonoy.”",
    "98": "All will exalt You, forever,",
    "99": "Creator of all.",
    "100": "The Almighty Who opens each day",
    "101": "the doors of the gates of the east",
    "102": "and pierces the windows of the firmament;",
    "103": "Who brings the sun out of its place",
    "104": "and the moon from its dwelling-place;",
    "105": "and illuminates the entire world",
    "106": "and to its inhabitants,",
    "107": "whom He created",
    "108": "with [His] attribute of mercy.",
    "109": "He illuminates the earth",
    "110": "and those who dwell on it",
    "111": "with compassion,",
    "112": "and in His goodness",
    "113": "renews every day, continually,",
    "114": "the work of creation.",
    "115": "How many are Your works, Adonoy;",
    "116": "You made them all with wisdom,",
    "117": "the earth is full of Your possessions.",
    "118": "The King Who alone is exalted from then;",
    "119": "Who is praised, glorified, and uplifted",
    "120": "from the beginning of time.",
    "121": "Eternal God—",
    "122": "in Your abundant mercy,",
    "123": "have compassion on us,",
    "124": "Master Who is our strength,",
    "125": "Rock Who is our stronghold,",
    "126": "Shield of our deliverance,",
    "127": "[Be] a stronghold for us.",
    "128": "There is none to be compared to You,",
    "129": "and there is none other than You,",
    "130": "nothing exists without You",
    "131": "and who is like You?",
    "132": "There is none to be compared to You,",
    "133": "Adonoy, our God,",
    "134": "in this world;",
    "135": "and there is none beside You, our King",
    "136": "in the life of the World to Come;",
    "137": "Nothing exists without You",
    "138": "our Redeemer",
    "139": "in the days of the Messiah;",
    "140": "and there will be none like You,",
    "141": "our Deliverer,",
    "142": "at the time of the resurrection of the dead."
   }
  },
  "Shabbat Siddur Sefard Linear, The Morning Prayers, Eil Adon": {
   "edition": "metsudah-sefard-shabbat",
   "he": {
    "1": "אֵל",
    "2": "אָדוֹן עַל כָּל הַמַּעֲשִׂים.",
    "3": "בָּרוּךְ",
    "4": "וּמְבֹרָךְ בְּפִי כָּל הַנְּשָׁמָה.",
    "5": "גָּדְלוֹ וְטוּבוֹ מָלֵא עוֹלָם.",
    "6": "דַּֽעַת וּתְבוּנָה",
    "7": "סוֹבְ֒בִים הוֹדוֹ:",
    "8": "הַמִּתְגָּאֶה עַל חַיּוֹת הַקֹּֽדֶשׁ.",
    "9": "וְנֶהְדָּר בְּכָבוֹד עַל הַמֶּרְכָּבָה.",
    "10": "זְכוּת וּמִישׁוֹר לִפְנֵי כִסְאוֹ.",
    "11": "חֶֽסֶד וְרַחֲמִים מָלֵא כְבוֹדוֹ:",
    "12": "טוֹבִים מְאוֹרוֹת",
    "13": "שֶׁבָּרָא אֱלֹהֵֽינוּ.",
    "14": "יְצָרָם בְּדַֽעַת",
    "15": "בְּבִינָה וּבְהַשְׂכֵּל.",
    "16": "כֹּֽחַ וּגְבוּרָה נָתַן בָּהֶם.",
    "17": "לִהְיוֹת מוֹשְׁ֒לִים",
    "18": "בְּקֶֽרֶב תֵּבֵל:",
    "19": "מְלֵאִים זִיו וּמְפִיקִים נֹֽגַהּ.",
    "20": "נָאֶה זִיוָם בְּכָל הָעוֹלָם.",
    "21": "שְׂמֵחִים בְּצֵאתָם",
    "22": "וְשָׂשִׂים בְּבוֹאָם.",
    "23": "עוֹשִׂים בְּאֵימָה",
    "24": "רְצוֹן קוֹנָם:",
    "25": "פְּאֵר וְכָבוֹד נוֹתְ֒נִים לִשְׁמוֹ.",
    "26": "צָהֳלָה וְרִנָּה",
    "27": "לְזֵֽכֶר מַלְכוּתוֹ.",
    "28": "קָרָא לַשֶּֽׁמֶשׁ",
    "29": "וַיִּזְרַח אוֹר.",
    "30": "רָאָה וְהִתְקִין",
    "31": "צוּרַת הַלְּ֒בָנָה:",
    "32": "שֶֽׁבַח נוֹתְ֒נִים לוֹ",
    "33": "כָּל צְבָא מָרוֹם.",
    "34": "תִּפְאֶֽרֶת וּגְדֻלָּה",
    "35": "שְׂרָפִים וְאוֹפַנִּים וְחַיּוֹת הַקֹּֽדֶשׁ:",
    "36": "לָאֵל",
    "37": "אֲשֶׁר שָׁבַת מִכָּל הַמַּעֲשִׂים.",
    "38": "בַּיּוֹם הַשְּׁ֒בִיעִי הִתְעַלָּה",
    "39": "וְיָשַׁב עַל כִּסֵּא כְבוֹדוֹ.",
    "40": "תִּפְאֶֽרֶת עָטָה",
    "41": "לְיוֹם הַמְּ֒נוּחָה.",
    "42": "עֹֽנֶג קָרָא לְיוֹם הַשַּׁבָּת.",
    "43": "זֶה שֶֽׁבַח שֶׁל יוֹם הַשְּׁ֒בִיעִי",
    "44": "שֶׁבּוֹ שָׁבַת אֵל",
    "45": "מִכָּל מְלַאכְתּוֹ.",
    "46": "וְיוֹם הַשְּׁ֒בִיעִי מְשַׁבֵּֽחַ וְאוֹמֵר.",
    "47": "מִזְמוֹר שִׁיר לְיוֹם הַשַּׁבָּת",
    "48": "טוֹב לְהוֹדוֹת לַיהוֹה:",
    "49": "לְפִיכָךְ יְפָאֲרוּ וִיבָרְ֒כוּ לָאֵל",
    "50": "כָּל יְצוּרָיו.",
    "51": "שֶֽׁבַח יְקָר וּגְדֻלָּה וְכָבוֹד",
    "52": "יִתְּ֒נוּ לָאֵל",
    "53": "מֶֽלֶךְ",
    "54": "יוֹצֵר כֹּל.",
    "55": "הַמַּנְחִיל מְנוּחָה",
    "56": "לְעַמּוֹ יִשְׂרָאֵל בִּקְדֻשָּׁתוֹ",
    "57": "בְּיוֹם שַׁבַּת קֹֽדֶשׁ.",
    "58": "שִׁמְךָ יְהֹוָה אֱלֹהֵֽינוּ",
    "59": "יִתְקַדַּשׁ.",
    "60": "וְזִכְרְ֒ךָ מַלְכֵּֽנוּ יִתְפָּאַר",
    "61": "בַּשָּׁמַֽיִם מִמַּֽעַל",
    "62": "וְעַל הָאָֽרֶץ מִתָּֽחַת.",
    "63": "תִּתְבָּרֵךְ מוֹשִׁיעֵֽנוּ",
    "64": "עַל כָּל שֶֽׁבַח מַעֲשֵׂה יָדֶֽיךָ.",
    "65": "וְעַל מְאוֹרֵי אוֹר",
    "66": "שֶׁיָצַֽרְתָּ",
    "67": "הֵמָּה יְפָאֲרֽוּךָ סֶּֽלָה:",
    "101": "תִּתְבָּרֵךְ יְהֹוָה אֱלֹהֵֽינוּ",
    "102": "בַּשָּׁמַֽיִם מִמַּֽעַל",
    "103": "וְעַל הַאָֽרֶץ מִתָּֽחַת",
    "104": "עַל כָּל שֶֽׁבַח מַעֲשֵׂה יָדֶֽיךָ",
    "105": "וְעַל מְאֽוֹרֵי אוֹר",
    "106": "שֶׁיָצַרְתָּ",
    "107": "הֵֽמָּה יְפָאֲרֽוּךָ סֶּֽלָה:",
    "108": "תִּתְבָּרֵךְ לָנֶצַח צוּרֵֽנוּ מַלְכֵּֽנוּ",
    "109": "וְגוֹאֲלֵֽנוּ, בּוֹרֵא קְדוֹשִׁים",
    "110": "יִשְׁתַּבַּח שִׁמְ֒ךָ לָעַד מַלְכֵּֽנוּ,",
    "111": "יוֹצֵר מְשָׁרְתִים,",
    "112": "וַאֲשֶׁר מְשָׁרְתָיו",
    "113": "כֻּלָּם עוֹמְ֒דִים בְּרוּם עוֹלָם",
    "114": "וּמַשְׁמִיעִים בְּיִרְאָה יַֽחַד בְּקוֹל",
    "115": "דִּבְ֒רֵי אֱלֹהִים חַיִּים",
    "116": "וּמֶֽלֶךְ עוֹלָם:",
    "117": "כֻּלָם אֲהוּבִים",
    "118": "כֻּלָּם בְּרוּרִים",
    "119": "כֻּלָּם גִּבּוֹרִים",
    "120": "כֻּלָּם קְדוֹשִׁים",
    "121": "וְכֻלָּם עֹשִׂים",
    "122": "בְּאֵימָה וּבְ֒יִרְאָה",
    "123": "רְצוֹן קוֹנָם:",
    "124": "❖וְכֻלָּם פּוֹתְ֒חִים אֶת פִּיהֶם",
    "125": "בִּקְ֒דֻשָּׁה וּבְ֒טָהֳרָה",
    "126": "בְּשִׁירָה וּבְ֒זִמְרָה",
    "127": "וּמְ֒בָרְכִין וּמְ֒שַׁבְּ֒חִין וּמְ֒פָאֲרִין",
    "128": "וּמַעֲרִיצִין וּמַקְדִּישִׁין",
    "129": "וּמַמְלִיכִין:",
    "130": "אֶת שֵׁם הָאֵל הַמֶּֽלֶךְ",
    "131": "הַגָּדוֹל הַגִּבּוֹר וְהַנּוֹרָא",
    "132": "קָדוֹשׁ הוּא:",
    "133": "וְכֻלָּם מְקַבְּ֒לִים עֲלֵיהֶם",
    "134": "עֹל מַלְ֒כוּת שָׁמַֽיִם",
    "135": "זֶה מִזֶּה,",
    "136": "וְנוֹתְ֒נִים בְּאַהֲבָה רְשׁוּת זֶה לָזֶה",
    "137": "לְהַקְדִּישׁ לְיוֹצְ֒רָם",
    "138": "בְּנַֽחַת רֽוּחַ",
    "139": "בְּשָׂפָה בְרוּרָה וּבִנְ֒עִימָה,",
    "140": "קְדֻשָּׁה כֻּלָּם כְּאֶחָד עוֹנִים",
    "141": "בְּאֵימָה",
    "142": "וְאוֹמְ֒רִים בְּיִרְאָה",
    "143": "<b>קָדוֹשׁ קָדוֹשׁ קָדוֹשׁ</b>",
    "144": "<b>יְהֹוָה צְבָאוֹת.</b>",
    "145": "<b>מְלֹא כָל־הָאָֽרֶץ כְּבוֹדוֹ:</b>",
    "146": "וְהָאוֹפַנִּים וְחַיּוֹת הַקֹּֽדֶשׁ",
    "147": "בְּרַֽעַשׁ גָּדוֹל מִתְנַשְּׂ֒אִים",
    "148": "לְעֻמַּת שְׂרָפִים",
    "149": "לְעֻמָּתָם מְשַׁבְּ֒חִים וְאוֹמְ֒רִים:",
    "150": "<b>בָּרוּךְ כְּבוֹד־יְהֹוָה</b>",
    "151": "<b>מִמְּ֒קוֹמוֹ:</b>",
    "152": "לָאֵל בָּרוּךְ",
    "153": "נְעִימוֹת יִתֵּֽנוּ,",
    "154": "לַמֶּֽלֶךְ אֵל",
    "155": "חַי וְקַיָּם",
    "156": "זְמִירוֹת יֹאמֵֽרוּ",
    "157": "וְתִשְׁבָּחוֹת יַשְׁמִֽיעוּ,",
    "158": "כִּי הוּא לְבַדּוֹ מָרוֹם וְקָדוֹשׁ",
    "159": "פּוֹעֵל גְּבוּרוֹת",
    "160": "עֹשֶׂה חֲדָשׁוֹת",
    "161": "בַּֽעַל מִלְחָמוֹת",
    "162": "זוֹרֵֽעַ צְדָקוֹת",
    "163": "מַצְמִֽיחַ יְשׁוּעוֹת",
    "164": "בּוֹרֵא רְפוּאוֹת",
    "165": "נוֹרָא תְהִלּוֹת אֲדוֹן הַנִּפְלָאוֹת:",
    "166": "הַמְ֒חַדֵּשׁ בְּטוּבוֹ",
    "167": "בְּכָל יוֹם תָּמִיד",
    "168": "מַעֲשֵׂה בְרֵאשִׁית:",
    "169": "כָּאָמוּר",
    "170": "לְעֹשֵׂה אוֹרִים גְּדֹלִים",
    "171": "כִּי לְעוֹלָם חַסְדּוֹ:",
    "172": "(וְהִתְקִין מְאוֹרוֹת",
    "173": "מְשַׂמֵּֽחַ עוֹלָמוֹ אֲשֶׁר בָּרָא.)",
    "174": "❖אוֹר חָדָשׁ עַל צִיּוֹן תָּאִיר",
    "175": "וְנִזְכֶּה כֻלָּֽנוּ בִּמְ֒הֵרָה",
    "176": "לְאוֹרוֹ:",
    "177": "בָּרוּךְ אַתָּה יְהֹוָה",
    "178": "יוֹצֵר הַמְּ֒אוֹרוֹת:",
    "180": "אַהֲבַת עוֹלָם אֲהַבְתָּֽנוּ",
    "181": "יְהֹוָה אֱלֹהֵֽינוּ",
    "182": "חֶמְלָה גְדוֹלָה וִיתֵרָה",
    "183": "חָמַֽלְתָּ עָלֵֽינוּ:",
    "184": "אָבִֽינוּ מַלְכֵּֽנוּ",
    "185": "בַּעֲבוּר שִׁמְ֒ךָ הַגָּדוֹל",
    "186": "וּבַעֲבוּר אֲבוֹתֵֽינוּ",
    "187": "שֶׁבָּטְ֒חוּ בְךָ",
    "188": "וַתְּ֒לַמְּ֒דֵם חֻקֵּי חַיִּים",
    "189": "לַעֲשׂוֹת רְצוֹנְ֒ךָ",
    "190": "בְּלֵבָב שָׁלֵם",
    "191": "כֵּן תְּחָנֵּֽנוּ וּתְ֒לַמְּ֒דֵֽנוּ:",
    "192": "אָבִֽינוּ אָב הָרַחֲמָן",
    "193": "הַמְ֒רַחֵם",
    "194": "רַחֵם עָלֵֽינוּ",
    "195": "וְתֵן בְּלִבֵּֽנוּ בִּינָה",
    "196": "לְהָבִין",
    "197": "וּלְ֒הַשְׂכִּיל",
    "198": "לִשְׁמֹֽעַ לִלְמוֹד וּלְ֒לַמֵּד",
    "199": "לִשְׁמֹר וְלַעֲשׂוֹת וּלְ֒קַיֵּם",
    "200": "אֶת כָּל דִּבְ֒רֵי תַלְמוּד תּוֹרָתֶֽךָ",
    "201": "בְּאַהֲבָה:",
    "202": "וְהָאֵר עֵינֵֽינוּ בְּתוֹרָתֶֽךָ",
    "203": "וְדַבֵּק לִבֵּֽנוּ",
    "204": "בְּמִצְוֹתֶֽיךָ",
    "205": "וְיַחֵד לְבָבֵֽנוּ",
    "206": "לְאַהֲבָה וּלְ֒יִרְאָה אֶת שְׁמֶֽךָ,",
    "207": "לְמַֽעַן לֹא נֵבוֹשׁ",
    "208": "וְלֹא נִכָּלֵם וְלֹא נִכָּשֵׁל",
    "209": "לְעוֹלָם וָעֶד,",
    "210": "כִּי בְשֵׁם קָדְ֒שְׁךָ",
    "211": "הַגָּדוֹל הַגִּבּוֹר וְהַנּוֹרָא",
    "212": "בָּטָֽחְנוּ",
    "213": "נָגִֽילָה וְנִשְׂמְחָה בִּישׁוּעָתֶֽךָ:",
    "214": "וְרַחֲמֶֽיךָ יְהֹוָה אֶלֹהֵֽינוּ",
    "215": "וַחֲסָדֶֽיךָ הָרַבִּים",
    "216": "אַל יַעַזְבֽוּנוּ נֶֽצַח סֶֽלָה וָעֶד:",
    "217": "מַהֵר וְהָבֵא עָלֵֽינוּ",
    "218": "בְּרָכָה וְשָׁלוֹם מְהֵרָה",
    "219": "מֵאַרְבַּע כַּנְ֒פוֹת הָאָֽרֶץ",
    "220": "וּשְׁ֒בוֹר עוֹל הַגּוֹיִם",
    "221": "מֵעַל צַוָּארֵֽנוּ",
    "222": "וְתוֹלִיכֵֽנוּ מְהֵרָה",
    "223": "קוֹמְ֒מִיּוּת לְאַרְצֵֽנוּ:",
    "224": "כִּי אֵל",
    "225": "פּוֹעֵל יְשׁוּעוֹת אָֽתָּה",
    "226": "וּבָֽנוּ בָחַֽרְתָּ",
    "227": "מִכָּל עַם וְלָשׁוֹן",
    "228": "❖וְקֵרַבְתָּֽנוּ מַלְכֵּֽנוּ",
    "229": "לְשִׁמְ֒ךָ הַגָּדוֹל סֶֽלָה בֶּאֱמֶת",
    "230": "בְּאַהֲבָה לְהוֹדוֹת לְךָ",
    "231": "וּלְיַחֶדְ֒ךָ בְּאַהֲבָה",
    "232": "וּלְ֒אַהֲבָה אֶת שְׁמֶֽךָ:",
    "233": "בָּרוּךְ אַתָּה יְהֹוָה",
    "234": "הַבּוֹחֵר בְּעַמּוֹ יִשְׂרָאֵל בְּאַהֲבָה:"
   },
   "en": {
    "1": "Almighty,",
    "2": "Master over all [created] works,",
    "3": "Blessed is He",
    "4": "and He is blessed by the mouth of every soul.",
    "5": "His greatness and goodness fill the world,",
    "6": "perception and understanding",
    "7": "surround His glory.",
    "8": "He is most high, over the holy chayos,",
    "9": "and adorned in glory above the chariot;",
    "10": "merit and uprightness are before His throne,",
    "11": "kindness and mercy fill His glory.",
    "12": "Good are the luminaries",
    "13": "which our God created",
    "14": "He formed them with perception,",
    "15": "understanding, and wisdom,",
    "16": "strength and power He put into them,",
    "17": "to be rulers",
    "18": "within the inhabited world.",
    "19": "Full of luster and radiating brightness,",
    "20": "beautiful is their luster throughout the world,",
    "21": "joyous in their rising",
    "22": "and happy in their setting,",
    "23": "they perform with reverence,",
    "24": "the will of their Possessor.",
    "25": "Glory and honor, they give to His Name,",
    "26": "jubilation and joyous song",
    "27": "at the mention of His kingship.",
    "28": "He called to the sun",
    "29": "and it shone with light,",
    "30": "He saw and fashioned",
    "31": "the form of the moon.",
    "32": "Praise [they] give Him,",
    "33": "all hosts on high,",
    "34": "glory and greatness [are given Him by]",
    "35": "the serafim, the ofanim and the holy chayos.",
    "36": "To the Almighty,",
    "37": "Who rested from all the creation.",
    "38": "On the Seventh Day, He elevated Himself",
    "39": "and sat upon the throne of His honor.",
    "40": "With glory He enwrapped Himself",
    "41": "for the day of rest,",
    "42": "a delight, He called the Sabbath Day;",
    "43": "this is the praise of the Seventh Day—",
    "44": "that on it, the Almighty rested",
    "45": "from all His work.",
    "46": "The Seventh Day [itself] offers praise and says:",
    "47": "“A Psalm, a song by the Sabbath Day:",
    "48": "‘It is good to give thanks to Adonoy.'”",
    "49": "Therefore glorify and bless the Almighty",
    "50": "all beings that He has formed;",
    "51": "praise, esteem, greatness and honor",
    "52": "will they give to the Almighty,",
    "53": "King,",
    "54": "Creator of all,",
    "55": "Who apportions rest",
    "56": "to His people Israel, in His holiness",
    "57": "on the holy Shabbos Day.",
    "58": "Your Name, Adonoy, our God",
    "59": "will be sanctified,",
    "60": "and Your mention, our King, will be glorified",
    "61": "in the heavens above",
    "62": "and on the earth below.",
    "63": "Be blessed, our Deliverer",
    "64": "for the praiseworthy work of Your hands",
    "65": "and for the light-giving luminaries",
    "66": "which You formed",
    "67": "—they will glorify You forever.",
    "68": "<small>On Shabbos, continue “Be blessed,” on page 000.</small>",
    "101": "Be Blessed, Adonoy, our God,",
    "102": "in the heavens above",
    "103": "and on earth below",
    "104": "for the excellent works of Your hands,",
    "105": "and for the light-giving luminaries",
    "106": "which You formed;",
    "107": "they will glorify You forever.",
    "108": "Be blessed eternally our Former, our King,",
    "109": "and our Redeemer—Creator of holy beings.",
    "110": "Praised be Your Name forever, our King,",
    "111": "Who forms ministering angels;",
    "112": "and Whose ministering angels",
    "113": "all stand at the height of the Universe,",
    "114": "and proclaim with reverence, in unison aloud",
    "115": "the words of the living God,",
    "116": "King of the Universe.",
    "117": "All of them are beloved,",
    "118": "all of them are pure,",
    "119": "all of them are mighty;",
    "120": "all are holy",
    "121": "and all of them perform",
    "122": "with awe and reverence",
    "123": "the will of their Possessor.",
    "124": "And they all open their mouths",
    "125": "in holiness and purity,",
    "126": "with song and music,",
    "127": "and they bless, and praise, and glorify,",
    "128": "and revere, and sanctify,",
    "129": "and proclaim the sovereignty of—",
    "130": "the Name of the Almighty, the King,",
    "131": "the Great, the Mighty, the awesome One;",
    "132": "holy is He.",
    "133": "And they all take upon themselves",
    "134": "the yoke of Divine sovereignty",
    "135": "one from the other,",
    "136": "and lovingly give leave to one another",
    "137": "to sanctify their Former",
    "138": "in a spirit of serenity",
    "139": "with clear speech and pleasantness,",
    "140": "all exclaimKedushah in unison,",
    "141": "with awe,",
    "142": "and reverently exclaim:",
    "143": "“Holy, holy, holy",
    "144": "is Adonoy of Hosts,",
    "145": "the fullness of all the earth is His glory.”",
    "146": "And the Ofanim and the holy Chayos,",
    "147": "with a mighty sound rise",
    "148": "toward the <i>Serafim.</i>",
    "149": "Facing them, they offer praise and say,",
    "150": "“Blessed is the glory of Adonoy",
    "151": "from His place.”",
    "152": "To the Blessed Almighty,",
    "153": "they offer pleasant melodies;",
    "154": "to the King, the Almighty,",
    "155": "[Who is] living and enduring,",
    "156": "they utter hymns",
    "157": "and make praises heard.",
    "158": "For He alone, exalted and holy",
    "159": "is the Performer of mighty deeds,",
    "160": "Maker of new things;",
    "161": "Master of battles,",
    "162": "Sower of acts of righteousness,",
    "163": "Causer of deliverance to sprout forth;",
    "164": "Creator of cures.",
    "165": "Awesome in praise, Master of wonders,",
    "166": "He renews in His goodness,",
    "167": "each day, continuously,",
    "168": "the work of creation,",
    "169": "as it is said: “[Give thanks to Him]",
    "170": "Who makes the great luminaries,”",
    "171": "for His kindness is everlasting.”",
    "172": "(and He fashioned the luminaries,",
    "173": "bringing joy to the world He created)",
    "174": "Shine a new light upon Zion,",
    "175": "and may we all soon be privileged",
    "176": "to [enjoy] its brightness.",
    "177": "Blessed are You, Adonoy,",
    "178": "Former of the luminaries.",
    "180": "[With] everlasting love You have loved us",
    "181": "Adonoy, our God;",
    "182": "[With] great and abundant pity",
    "183": "have You pitied us.",
    "184": "Our Father, our King!",
    "185": "for the sake of your great Name",
    "186": "and for the sake of our forefathers",
    "187": "who trusted in You,",
    "188": "and whom You taught statutes of life,",
    "189": "carry out your will",
    "190": "with a perfect heart,",
    "191": "so too, be gracious to us and teach us.",
    "192": "Our Father, merciful Father,",
    "193": "Who acts with compassion",
    "194": "have compassion on us",
    "195": "and put into our hearts to understand,",
    "196": "to comprehend,",
    "197": "and to be intellectually creative,",
    "198": "to listen, to learn, and to teach,",
    "199": "to preserve, to practice, and to fulfill",
    "200": "all the words of instruction in Your Torah",
    "201": "with love.",
    "202": "And enlighten our eyes in Your Torah,",
    "203": "and cause our hearts to hold fast",
    "204": "to Your commandments,",
    "205": "and unify our hearts",
    "206": "to love and fear Your Name;",
    "207": "and may we not be subject to shame,",
    "208": "disgrace or stumbling",
    "209": "forever",
    "210": "for in Your holy Name—",
    "211": "great, mighty and awesome—",
    "212": "have we trusted;",
    "213": "may we exult and rejoice in Your deliverance.",
    "214": "And may Your mercy Adonoy our God,",
    "215": "and Your abundant kindness",
    "216": "never forsake us.",
    "217": "Hasten and bring upon us",
    "218": "blessing and peace quickly",
    "219": "from the four corners of the earth",
    "220": "break the yoke of the nations",
    "221": "from our neck",
    "222": "and speedily lead us",
    "223": "upright to our land.",
    "224": "Because, You are the Almighty,",
    "225": "Who performs acts of deliverance,",
    "226": "and You have chosen us",
    "227": "from among all peoples and tongues,",
    "228": "and You have brought us near our king",
    "229": "to Your great Name, forever in truth;",
    "230": "with love, that we may give thanks to You,",
    "231": "and proclaim Your Oneness, with love.",
    "232": "and love Your Name.",
    "233": "Blessed are You, Adonoy,",
    "234": "Who chooses His people Israel with love."
   }
  },
  "Shabbat Siddur Sefard Linear, The Morning Prayers, Recitation of Shema": {
   "edition": "metsudah-sefard-shabbat",
   "he": {
    "4": "אֵל מֶֽלֶךְ נֶאֱמָן:",
    "5": "<b>שְׁמַע יִשְׂרָאֵל</b>",
    "6": "<b>יְהֹוָה אֱלֹהֵֽינוּ</b>",
    "7": "<b>יְהֹוָה אֶחָד:</b>",
    "9": "<small>בָּרוּךְ שֵׁם</small>",
    "10": "<small>כְּבוֹד מַלְ֒כוּתוֹ</small>",
    "11": "<small>לְעוֹלָם וָעֶד:</small>",
    "12": "וְאָהַבְתָּ אֵת יְהֹוָה אֱלֹהֶֽיךָ",
    "13": "בְּכָלּ־לְּבָבְ֒ךָ",
    "14": "וּבְ֒כָל־נַפְשְׁךָ",
    "15": "וּבְ֒כָל־מְאֹדֶֽךָ:",
    "16": "וְהָיוּ הַדְּ֒בָרִים הָאֵֽלֶּה",
    "17": "אֲשֶׁר֯ אָ֯נֹכִי מְצַוְּ֒ךָ הַיּוֹם",
    "18": "עַל֯־לְ֯בָבֶֽךָ:",
    "19": "וְשִׁנַּנְתָּם",
    "20": "לְבָנֶֽיךָ",
    "21": "וְדִבַּרְתָּ בָּם",
    "22": "בְּשִׁבְתְּ֒ךָ בְּבֵיתֶֽךָ",
    "23": "וּבְ֒לֶכְתְּךָ בַדֶּֽרֶךְ",
    "24": "וּבְ֒שָׁכְבְּךָ וּבְ֒קוּמֶֽךָ:",
    "25": "וּקְ֒שַׁרְתָּם לְאוֹת",
    "26": "עַל֯־יָ֯דֶֽךָ",
    "27": "וְהָיוּ לְטֹטָפֹת",
    "28": "בֵּין עֵינֶֽיךָ:",
    "29": "וּכְ֒תַבְתָּם",
    "30": "עַל־מְזֻזוֹת בֵּיתֶֽךָ",
    "31": "וּבִשְׁ֒עָרֶֽיךָ:",
    "32": "וְהָיָה",
    "33": "אִם־שָׁמֹֽעַ תִּשְׁמְעוּ אֶל־מִצְוֹתַי",
    "34": "אֲשֶׁר֯ אָ֯נֹכִי מְצַוֶּה אֶתְ֒כֶם הַיּוֹם",
    "35": "לְאַהֲבָה אֶת־יְהֹוָה אֱלֹהֵיכֶם",
    "36": "וּלְ֒עָבְ֒דוֹ",
    "37": "בְּכָל֯־לְ֯בַבְ֒כֶם",
    "38": "וּבְ֒כָל־נַפְשְׁכֶם:",
    "39": "וְנָתַתִּי מְטַר֯־אַ֯רְצְכֶם",
    "40": "בְּעִתּוֹ",
    "41": "יּוֹרֶה",
    "42": "וּמַלְקוֹשׁ",
    "43": "וְאָסַפְתָּ דְגָנֶֽךָ",
    "44": "וְתִירשְׁךָ וְיִצְהָרֶֽךָ:",
    "45": "וְנָתַתִּי עֵֽשֶׂבּ",
    "46": "בְּ֯שָׂדְ֒ךָ לִבְ֒הֶמְתֶּֽךָ",
    "47": "וְאָכַלְתָּ וְשָׂבָֽעְתָּ:",
    "48": "הִשָּׁמְ֒רוּ לָכֶם פֶּן֯־יִ֯פְתֶּה לְבַבְ֒כֶם",
    "49": "וְסַרְתֶּם",
    "50": "וַעֲבַדְתֶּם אֱלֹהִים֯ אֲ֯חֵרִים",
    "51": "וְהִשְׁתַּחֲוִיתֶם לָהֶם:",
    "52": "וְחָרָה אַף־יְהֹוָה בָּכֶם",
    "53": "וְעָצַר֯ אֶ֯ת־הַשָּׁמַֽיִם",
    "54": "וְלֹּא־יִּהְיֶה מָטָר",
    "55": "וְהָאֲדָמָה לֹא תִתֵּן אֶתּ־יְּבוּלָהּ",
    "56": "וַאֲבַדְתֶּם֯ מְּהֵרָה",
    "57": "מֵעַל הָאָֽרֶץ הַטֹּבָה",
    "58": "אֲשֶׁר֯ יְ֯הוֹה נֹתֵן לָכֶם:",
    "59": "וְשַׂמְתֶּם֯ אֶ֯ת־דְּבָרַיּ אֵֽ֯לֶּה",
    "60": "עַלּ־לְּבַבְ֒כֶם וְעַל־נַפְשְׁ֒כֶם",
    "61": "וּקְ֒שַׁרְתֶּם֯ אֹ֯תָם לְאוֹת",
    "62": "עַלּ־יֶּדְ֒כֶם",
    "63": "וְהָיוּ לְטוֹטָפֹת",
    "64": "בֵּין עֵינֵיכֶם:",
    "65": "וְלִמַּדְתֶּם֯ אֹ֯תָם אֶת־בְּנֵיכֶם",
    "66": "לְדַבֵּר בָּם",
    "67": "בְּשִׁבְתְּךָ בְּבֵיתֶֽךָ",
    "68": "וּבְ֒לֶכְתְּ֒ךָ בַדֶּֽרֶךְ",
    "69": "וּבְ֒שָׁכְבְּ֒ךָ וּבְ֒קוּמֶֽךָ:",
    "70": "וּכְ֒תַבְתָּם",
    "71": "עַל־מְזוּזוֹת בֵּיתֶֽךָ",
    "72": "וּבִשְׁ֒עָרֶֽיךָ:",
    "73": "לְמַֽעַן֯ יִ֯רְבּוּ יְמֵיכֶם",
    "74": "וִימֵי בְנֵיכֶם",
    "75": "עַל הָאֲדָמָה",
    "76": "אֲשֶׁר נִשְׁבַּע יְהֹוָה לַאֲבֹתֵיכֶם",
    "77": "לָתֵת לָהֶם",
    "78": "כִּימֵי הַשָּׁמַֽיִם עַל־הָאָֽרֶץ:",
    "79": "וַֽיֹּאמֶר֯ יְ֯הוֹהּ אֶ֯ל־משֶׁה לֵּאמֹר:",
    "80": "דַּבֵּר֯ אֶ֯ל־בְּנֵי יִשְׂרָאֵל",
    "81": "וְאָמַרְתָּ אֲלֵהֶם",
    "82": "וְעָשׂוּ לָהֶם צִיצִת",
    "83": "עַל־כַּנְ֒פֵי בִגְ֒דֵיהֶם",
    "84": "לְדֹרֹתָם",
    "85": "וְנָתְ֒נוּ עַל־צִיצִת",
    "86": "הַכָּנָף֯",
    "87": "פְּתִיל תְּכֵֽלֶת:",
    "88": "וְהָיָה לָכֶם לְצִיצִת",
    "89": "וּרְ֒אִיתֶם֯ אֹ֯תוֹ",
    "90": "וּזְ֒כַרְתֶּם֯",
    "91": "אֶ֯ת־כָּל־מִצְוֹת֯ יְ֯הוֹה",
    "92": "וַעֲשִׂיתֶם֯ אֹ֯תָם",
    "93": "וְלֹא תָתֽוּרוּ אַחֲרֵי לְבַבְ֒כֶם",
    "94": "וְאַחֲרֵי עֵינֵיכֶם",
    "95": "אֲשֶׁר֯־אַ֯תֶּם זֹנִים֯ אַ֯חֲרֵיהֶם:",
    "96": "לְמַֽעַן תִּזְכְּרוּ",
    "97": "וַעֲשִׂיתֶם֯ אֶ֯ת־כָּל־מִצְוֹתָי",
    "98": "וִהְיִיתֶם קְדשִׁים לֵאלֹהֵיכֶם:",
    "99": "אֲנִי יְהֹוָה אֱלֹהֵיכֶם֯",
    "100": "אֲ֯שֶׁר הוֹצֵֽאתִי אֶתְ֒כֶם֯",
    "101": "מֵּאֶֽרֶץ מִצְרַֽיִם",
    "102": "לִהְיוֹת לָכֶם לֵאלֹהִים֯",
    "103": "אֲ֯נִי יְהֹוָה אֱלֹהֵיכֶם֯:",
    "105": "אֱמֶת",
    "107": "יְהֹוָה אֱלֹהֵיכֶם֯ אֱ֯מֶת:",
    "109": "וְיַצִּיב",
    "110": "וְנָכוֹן וְקַיָּם",
    "111": "וְיָשָׁר וְנֶאֱמָן",
    "112": "וְאָהוּב וְחָבִיב",
    "113": "וְנֶחְמָד וְנָעִים",
    "114": "וְנוֹרָא וְאַדִּיר",
    "115": "וּמְ֒תֻקָּן וּמְ֒קֻבָּל",
    "116": "וְטוֹב וְיָפֶה",
    "117": "הַדָּבָר הַזֶּה עָלֵֽינוּ לְעוֹלָם וָעֶד:",
    "118": "אֱמֶת",
    "119": "אֱלֹהֵי עוֹלָם מַלְכֵּֽנוּ",
    "120": "צוּר יַעֲקֹב",
    "121": "מָגֵן יִשְׁעֵֽנוּ,",
    "122": "❖לְדֹר וָדֹר",
    "123": "הוּא קַיָּם וּשְׁ֒מוֹ קַיָּם",
    "124": "וְכִסְאוֹ נָכוֹן",
    "125": "וּמַלְ֒כוּתוֹ וֶאֱמוּנָתוֹ",
    "126": "לָעַד קַיָּֽמֶת:",
    "127": "וּדְ֒בָרָיו חָיִים וְקַיָּמִים",
    "128": "נֶאֱמָנִים וְנֶחֱמָדִים",
    "129": "לָעַד וּלְ֒עוֹלְ֒מֵי עוֹלָמִים,",
    "130": "עַל אֲבוֹתֵֽינוּ וְעָלֵֽינוּ",
    "131": "עַל בָּנֵֽינוּ וְעַל דּוֹרוֹתֵֽינוּ",
    "132": "וְעַל כָּל דּוֹרוֹת",
    "133": "זֶֽרַע יִשְׂרָאֵל עֲבָדֶֽיךָ:",
    "134": "עַל הָרִאשׁוֹנִים",
    "135": "וְעַל הָאַחֲרוֹנִים",
    "136": "דָּבָר טוֹב וְקַיָּם לְעוֹלָם וָעֶד,",
    "137": "אֱמֶת וֶאֱמוּנָה",
    "138": "חוֹק וְלֹא יַעֲבֹר:",
    "139": "אֱמֶת שָׁאַתָּה הוּא יְהֹוָה",
    "140": "אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ",
    "141": "מַלְכֵּֽנוּ מֶֽלֶךְ אֲבוֹתֵֽינוּ",
    "142": "גֹּאֲלֵֽנוּ גֹּאֵל אֲבוֹתֵֽינוּ",
    "143": "יוֹצְ֒רֵֽנוּ צוּר יְשׁוּעָתֵֽנוּ",
    "144": "קּפּוֹדֵֽנוּ וּמַצִּילֵֽנוּ",
    "145": "מֵעוֹלָם הוּא שְׁמֶֽךָ",
    "146": "וְאֵין לָֽנוּ עוֹד אֱלֹהִים",
    "147": "זוּלָתֶֽךָ סֶֽלָה:",
    "148": "עֶזְרַת אֲבוֹתֵֽינוּ",
    "149": "אַתָּה הוּא מֵעוֹלָם",
    "150": "מָגֵן וּמוֹשִֽׁיעַ",
    "151": "לָהֶם וְלִבְ֒נֵיהֶם אַחֲרֵיהֶם",
    "152": "בְּכָל דּוֹר וָדוֹר:",
    "153": "בְּרוּם עוֹלָם",
    "154": "מוֹשָׁבֶֽךָ",
    "155": "וּמִשְׁפָּטֶֽיךָ וְצִדְקָתְךָ",
    "156": "עַד אַפְ֒סֵי אָֽרֶץ:",
    "157": "אֶמֶת אַשְׁרֵי אִישׁ",
    "158": "שֶׁיִּשְׁמַע לְמִצְוֹתֶֽיךָ",
    "159": "וְתוֹרָתְ֒ךָ וּדְבָרְ֒ךָ",
    "160": "יָשִׂים עַל לִבּוֹ:",
    "161": "אֱמֶת אַתָּה הוּא אָדוֹן לְעַמֶּֽךָ",
    "162": "וּמֶֽלֶךְ גִּבּוֹר לָרִיב רִיבָם",
    "163": "לְאָבוֹת וּבָנִים:",
    "164": "אֱמֶת אַתָּה הוּא רִאשׁוֹן",
    "165": "וְאַתָּה הוּא אַחֲרוֹן",
    "166": "וּמִבַּלְעָדֶֽיךָ",
    "167": "אֵין לָֽנוּ מֶֽלֶךְ גּוֹאֵל וּמוֹשִֽׁיעַ:",
    "168": "אֱמֶת מִמִּצְרַֽיִם גְּאַלְתָּֽנוּ",
    "169": "יְהֹוָה אֱלֹהֵֽינוּ",
    "170": "וּמִבֵּית עֲבָדִים פְּדִיתָֽנוּ:",
    "171": "כָּל בְּכוֹרֵיהֶם הָרָֽגְתָּ",
    "172": "וּבְ֒כוֹרְ֒ךָ יִשְׂרָאֵל גָּאָֽלְתָּ",
    "173": "וְיַם סוּף לָהֶם בָּקַֽעְתָּ",
    "174": "וְזֵדִים טִבַּֽעְתָּ",
    "175": "וִידִידִים הֶעֱבַֽרְתָּ",
    "176": "וַיְ֒כַסּוּ מַֽיִם צָרֵיהֶם",
    "177": "אֶחָד מֵהֶם לֹא נוֹתָר:",
    "178": "עַל זֹאת שִׁבְּ֒חוּ אֲהוּבִים",
    "179": "וְרוֹמְ֒מוּ לָאֵל",
    "180": "וְנָתְ֒נוּ יְדִידִים",
    "181": "זְמִירוֹת שִׁירוֹת וְתִשְׁבָּחוֹת",
    "182": "בְּרָכוֹת וְהוֹדָאוֹת",
    "183": "לְמֶּֽלֶךְ אֵל",
    "184": "חַי וְקַיָּם:",
    "185": "רָם וְנִשָּׂא",
    "186": "גָּדוֹל וְנוֹרָא",
    "187": "מַשְׁפִּיל גֵּאִים עֲדֵי אָֽרֶץ",
    "188": "וּמַגְבִּֽיהַּ שְׁפָלִים עֲדֵי מָרוֹם",
    "189": "מוֹצִיא אֲסִירִים",
    "190": "וּפוֹדֶה עֲנָוִים",
    "191": "וְעוֹזֵר דַּלִּים",
    "192": "וְעוֹנֶה לְעַמּוֹ יִשְׂרָאֵל",
    "193": "בְּעֵת שַׁוְּעָם אֵלָיו:",
    "194": "❖תְּהִלּוֹת לְאֵל עֶלְיוֹן",
    "195": "גֹּאֲלָם",
    "196": "בָּרוּךְ הוּא וּמְ֒בֹרָךְ,",
    "197": "משֶׁה וּבְ֒נֵי יִשְׂרָאֵל",
    "198": "לְךָ עָנוּ שִׁירָה בְּשִׂמְחָה רַבָּה",
    "199": "וְאָמְ֒רוּ כֻלָּם:",
    "200": "מִי כָמֹֽכָה בָּאֵלִם יְהֹוָה",
    "201": "מִי כָּמֹֽכָה",
    "202": "נֶאְדָּר בַּקֹּֽדֶשׁ",
    "203": "נוֹרָא תְהִלֹּת עֹֽשֵׂה פֶֽלֶא:",
    "204": "שִׁירָה חֲדָשָׁה שִׁבְּ֒חוּ גְאוּלִים",
    "205": "לְשִׁמְךָ הַגָּדוֹל עַל שְׂפַת הַיָּם",
    "206": "יַֽחַד כֻּלָּם",
    "207": "הוֹדוּ",
    "208": "וְהִמְלִֽיכוּ",
    "209": "וְאָמְרוּ:",
    "210": "יְהֹוָה יִמְלֹךְ לְעוֹלָם וָעֶד:",
    "211": "צוּר יִשְׂרָאֵל",
    "212": "קֽוּמָה בְּעֶזְרַת יִשְׂרָאֵל",
    "213": "וּפְ֒דֵה",
    "214": "כִנְ֒אֻמֶֽךָ יְהוּדָה וְיִשְׂרָאֵל,",
    "215": "❖גֹּאֲלֵֽנוּ",
    "216": "יְהֹוָה צְבָאוֹת שְׁמוֹ",
    "217": "קְדוֹשׁ יִשְׂרָאֵל:",
    "218": "בָּרוּךְ אַתָּה יְהֹוָה",
    "219": "גָּאַל יִשְׂרָאֵל:"
   },
   "en": {
    "3": "<small>The following three words should be said when praying without aminyan:</small>",
    "4": "(Almighty, faithful King)",
    "5": "Hear, Israel:",
    "6": "Adonoy is our God,",
    "7": "Adonoy is One.",
    "8": "<small>The following three lines are to be said silently:</small>",
    "9": "Blessed [is His] Name,",
    "10": "Whose glorious kingdom",
    "11": "is forever and ever.",
    "12": "And you shall love Adonoy your God",
    "13": "with all your heart",
    "14": "and with all your soul",
    "15": "and with all your possessions.",
    "16": "And these words",
    "17": "which I command you today,",
    "18": "shall be upon your heart.",
    "19": "And you shall teach them sharply",
    "20": "to your children.",
    "21": "And you shall discuss them",
    "22": "when you sit in your house,",
    "23": "and when you travel on the road,",
    "24": "and when you lie down and when you rise.",
    "25": "And you shall bind them for a sign",
    "26": "upon your hand,",
    "27": "and they shall be for <i>totafos</i>",
    "28": "between your eyes.",
    "29": "And you shall write them",
    "30": "upon the doorposts of your house",
    "31": "and upon your gateways.",
    "32": "And it will be—",
    "33": "if you vigilantly obey My commandments",
    "34": "which I command you this day,",
    "35": "to love Adonoy your God,",
    "36": "and serve Him",
    "37": "with your entire hearts",
    "38": "and with your entire souls—",
    "39": "that I will give rain for your land",
    "40": "in its proper time,",
    "41": "the early (autumn) rain",
    "42": "and the late (spring) rain;",
    "43": "and you will harvest your grain",
    "44": "and your wine and your oil.",
    "45": "And I will put grass",
    "46": "in your fields for your cattle,",
    "47": "and you will eat and be satisfied.",
    "48": "Beware lest your hearts be swayed",
    "49": "and you turn astray,",
    "50": "and you worship alien gods",
    "51": "and bow to them.",
    "52": "And Adonoy's fury will blaze among you,",
    "53": "and He will close off the heavens",
    "54": "and there will be no rain",
    "55": "and the earth will not yield its produce;",
    "56": "and you will perish swiftly",
    "57": "from the good land",
    "58": "which Adonoy gives you.",
    "59": "Place these words of Mine",
    "60": "upon your hearts and upon your souls,—",
    "61": "and bind them for a sign",
    "62": "upon your hands,",
    "63": "and they shall be for <i>totafos</i>",
    "64": "between your eyes.",
    "65": "And you shall teach them to your sons,",
    "66": "to speak them",
    "67": "when you sit in your house,",
    "68": "and when you travel on the road,",
    "69": "and when you lie down and when you rise.",
    "70": "And you shall write them",
    "71": "upon the doorposts of your house",
    "72": "and upon your gateways.",
    "73": "In order that your days be prolonged,",
    "74": "and the days of your children,",
    "75": "upon the land",
    "76": "which Adonoy swore to your fathers",
    "77": "to give them [for as long]",
    "78": "as the heavens are above the earth.",
    "79": "And Adonoy spoke to Moses saying:",
    "80": "Speak to the children of Israel,",
    "81": "and tell them",
    "82": "to make for themselves fringes",
    "83": "on the corners of their garments",
    "84": "throughout their generations;",
    "85": "and they will place with the fringes",
    "86": "of each corner",
    "87": "a thread of blue.",
    "88": "And it will be to you for fringes,",
    "89": "and you will look upon it",
    "90": "and you will remember",
    "91": "all the commandments of Adonoy,",
    "92": "and you will perform them;",
    "93": "and you will not turn aside after your hearts",
    "94": "and after your eyes",
    "95": "which cause you to go astray.",
    "96": "In order that you will remember",
    "97": "and perform all My commandments;",
    "98": "and you will be holy unto your God.",
    "99": "I am Adonoy, your God,",
    "100": "Who brought you out",
    "101": "of the land of Egypt",
    "102": "to be your God:",
    "103": "I am Adonoy, your God—",
    "105": "is true—",
    "106": "<small>The Chazzan repeats:</small>",
    "107": "Adonoy, your God, is true.",
    "109": "—and firm,",
    "110": "certain and enduring,",
    "111": "upright and faithful,",
    "112": "beloved and cherished,",
    "113": "desired and pleasant,",
    "114": "awesome and mighty,",
    "115": "correct80 and acceptable,",
    "116": "good and beautiful",
    "117": "is this [affirmation] to us for all eternity.",
    "118": "It is true,",
    "119": "that the God of the Universe, is our King,",
    "120": "the Stronghold of Jacob",
    "121": "is the Shield of our deliverance.",
    "122": "Throughout the generations",
    "123": "He endures and His Name endures,",
    "124": "and His throne is confirmed;",
    "125": "and His sovereignty and His faithfulness",
    "126": "endure forever.",
    "127": "His words are alive and enduring,",
    "128": "faithful and desirable",
    "129": "forever and to all eternity;",
    "130": "for our fathers and for us,",
    "131": "for our children and for our generations,",
    "132": "and for all generations",
    "133": "of the seed of Israel, Your servants.",
    "134": "Upon the first",
    "135": "and upon the last, [generations]",
    "136": "[it is] a matter that is good and everlasting.",
    "137": "It is true and faithful,",
    "138": "a Law that will never be abrogated.",
    "139": "Truly you Adonoy, are",
    "140": "our God, and the God of our fathers,",
    "141": "our King the King of our fathers,",
    "142": "our Redeemer, Redeemer of our fathers,",
    "143": "our Former, Rock of our deliverance;",
    "144": "our Liberator and our Saver",
    "145": "which is Your Name from old,",
    "146": "and we have no other God",
    "147": "besides You, ever.",
    "148": "The help of our fathers",
    "149": "You have always been.",
    "150": "A Shield and a Deliverer",
    "151": "to them and their children after them",
    "152": "in every generation.",
    "153": "The heights of the universe,",
    "154": "is Your habitation,",
    "155": "and Your judgments and Your righteousness",
    "156": "[reach] to the ends of the earth.",
    "157": "Truly fortunate is man",
    "158": "who heeds Your commandments;",
    "159": "and Your Torah and Your word",
    "160": "he takes to his heart.",
    "161": "Truly, You are the Master of Your people",
    "162": "and a mighty King to defend their cause.",
    "163": "for the fathers and [their] sons:",
    "164": "Truly, You are First",
    "165": "and You are Last,",
    "166": "and besides You",
    "167": "we have no king, redeemer, or deliverer.",
    "168": "Truly Your redeemed us from Egypt.",
    "169": "Adonoy, our God,",
    "170": "from the house of bondage You liberated us.",
    "171": "All their firstborn You slew,",
    "172": "and Israel, Your firstborn, You redeemed.",
    "173": "The Sea of Reeds, You split for them,",
    "174": "and the wicked, You drowned.",
    "175": "You caused the beloved ones to pass through,",
    "176": "while the waters covered their enemies;",
    "177": "not one of them remained.",
    "178": "Because of this, the beloved ones praised",
    "179": "and exalted the Almighty;",
    "180": "and the beloved ones offered",
    "181": "hymns, songs, and praises,",
    "182": "blessings and thanksgiving",
    "183": "to the King, the Almighty,",
    "184": "[Who is] living and enduring.",
    "185": "(He is) exalted and uplifted,",
    "186": "great and awesome;",
    "187": "He humbles the haughty to the ground.",
    "188": "and raises the lowly, to the heights.",
    "189": "He frees the captives",
    "190": "and redeems the humble,",
    "191": "(and) helps the impoverished,",
    "192": "and He answers His people Israel",
    "193": "when they cry out to Him.",
    "194": "Praises to the most high Almighty",
    "195": "their redeemer,",
    "196": "blessed is He,91 and He is blessed.",
    "197": "Moses and the Children of Israel",
    "198": "sang a song to You with great joy,",
    "199": "and they all proclaimed:",
    "200": "“Who is like You among the mighty, Adonoy!",
    "201": "Who is like You—",
    "202": "[You are] adorned in holiness,",
    "203": "awesome in praise, performing wonders!”",
    "204": "With a new song the redeemed people praised",
    "205": "Your great Name at the seashore!",
    "206": "All of them in unison",
    "207": "gave thanks",
    "208": "and proclaimed Your sovereignty,",
    "209": "and said:",
    "210": "“Adonoy will reign forever and ever.”",
    "211": "Rock of Israel,",
    "212": "arise to the aid of Israel,",
    "213": "and liberate",
    "214": "Judah and Israel as You promised.",
    "215": "Our Redeemer—",
    "216": "‘Adonoy of hosts' is His Name,",
    "217": "the Holy One of Israel",
    "218": "Blessed are You, Adonoy,",
    "219": "Who redeemed Israel."
   }
  }
 }
}
