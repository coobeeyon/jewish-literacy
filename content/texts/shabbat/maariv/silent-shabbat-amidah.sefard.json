    "52": "וְנֶאֱמָן אַתָּה",
    "53": "לְהַחֲיוֹת מֵתִים:",
    "54": "בָּרוּךְ אַתָּה יְהֹוָה",
    "55": "מְחַיֵּה הַמֵּתִים:",
    "57": "אַתָּה קָדוֹשׁ וְשִׁמְךָ קָדוֹשׁ",
    "58": "וּקְ֒דוֹשִׁים",
    "59": "בְּכָל יוֹם יְהַלְ֒לֽוּךָ סֶּֽלָה:",
    "60": "כִּי אֵל מֶֽלֶךְ",
    "61": "גָּדוֹל וְקָדוֹשׁ אָֽתָּה:",
    "63": "בָּרוּךְ אַתָּה יְהֹוָה",
    "64": "הָאֵל הַקָּדוֹשׁ:",
    "66": "<small>בָּרוּךְ אַתָּה יְהֹוָה</small>",
    "67": "<small>הַמֶּֽלֶךְ הַקָּדוֹשׁ:</small>",
    "69": "אַתָּה קִדַּֽשְׁתָּ אֶת יוֹם הַשְּׁ֒בִיעִי",
    "70": "לִשְׁמֶךָ.",
    "71": "תַּכְלִית",
    "72": "מַעֲשֵׂה שָׁמַֽיִם וָאָֽרֶץ.",
    "73": "וּבֵרַכְתּוֹ מִכָּל הַיָּמִים.",
    "74": "וְקִדַּשְׁתּוֹ מִכָּל הַזְּ֒מַנִּים",
    "75": "וְכֵן כָּתוּב בְּתוֹרָתֶֽךָ:",
    "76": "וַיְכֻלּוּ הַשָּׁמַֽיִם וְהָאָֽרֶץ",
    "77": "וְכָל־צְבָאָם:",
