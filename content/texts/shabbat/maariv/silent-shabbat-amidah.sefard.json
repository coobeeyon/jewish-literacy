    "79": "מְלַאכְתּוֹ אֲשֶׁר עָשָׂה.",
    "80": "וַיִּשְׁבֹּת בַּיּוֹם הַשְּׁ֒בִיעִי",
    "81": "מִכָּל־מְלַאכְתּוֹ אֲשֶׁר עָשָׂה:",
    "82": "וַיְבָֽרֶךְ אֱלֹהִים אֶת־יוֹם הַשְּׁ֒בִיעִי",
    "83": "וַיְקַדֵּשׁ אֹתוֹ.",
    "84": "כִּי בוֹ שָׁבַת",
    "85": "מִכָּל־מְלַאכְתּוֹ",
    "86": "אֲשֶׁר־בָּרָא אֱלֹהִים לַעֲשׂוֹת:",
    "87": "יִשְׂמְחוּ בְמַלְכוּתְ֒ךָ",
    "88": "שׁוֹמְ֒רֵי שַׁבָּת",
    "89": "וְקוֹרְ֒אֵי עֹֽנֶג.",
    "90": "עַם מְקַדְּ֒שֵׁי שְׁבִיעִי.",
    "91": "כֻּלָּם יִשְׂבְּ֒עוּ",
    "92": "וְיִתְעַנְּ֒גוּ מִטּוּבֶֽךָ.",
    "93": "וּבַשְּׁ֒בִיעִי רָצִֽיתָ בּוֹ",
    "94": "וְקִדַּשְׁתּוֹ.",
    "95": "חֶמְדַּת יָמִים אוֹתוֹ קָרָֽאתָ.",
    "96": "זֵֽכֶר",
    "97": "לְמַעֲשֵׂה בְרֵאשִׁית:",
    "98": "אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ",
    "99": "רְצֵה נָא בִמְנוּחָתֵֽנוּ.",
    "100": "קַדְּ֒שֵֽׁנוּ בְּמִצְוֹתֶֽיךָ",
    "101": "וְתֵן חֶלְקֵֽנוּ בְּתוֹרָתֶֽךָ",
    "102": "שַׂבְּ֒עֵֽנוּ מִטּוּבֶֽךָ.",
    "103": "וְשַׂמַּח נַפְשֵֽׁנוּ בִּישׁוּעָתֶֽךָ.",
    "104": "וְטַהֵר לִבֵּֽנוּ לְעָבְדְּ֒ךָ בֶּאֱמֶת.",
    "105": "וְהַנְחִילֵֽנוּ",
    "106": "יְהֹוָה אֱלֹהֵֽינוּ",
    "107": "בְּאַהֲבָה וּבְרָצוֹן",
    "108": "שַׁבַּת קָדְשֶֽׁךָ.",
    "109": "וְיָנֽוּחוּ בָהּ כָּל יִשְׂרָאֵל",
    "110": "מְקַדְּ֒שֵׁי שְׁמֶֽךָ.",
    "111": "בָּרוּךְ אַתָּה יְהֹוָה",
    "112": "מְקַדֵּשׁ הַשַּׁבָּת:",
    "114": "רְצֵה יְהֹוָה אֱלֹהֵֽינוּ",
    "115": "בְּעַמְּ֒ךָ יִשְׂרָאֵל",
    "116": "וְלִתְ֒פִלָּתָם שְׁעֵה,",
    "117": "וְהָשֵׁב אֶת הָעֲבוֹדָה",
    "118": "לִדְ֒בִיר בֵּיתֶֽךָ",
    "119": "וְאִשֵּׁי יִשְׂרָאֵל,",
    "120": "וּתְ֒פִלָּתָם בְּאַהֲבָה תְקַבֵּל",
    "121": "בְּרָצוֹן",
    "122": "וּתְ֒הִי לְרָצוֹן תָּמִיד",
    "123": "עֲבוֹדַת יִשְׂרָאֵל עַמֶּֽךָ:",
    "126": "אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ",
    "127": "יַעֲלֶה וְיָבֹא וְיַגִּֽיעַ",
    "128": "וְיֵרָאֶה וְיֵרָצֶה וְיִשָּׁמַע",
    "129": "וְיִפָּקֵד וְיִזָּכֵר",
    "130": "זִכְרוֹנֵֽנוּ וּפִקְ֒דוֹנֵֽנוּ",
    "131": "וְזִכְרוֹן אֲבוֹתֵֽינוּ",
    "132": "וְזִכְרוֹן מָשִֽׁיחַ",
    "133": "בֶּן דָּוִד עַבְדֶּֽךָ",
    "134": "וְזִכְרוֹן יְרוּשָׁלַֽיִם",
    "135": "עִיר קָדְשֶֽׁךָ",
    "136": "וְזִכְרוֹן כָּל עַמְּ֒ךָ",
    "137": "בֵּית יִשְׂרָאֵל לְפָנֶֽיךָ,",
    "138": "לִפְ֒לֵיטָה לְטוֹבָה",
    "139": "לְחֵן וּלְ֒חֶֽסֶד וּלְ֒רַחֲמִים",
    "140": "וּלְ֒חַיִּים טוֹבִים וּלְ֒שָׁלוֹם",
    "141": "בְּיוֹם",
    "142": "<small>לר\"ח:</small> רֹאשׁ הַחֹֽדֶשׁ הַזֶּה",
    "143": "<small>לפסח:</small> חַג הַמַּצּוֹת הַזֶּה",
    "144": "<small>לסכות:</small> חַג הַסֻּכּוֹת הַזֶּה",
    "145": "זָכְ֒רֵֽנוּ יְהֹוָה אֱלֹהֵֽינוּ",
    "146": "בּוֹ לְטוֹבָה,",
    "147": "וּפָקְ֒דֵֽנוּ בוֹ לִבְ֒רָכָה,",
    "148": "וְהוֹשִׁיעֵֽנוּ בוֹ לְחַיִּים טוֹבִים,",
    "149": "וּבִדְ֒בַר יְשׁוּעָה",
    "150": "וְרַחֲמִים",
    "151": "חוּס וְחָנֵּֽנוּ,",
    "152": "וְרַחֵם עָלֵֽינוּ וְהוֹשִׁיעֵֽנוּ,",
    "153": "כִּי אֵלֶֽיךָ עֵינֵֽינוּ,",
    "154": "כִּי אֵל",
    "155": "מֶֽלֶךְ חַנּוּן וְרַחוּם אָֽתָּה:",
    "157": "וְתֶחֱזֶֽינָה עֵינֵֽינוּ",
    "158": "בְּשׁוּבְ֒ךָ לְצִיּוֹן בְּרַחֲמִים:",
    "159": "בָּרוּךְ אַתָּה יְהֹוָה",
    "160": "הַמַּחֲזִיר שְׁכִינָתוֹ לְצִיּוֹן:",
    "163": "מוֹדִים אֲנַֽחְנוּ לָךְ",
    "164": "שָׁאַתָּה הוּא יְהֹוָה אֱלֹהֵֽינוּ",
    "165": "וֵאלֹהֵי אֲבוֹתֵֽינוּ לְעוֹלָם וָעֶד",
    "166": "צוּרֵֽנוּ צוּר חַיֵּֽינוּ",
    "167": "מָגֵן יִשְׁעֵֽנוּ",
    "168": "אַתָּה הוּא לְדוֹר וָדוֹר",
    "169": "נוֹדֶה לְּךָ",
    "170": "וּנְ֒סַפֵּר תְּהִלָּתֶֽךָ",
    "171": "עַל חַיֵּֽינוּ",
    "172": "הַמְּ֒סוּרִים בְּיָדֶֽךָ",
    "173": "וְעַל נִשְׁ֒מוֹתֵֽינוּ",
    "174": "הַפְּ֒קוּדוֹת לָךְ",
    "175": "וְעַל נִסֶּֽיךָ שֶׁבְּ֒כָל יוֹם עִמָּֽנוּ",
    "176": "וְעַל נִפְלְאוֹתֶֽיךָ וְטוֹבוֹתֶֽיךָ",
    "177": "שֶׁבְּ֒כָל עֵת,",
    "178": "עֶֽרֶב וָבֹֽקֶר וְצָהֳרָֽיִם,",
    "179": "הַטּוֹב",
    "180": "כִּי לֹא כָלוּ רַחֲמֶֽיךָ",
    "181": "וְהַמְ֒רַחֵם",
    "182": "כִּי לֹא תַֽמּוּ חֲסָדֶֽיךָ,",
    "183": "כִּי מֵעוֹלָם קִוִּֽינוּ לָךְ:",
    "185": "וְעַל הַנִּסִּים",
    "186": "וְעַל הַפֻּרְקָן וְעַל הַגְּ֒בוּרוֹת",
    "187": "וְעַל הַתְּ֒שׁוּעוֹת וְעַל הַנִּפְלָאוֹת",
    "188": "וְעַל הַנֶּחָמוֹת וְעַל הַמִּלְחָמוֹת",
    "189": "שֶׁעָשִֽׂיתָ לַאֲבוֹתֵֽינוּ",
    "190": "בַּיָּמִים הָהֵם בִּזְּ֒מַן הַזֶּה:",
    "191": "בִּימֵי מַתִּתְיָֽהוּ",
    "192": "בֶּן יוֹחָנָן כֹּהֵן גָּדוֹל",
    "193": "חַשְׁמוֹנָאִי וּבָנָיו",
    "194": "כְּשֶׁעָמְ֒דָה מַלְ֒כוּת יָוָן הָרְ֒שָׁעָה",
    "195": "עַל עַמְּ֒ךָ יִשְׂרָאֵל",
    "196": "לְהַשְׁכִּיחָם תּוֹרָתֶֽךָ",
    "197": "וּלְ֒הַעֲבִירָם",
    "198": "מֵחֻקֵּי רְצוֹנֶֽךָ,",
    "199": "וְאַתָּה בְּרַחֲמֶֽיךָ הָרַבִּים",
    "200": "עָמַֽדְתָּ לָהֶם בְּעֵת צָרָתָם",
    "201": "רַֽבְתָּ אֶת רִיבָם",
    "202": "דַּֽנְתָּ אֶת דִּינָם",
    "203": "נָקַֽמְתָּ אֶת נִקְ֒מָתָם",
    "204": "מָסַֽרְתָּ גִבּוֹרִים",
    "205": "בְּיַד חַלָּשִׁים",
    "206": "וְרַבִּים בְּיַד מְעַטִּים",
    "207": "וּטְ֒מֵאִים בְּיַד טְהוֹרִים",
    "208": "וּרְ֒שָׁעִים בְּיַד צַדִּיקִים",
    "209": "וְזֵדִים בְּיַד",
    "210": "עוֹסְ֒קֵי תוֹרָתֶֽךָ",
    "211": "וּלְ֒ךָ עָשִֽׂיתָ",
    "212": "שֵׁם גָּדוֹל וְקָדוֹשׁ בְּעוֹלָמֶֽךָ",
    "213": "וּלְ֒עַמְּ֒ךָ יִשְׂרָאֵל",
    "214": "עָשִֽׂיתָ תְּשׁוּעָה גְדוֹלָה",
    "215": "וּפֻרְקָן כְּהַיּוֹם הַזֶּה",
    "216": "וְאַחַר כַּךְ בָּֽאוּ בָנֶֽיךָ",
    "217": "לִדְ֒בִיר בֵּיתֶֽךָ",
    "218": "וּפִנּוּ אֶת הֵיכָלֶֽךָ",
    "219": "וְטִהֲרוּ אֶת מִקְדָּשֶֽׁךָ",
    "220": "וְהִדְלִֽיקוּ נֵרוֹת",
    "221": "בְּחַצְ֒רוֹת קָדְשֶֽׁךָ",
    "222": "וְקָבְ֒עוּ שְׁמוֹנַת יְמֵי חֲנֻכָּה אֵֽלּוּ",
    "223": "לְהוֹדוֹת וּלְ֒הַלֵּל לְשִׁמְ֒ךָ הַגָּדוֹל:",
    "224": "וְעַל כֻּלָּם",
    "225": "יִתְבָּרַךְ וְיִתְרוֹמַם וְיִתְנַשֵׂא",
    "226": "שִׁמְ֒ךָ מַלְכֵּֽנוּ",
    "227": "תָּמִיד לְעוֹלָם וָעֶד:",
    "229": "<small>וּכְ֒תוֹב לְחַיִּים טוֹבִים</small>",
    "230": "<small>כָּל בְּנֵי בְרִיתֶֽךָ:</small>",
    "232": "וְכֹל הַחַיִּים יוֹדֽוּךָ סֶּֽלָה",
    "233": "וִיהַלְ֒לוּ וְיבָרְ֒כוּ",
    "234": "אֶת שִׁמְ֒ךָ הַגָּדוֹל בְּאֱמֶת לְעוֹלָם",
    "235": "כִּי טוֹב",
    "236": "הָאֵל יְשׁוּעָתֵֽנוּ",
    "237": "וְעֶזְרָתֵֽנוּ סֶֽלָה",
    "238": "הָאֵל הַטּוֹב:",
    "239": "בָּרוּךְ אַתָּה יְהֹוָה",
    "240": "הַטּוֹב שִׁמְ֒ךָ",
    "241": "וּלְ֒ךָ נָאֶה לְהוֹדוֹת:",
    "244": "שִׂים שָׁלוֹם טוֹבָה וּבְ֒רָכָה",
    "245": "חַיִים חֵן וָחֶֽסֶד וְרַחֲמִים",
    "246": "עָלֵֽינוּ וְעַל כָּל יִשְׂרָאֵל עַמֶּֽךָ,",
    "247": "בָּרְ֒כֵֽנוּ אָבִֽינוּ כֻּלָּֽנוּ כְּאֶחָד",
    "248": "בְּאוֹר פָּנֶֽיךָ",
    "249": "כִּי בְאוֹר פָּנֶֽיךָ",
    "250": "נָתַֽתָּ לָּֽנוּ יְהֹוָה אֱלֹהֵֽינוּ",
    "251": "תּוֹרַת חַיִּים וְאַהֲבַת חֶֽסֶד",
    "252": "וּצְ֒דָקָה וּבְ֒רָכָה וְרַחֲמִים",
    "253": "וְחַיִּים וְשָׁלוֹם,",
    "254": "וְטוֹב יִהְיֶה בְּעֵינֶֽיךָ",
    "255": "לְבָרְ֒כֵֽנוּ",
    "256": "וּלְ֒בָרֵךְ אֶת כָּל עַמְּ֒ךָ יִשְׂרָאֵל",
    "257": "בְּכָל עֵת וּבְכָל שָׁעָה",
    "258": "בִּשְׁ֒לוֹמֶֽךָ",
    "259": "(בְּרוֹב עוֹז וְשָׁלוֹם).",
    "261": "<small>בְּסֵֽפֶר חַיִּים בְּרָכָה וְשָׁלוֹם</small>",
    "262": "<small>וּפַרְנָסָה טוֹבָה</small>",
    "263": "<small> וּגְ֒זֵרוֹת טוֹבוֹת, יְשׁוּעוֹת וְנֶחָמוֹת,</small>",
    "264": "<small>נִזָּכֵר וְנִכָּתֵב</small>",
    "265": "<small>לְפָנֶֽיךָ</small>",
    "266": "<small>אֲנַֽחְנוּ וְכָל עַמְּ֒ךָ בֵּית יִשְׂרָאֵל</small>",
    "267": "<small>לְחַיִּים טוֹבִים וּלְ֒שָׁלוֹם:</small>",
    "269": "בָּרוּךְ אַתָּה יְהֹוָה",
    "270": "הַמְּ֒בָרֵךְ אֶת עַמּוֹ יִשְׂרָאֵל",
    "271": "בַּשָּׁלוֹם:",
    "273": "שָׁלוֹם רָב",
    "274": "עַל יִשְׂרָאֵל עַמְּ֒ךָ.",
    "275": "תָּשִׂים לְעוֹלָם",
    "276": "כִּי אַתָּה הוּא מֶֽלֶךְ",
    "277": "אָדוֹן לְכָל הַשָּׁלוֹם",
    "278": "וְטוֹב יִהְיֶה בְּעֵינֶֽיךָ",
    "279": "לְבָרְ֒כֵֽנוּ",
    "280": "וּלְ֒בָרֵךְ אֶת כָּל עַמְּ֒ךָ יִשְׂרָאֵל",
    "281": "בְּכָל עֵת וּבְכָל שָׁעָה",
    "282": "בִּשְׁ֒לוֹמֶֽךָ",
    "284": "<small>בְּסֵֽפֶר חַיִּים בְּרָכָה וְשָׁלוֹם</small>",
    "285": "<small>וּפַרְנָסָה טוֹבָה</small>",
    "286": "<small> וּגְ֒זֵרוֹת טוֹבוֹת, יְשׁוּעוֹת וְנֶחָמוֹת,</small>",
    "287": "<small>נִזָּכֵר וְנִכָּתֵב</small>",
    "288": "<small>לְפָנֶֽיךָ</small>",
    "289": "<small>אֲנַֽחְנוּ וְכָל עַמְּ֒ךָ בֵּית יִשְׂרָאֵל</small>",
    "290": "<small>לְחַיִּים טוֹבִים וּלְ֒שָׁלוֹם:</small>",
    "292": "בָּרוּךְ אַתָּה יְהֹוָה",
    "293": "הַמְּ֒בָרֵךְ אֶת עַמּוֹ יִשְׂרָאֵל",
    "294": "בַּשָּׁלוֹם:",
    "295": "יִהְיוּ לְרָצוֹן",
    "296": "אִמְ֒רֵי פִי",
    "297": "וְהֶגְיוֹן לִבִּי לְפָנֶֽיךָ",
    "298": "יְהֹוָה צוּרִי וְגוֹאֲלִי:",
    "299": "אֱלֹהַי נְצוֹר לְשׁוֹנִי מֵרָע",
    "300": "וּשְׂ֒פָתַי מִדַּבֵּר מִרְמָה",
    "301": "וְלִמְ֒קַלְ֒לַי",
    "302": "נַפְשִׁי תִדּוֹם",
    "303": "וְנַפְשִׁי כֶּעָפָר לַכֹּל תִּהְיֶה",
    "304": "פְּתַח לִבִּי בְּתוֹרָתֶֽךָ",
    "305": "וְאַחֲרֵי מִצְוֹתֶֽיךָ תִּרְדּוֹף נַפְשִׁי",
    "306": "וְכָל הַקָמִים וְהַחוֹשְׁ֒בִים עָלַי רָעָה",
    "307": "מְהֵרָה הָפֵר עֲצָתָם",
    "308": "וְקַלְקֵל מַחֲשַׁבְתָּם:",
    "309": "(יְהִי רָצוֹן מִלְ֒פָנֶיךָ",
    "310": "יְהֹוָה אֱלֹהַי וֵאלֹהֵי אֲבוֹתַי",
    "311": "שֶׁלֹּא תַעֲלֶה קִנְאַת אָדָם עָלַי",
    "312": "וְלֹא קִנְאָתִי עַל אֲחֵרִים",
    "313": "וְשֶׁלֹּא אֶכְעֹס הַיּוֹם",
    "314": "וְשֶׁלֹּא אַכְעִיסֶֽךָ",
    "315": "וְתַצִּילֵנִי מִיֵּֽצֶר הָרָע",
    "316": "וְתֵן בְּלִבִּי הַכְנָעָה וַעֲנָוָה.",
    "317": "מַלְכֵּֽנוּ וֵאלֹהֵֽינוּ",
    "318": "יַחֵד שִׁמְ֒ךָ בְּעוֹלָמֶֽךָ,",
    "319": "בְּנֵה עִירְ֒ךָ, יַסֵּד בֵּיתֶֽךָ,",
    "320": "וְשַׁכְלֵל הֵיכָלֶֽךָ.",
    "321": "וְקַבֵּץ קִבּוּץ גָּלֻיּוֹת,",
    "322": "וּפְ֒דֵה צֹאנֶֽךָ וְשַׂמַּח עֲדָתֶֽךָ.)",
    "323": "עֲשֵׂה לְמַֽעַן שְׁמֶֽךָ,",
    "324": "עֲשֵׂה לְמַֽעַן יְמִינֶֽךָ,",
    "325": "עֲשֵׂה לְמַֽעַן תּוֹרָתֶֽךָ,",
    "326": "עֲשֵׂה לְמַֽעַן קְדֻשָּׁתֶֽךָ.",
    "327": "לְמַֽעַן יֵחָלְ֒צוּן יְדִידֶֽיךָ",
    "328": "הוֹשִֽׁיעָה יְמִינְ֒ךָ וַעֲנֵֽנִי:",
    "330": "יִהְיוּ לְרָצוֹן",
    "331": "אִמְרֵי פִי",
    "332": "וְהֶגְיוֹן לִבִּי לְפָנֶֽיךָ",
    "333": "יְהֹוָה צוּרִי וְגוֹאֲלִי:",
    "334": "עֹשֶׂה (<small>בעשי\"ת</small> הַשָּׁלוֹם) שָׁלוֹם",
    "335": "בִּמְ֒רוֹמָיו",
    "336": "הוּא יַעֲשֶׂה שָׁלוֹם",
    "337": "עָלֵֽינוּ וְעַל כָּל יִשְׂרָאֵל",
    "338": "וְאִמְרוּ אָמֵן:",
    "339": "יְהִי רָצוֹן מִלְּ֒פָנֶֽיךָ",
    "340": "יְהֹוָה אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ",
    "341": "שֶׁיִּבָּנֶה בֵּית הַמִּקְדָּשׁ",
    "342": "בִּמְהֵרָה בְיָמֵֽינוּ",
    "343": "וְתֵן חֶלְקֵֽנוּ בְּתוֹרָתֶֽךָ:",
    "344": "וְשָׁם נַעֲבָדְ֒ךָ בְּיִרְאָה",
    "345": "כִּימֵי עוֹלָם",
    "346": "וּכְ֒שָׁנִים קַדְמוֹנִיּוֹת:",
    "347": "וְעָרְ֒בָה לַיהֹוָה",
    "348": "מִנְחַת יְהוּדָה וִירוּשָׁלָֽםִ",
    "349": "כִּימֵי עוֹלָם וּכְ֒שָׁנִים קַדְמוֹנִיּוֹת:"
   },
   "en": {
    "1": "My Master, open my lips,",
    "2": "and my mouth will declare Your praise.",
    "4": "Blessed are You, Adonoy,",
    "5": "our God, and God of our fathers,",
    "6": "God of Abraham, God of Isaac,",
    "7": "and God of Jacob,",
    "8": "the Almighty,",
    "9": "the Great, the Powerful, the Awesome,",
    "10": "most high Almighty,",
    "11": "Who bestows beneficent kindness,",
    "12": "Who possesses everything,",
    "13": "Who remembers the piety of the Patriarchs,",
    "14": "and Who brings a redeemer",
    "15": "to their children's children,",
    "16": "for the sake of His Name, with love.",
    "17": "<small>(During the Ten Days of Penitence add:</small>",
    "18": "Remember us for life",
    "19": "King, Who desires life;",
    "20": "and inscribe us in the Book of Life,",
    "21": "for Your sake, Living God.)",
    "23": "King, Helper, and Deliverer and Shield.",
    "24": "Blessed are You, Adonoy,",
    "25": "Shield of Abraham.",
    "27": "You are mighty forever, my Master;",
    "28": "You are the Resurrector of the dead",
    "29": "the Powerful One to deliver us.",
    "30": "<small>From the Musaf of the first day of Pesach until the Musaf of Shemini Atzeres you should say:</small>",
    "31": "He causes the dew to descend.",
    "32": "<small>From the Musaf of Shemini Atzeres until the Musaf <i>of the first day of Pesach you should say:</i></small>",
    "33": "Causer of the wind to blow",
    "34": "and of the rain to fall.",
    "36": "Sustainer of the living with kindliness,",
    "37": "Resurrector of the dead with great mercy,",
    "38": "Supporter of the fallen,",
    "39": "and Healer of the sick,",
    "40": "and Releaser of the imprisoned,",
    "41": "and Fulfiller of His faithfulness",
    "42": "to those who sleep in the dust.",
    "43": "Who is like You, Master of mighty deeds,",
    "44": "and who can be compared to You?",
    "45": "King Who causes death and restores life,",
    "46": "and causes deliverance to sprout forth.",
    "47": "<small>(During the Ten Days of Penitence add:</small>",
    "48": "Who is like You merciful Father,",
    "49": "Who remembers His creatures for life,",
    "50": "in His mercy.)",
    "52": "And You are faithful",
    "53": "to restore the dead to life.",
    "54": "Blessed are You, Adonoy,",
    "55": "Resurrector of the dead.",
    "57": "You are holy and Your Name is holy",
    "58": "and holy beings",
    "59": "praise You every day, forever.",
    "60": "For a great and Almighty King—",
    "61": "great and holy—are You.",
    "62": "<small>During the Ten Days of Penitence, continue at the asterisk (*).</small>",
    "63": "Blessed are You, Adonoy,",
    "64": "the Almighty, the Holy One.",
    "65": "<small>*During the Ten Days of Penitence:</small>",
    "66": "Blessed are You, Adonoy,",
    "67": "the King, the Holy One.",
    "69": "You have sanctified the seventh day",
    "70": "to Your Name,",
    "71": "[it was] the purpose of",
    "72": "making heaven and earth;",
    "73": "and You blessed it above all days",
    "74": "and You sanctified it above all seasons.",
    "75": "And so it is written in Your Torah:",
    "76": "And the heavens and the earth were completed",
    "77": "and [so were] all their hosts.",
    "78": "And God completed by the seventh day",
    "79": "His work which He had done,",
    "80": "and He abstained on the seventh day,",
    "81": "from all His work which He had done.",
    "82": "And God blessed the seventh day",
    "83": "and sanctified it",
    "84": "for on it He abstained",
    "85": "from all His work",
    "86": "which God had created to do.",
    "87": "They will rejoice in Your Kingship",
    "88": "those who preserve the Shabbos",
    "89": "and call it a delight",
    "90": "The people who sanctify the seventh [day]",
    "91": "will all be satisfied",
    "92": "and delighted from Your goodness.",
    "93": "And in the seventh [day], You took pleasure",
    "94": "and made it holy.",
    "95": "“Most desirable of days,” You called it,",
    "96": "in commemoration",
    "97": "of the work of the [world's] beginning.",
    "98": "Our God, and God of our fathers,",
    "99": "be pleased with our rest,",
    "100": "sanctify us with Your commandments",
    "101": "and give us our share in Your Torah;",
    "102": "satisfy us from Your goodness",
    "103": "and gladden us with Your deliverance,",
    "104": "and purify our hearts to serve You in truth.",
    "105": "And give us as our inheritance,",
    "106": "Adonoy our God,",
    "107": "in love and in pleasure",
    "108": "Your holy Shabbos;",
    "109": "and may all Israel rest thereon—",
    "110": "the sanctifiers of Your Name.",
    "111": "Blessed are You Adonoy,",
    "112": "Sanctifier of Shabbos.",
    "114": "Be pleased, Adonoy, our God,",
    "115": "with Your people Israel",
    "116": "and pay heed to their prayer;",
    "117": "and restore the service",
    "118": "to the Holy of Holies in Your abode,",
    "119": "and the fire-offerings of Israel;",
    "120": "and accept their prayer, lovingly",
    "121": "and willingly.",
    "122": "And may You always find pleasure",
    "123": "with the service of Your people, Israel.",
    "124": "<small>On a regular Shabbos continue, “And may our eyes,” on p. 000.</small>",
    "125": "<small>On Rosh Chodesh and on Chol HaMoed, the following prayer is added:</small>",
    "126": "Our God and God of our fathers,",
    "127": "may there ascend, come, and reach,",
    "128": "appear, be desired, and heard,",
    "129": "counted and recalled",
    "130": "our remembrance and reckoning;",
    "131": "the remembrance of our fathers;",
    "132": "the remembrance of the Mashiach",
    "133": "the son of David, Your servant;",
    "134": "the remembrance of Jerusalem,",
    "135": "city of Your Sanctuary;",
    "136": "and the remembrance of Your entire people,",
    "137": "the House of Israel, before You",
    "138": "for survival, for well-being,",
    "139": "for favor, kindliness, compassion,",
    "140": "for good life and peace",
    "141": "on this day of:",
    "142": "Rosh Chodesh",
    "143": "the <i>Festival of Matzos</i>",
    "144": "the <i>Festival of Sukkos</i>",
    "145": "Remember us Adonoy, our God,",
    "146": "on this day for well-being;",
    "147": "be mindful of us on this day for blessing,",
    "148": "and deliver us for good life.",
    "149": "In accord with the promise of deliverance",
    "150": "and compassion,",
    "151": "spare us and favor us,",
    "152": "have compassion on us and deliver us;",
    "153": "for to You our eyes are directed",
    "154": "because You are the Almighty",
    "155": "Who is King, Gracious, and Merciful.",
    "157": "And may our eyes behold",
    "158": "Your merciful return to Zion.",
    "159": "Blessed are You, Adonoy,",
    "160": "Who returns His Divine Presence to Zion.",
    "161": "<small>At the words, We are thankful, <i>bend forward; at </i>Adonoy <i>return to an upright position.</i></small>",
    "163": "We are thankful to You",
    "164": "that You Adonoy are our God",
    "165": "and the God of our fathers forever;",
    "166": "Our Rock, Rock of our lives,",
    "167": "the Shield of our deliverance,",
    "168": "You are in every generation.",
    "169": "We will give thanks to You",
    "170": "and recount Your praise,",
    "171": "for our lives",
    "172": "which are committed into Your hand,",
    "173": "and for our souls",
    "174": "which are entrusted to (You,",
    "175": "and for Your miracles of every day with us,",
    "176": "and for Your wonders and benefactions",
    "177": "at all times—",
    "178": "evening, morning and noon.",
    "179": "(You are) The Beneficent One—",
    "180": "for Your compassion is never withheld;",
    "181": "And (You are) the Merciful One—",
    "182": "for Your kindliness never ceases;",
    "183": "for we have always placed our hope in You.",
    "185": "[We thank You] for the miracles",
    "186": "for the redemption, for the mighty deeds,",
    "187": "for the deliverances, for the wonders",
    "188": "for the consolations and for the wars",
    "189": "that You performed for our fathers",
    "190": "in those days at this season.",
    "191": "In the days of Matisyahu,",
    "192": "son of Yochanan the High Priest,",
    "193": "the Hasmonean and his sons,",
    "194": "when the evil Greek kingdom rose up",
    "195": "against Your people Israel",
    "196": "to make them forget Your Torah",
    "197": "and to turn them away",
    "198": "from the statutes of Your will—",
    "199": "You, in Your abundant mercy,",
    "200": "stood by them in their time of distress,",
    "201": "You defended their cause,",
    "202": "You judged their grievances,",
    "203": "You avenged them.",
    "204": "You delivered the mighty",
    "205": "into the hands of the weak,",
    "206": "many into the hands of the few,",
    "207": "defiled people into the hands of the undefiled,",
    "208": "the wicked into the hands of the righteous,",
    "209": "and insolent [sinners] into the hands of",
    "210": "diligent students of Your Torah.",
    "211": "And You made Yourself",
    "212": "a great and sanctified name in Your world.",
    "213": "And for Your people, Israel,",
    "214": "You performed a great deliverance",
    "215": "and redemption unto this very day.",
    "216": "Afterwards, Your sons entered",
    "217": "the Holy of Holies of Your Abode,",
    "218": "cleaned Your Temple,",
    "219": "purified Your Sanctuary,",
    "220": "and kindled lights",
    "221": "in the Courtyards of Your Sanctuary,",
    "222": "and designated these eight days of Chanukah",
    "223": "to thank and praise Your great Name.",
    "224": "And for all the foregoing",
    "225": "blessed, exalted and extolled",
    "226": "your Name, our King",
    "227": "constantly, forever and ever.",
    "228": "<small>During the Ten Days of Penitence, add:</small>",
    "229": "Inscribe for a good life",
    "230": "all the children of Your covenant.",
    "232": "And all the living shall thank You forever",
    "233": "and praise and bless",
    "234": "Your great Name with sincerity forever;",
    "235": "for You are goodness—",
    "236": "the Almighty, Who is our deliverance",
    "237": "and our help forever—",
    "238": "the benevolent Almighty.",
    "239": "Blessed are You, Adonoy,",
    "240": "“The Beneficent” is Your Name",
    "241": "and You it is fitting to praise.",
    "242": "<small>Some have the custom of saying שים שלום “Grant peace” here, while others say שלום רב “Abundant peace” on page 000.</small>",
    "244": "Grant peace, goodness, and blessing,",
    "245": "life favor, kindness and compassion",
    "246": "upon us and upon all Israel, Your people.",
    "247": "Bless us, our Father, all of us as one",
    "248": "with the light of Your countenance.",
    "249": "For by the light of Your countenance",
    "250": "You gave us Adonoy our God,",
    "251": "a Torah of life and the love of kindliness,",
    "252": "righteousness, blessing, compassion,",
    "253": "life, and peace.",
    "254": "And may it be good in Your sight",
    "255": "to bless us",
    "256": "and to bless Your people Israel,",
    "257": "at all times and at every moment",
    "258": "with Your peace",
    "259": "(with much strength and peace).",
    "260": "<small>During the Ten Days of Penitence continue here:</small>",
    "261": "In the book of life, blessing, peace",
    "262": "and abundant maintenance,",
    "263": "good decrees, salvations and condolences,",
    "264": "may we be remembered and inscribed",
    "265": "before You;",
    "266": "we and all Your people, the House of Israel",
    "267": "for a good life and peace.",
    "269": "Blessed are You, Adonoy,",
    "270": "Who blesses His people Israel",
    "271": "with peace.",
    "272": "<small>The following is said by some in place of שים שלום on the previous page.</small>",
    "273": "Abundant peace",
    "274": "upon Israel, Your people,",
    "275": "bestow forever,",
    "276": "for You King",
    "277": "are the Master of all peace.",
    "278": "And may it be good in Your sight",
    "279": "to bless us",
    "280": "and to bless Your people Israel,",
    "281": "at all times and at every moment",
    "282": "with Your peace.",
    "283": "<small>During the Ten Days of Penitence continue here:</small>",
    "284": "In the book of life, blessing, peace",
    "285": "and abundant maintenance,",
    "286": "good decrees, salvations and condolences,",
    "287": "may we be remembered and inscribed",
    "288": "before You;",
    "289": "we and all Your people, the House of Israel",
    "290": "for a good life and peace.",
    "292": "Blessed are You, Adonoy,",
    "293": "Who blesses His people Israel",
    "294": "with peace.",
    "295": "May they be acceptable",
    "296": "the words of my mouth",
    "297": "and the thoughts of my heart, before You",
    "298": "Adonoy, my Rock and my Redeemer.",
    "299": "My God, guard my tongue from evil",
    "300": "and my lips from speaking deceitfully.",
    "301": "To those who curse me,",
    "302": "may my soul be unresponsive;",
    "303": "and let my soul be like dust to all.",
    "304": "Open my heart to Your Torah",
    "305": "and let my soul pursue Your commandments.",
    "306": "And all who plan evil against me,",
    "307": "quickly annul their counsel",
    "308": "and frustrate their intention.",
    "309": "(May it it be Your will",
    "310": "Adonoy, my God and God of my fathers,",
    "311": "that no person be envious of me",
    "312": "and that I not be envious of others,",
    "313": "that I not be brought to anger this day,",
    "314": "and that I not cause Your anger;",
    "315": "and save me from the evil inclination,",
    "316": "and help me be humble and any modest.",
    "317": "Our King and our Father,",
    "318": "unify Your Name in Your world,",
    "319": "rebuild Your city, establish Your house",
    "320": "and perfect your sanctuary.",
    "321": "Gather our exiles,",
    "322": "redeem Your people, rejoice Your congregation).",
    "323": "Act for the sake of Your Name.",
    "324": "Act for the sake of Your right hand.",
    "325": "Act for the sake of Your Torah.",
    "326": "Act for the sake of Your holiness.",
    "327": "In order that Your loved ones be released,",
    "328": "deliver [with] Your right hand and answer me.",
    "330": "May they be acceptable—",
    "331": "the words of my mouth",
    "332": "and the thoughts of my heart—before You",
    "333": "Adonoy, my Rock and my Redeemer.",
    "334": "He Who makes peace",
    "335": "in His high heavens",
    "336": "may He make peace",
    "337": "upon us and upon all Israel",
    "338": "and say Amein.",
    "339": "May it be Your will,",
    "340": "Adonoy, our God, and the God of our Fathers",
    "341": "that the Holy Temple be rebuilt",
    "342": "speedily in our days,",
    "343": "and grant us our share in Your Torah.",
    "344": "And there we will serve You reverently",
    "345": "as in the days of old,",
    "346": "and in earlier years.",
    "347": "And let Adonoy be pleased",
    "348": "with the offerings of Judah and Jerusalem",
    "349": "as in the days of old and in earlier years."
   }
  }
 }
}
