{
 "id": "shabbat/maariv/meein-sheva:sefard",
 "refs": {
  "Shabbat Siddur Sefard Linear, Maariv Service for Shabbos and Yom Tov, Vayechulu": {
   "edition": "metsudah-sefard-shabbat",
   "he": {
    "13": "בָּרוּךְ אַתָּה יְהֹוָה",
    "14": "אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ",
    "15": "אֱלֹהֵי אַבְרָהָם אֱלֹהֵי יִצְחָק",
    "16": "וֵאלֹהֵי יַעֲקֹב",
    "17": "הָאֵל",
    "18": "הַגָּדוֹל הַגִּבּוֹר וְהַנּוֹרָא.",
    "19": "אֵל עֶלְיוֹן",
    "20": "קוֹנֵה שָׁמַֽיִם וָאָֽרֶץ:"
   },
   "en": {
    "13": "Blessed are You, Adonoy,",
    "14": "our God and God of our fathers,",
    "15": "God of Abraham, God of Isaac,",
    "16": "and God of Jacob;",
    "17": "the Almighty,",
    "18": "the Great, the Powerful, the Awesome,",
    "19": "the most high Almighty,",
    "20": "Possessor of heaven and earth.",
    "21": "<small>The congregation may recite the following paragraph, which should then be repeated aloud <i>and </i>in its entirety <i>by the Chazzan.</i></small>"
   }
  },
  "Shabbat Siddur Sefard Linear, Maariv Service for Shabbos and Yom Tov, Magein Avos": {
   "edition": "metsudah-sefard-shabbat",
   "he": {
    "1": "מָגֵן אָבוֹת בִּדְבָרוֹ.",
    "2": "מְחַיֵּה מֵתִים",
    "3": "בְּמַאֲמָרוֹ.",
    "4": "הָאֵל הַקָּדוֹשׁ",
    "6": "<small>(הַמֶּלֶךְ הַקָּדוֹשׁ)</small>",
    "7": "שֶׁאֵין כָּמֽוֹהוּ.",
    "8": "הַמֵּנִֽיחַ לְעַמּוֹ",
    "9": "בְּיוֹם שַׁבַּת קָדְשׁוֹ.",
    "10": "כִּי בָם רָצָה",
    "11": "לְהָנִֽיחַ לָהֶם.",
    "12": "לְפָנָיו נַעֲבוֹד",
    "13": "בְּיִרְאָה וָפַֽחַד.",
    "14": "וְנוֹדֶה לִשְׁמוֹ",
    "15": "בְּכָל יוֹם תָּמִיד",
    "16": "מֵעֵין הַבְּ֒רָכוֹת:",
    "17": "אֵל הַהוֹדָאוֹת.",
    "18": "אֲדוֹן הַשָּׁלוֹם.",
    "19": "מְקַדֵּשׁ הַשַּׁבָּת",
    "20": "וּמְבָרֵךְ שְׁבִיעִי.",
    "21": "וּמֵנִֽיחַ בִּקְדֻשָּׁה",
    "22": "לְעַם מְדֻשְּׁ֒נֵי עֹֽנֶג",
    "23": "זֵֽכֶר לְמַעֲשֵׂה בְרֵאשִׁית:",
    "24": "אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ",
    "25": "רְצֵה נָא בִמְנוּחָתֵֽנוּ.",
    "26": "קַדְּ֒שֵֽׁנוּ בְּמִצְוֹתֶֽיךָ",
    "27": "וְתֵן חֶלְקֵֽנוּ בְּתוֹרָתֶֽךָ",
    "28": "שַׂבְּ֒עֵֽנוּ מִטּוּבֶֽךָ.",
    "29": "וְשַׂמַּח נַפְשֵֽׁנוּ בִּישׁוּעָתֶֽךָ.",
    "30": "וְטַהֵר לִבֵּֽנוּ לְעָבְדְּ֒ךָ בֶּאֱמֶת.",
    "31": "וְהַנְחִילֵֽנוּ",
    "32": "יְהֹוָה אֱלֹהֵֽינוּ",
    "33": "בְּאַהֲבָה וּבְרָצוֹן",
    "34": "שַׁבַּת קָדְשֶֽׁךָ.",
    "35": "וְיָנֽוּחוּ בָהּ כָּל יִשְׂרָאֵל",
    "36": "מְקַדְּ֒שֵׁי שְׁמֶֽךָ.",
    "37": "בָּרוּךְ אַתָּה יְהֹוָה",
    "38": "מְקַדֵּשׁ הַשַּׁבָּת:"
   },
   "en": {
    "1": "Shield of [our] fathers with His word,",
    "2": "Resurrector of the dead",
    "3": "with His utterance;",
    "4": "*the Almighty, the Holy One",
    "5": "<small>(*Between Rosh Hashanah and Yom Kippur, substitute:)</small>",
    "6": "the King, the Holy One)",
    "7": "Who has no peer.",
    "8": "He gives rest to His people",
    "9": "on the day of His holy Shabbos",
    "10": "for with them He was pleased",
    "11": "to grant them rest.",
    "12": "Before Him we will serve",
    "13": "with fear and trepidation,",
    "14": "and give thanks to His Name",
    "15": "every day continuously,",
    "16": "from the essence of the blessings.",
    "17": "Almighty of thanksgiving,",
    "18": "Master of peace,",
    "19": "Sanctifier of the Shabbos,",
    "20": "Who blesses the seventh day",
    "21": "and grants rest in sanctity",
    "22": "to a people sated with delight—",
    "23": "in commemoration of the work of creation.",
    "24": "Our God, and God of our fathers,",
    "25": "be pleased with our rest,",
    "26": "sanctify us with Your commandments",
    "27": "and give us our share in Your Torah;",
    "28": "satisfy us from Your goodness",
    "29": "and gladden us with Your deliverance,",
    "30": "and purify our hearts to serve You in truth.",
    "31": "And give us as our inheritance,",
    "32": "Adonoy our God,",
    "33": "in love and in pleasure",
    "34": "Your holy Shabbos;",
    "35": "and may Israel rest thereon—",
    "36": "the sanctifiers of Your Name.",
    "37": "Blessed are You Adonoy,",
    "38": "Sanctifier of Shabbos."
   }
  }
 }
}
