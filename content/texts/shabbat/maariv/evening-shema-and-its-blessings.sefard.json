 "refs": {
  "Shabbat Siddur Sefard Linear, Maariv Service for Shabbos and Yom Tov, Borechu": {
   "edition": "metsudah-sefard-shabbat",
   "he": {
    "10": "בָּרוּךְ אַתָּה יְהֹוָה",
    "11": "אֱלֹהֵֽינוּ מֶֽלֶךְ הָעוֹלָם",
    "12": "אֲשֶׁר בִּדְבָרוֹ מַעֲרִיב עֲרָבִים",
    "13": "בְּחָכְמָה פּוֹתֵֽחַ שְׁעָרִים",
    "14": "וּבִתְבוּנָה מְשַׁנֶּה עִתִּים",
    "15": "וּמַחֲלִיף אֶת הַזְּ֒מַנִּים",
    "16": "וּמְסַדֵּר אֶת הַכּוֹכָבִים",
    "17": "בְּמִשְׁמְ֒רוֹתֵיהֶם בָּרָקִֽיעַ",
    "18": "כִּרְצוֹנוֹ.",
    "19": "בּוֹרֵא יוֹם וָלָֽיְלָה",
    "20": "גּוֹלֵל אוֹר מִפְּ֒נֵי חֽשֶׁךְ",
    "21": "וְחֽשֶׁךְ מִפְּ֒נֵי אוֹר",
    "22": "וּמַעֲבִיר יוֹם",
    "23": "וּמֵבִיא לָֽיְלָה",
    "24": "וּמַבְדִּיל בֵּין יוֹם וּבֵין לָֽיְלָה",
    "25": "יְהֹוָה צְבָאוֹת שְׁמוֹ:",
    "26": "❖אֵל",
    "27": "חַי וְקַיָּם",
    "28": "תָּמִיד יִמְלֹךְ עָלֵֽינוּ",
    "29": "לְעוֹלָם וָעֶד.",
    "30": "בָּרוּךְ אַתָּה יְהֹוָה",
    "31": "הַמַּעֲרִיב עֲרָבִים:",
    "32": "אַהֲבַת עוֹלָם",
    "33": "בֵּית יִשְׂרָאֵל עַמְּ֒ךָ אָהָֽבְתָּ",
    "34": "תּוֹרָה וּמִצְוֹת",
    "35": "חֻקִּים וּמִשְׁפָּטִים",
    "36": "אוֹתָֽנוּ לִמַּֽדְתָּ.",
    "37": "עַל כֵּן יְהֹוָה אֱלֹהֵֽינוּ",
    "38": "בְּשָׁכְבֵֽנוּ וּבְקוּמֵֽנוּ",
    "39": "נָשִֽׂיחַ בְּחֻקֶּֽיךָ",
    "40": "וְנִשְׂמַח",
    "41": "בְּדִבְרֵי תַלמוּד תּוֹרָתֶֽךָ",
    "42": "וּבְמִצְוֹתֶֽיךָ לְעוֹלָם וָעֶד.",
    "43": "כִּי הֵם חַיֵּֽינוּ",
    "44": "וְאֹֽרֶךְ יָמֵֽינוּ",
    "45": "וּבָהֶם נֶהְגֶּה יוֹמָם וָלָֽיְלָה.",
    "46": "❖וְאַהֲבָתְ֒ךָ",
    "47": "אַל תָּסִיר מִמֶּֽנּוּ לְעוֹלָמִים.",
    "48": "בָּרוּךְ אַתָּה יְהֹוָה",
    "49": "אוֹהֵב עַמּוֹ יִשְׂרָאֵל:",
    "51": "<small>אֵל מֶֽלֶךְ נֶאֱמָן:</small>",
    "52": "<b>שְׁמַע יִשְׂרָאֵל</b>",
    "53": "<b>יְהֹוָה אֱלֹהֵֽינוּ יְהֹוָה אֶחָד :</b>",
    "55": "<small>בָּרוּךְ שֵׁם</small>",
    "56": "<small>כְּבוֹד מַלְ֒כוּתוֹ</small>",
    "57": "<small>לְעוֹלָם וָעֶד:</small>",
    "58": "וְאָהַבְתָּ אֵת יְהֹוָה אֱלֹהֶֽיךָ",
    "59": "בְּכָל֯־לְ֯בָבְ֒ךָ",
    "60": "וּבְ֒כָל־נַפְשְׁךָ",
    "61": "וּבְ֒כָל־מְאֹדֶֽךָ:",
    "62": "וְהָיוּ הַדְּ֒בָרִים הָאֵֽלֶּה",
    "63": "אֲשֶׁר֯ אָ֯נֹכִי מְצַוְּ֒ךָ הַיּוֹם",
    "64": "עַל֯־לְ֯בָבֶֽךָ:",
    "65": "וְשִׁנַּנְתָּם",
    "66": "לְבָנֶֽיךָ",
    "67": "וְדִבַּרְתָּ בָּם",
    "68": "בְּשִׁבְתְּ֒ךָ בְּבֵיתֶֽךָ",
    "69": "וּבְ֒לֶכְתְּךָ בַדֶּֽרֶךְ",
    "70": "וּבְ֒שָׁכְבְּךָ וּבְ֒קוּמֶֽךָ:",
    "71": "וּקְ֒שַׁרְתָּם לְאוֹת",
    "72": "עַל֯־יָ֯דֶֽךָ",
    "73": "וְהָיוּ לְטֹטָפֹת",
    "74": "בֵּין עֵינֶֽיךָ:",
    "75": "וּכְ֒תַבְתָּם",
    "76": "עַל־מְזֻזוֹת בֵּיתֶֽךָ",
    "77": "וּבִשְׁ֒עָרֶֽיךָ:",
    "78": "וְהָיָה",
    "79": "אִם־שָׁמֹֽעַ תִּשְׁמְעוּ אֶל־מִצְוֹתַי",
    "80": "אֲשֶׁר֯ אָ֯נֹכִי מְצַוֶּה אֶתְ֒כֶם הַיּוֹם",
    "81": "לְאַהֲבָה אֶת־יְהֹוָה אֱלֹהֵיכֶם",
    "82": "וּלְ֒עָבְ֒דוֹ",
    "83": "בְּכָלּ־לְּבַבְ֒כֶם",
    "84": "וּבְ֒כָל־נַפְשְׁכֶם:",
    "85": "וְנָתַתִּי מְטַר֯־אַ֯רְצְכֶם",
    "86": "בְּעִתּוֹ",
    "87": "יּוֹרֶה",
    "88": "וּמַלְקוֹשׁ",
    "89": "וְאָסַפְתָּ דְגָנֶֽךָ",
    "90": "וְתִירשְׁךָ וְיִצְהָרֶֽךָ:",
    "91": "וְנָתַתִּי עֵֽשֶׂב֯",
    "92": "בְּ֯שָׂדְ֒ךָ לִבְ֒הֶמְתֶּֽךָ",
    "93": "וְאָכַלְתָּ וְשָׂבָֽעְתָּ:",
    "94": "הִשָּׁמְ֒רוּ לָכֶם פֶּן֯־יִ֯פְתֶּה לְבַבְ֒כֶם",
    "95": "וְסַרְתֶּם",
    "96": "וַעֲבַדְתֶּם אֱלֹהִים֯ אֲ֯חֵרִים",
    "97": "וְהִשְׁתַּחֲוִיתֶם לָהֶם:",
    "98": "וְחָרָה אַף־יְהֹוָה בָּכֶם",
    "99": "וְעָצַר֯ אֶ֯ת־הַשָּׁמַֽיִם",
    "100": "וְלֹּא֯־יִ֯הְיֶה מָטָר",
    "101": "וְהָאֲדָמָה לֹא תִתֵּן אֶת֯־יְ֯בוּלָהּ",
    "102": "וַאֲבַדְתֶּם֯ מְ֯הֵרָה",
    "103": "מֵעַל הָאָֽרֶץ הַטֹּבָה",
    "104": "אֲשֶׁר֯ יְ֯הֹוָה נֹתֵן לָכֶם:",
    "105": "וְשַׂמְתֶּם֯ אֶ֯ת־דְּבָרַי֯ אֵֽ֯לֶּה",
    "106": "עַל֯־לְ֯בַבְ֒כֶם וְעַל־נַפְשְׁ֒כֶם",
    "107": "וּקְ֒שַׁרְתֶּם֯ אֹ֯תָם לְאוֹת",
    "108": "עַלּ־יֶּדְ֒כֶם",
    "109": "וְהָיוּ לְטוֹטָפֹת",
    "110": "בֵּין עֵינֵיכֶם:",
    "111": "וְלִמַּדְתֶּם֯ אֹ֯תָם אֶת־בְּנֵיכֶם",
    "112": "לְדַבֵּר בָּם",
    "113": "בְּשִׁבְתְּךָ בְּבֵיתֶֽךָ",
    "114": "וּבְ֒לֶכְתְּ֒ךָ בַדֶּֽרֶךְ",
    "115": "וּבְ֒שָׁכְבְּ֒ךָ וּבְ֒קוּמֶֽךָ:",
    "116": "וּכְ֒תַבְתָּם",
    "117": "עַל־מְזוּזוֹת בֵּיתֶֽךָ",
    "118": "וּבִשְׁ֒עָרֶֽיךָ:",
    "119": "לְמַֽעַן֯ יִ֯רְבּוּ יְמֵיכֶם",
    "120": "וִימֵי בְנֵיכֶם",
    "121": "עַל הָאֲדָמָה",
    "122": "אֲשֶׁר נִשְׁבַּע יְהֹוָה לַאֲבֹתֵיכֶם",
    "123": "לָתֵת לָהֶם",
    "124": "כִּימֵי הַשָּׁמַֽיִם עַל־הָאָֽרֶץ:",
    "125": "וַֽיֹּאמֶר֯ יְהֹוָה אֶ֯ל־משֶׁה לֵּאמֹר:",
    "126": "דַּבֵּר֯ אֶ֯ל־בְּנֵי יִשְׂרָאֵל",
    "127": "וְאָמַרְתָּ אֲלֵהֶם",
    "128": "וְעָשׂוּ לָהֶם צִיצִת",
    "129": "עַל־כַּנְ֒פֵי בִגְ֒דֵיהֶם",
    "130": "לְדֹרֹתָם",
    "131": "וְנָתְ֒נוּ עַל־צִיצִת",
    "132": "הַכָּנָף֯",
    "133": "פְּ֯תִיל תְּכֵֽלֶת:",
    "134": "וְהָיָה לָכֶם לְצִיצִת",
    "135": "וּרְ֒אִיתֶם֯ אֹ֯תוֹ",
    "136": "וּזְ֒כַרְתֶּם֯",
    "137": "אֶ֯ת־כָּל־מִצְוֹת֯ יְ֯הֹוָה",
    "138": "וַעֲשִׂיתֶם֯ אֹ֯תָם",
    "139": "וְלֹא תָתֽוּרוּ אַחֲרֵי לְבַבְ֒כֶם",
    "140": "וְאַחֲרֵי עֵינֵיכֶם",
    "141": "אֲשֶׁר֯־אַ֯תֶּם זֹנִים֯ אַ֯חֲרֵיהֶם:",
    "142": "לְמַֽעַן תִּזְכְּרוּ",
    "143": "וַעֲשִׂיתֶם֯ אֶ֯ת־כָּל־מִצְוֹתָי",
    "144": "וִהְיִיתֶם קְדשִׁים לֵאלֹהֵיכֶם:",
    "145": "אֲנִי יְהֹוָה אֱלֹהֵיכֶם֯",
    "146": "אֲ֯שֶׁר הוֹצֵֽאתִי אֶתְ֒כֶם֯",
    "147": "מֵּאֶֽרֶץ מִצְרַֽיִם",
    "148": "לִהְיוֹת לָכֶם לֵאלֹהִים֯",
    "149": "אֲ֯נִי יְהֹוָה אֱלֹהֵיכֶם֯:",
    "151": "אֱ֯מֶת",
    "153": "יְהֹוָה אֱלֹהֵיכֶם֯ אֱ֯מֶת:",
    "154": "וֶאֱמוּנָה כָּל זֹאת",
    "155": "וְקַיָּם עָלֵֽינוּ",
    "156": "כִּי הוּא יְהֹוָה אֱלֹהֵֽינוּ",
    "157": "וְאֵין זוּלָתוֹ",
    "158": "וַאֲנַֽחְנוּ יִשְׂרָאֵל עַמּוֹ:",
    "159": "הַפּוֹדֵֽנוּ",
    "160": "מִיַּד מְלָכִים",
    "161": "מַלְכֵּֽנוּ הַגּוֹאֲלֵֽנוּ",
    "162": "מִכַּף כָּל הֶעָרִיצִים:",
    "163": "הָאֵל",
    "164": "הַנִּפְרָע לָֽנוּ",
    "165": "מִצָּרֵֽינוּ",
    "166": "וְהַמְ֒שַׁלֵּם גְּמוּל",
    "167": "לְכָל אֹיְ֒בֵי נַפְשֵֽׁנוּ:",
    "168": "הָעֹשֶׂה גְדוֹלוֹת",
    "169": "עַד אֵין חֵֽקֶר",
    "170": "נִסִּים וְנִפְלָאוֹת עַד אֵין מִסְפָּר:",
    "171": "הַשָּׂם נַפְשֵֽׁנוּ בַּחַיִּים",
    "172": "וְלֹא נָתַן לַמּוֹט רַגְלֵֽנוּ",
    "173": "הַמַּדְרִיכֵֽנוּ",
    "174": "עַל בָּמוֹת אֹיְ֒בֵֽינוּ",
    "175": "וַיָּֽרֶם קַרְנֵֽנוּ",
    "176": "עַל כָּל שׂוֹנְ֒אֵֽינוּ:",
    "177": "הָעֹֽשֶׂה לָּֽנוּ נִסִּים",
    "178": "וּנְקָמָה בְּפַרְעֹה",
    "179": "אוֹתוֹת וּמוֹפְ֒תִים",
    "180": "בְּאַדְמַת בְּנֵי חָם:",
    "181": "הַמַּכֶּה בְעֶבְרָתוֹ",
    "182": "כָּל בְּכוֹרֵי מִצְרָֽיִם",
    "183": "וַיּוֹצֵא אֶת עַמּוֹ יִשְׂרָאֵל",
    "184": "מִתּוֹכָם",
    "185": "לְחֵרוּת עוֹלָם:",
    "186": "הַמַּעֲבִיר בָּנָיו",
    "187": "בֵּין גִּזְרֵי",
    "188": "יַם סוּף",
    "189": "אֶת רוֹדְ֒פֵיהֶם וְאֶת שׂוֹנְ֒אֵיהֶם",
    "190": "בִּתְהוֹמוֹת טִבַּע:",
    "191": "וְרָאוּ בָנָיו גְּבוּרָתוֹ",
    "192": "שִׁבְּ֒חוּ וְהוֹדוּ לִשְׁמוֹ.",
    "193": "❖וּמַלְכוּתוֹ",
    "194": "בְרָצוֹן קִבְּ֒לוּ עֲלֵיהֶם",
    "195": "משֶׁה וּבְנֵי יִשְׂרָאֵל",
    "196": "לְךָ עָנוּ שִׁירָה בְּשִׂמְחָה רַבָּה",
    "197": "וְאָמְ֒רוּ כֻלָּם:",
    "198": "מִי כָמֹֽכָה בָּאֵלִם יְהֹוָה",
    "199": "מִי כָּמֹֽכָה",
    "200": "נֶאְדָּר בַּקֹּֽדֶשׁ",
    "201": "נוֹרָא תְהִלֹּת עֹֽשֵׂה פֶלֶא:",
    "202": "❖מַלְכוּתְךָ רָאוּ בָנֶֽיךָ",
    "203": "בּוֹקֵֽעַ יָם לִפְנֵי משֶׁה",
    "204": "זֶה אֵלִי עָנוּ",
    "205": "וְאָמְ֒רוּ:",
    "206": "יְהֹוָה יִמְלֹךְ לְעֹלָם וָעֶד:",
    "207": "❖וְנֶאֱמַר",
    "208": "כִּי פָדָה יְהֹוָה אֶת יַעֲקֹב",
    "209": "וּגְאָלוֹ",
    "210": "מִיַּד חָזָק מִמֶּֽנּוּ.",
    "211": "בָּרוּךְ אַתָּה יְהֹוָה",
    "212": "גָּאַל יִשְׂרָאֵל:",
    "214": "הַשְׁכִּיבֵֽנוּ יְהֹוָה אֱלֹהֵֽינוּ לְשָׁלוֹם",
    "215": "וְהַעֲמִידֵֽנוּ מַלְכֵּֽנוּ לְחַיִּים",
    "216": "טוֹבִים וּלְשָׁלוֹם",
    "217": "וּפְרוֹשׂ עָלֵֽינוּ סֻכַּת שְׁלוֹמֶֽךָ",
    "218": "וְתַקְּ֒נֵֽנוּ",
    "219": "בְּעֵצָה טוֹבָה מִלְּ֒פָנֶֽיךָ",
    "220": "וְהוֹשִׁיעֵֽנוּ מְהֵרָה לְמַֽעַן שְׁמֶֽךָ.",
    "221": "וְהָגֵן בַּעֲדֵֽנוּ וְהָסֵר מֵעָלֵֽינוּ",
    "222": "אוֹיֵב דֶּֽבֶר וְחֶֽרֶב",
    "223": "וְרָעָב וְיָגוֹן",
    "224": "וְהָסֵר שָׂטָן מִלְּ֒פָנֵֽינוּ",
    "225": "וּמֵאַחֲרֵֽינוּ",
    "226": "וּבְצֵל כְּנָפֶֽיךָ תַּסְתִּירֵֽנוּ.",
    "227": "כִּי אֵל",
    "228": "שׁוֹמְ֒רֵֽנוּ וּמַצִּילֵֽנוּ אָֽתָּה",
    "229": "כִּי אֵל",
    "230": "מֶֽלֶךְ חַנּוּן וְרַחוּם אָֽתָּה.",
    "231": "וּשְׁמוֹר צֵאתֵֽנוּ וּבוֹאֵֽנוּ",
    "232": "לְחַיִּים וּלְשָׁלוֹם",
    "233": "מֵעַתָּה וְעַד עוֹלָם.",
    "234": "❖וּפְרוֹשׂ עָלֵֽינוּ",
    "235": "סֻכַּת רַחֲמִים וְחַיִּים וְשָׁלוֹם:",
    "236": "בָּרוּךְ אַתָּה יְהֹוָה",
    "237": "הַפּוֹרֵשׂ סֻכַּת שָׁלוֹם עָלֵֽינוּ",
    "238": "וְעַל כָּל עַמּוֹ יִשְׂרָאֵל",
    "239": "וְעַל יְרוּשָׁלָֽיִם:",
    "241": "וְשָׁמְ֒רוּ בְנֵי־יִשְׂרָאֵל",
    "242": "אֶת־הַשַּׁבָּת.",
    "243": "לַעֲשׂוֹת אֶת־הַשַּׁבָּת",
    "244": "לְדֹרֹתָם",
    "245": "בְּרִית עוֹלָם:",
    "246": "בֵּינִי",
    "247": "וּבֵין בְּנֵי יִשְׂרָאֵל",
    "248": "אוֹת הִיא לְעֹלָם.",
    "249": "כִּי־שֵֽׁשֶׁת יָמִים עָשָׂה יְהֹוָה",
    "250": "אֶת־הַשָּׁמַֽיִם וְאֶת־הָאָֽרֶץ",
    "251": "וּבַיּוֹם הַשְּׁ֒בִיעִי",
    "252": "שָׁבַת",
    "253": "וַיִּנָּפַשׁ:"
   },
   "en": {
    "10": "Blessed are You, Adonoy,",
    "11": "our God, King of the Universe,",
    "12": "With His word He brings on evenings,",
    "13": "with wisdom He opens the gates (of heaven);",
    "14": "and with understanding changes the times",
    "15": "and alternates the seasons,",
    "16": "and arranges the stars",
    "17": "in their watches, in the sky,",
    "18": "according to His will.",
    "19": "He creates day and night,",
    "20": "He rolls the light away from before darkness,",
    "21": "and darkness from before light;",
    "22": "He causes day to pass",
    "23": "and brings night,",
    "24": "and separates between day and night;",
    "25": "Adonoy of Hosts is His Name.",
    "26": "The Almighty,",
    "27": "[Who is] living and enduring",
    "28": "will always reign over us",
    "29": "forever and ever.",
    "30": "Blessed are You, Adonoy,",
    "31": "Who brings on evening.",
    "32": "[With] An everlasting love",
    "33": "You loved the House of Israel, Your people.",
    "34": "Torah and commandments,",
    "35": "statutes and laws,",
    "36": "You taught us.",
    "37": "Therefore, Adonoy, our God,",
    "38": "when we lie down and when we rise,",
    "39": "we will discuss Your statutes,",
    "40": "and rejoice",
    "41": "in the words of the teachings of Your Torah",
    "42": "and in Your commandments forever.",
    "43": "For they are our life",
    "44": "and they lengthen our days,",
    "45": "and on them we will meditate day and night.",
    "46": "[May] Your love",
    "47": "never be removed from us",
    "48": "Blessed are You, Adonoy,",
    "49": "Who loves His people Israel.",
    "50": "<small>The following three words should be said when praying without a minyan:</small>",
    "51": "(Almighty, faithful King)",
    "52": "Hear, Israel:",
    "53": "Adonoy is our God, Adonoy is One.",
    "54": "<small>The following three lines are to be said silently:</small>",
    "55": "Blessed [is His] Name,",
    "56": "Whose glorious kingdom",
    "57": "is forever and ever.",
    "58": "And you shall love Adonoy your God",
    "59": "with all your heart",
    "60": "and with all your soul",
    "61": "and with all your possessions.",
    "62": "And these words",
    "63": "which I command you today,",
    "64": "shall be upon your heart.",
    "65": "And you shall teach them sharply",
    "66": "to your children.",
    "67": "And you shall discuss them",
    "68": "when you sit in your house,",
    "69": "and when you travel on the road,",
    "70": "and when you lie down and when you rise.",
    "71": "And you shall bind them for a sign",
    "72": "upon your hand,",
    "73": "and they shall be for <i>totafos</i>",
    "74": "between your eyes.",
    "75": "And you shall write them",
    "76": "upon the doorposts of your house",
    "77": "and upon your gateways.",
    "78": "And it will be—",
    "79": "if you vigilantly obey My commandments",
    "80": "which I command you this day,",
    "81": "to love Adonoy your God,",
    "82": "and serve Him",
    "83": "with your entire hearts",
    "84": "and with your entire souls—",
    "85": "that I will give rain for your land",
    "86": "in its proper time,",
    "87": "the early (autumn) rain",
    "88": "and the late (spring) rain;",
    "89": "and you will harvest your grain",
    "90": "and your wine and your oil.",
    "91": "And I will put grass",
    "92": "in your fields for your cattle,",
    "93": "and you will eat and be satisfied.",
    "94": "Beware lest your hearts be swayed",
    "95": "and you turn astray,",
    "96": "and you worship alien gods",
    "97": "and bow to them.",
    "98": "And Adonoy's fury will blaze among you,",
    "99": "and He will close off the heavens",
    "100": "and there will be no rain",
    "101": "and the earth will not yield its produce;",
    "102": "and you will perish swiftly",
    "103": "from the good land",
    "104": "which Adonoy gives you.",
    "105": "Place these words of Mine",
    "106": "upon your hearts and upon your souls,—",
    "107": "and bind them for a sign",
    "108": "upon your hands,",
    "109": "and they shall be for <i>totafos</i>",
    "110": "between your eyes.",
    "111": "And you shall teach them to your sons,",
    "112": "to speak them",
    "113": "when you sit in your house,",
    "114": "and when you travel on the road,",
    "115": "and when you lie down and when you rise.",
    "116": "And you shall write them",
    "117": "upon the doorposts of your house",
    "118": "and upon your gateways.",
    "119": "In order that your days be prolonged,",
    "120": "and the days of your children,",
    "121": "upon the land",
    "122": "which Adonoy swore to your fathers",
    "123": "to give them [for as long]",
    "124": "as the heavens are above the earth.",
    "125": "And Adonoy spoke to Moses saying:",
    "126": "Speak to the children of Israel,",
    "127": "and tell them",
    "128": "to make for themselves fringes",
    "129": "on the corners of their garments",
    "130": "throughout their generations;",
    "131": "and they will place with the fringes",
    "132": "of each corner",
    "133": "a thread of blue.",
    "134": "And it will be to you for fringes,",
    "135": "and you will look upon it",
    "136": "and you will remember",
    "137": "all the commandments of Adonoy,",
    "138": "and you will perform them;",
    "139": "and you will not turn aside after your hearts",
    "140": "and after your eyes",
    "141": "which cause you to go astray.",
    "142": "In order that you will remember",
    "143": "and perform all My commandments;",
    "144": "and you will be holy unto your God.",
    "145": "I am Adonoy, your God,",
    "146": "Who brought you out",
    "147": "of the land of Egypt",
    "148": "to be your God:",
    "149": "I am Adonoy, your God—",
    "151": "—is true—",
    "153": "Adonoy, your God, is true.",
    "154": "—and faithful is all this,",
    "155": "and it is permanently established with us",
    "156": "that he is Adonoy, our God,",
    "157": "and there is nothing besides Him,",
    "158": "and that we, Israel, are His people.",
    "159": "[He] Who liberated us",
    "160": "from the hand of kings,",
    "161": "[is] our King, Who redeemed us",
    "162": "from the grasp of all the tyrants.",
    "163": "[He is] the Almighty",
    "164": "Who exacts payment [punishment]",
    "165": "from our oppressors,",
    "166": "and brings retribution",
    "167": "on all those who are enemies of our soul.",
    "168": "He does great things",
    "169": "beyond comprehension,",
    "170": "miracles and wonders without number.",
    "171": "He sustains our soul in life",
    "172": "and does not allow our feet to slip.",
    "173": "He makes us tread",
    "174": "upon the high places of our enemies,",
    "175": "and exalts our strength",
    "176": "over all who hate us.",
    "177": "He performed miracles for us",
    "178": "and vengeance upon Pharaoh,",
    "179": "signs and wonders",
    "180": "in the land of the Hamites.",
    "181": "He slew in His wrath,",
    "182": "all the firstborn of Egypt,",
    "183": "and brought out His people, Israel,",
    "184": "from their midst",
    "185": "to everlasting freedom.",
    "186": "He led His children",
    "187": "through the divided parts of",
    "188": "the Sea of Reeds,",
    "189": "their pursuers and their enemies",
    "190": "He drowned in its depths.",
    "191": "And His children saw His mighty power—",
    "192": "they praised and gave thanks to His Name,",
    "193": "His sovereignty",
    "194": "they willingly accepted;",
    "195": "Moses and the children of Israel",
    "196": "sang unto You with great joy,",
    "197": "and they all said:",
    "198": "“Who is like You among the mighty, Adonoy!",
    "199": "Who is like You?",
    "200": "[You are] adorned in holiness,",
    "201": "awesome in praise, performing wonders”",
    "202": "Your children beheld Your sovereignty",
    "203": "when You divided the sea before Moses.",
    "204": "“This is my God,” they exclaimed,",
    "205": "and declared,",
    "206": "“Adonoy will reign forever and ever.”",
    "207": "And it is said,",
    "208": "“For Adonoy has liberated Jacob",
    "209": "and redeemed him",
    "210": "from a hand, mightier than his.”",
    "211": "Blessed are You, Adonoy",
    "212": "Who has redeemed Israel.",
    "214": "Adonoy our God; make us lie down in peace,",
    "215": "our King, raise us again",
    "216": "to good life, and peace",
    "217": "Spread over us the shelter of Your peace,",
    "218": "and direct us to better ourselves",
    "219": "through Your good counsel;",
    "220": "and deliver us speedily for Your Name's sake.",
    "221": "Shield us, and remove from us",
    "222": "enemies, pestilence, sword,",
    "223": "famine and sorrow.",
    "224": "Remove the adversary from before us",
    "225": "and from behind us,",
    "226": "and shelter us in the shadow of Your wings.",
    "227": "For, Almighty,",
    "228": "You are our Protector and Rescuer,",
    "229": "For, Almighty",
    "230": "You are a gracious and merciful King.",
    "231": "Guard our going out and our coming in",
    "232": "for life and peace",
    "233": "for now forever.",
    "234": "And spread over us",
    "235": "the shelter of mercy, life and peace.",
    "236": "Blessed are You, Adonoy,",
    "237": "Who spreads the shelter of peace over us",
    "238": "and over all His people, Israel",
    "239": "and over Jerusalem.",
    "240": "<small>On Shabbos say:</small>",
    "241": "And the Children of Israel shall preserve",
    "242": "the Sabbath,",
    "243": "to maintain the Sabbath",
    "244": "for their generations",
    "245": "as an everlasting covenant.",
    "246": "Between Me",
    "247": "and between the Children of Israel",
    "248": "it is a sign for eternity,",
    "249": "that [in] six days, Adonoy made",
    "250": "the heavens and the earth,",
    "251": "and on the seventh [day]",
    "252": "He abstained from work",
    "253": "and rested."
   }
  }
 }
}
