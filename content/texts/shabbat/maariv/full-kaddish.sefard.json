{
 "id": "shabbat/maariv/full-kaddish:sefard",
 "refs": {
  "Shabbat Siddur Sefard Linear, Maariv Service for Shabbos and Yom Tov, Magein Avos": {
   "edition": "metsudah-sefard-shabbat",
   "he": {
    "40": "יִתְגַּדַּל וְיִתְקַדַּשׁ שְׁמֵהּ רַבָּא",
    "41": "בְּעָלְ֒מָא דִּי בְרָא",
    "42": "כִרְ֒עוּתֵהּ",
    "43": "וְיַמְלִיךְ מַלְ֒כוּתֵהּ",
    "44": "וְיַצְמַח פּוּרְ֒קָנֵהּ",
    "45": "וִיקָרֵב (קֵץ) מְשִׁיחֵהּ",
    "46": "בְּחַיֵּיכוֹן וּבְ֒יוֹמֵיכוֹן",
    "47": "וּבְ֒חַיֵּי",
    "48": "דְכָל בֵּית יִשְׂרָאֵל,",
    "49": "בַּעֲגָלָא וּבִזְ֒מַן קָרִיב",
    "50": "וְאִמְ֒רוּ אָמֵן:",
    "51": "יְהֵא שְׁמֵהּ רַבָּא מְבָרַךְ",
    "52": "לְעָלַם וּלְ֒עָלְ֒מֵי עָלְ֒מַיָּא:",
    "53": "יִתְבָּרַךְ וְיִשְׁתַּבַּח",
    "54": "וְיִתְפָּאַר וְיִתְרוֹמַם וְיִתְנַשֵּׂא",
    "55": "וְיִתְהַדָּר וְיִתְעַלֶּה וְיִתְהַלָּל",
    "56": "שְׁמֵהּ דְקוּדְשָׁא, בְּרִיךְ הוּא",
    "57": "לְעֵֽלָּא (<small>בעשי\"ת</small> וּלְ֒עֵֽלָּא מִכָּל)",
    "58": "מִן כָּל בִּרְ֒כָתָא וְשִׁירָתָא,",
    "59": "תֻּשְׁבְּחָתָא וְנֶחֱמָתָא,",
    "60": "דַּאֲמִירָן בְּעָלְ֒מָא, וְאִמְ֒רוּ אָמֵן:",
    "61": "תִּתְקַבֵּל",
    "62": "צְלוֹתְ֒הוֹן וּבָעוּתְ֒הוֹן",
    "63": "דְּכָל בֵּית יִשְׂרָאֵל",
    "64": "קֳדָם אֲבוּהוֹן דִּי בִשְׁ֒מַיָּא",
    "65": "וְאִמְ֒רוּ אָמֵן:",
    "66": "יְהֵא שְׁלָמָא רַבָּא מִן שְׁמַיָּא",
    "67": "וְחַיִּים טוֹבִים",
    "68": "עָלֵֽינוּ וְעַל כָּל יִשְׂרָאֵל",
    "69": "וְאִמְ֒רוּ אָמֵן:",
    "70": "עוֹשֶׂה שָׁלוֹם",
    "71": "(<small>בעשי\"ת</small> הַשָּׁלוֹם)",
    "72": "בִּמְ֒רוֹמָיו",
    "73": "הוּא יַעֲשֶׂה שָׁלוֹם",
    "74": "עָלֵינוּ וְעַל כָּל יִשְׂרָאֵל",
    "75": "וְאִמְ֒רוּ אָמֵן:"
   },
   "en": {
    "39": "<small>The Chazzan recites the following Kaddish:</small>",
    "40": "Exalted and sanctified be His great Name",
    "41": "in the world which He created",
    "42": "according to His will",
    "43": "and may He rule His kingdom",
    "44": "bring forth His redemption",
    "45": "and hasten the coming of His Mashiach",
    "46": "in your lifetime and in your days,",
    "47": "and in the lifetime",
    "48": "of the entire House of Israel,",
    "49": "speedily and in the near future—",
    "50": "and say Amein.",
    "51": "May His great Name be blessed",
    "52": "forever and for all eternity.",
    "53": "Blessed and praised,",
    "54": "glorified, and exalted and uplifted,",
    "55": "honored and elevated and extolled",
    "56": "be the Name of the Holy One, blessed is He;",
    "57": "above (<i>Ten Days of Penitence:</i> far above)",
    "58": "all the blessings and hymns,",
    "59": "praises and consolations",
    "60": "which we utter in the world—and say Amein.",
    "61": "May there be acceptance",
    "62": "of the prayers and supplications",
    "63": "of the entire House of Israel",
    "64": "before their Father in heaven.",
    "65": "And say, Amein.",
    "66": "May there be abundant peace from heaven",
    "67": "and good life",
    "68": "for us and for all Israel,",
    "69": "—and say Amein.",
    "70": "He Who makes peace",
    "71": "(<i>Ten Days of Penitence:</i> the peace)",
    "72": "in His high heavens",
    "73": "may He, make peace",
    "74": "for us and for all Israel,",
    "75": "and say, Amen."
   }
  }
 }
}
