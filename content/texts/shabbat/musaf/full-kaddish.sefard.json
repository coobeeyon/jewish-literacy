{
 "id": "shabbat/musaf/full-kaddish:sefard",
 "refs": {
  "Shabbat Siddur Sefard Linear, Musaf Service, Amidah": {
   "edition": "metsudah-sefard-shabbat",
   "he": {
    "525": "יִתְגַּדַּל וְיִתְקַדַּשׁ שְׁמֵהּ רַבָּא",
    "526": "בְּעָלְמָא דִּי בְרָא",
    "527": "כִרְעוּתֵהּ",
    "528": "וְיַמְלִיךְ מַלְכוּתֵהּ",
    "529": "וְיַצְמַח פּוּרְ֒קָנֵהּ",
    "530": "וִיקָרֵב (קֵץ) מְשִׁיחֵהּ.",
    "531": "בְּחַיֵּיכוֹן וּבְיוֹמֵיכוֹן",
    "532": "וּבְחַיֵּי",
    "533": "דְכָל בֵּית יִשְׂרָאֵל.",
    "534": "בַּעֲגָלָא וּבִזְמַן קָרִיב.",
    "535": "וְאִמְרוּ אָמֵן:",
    "536": "יְהֵא שְׁמֵהּ רַבָּא מְבָרַךְ",
    "537": "לְעָלַם וּלְעָלְמֵי עָלְמַיָּא:",
    "538": "יִתְבָּרַךְ וְיִשְׁתַּבַּח",
    "539": "וְיִתְפָּאַר וְיִתְרוֹמַם וְיִתְנַשֵּׂא",
    "540": "וְיִתְהַדָּר וְיִתְעַלֶּה וְיִתְהַלָּל",
    "541": "שְׁמֵהּ דְקֻדְשָׁא. בְּרִיךְ הוּא",
    "542": "לְעֵֽלָּא (<small>בעשי\"ת</small> וּלְעֵֽלָּא מִכָּל) ",
    "543": "מִן כָּל בִּרְכָתָא וְשִׁירָתָא.",
    "544": "תֻּשְׁבְּ֒חָתָא וְנֶחֱמָתָא.",
    "545": "דַּאֲמִירָן בְּעָלְמָא.",
    "546": "וְאִמְרוּ אָמֵן.",
    "547": "תִּתְקַבֵּל",
    "548": "צְלוֹתְ֒הוֹן וּבָעוּתְ֒הוֹן",
    "549": "דְּכָל בֵּית יִשְׂרָאֵל",
    "550": "קֳדָם אֲבוּהוֹן דִּי בִשְׁמַיָּא.",
    "551": "וְאִמְרוּ אָמֵן:",
    "552": "יְהֵא שְׁלָמָא רַבָּא מִן שְׁמַיָּא",
    "553": "וְחַיִּים טוֹבִים",
    "554": "עָלֵֽינוּ וְעַל כָּל יִשְׂרָאֵל.",
    "555": "וְאִמְרוּ אָמֵן:",
    "556": "עוֹשֶׂה שָׁלוֹם בִּמְרוֹמָיו",
    "557": "הוּא יַעֲשֶׂה שָׁלוֹם",
    "558": "עָלֵֽינוּ וְעַל כָּל יִשְׂרָאֵל.",
    "559": "וְאִמְרוּ אָמֵן:"
   },
   "en": {
    "525": "Exalted and sanctified be His great Name",
    "526": "in the world which He created",
    "527": "according to His will",
    "528": "and may He rule His kingdom",
    "529": "bring forth His redemption",
    "530": "and hasten the coming of His Mashiach",
    "531": "in your lifetime and in your days,",
    "532": "and in the lifetime",
    "533": "of the entire House of Israel,",
    "534": "speedily and in the near future—",
    "535": "and say Amein.",
    "536": "May His great Name be blessed",
    "537": "forever and for all eternity.",
    "538": "Blessed and praised,",
    "539": "glorified, and exalted and uplifted,",
    "540": "honored and elevated and extolled",
    "541": "be the Name of the Holy One, blessed is He;",
    "542": "above (<i>Shabbos Shuva:</i> far above)",
    "543": "all the blessings and hymns,",
    "544": "praises and consolations",
    "545": "which we utter in the world—",
    "546": "and say Amein.",
    "547": "May there be acceptance",
    "548": "of the prayers and supplications",
    "549": "of the entire House of Israel",
    "550": "before their Father in heaven.",
    "551": "And say, Amein.",
    "552": "May there be abundant peace from heaven",
    "553": "and good life",
    "554": "for us and for all Israel,",
    "555": "—and say Amein.",
    "556": "He Who makes peace in His high heavens",
    "557": "may He, make peace",
    "558": "for us and for all Israel,",
    "559": "—and say Amein."
   }
  }
 }
}
