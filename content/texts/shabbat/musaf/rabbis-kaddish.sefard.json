{
 "id": "shabbat/musaf/rabbis-kaddish:sefard",
 "refs": {
  "Shabbat Siddur Sefard Linear, Musaf Service, Kaddish d'Rabanan": {
   "edition": "metsudah-sefard-shabbat",
   "he": {
    "1": "יִתְגַּדַּל וְיִתְקַדַּשׁ שְׁמֵהּ רַבָּא",
    "2": "בְּעָלְמָא דִּי בְרָא",
    "3": "כִרְעוּתֵהּ",
    "4": "וְיַמְלִיךְ מַלְכוּתֵהּ",
    "5": "וְיַצְמַח פּוּרְ֒קָנֵהּ",
    "6": "וִיקָרֵב (קֵץ) מְשִׁיחֵהּ.",
    "7": "בְּחַיֵּיכוֹן וּבְיוֹמֵיכוֹן",
    "8": "וּבְחַיֵּי",
    "9": "דְכָל בֵּית יִשְׂרָאֵל.",
    "10": "בַּעֲגָלָא וּבִזְמַן קָרִיב.",
    "11": "וְאִמְרוּ אָמֵן:",
    "12": "יְהֵא שְׁמֵהּ רַבָּא מְבָרַךְ",
    "13": "לְעָלַם וּלְעָלְמֵי עָלְמַיָּא:",
    "14": "יִתְבָּרַךְ וְיִשְׁתַּבַּח",
    "15": "וְיִתְפָּאַר וְיִתְרוֹמַם וְיִתְנַשֵּׂא",
    "16": "וְיִתְהַדָּר וְיִתְעַלֶּה וְיִתְהַלָּל",
    "17": "שְׁמֵהּ דְקֻדְשָׁא. בְּרִיךְ הוּא",
    "18": "לְעֵֽלָּא (<small>בעשי\"ת</small> וּלְעֵֽלָּא מִכָּל) ",
    "19": "מִן כָּל בִּרְכָתָא וְשִׁירָתָא.",
    "20": "תֻּשְׁבְּחָתָא וְנֶחֱמָתָא.",
    "21": "דַּאֲמִירָן בְּעָלְמָא וְאִמְרוּ אָמֵן:",
    "22": "עַל יִשְׂרָאֵל וְעַל רַבָּנָן",
    "23": "וְעַל תַּלְמִידֵיהוֹן",
    "24": "וְעַל כָּל תַּלְמִידֵי תַלְמִידֵיהוֹן.",
    "25": "וְעַל כָּל מָאן דְּעָסְקִין",
    "26": "בְּאוֹרַיְתָא.",
    "27": "דִּי בְאַתְרָא הָדֵין",
    "28": "וְדִי בְכָל אֲתַר וַאֲתַר.",
    "29": "יְהֵא לְהוֹן וּלְכוֹן",
    "30": "שְׁלָמָא רַבָּא חִנָּא וְחִסְדָּא",
    "31": "וְרַחֲמִין וְחַיִּין אֲרִיכִין",
    "32": "וּמְזוֹנָא רְוִיחֵי וּפוּרְקָנָא",
    "33": "מִן קֳדָם אֲבוּהוֹן",
    "34": "דְבִשְׁמַיָּא וְאַרְעָא",
    "35": "וְאִמְרוּ אָמֵן:",
    "36": "יְהֵא שְׁלָמָא רַבָּא מִן שְׁמַיָּא",
    "37": "וְחַיִּים טוֹבִים",
    "38": "עָלֵֽינוּ וְעַל כָּל יִשְׂרָאֵל.",
    "39": "וְאִמְרוּ אָמֵן:",
    "40": "עוֹשֶׂה שָׁלוֹם בִּמְרוֹמָיו",
    "41": "הוּא יַעֲשֶׂה בְרַחֲמָיו שָׁלוֹם",
    "42": "עָלֵֽינוּ וְעַל כָּל יִשְׂרָאֵל.",
    "43": "וְאִמְרוּ אָמֵן:"
   },
   "en": {
    "1": "Exalted and sanctified be His great Name",
    "2": "in the world which He created",
    "3": "according to His will",
    "4": "and may He rule His kingdom",
    "5": "bring forth His redemption",
    "6": "and hasten the coming of His Mashiach",
    "7": "in your lifetime and in your days,",
    "8": "and in the lifetime",
    "9": "of the entire House of Israel,",
    "10": "speedily and in the near future—",
    "11": "and say Amein.",
    "12": "May His great Name be blessed",
    "13": "forever and for all eternity.",
    "14": "Blessed and praised,",
    "15": "glorified, and exalted and uplifted,",
    "16": "honored and elevated and extolled",
    "17": "be the Name of the Holy One, blessed is He;",
    "18": "above (<i>Shabbos Shuva:</i> far above)",
    "19": "all the blessings and hymns,",
    "20": "praises and consolations",
    "21": "which we utter in the world—and say Amein.",
    "22": "Upon Israel, and upon our Sages,",
    "23": "and upon their disciples,",
    "24": "and upon all the disciples of their disciples,",
    "25": "and upon all those who engage",
    "26": "in Torah study",
    "27": "in this land",
    "28": "and in every land.",
    "29": "May there be unto them and unto you",
    "30": "abundant peace, favor, kindness,",
    "31": "compassion, long life,",
    "32": "ample sustenance and redemption",
    "33": "from their Father",
    "34": "Who is in heaven and on earth",
    "35": "—and say Amein.",
    "36": "May there be abundant peace from heaven",
    "37": "and a good life",
    "38": "for us and for all Israel,",
    "39": "—and say Amein.",
    "40": "He Who makes peace in His high heavens",
    "41": "may He, in His mercy, make peace",
    "42": "for us and for all Israel,",
    "43": "—and say Amein."
   }
  }
 }
}
