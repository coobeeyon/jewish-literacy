{
 "id": "shabbat/musaf/aleinu:sefard",
 "refs": {
  "Shabbat Siddur Sefard Linear, Musaf Service, Aleinu": {
   "edition": "metsudah-sefard-shabbat",
   "he": {
    "1": "עָלֵֽינוּ לְשַׁבֵּֽחַ",
    "2": "לַאֲדוֹן הַכֹּל",
    "3": "לָתֵת גְּדֻלָּה",
    "4": "לְיוֹצֵר בְּרֵאשִׁית",
    "5": "שֶׁלֹּא עָשָֽׂנוּ",
    "6": "כְּגוֹיֵי הָאֲרָצוֹת",
    "7": "וְלֹא שָׂמָֽנוּ",
    "8": "כְּמִשְׁפְּ֒חוֹת הָאֲדָמָה",
    "9": "שֶׁלֹּא שָׂם",
    "10": "חֶלְקֵֽנוּ כָּהֶם",
    "11": "וְגוֹרָלֵֽנוּ כְּכָל הֲמוֹנָם:",
    "12": "שֶׁהֵם מִשְׁתַּחֲוִים",
    "13": "לַהֶֽבֶל וָרִיק",
    "14": "וּמִתְפַּלְּ֒לִים אֶל אֵל לֹא יוֹשִֽׁיעַ.",
    "15": "וַאֲנַֽחְנוּ כּוֹרְ֒עִים וּמִשְׁתַּחֲוִים",
    "16": "וּמוֹדִים",
    "17": "לִפְנֵי מֶֽלֶךְ מַלְכֵי הַמְּ֒לָכִים",
    "18": "הַקָּדוֹשׁ בָּרוּךְ הוּא.",
    "19": "שֶׁהוּא נוֹטֶה שָׁמַֽיִם",
    "20": "וְיוֹסֵד אָֽרֶץ.",
    "21": "וּמוֹשַׁב יְקָרוֹ בַּשָּׁמַֽיִם מִמַּֽעַל.",
    "22": "וּשְׁכִינַת עֻזּוֹ",
    "23": "בְּגָבְהֵי מְרוֹמִים.",
    "24": "הוּא אֱלֹהֵֽינוּ אֵין עוֹד.",
    "25": "אֱמֶת מַלְכֵּֽנוּ",
    "26": "אֶֽפֶס זוּלָתוֹ",
    "27": "כַּכָּתוּב בְּתוֹרָתוֹ",
    "28": "וְיָדַעְתָּ הַיּוֹם",
    "29": "וַהֲשֵׁבֹתָ אֶל לְבָבֶֽךָ",
    "30": "כִּי יְהֹוָה הוּא הָאֱלֹהִים",
    "31": "בַּשָּׁמַֽיִם מִמַּֽעַל",
    "32": "וְעַל הָאָֽרֶץ מִתָּֽחַת",
    "33": "אֵין עוֹד:",
    "34": "עַל כֵּן נְקַוֶּה לְךָ",
    "35": "יְהֹוָה אֱלֹהֵֽינוּ",
    "36": "לִרְאוֹת מְהֵרָה בְּתִפְאֶֽרֶת עֻזֶּֽךָ",
    "37": "לְהַעֲבִיר גִּלּוּלִים מִן הָאָֽרֶץ",
    "38": "וְהָאֱלִילִים",
    "39": "כָּרוֹת יִכָּרֵתוּן",
    "40": "לְתַקֵּן עוֹלָם",
    "41": "בְּמַלְכוּת שַׁדַּי",
    "42": "וְכָל בְּנֵי בָשָׂר יִקְרְ֒אוּ בִשְׁמֶֽךָ.",
    "43": "לְהַפְנוֹת אֵלֶֽיךָ",
    "44": "כָּל רִשְׁעֵי אָֽרֶץ.",
    "45": "יַכִּֽירוּ וְיֵדְ֒עוּ",
    "46": "כָּל יוֹשְׁ֒בֵי תֵבֵל",
    "47": "כִּי לְךָ תִכְרַע כָּל בֶּֽרֶךְ",
    "48": "תִּשָּׁבַע כָּל לָשׁוֹן:",
    "49": "לְפָנֶֽיךָ יְהֹוָה אֱלֹהֵֽינוּ",
    "50": "יִכְרְ֒עוּ וְיִפֹּֽלוּ.",
    "51": "וְלִכְבוֹד שִׁמְךָ יְקָר יִתֵּֽנוּ.",
    "52": "וִיקַבְּ֒לוּ כֻלָּם",
    "53": "אֶת עֹל מַלְכוּתֶֽךָ.",
    "54": "וְתִמְלֹךְ עֲלֵיהֶם מְהֵרָה",
    "55": "לְעוֹלָם וָעֶד.",
    "56": "כִּי הַמַּלְכוּת שֶׁלְּ֒ךָ הִיא",
    "57": "וּלְעֽוֹלְ֒מֵי עַד תִּמְלוֹךְ בְּכָבוֹד.",
    "58": "כַּכָּתוּב בְּתוֹרָתֶֽךָ",
    "59": "יְהֹוָה יִמְלֹךְ לְעֹלָם וָעֶד:",
    "60": "❖וְנֶאֱמַר",
    "61": "וְהָיָה יְהֹוָה לְמֶֽלֶךְ",
    "62": "עַל כָּל הָאָֽרֶץ",
    "63": "בַּיּוֹם הַהוּא יִהְיֶה יְהֹוָה אֶחָד",
    "64": "וּשְׁמוֹ אֶחָד:"
   },
   "en": {
    "1": "It is our obligation to praise",
    "2": "the Master of all,",
    "3": "to ascribe greatness",
    "4": "to the Creator of the [world in the] beginning:",
    "5": "that He has not made us",
    "6": "like the nations of the lands,",
    "7": "and has not positioned us",
    "8": "like the families of the earth;",
    "9": "that He has not assigned",
    "10": "our portion like theirs,",
    "11": "nor our lot like that of all their multitudes.",
    "12": "For they prostrate themselves",
    "13": "to vanity and nothingness,",
    "14": "and pray to a god that cannot deliver.",
    "15": "But we bow, prostrate ourselves,",
    "16": "and offer thanks",
    "17": "before the Supreme King of kings,",
    "18": "the Holy One blessed is He,",
    "19": "Who spreads the heavens,",
    "20": "and establishes the earth,",
    "21": "and the Seat of His glory is in heaven above,",
    "22": "and the abode of His invincible might",
    "23": "is in the loftiest heights.",
    "24": "He is our God, there is nothing else.",
    "25": "Our King is true,",
    "26": "all else is insignificant,",
    "27": "as it is written in His Torah:",
    "28": "“And you shall know this day",
    "29": "and take into your heart",
    "30": "that Adonoy is God",
    "31": "in the heavens above",
    "32": "and upon the earth below;",
    "33": "there is nothing else.”",
    "34": "We therefore put our hope in You,",
    "35": "Adonoy our God,",
    "36": "to soon behold the glory of Your might",
    "37": "in banishing idolatry from the earth",
    "38": "and the false gods",
    "39": "will be utterly exterminated",
    "40": "to perfect the world",
    "41": "as the kingdom of Shadai.",
    "42": "And all mankind will invoke Your Name,",
    "43": "to turn back to You,",
    "44": "all the wicked of the earth.",
    "45": "They will realize and know,",
    "46": "all the inhabitants of the world,",
    "47": "that to You, every knee must bend,",
    "48": "every tongue must swear [allegiance to You].",
    "49": "Before You, Adonoy, our God,",
    "50": "they will bow and prostrate themselves,",
    "51": "and to the glory of Your Name give honor.",
    "52": "And they will all accept [upon themselves]",
    "53": "the yoke of Your kingdom,",
    "54": "and You will reign over them, soon,",
    "55": "forever and ever.",
    "56": "For the kingdom is Yours,",
    "57": "and to all eternity You will reign in glory,",
    "58": "as it is written in Your Torah:",
    "59": "“Adonoy will reign forever and ever.”",
    "60": "And it is said:",
    "61": "“And Adonoy will be King",
    "62": "over the whole earth;",
    "63": "on that day Adonoy will be One",
    "64": "and His Name One.”"
   }
  }
 }
}
