{
 "id": "shabbat/musaf/chazzans-musaf-repetition:sefard",
 "refs": {
  "Shabbat Siddur Sefard Linear, Musaf Service, Amidah": {
   "edition": "metsudah-sefard-shabbat",
   "he": {
    "2": "כִּי שֵׁם יְהֹוָה אֶקְרָא",
    "3": "הָבוּ גֹֽדֶל לֵאלֹהֵֽינוּ:",
    "4": "אֲדֹנָי שְׂפָתַי תִּפְתָּח",
    "5": "וּפִי יַגִּיד תְּהִלָּתֶֽךָ:",
    "7": "בָּרוּךְ אַתָּה יְהֹוָה",
    "8": "אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ",
    "9": "אֱלֹהֵי אַבְרָהָם אֱלֹהֵי יִצְחָק",
    "10": "וֵאלֹהֵי יַעֲקֹב",
    "11": "הָאֵל",
    "12": "הַגָּדוֹל הַגִּבּוֹר וְהַנּוֹרָא",
    "13": "אֵל עֶלְיוֹן",
    "14": "גּוֹמֵל חֲסָדִים טוֹבִים",
    "15": "וְקוֹנֵה הַכֹּל",
    "16": "וְזוֹכֵר חַסְדֵי אָבוֹת",
    "17": "וּמֵבִיא גוֹאֵל",
    "18": "לִבְנֵי בְנֵיהֶם",
    "19": "לְמַֽעַן שְׁמוֹ בְּאַהֲבָה:",
    "21": "<small>זָכְרֵֽנוּ לְחַיִּים</small>",
    "22": "<small>מֶֽלֶךְ חָפֵץ בַּחַיִּים</small>",
    "23": "<small>וְכָתְבֵֽנוּ בְּסֵֽפֶר הַחַיִּים</small>",
    "24": "<small>לְמַעַנְךָ אֱלֹהִים חַיִּים:</small>",
    "26": "מֶֽלֶךְ עוֹזֵר וּמוֹשִֽׁיעַ וּמָגֵן:",
    "27": "בָּרוּךְ אַתָּה יְהֹוָה",
    "28": "מָגֵן אַבְרָהָם:",
    "30": "אַתָּה גִבּוֹר לְעוֹלָם אֲדֹנָי",
    "31": "מְחַיֶּה מֵתִים אַתָּה",
    "32": "רַב לְהוֹשִֽׁיעַ:",
    "34": "<b>מוֹרִיד הַטָּל</b>",
    "36": "<b>מַשִּׁיב הָרֽוּחַ</b>",
    "37": "<b>וּמוֹרִיד הַגֶּֽשֶׁם:</b>",
    "39": "מְכַלְכֵּל חַיִּים בְּחֶֽסֶד",
    "40": "מְחַיֵּה מֵתִים בְּרַחֲמִים רַבִּים",
    "41": "סוֹמֵךְ נוֹפְלִים",
    "42": "וְרוֹפֵא חוֹלִים",
    "43": "וּמַתִּיר אֲסוּרִים",
    "44": "וּמְקַיֵּם אֱמוּנָתוֹ",
    "45": "לִישֵׁנֵי עָפָר.",
    "46": "מִי כָמֽוֹךָ בַּֽעַל גְּבוּרוֹת",
    "47": "וּמִי דּֽוֹמֶה לָּךְ",
    "48": "מֶֽלֶךְ מֵמִית וּמְחַיֶּה",
    "49": "וּמַצְמִֽיחַ יְשׁוּעָה:",
    "51": "<small>מִי כָמֽוֹךָ אַב הָרַחֲמִים</small>",
    "52": "<small>זוֹכֵר יְצוּרָיו לְחַיִּים</small>",
    "53": "<small>בְּרַחֲמִים:</small>",
    "55": "וְנֶאֱמָן אַתָּה",
    "56": "לְהַחֲיוֹת מֵתִים:",
    "57": "בָּרוּךְ אַתָּה יְהֹוָה",
    "58": "מְחַיֵּה הַמֵּתִים:",
    "62": "כֶּֽתֶר יִתְּ֒נוּ לְךָ",
    "63": "יְהֹוָה אֱלֹהֵֽינוּ",
    "64": "מַלְאָכִים הֲמֽוֹנֵי מַֽעְלָה",
    "65": "עִם עַמְּ֒ךָ יִשְׂרָאֵל קְבוּצֵי מַֽטָּה:",
    "66": "יַחַד כֻּלָּם",
    "67": "קְדֻשָּׁה לְךָ יְשַׁלֵּֽשׁוּ",
    "68": "כַּדָּבָר הָאָמוּר עַל יַד נְבִיאֶֽךָ",
    "69": "וְקָרָא זֶה אֶל זֶה וְאָמַר:",
    "71": "<b>קָדוֹשׁ קָדוֹשׁ קָדוֹשׁ</b>",
    "72": "<b>יְהֹוָה צְבָאוֹת</b>",
    "73": "<b>מְלֹא כָל הָאָֽרֶץ כְּבוֹדוֹ:</b>",
    "74": "❖כְּבוֹדוֹ מָלֵא עוֹלָם",
    "75": "מְשָׁרְ֒תָיו שׁוֹאֲלִים זֶה לָזֶה",
    "76": "אַיֵּה מְקוֹם כְּבוֹדוֹ",
    "77": "לְעֻמָּתָם מְשַׁבְּ֒חִים וְאוֹמְ֒רִים:",
    "79": "<b>בָּרוּךְ כְּבוֹד יְהֹוָה</b>",
    "80": "<b>מִמְּ֒קוֹמוֹ:</b>",
    "81": "❖מִמְּ֒קוֹמוֹ הוּא יִֽפֶן בְּרַחֲמִים",
    "82": "וְיָחוֹן עַם",
    "83": "הַמְּ֒יַחֲדִים שְׁמוֹ",
    "84": "עֶֽרֶב וָבֹֽקֶר בְּכָל יוֹם תָּמִיד",
    "85": "פַּעֲמַֽיִם בְּאַהֲבָה שְׁמַע אוֹמְרִים:",
    "87": "<b>שְׁמַע יִשְׂרָאֵל</b>",
    "88": "<b>יְהֹוָה אֱלֹהֵֽינוּ יְהֹוָה אֶחָד:</b>",
    "89": "❖הוּא אֱלֹהֵֽינוּ הוּא אָבִֽינוּ",
    "90": "הוּא מַלְכֵּֽנוּ הוּא מוֹשִׁיעֵֽנוּ",
    "91": "וְהוּא יוֹשִׁיעֵֽנוּ",
    "92": "וְיִּגְאָלֵֽנוּ שֵׁנִית.",
    "93": "וְיַשְׁמִיעֵֽנוּ בְּרַחֲמָיו",
    "94": "שֵׁנִית",
    "95": "לְעֵינֵי כָּל חַי",
    "96": "לֵאמֹר:",
    "97": "הֵן גָּאַֽלְתִּי אֶתְכֶם",
    "98": "אַחֲרִית כְרֵאשִׁית.",
    "99": "לִהְיוֹת לָכֶם לֵאלֹהִים:",
    "100": "אֲנִי יְהֹוָה אֱלֹהֵיכֶם:",
    "101": "וּבְדִבְרֵי קָדְשְׁ֒ךָ כָּתוּב לֵאמֹר:",
    "103": "<b>יִמְלֹךְ יְהֹוָה לְעוֹלָם</b>",
    "104": "<b>אֱלֹהַֽיִךְ צִיּוֹן לְדֹר וָדֹר</b>",
    "105": "<b>הַלְ֒לוּיָהּ:</b>",
    "107": "לְדוֹר וָדוֹר",
    "108": "נַגִּיד גָּדְלָךְ",
    "109": "וּלְנֵֽצַח נְצָחִים",
    "110": "קְדֻשָּׁתְ֒ךָ נַקְדִּישׁ",
    "111": "וְשִׁבְחֲךָ אֱלֹהֵֽינוּ",
    "112": "מִפִּֽינוּ לֹא יָמוּשׁ",
    "113": "לְעוֹלָם וָעֶד",
    "114": "כִּי אֵל",
    "115": "מֶֽלֶךְ גָּדוֹל וְקָדוֹשׁ אָֽתָּה:",
    "117": "בָּרוּךְ אַתָּה יְהֹוָה",
    "118": "הָאֵל הַקָּדוֹשׁ:",
    "119": "<small>בָּרוּךְ אַתָּה יְהֹוָה</small>",
    "120": "<small>הַמֶּֽלֶךְ הַקָּדוֹשׁ:</small>",
    "135": "תִּכַּֽנְתָּ שַׁבָּת",
    "136": "רָצִֽיתָ קָרְבְּ֒נוֹתֶֽיהָ.",
    "137": "צִוִּֽיתָ פֵּרוּשֶֽׁיהָ",
    "138": "עִם סִדּוּרֵי",
    "139": "נְסָכֶֽיהָ.",
    "140": "מְעַנְּ֒גֶֽיהָ",
    "141": "לְעוֹלָם כָּבוֹד יִנְחָֽלוּ.",
    "142": "טוֹעֲמֶֽיהָ",
    "143": "חַיִּים זָכוּ.",
    "144": "וְגַם הָאוֹהֲבִים דְּבָרֶֽיהָ",
    "145": "גְּדֻלָּה בָּחָֽרוּ.",
    "146": "אָז מִסִּינַי",
    "147": "נִצְטַוּוּ",
    "148": "צִוּוּי",
    "149": "פָּעֳלֶֽיהָ כָּרָאוּי.",
    "150": "וַתְּצַוֵּֽנוּ יְהֹוָה אֱלֹהֵֽינוּ",
    "151": "לְהַקְרִיב בָּהּ",
    "152": "קָרְבַּן מוּסַף שַׁבָּת",
    "153": "כָּרָאוּי:",
    "154": "יְהִי רָצוֹן מִלְּ֒פָנֶֽיךָ",
    "155": "יְהֹוָה אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ",
    "156": "שֶׁתַּעֲלֵֽנוּ בְשִׂמְחָה לְאַרְצֵֽנוּ",
    "157": "וְתִטָּעֵֽנוּ בִּגְבוּלֵֽנוּ",
    "158": "וְשָׁם נַעֲשֶׂה לְפָנֶֽיךָ",
    "159": "אֶת קָרְבְּ֒נוֹת חוֹבוֹתֵֽינוּ",
    "160": "תְּמִידִים כְּסִדְרָם",
    "161": "וּמוּסָפִים",
    "162": "כְּהִלְכָתָם.",
    "163": "וְאֶת מוּסַף יוֹם הַשַּׁבָּת הַזֶּה",
    "164": "נַעֲשֶׂה וְנַקְרִיב לְפָנֶֽיךָ",
    "165": "בְּאַהֲבָה",
    "166": "כְּמִצְוַת רְצוֹנֶֽךָ",
    "167": "כְּמוֹ שֶׁכָּתַֽבְתָּ עָלֵֽינוּ בְּתוֹרָתֶֽךָ",
    "168": "עַל יְדֵי משֶׁה עַבְדֶּֽךָ",
    "169": "מִפִּי כְבוֹדֶֽךָ כָּאָמוּר:",
    "170": "וּבְיוֹם הַשַּׁבָּת",
    "171": "שְׁנֵי כְבָשִׂים בְּנֵי שָׁנָה תְּמִימִים",
    "172": "וּשְׁנֵי עֶשְׂרֹנִים סֹֽלֶת",
    "173": "מִנְחָה",
    "174": "בְּלוּלָה בַשֶּֽׁמֶן וְנִסְכּוֹ:",
    "175": "עֹלַת שַׁבַּת בְּשַׁבַּתּוֹ",
    "176": "עַל עֹלַת הַתָּמִיד",
    "177": "וְנִסְכָּהּ:",
    "178": "יִשְׂמְ֒חוּ בְמַלְכוּתְ֒ךָ",
    "179": "שׁוֹמְ֒רֵי שַׁבָּת",
    "180": "וְקֽוֹרְ֒אֵי עֹֽנֶג.",
    "181": "עַם מְקַדְּ֒שֵׁי שְׁבִיעִי.",
    "182": "כֻּלָּם יִשְׂבְּ֒עוּ",
    "183": "וְיִתְעַנְּ֒גוּ מִטּוּבֶֽךָ.",
    "184": "וּבַשְּׁ֒בִיעִי רָצִֽיתָ בּוֹ",
    "185": "וְקִדַּשְׁתּוֹ",
    "186": "חֶמְדַּת יָמִים אוֹתוֹ קָרָֽאתָ.",
    "187": "זֵֽכֶר לְמַעֲשֵׂה בְרֵאשִׁית:",
    "188": "אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ",
    "189": "רְצֵה בִמְנוּחָתֵֽנוּ.",
    "190": "קַדְּ֒שֵֽׁנוּ בְּמִצְוֹתֶֽיךָ",
    "191": "וְתֵן חֶלְקֵֽנוּ בְּתוֹרָתֶֽךָ",
    "192": "שַׂבְּ֒עֵֽנוּ מִטּוּבֶֽךָ.",
    "193": "וְשַׂמַּח נַפְשֵֽׁנוּ בִּישׁוּעָתֶֽךָ.",
    "194": "וְטַהֵר לִבֵּֽנוּ לְעָבְדְּ֒ךָ בֶּאֱמֶת.",
    "195": "וְהַנְחִילֵֽנוּ",
    "196": "יְהֹוָה אֱלֹהֵֽינוּ",
    "197": "בְּאַהֲבָה וּבְרָצוֹן",
    "198": "שַׁבַּת קָדְשֶֽׁךָ.",
    "199": "וְיָנֽוּחוּ בוֹ כָּל יִשְׂרָאֵל",
    "200": "מְקַדְּ֒שֵׁי שְׁמֶֽךָ:",
    "201": "בָּרוּךְ אַתָּה יְהֹוָה",
    "202": "מְקַדֵּשׁ הַשַּׁבָּת:",
    "312": "רְצֵה יְהֹוָה אֱלֹהֵֽינוּ",
    "313": "בְּעַמְּ֒ךָ יִשְׂרָאֵל וּבִתְפִלָּתָם שְׁעֵה.",
    "314": "וְהָשֵׁב אֶת הָעֲבוֹדָה",
    "315": "לִדְבִיר בֵּיתֶֽךָ",
    "316": "וְאִשֵּׁי יִשְׂרָאֵל.",
    "317": "וּתְפִלָּתָם בְּאַהֲבָה תְקַבֵּל בְּרָצוֹן",
    "318": "וּתְהִי לְרָצוֹן תָּמִיד",
    "319": "עֲבוֹדַת יִשְׂרָאֵל עַמֶּֽךָ:",
    "320": "וְתֶחֱזֶֽינָה עֵינֵֽינוּ",
    "321": "בְּשׁוּבְ֒ךָ לְצִיּוֹן בְּרַחֲמִים:",
    "322": "בָּרוּךְ אַתָּה יְהֹוָה",
    "323": "הַמַּחֲזִיר שְׁכִינָתוֹ לְצִיּוֹן:",
    "326": "מוֹדִים אֲנַֽחְנוּ לָךְ",
    "327": "שָׁאַתָּה הוּא יְהֹוָה אֱלֹהֵֽינוּ",
    "328": "וֵאלֹהֵי אֲבוֹתֵֽינוּ לְעוֹלָם וָעֶד",
    "329": "צוּר חַיֵּֽינוּ",
    "330": "מָגֵן יִשְׁעֵֽנוּ",
    "331": "אַתָּה הוּא לְדוֹר וָדוֹר",
    "332": "נוֹדֶה לְּךָ",
    "333": "וּנְסַפֵּר תְּהִלָּתֶֽךָ",
    "334": "עַל חַיֵּֽינוּ",
    "335": "הַמְּ֒סוּרִים בְּיָדֶֽךָ",
    "336": "וְעַל נִשְׁמוֹתֵֽינוּ הַפְּ֒קוּדוֹת לָךְ",
    "337": "וְעַל נִסֶּֽיךָ שֶׁבְּ֒כָל יוֹם עִמָּֽנוּ",
    "338": "וְעַל נִפְלְ֒אוֹתֶֽיךָ וְטוֹבוֹתֶֽיךָ",
    "339": "שֶׁבְּ֒כָל עֵת.",
    "340": "עֶֽרֶב וָבֹֽקֶר וְצָהֳרָֽיִם.",
    "341": "הַטּוֹב",
    "342": "כִּי לֹא כָלוּ רַחֲמֶֽיךָ",
    "343": "וְהַמְ֒רַחֵם",
    "344": "כִּי לֹא תַֽמּוּ חֲסָדֶֽיךָ.",
    "345": "מֵעוֹלָם קִוִּֽינוּ לָךְ:",
    "347": "מוֹדִים אֲנַֽחְנוּ לָךְ",
    "348": "שָׁאַתָּה הוּא יְהֹוָה אֱלֹהֵֽינוּ",
    "349": "וֵאלֹהֵי אֲבוֹתֵֽינוּ",
    "350": "אֱלֹהֵי כָל בָּשָׂר",
    "351": "יוֹצְ֒רֵֽנוּ יוֹצֵר בְּרֵאשִׁית",
    "352": "בְּרָכוֹת וְהוֹדָאוֹת",
    "353": "לְשִׁמְךָ הַגָּדוֹל וְהַקָּדוֹשׁ",
    "354": "עַל שֶׁהֶחֱיִיתָֽנוּ וְקִיַּמְתָּֽנוּ",
    "355": "כֵּן תְּחַיֵּֽינוּ",
    "356": "וּתְקַיְּ֒מֵֽנוּ",
    "357": "וְתֶאֱסוֹף גָּלֻיּוֹתֵֽינוּ",
    "358": "לְחַצְרוֹת קָדְשֶֽׁךָ",
    "359": "לִשְׁמוֹר חֻקֶּֽיךָ",
    "360": "וְלַעֲשׂוֹת רְצוֹנֶֽךָ",
    "361": "וּלְעָבְדְּ֒ךָ בְּלֵבָב שָׁלֵם",
    "362": "עַל שֶׁאָֽנוּ מוֹדִים לָךְ.",
    "363": "בָּרוּךְ אֵל",
    "364": "הַהוֹדָאוֹת:",
    "366": "וְעַל הַנִּסִּים",
    "367": "וְעַל הַפֻּרְקָן וְעַל הַגְּ֒בוּרוֹת",
    "368": "וְעַל הַתְּ֒שׁוּעוֹת וְעַל הַמִּלְחָמוֹת",
    "369": "שֶׁעָשִֽׂיתָ לַאֲבוֹתֵֽינוּ",
    "370": "בַּיָּמִים הָהֵם בַּזְּ֒מַן הַזֶּה:",
    "371": "בִּימֵי מַתִּתְיָֽהוּ",
    "372": "בֶּן יוֹחָנָן כֹּהֵן גָּדוֹל",
    "373": "חַשְׁמוֹנַאי וּבָנָיו",
    "374": "כְּשֶׁעָמְ֒דָה מַלְכוּת יָוָן הָרְ֒שָׁעָה",
    "375": "עַל עַמְּ֒ךָ יִשְׂרָאֵל",
    "376": "לְהַשְׁכִּיחָם תּוֹרָתֶֽךָ",
    "377": "וּלְהַעֲבִירָם",
    "378": "מֵחֻקֵּי רְצוֹנֶֽךָ.",
    "379": "וְאַתָּה בְּרַחֲמֶֽיךָ הָרַבִּים",
    "380": "עָמַֽדְתָּ לָהֶם בְּעֵת צָרָתָם",
    "381": "רַֽבְתָּ אֶת רִיבָם",
    "382": "דַּֽנְתָּ אֶת דִּינָם",
    "383": "נָקַֽמְתָּ אֶת נִקְמָתָם",
    "384": "מָסַֽרְתָּ גִבּוֹרִים",
    "385": "בְּיַד חַלָּשִׁים",
    "386": "וְרַבִּים בְּיַד מְעַטִּים",
    "387": "וּטְמֵאִים בְּיַד טְהוֹרִים",
    "388": "וּרְשָׁעִים בְּיַד צַדִּיקִים",
    "389": "וְזֵדִים בְּיַד",
    "390": "עוֹסְ֒קֵי תוֹרָתֶֽךָ",
    "391": "וּלְךָ עָשִֽׂיתָ",
    "392": "שֵׁם גָּדוֹל וְקָדוֹשׁ בְּעוֹלָמֶֽךָ",
    "393": "וּלְעַמְּ֒ךָ יִשְׂרָאֵל",
    "394": "עָשִֽׂיתָ תְּשׁוּעָה גְדוֹלָה",
    "395": "וּפֻרְקָן כְּהַיּוֹם הַזֶּה",
    "396": "וְאַחַר כַּךְ בָּֽאוּ בָנֶֽיךָ",
    "397": "לִדְבִיר בֵּיתֶֽךָ",
    "398": "וּפִנּוּ אֶת הֵיכָלֶֽךָ",
    "399": "וְטִהֲרוּ אֶת מִקְדָּשֶֽׁךָ",
    "400": "וְהִדְלִֽיקוּ נֵרוֹת",
    "401": "בְּחַצְרוֹת קָדְשֶֽׁךָ",
    "402": "וְקָבְ֒עוּ שְׁמוֹנַת יְמֵי חֲנֻכָּה אֵֽלּוּ",
    "403": "לְהוֹדוֹת וּלְהַלֵּל לְשִׁמְךָ הַגָּדוֹל:",
    "404": "וְעַל כֻּלָּם",
    "405": "יִתְבָּרַךְ וְיִתְרוֹמַם וְיִתְנַשֵׂא",
    "406": "שִׁמְ֒ךָ מַלְכֵּֽנוּ",
    "407": "תָּמִיד לְעוֹלָם וָעֶד:",
    "409": "<small>וּכְתֹב לְחַיִּים טוֹבִים</small>",
    "410": "<small>כָּל בְּנֵי בְרִיתֶֽךָ:</small>",
    "412": "וְכֹל הַחַיִּים יוֹדֽוּךָ סֶּֽלָה",
    "413": "וִיהַלְ֒לוּ וְיבָרְ֒כוּ",
    "414": "אֶת שִׁמְ֒ךָ הַגָּדוֹל בְּאֱמֶת לְעוֹלָם",
    "415": "כִּי טוֹב",
    "416": "הָאֵל יְשׁוּעָתֵֽנוּ",
    "417": "וְעֶזְרָתֵֽנוּ סֶֽלָה",
    "418": "הָאֵל הַטּוֹב:",
    "419": "בָּרוּךְ אַתָּה יְהֹוָה",
    "420": "הַטּוֹב שִׁמְ֒ךָ",
    "421": "וּלְ֒ךָ נָאֶה לְהוֹדוֹת:",
    "424": "אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ בָּרְ֒כֵֽנוּ",
    "425": "בַבְּ֒רָכָה הַמְּ֒שֻׁלֶּֽשֶׁת בַּתּוֹרָה",
    "426": "הַכְּ֒תוּבָה עַל יְדֵי משֶׁה עַבְדֶּֽךָ,",
    "427": "הָאֲמוּרָה מִפִּי אַהֲרֹן",
    "428": "וּבָנָיו כֹּהֲנִים עַם קְדוֹשֶֽׁךָ",
    "429": "כָּאָמוּר:",
    "430": "יְבָרֶכְךָ יְהֹוָה וְיִשְׁמְ֒רֶֽךָ:",
    "431": "יָאֵר יְהֹוָה פָּנָיו אֵלֶֽיךָ",
    "432": "וִיחֻנֶּֽךָ:",
    "433": "יִשָּׂא יְהֹוָה פָּנָיו אֵלֶֽיךָ",
    "434": "וְיָשֵׂם לְךָ שָׁלוֹם:",
    "436": "אַדִּיר בַּמָּרוֹם שׁוֹכֵן בִּגְ֒בוּרָה,",
    "437": "אַתָּה שָׁלוֹם וְשִׁמְ֒ךָ שָׁלוֹם.",
    "438": "יְהִי רָצוֹן שֶׁתָּשִׂים עָלֵֽינוּ",
    "439": "וְעַל כָּל עַמְּ֒ךָ בֵּית יִשְׂרָאֵל",
    "440": "חַיִּים וּבְ֒רָכָה",
    "441": "לְמִשְׁמֶֽרֶת שָׁלוֹם:",
    "443": "שִׂים שָׁלוֹם טוֹבָה וּבְ֒רָכָה",
    "444": "חַיִים חֵן וָחֶֽסֶד וְרַחֲמִים",
    "445": "עָלֵֽינוּ וְעַל כָּל יִשְׂרָאֵל עַמֶּֽךָ,",
    "446": "בָּרְ֒כֵֽנוּ אָבִֽינוּ כֻּלָּֽנוּ כְּאֶחָד",
    "447": "בְּאוֹר פָּנֶֽיךָ",
    "448": "כִּי בְאוֹר פָּנֶֽיךָ",
    "449": "נָתַֽתָּ לָּֽנוּ יְהֹוָה אֱלֹהֵֽינוּ",
    "450": "תּוֹרַת חַיִּים וְאַהֲבַת חֶֽסֶד",
    "451": "וּצְ֒דָקָה וּבְ֒רָכָה וְרַחֲמִים",
    "452": "וְחַיִּים וְשָׁלוֹם,",
    "453": "וְטוֹב יִהְיֶה בְּעֵינֶֽיךָ",
    "454": "לְבָרְ֒כֵֽנוּ",
    "455": "וּלְ֒בָרֵךְ אֶת כָּל עַמְּ֒ךָ יִשְׂרָאֵל",
    "456": "בְּכָל עֵת וּבְכָל שָׁעָה",
    "457": "בִּשְׁ֒לוֹמֶֽךָ",
    "458": "(בְּרוֹב עוֹז וְשָׁלוֹם).",
    "460": "<small>בְּסֵֽפֶר חַיִּים בְּרָכָה וְשָׁלוֹם</small>",
    "461": "<small>וּפַרְנָסָה טוֹבָה</small>",
    "462": "<small> וּגְ֒זֵרוֹת טוֹבוֹת, יְשׁוּעוֹת וְנֶחָמוֹת,</small>",
    "463": "<small>נִזָּכֵר וְנִכָּתֵב</small>",
    "464": "<small>לְפָנֶֽיךָ</small>",
    "465": "<small>אֲנַֽחְנוּ וְכָל עַמְּ֒ךָ בֵּית יִשְׂרָאֵל</small>",
    "466": "<small>לְחַיִּים טוֹבִים וּלְ֒שָׁלוֹם:</small>",
    "468": "בָּרוּךְ אַתָּה יְהֹוָה",
    "469": "הַמְּ֒בָרֵךְ אֶת עַמּוֹ יִשְׂרָאֵל",
    "470": "בַּשָּׁלוֹם:",
    "471": "יִהְיוּ לְרָצוֹן",
    "472": "אִמְ֒רֵי פִי",
    "473": "וְהֶגְיוֹן לִבִּי לְפָנֶֽיךָ",
    "474": "יְהֹוָה צוּרִי וְגוֹאֲלִי:"
   },
   "en": {
    "2": "“When I proclaim Adonoy's Name",
    "3": "attribute greatness to our God.”",
    "4": "My Master open my lips",
    "5": "and my mouth will declare Your praise.",
    "7": "Blessed are You, Adonoy,",
    "8": "our God, and God of our fathers,",
    "9": "God of Abraham, God of Isaac,",
    "10": "and God of Jacob,",
    "11": "the Almighty",
    "12": "the Great, the Powerful, the Awesome,",
    "13": "most high Almighty,",
    "14": "Who bestows beneficent kindness,",
    "15": "Who possesses everything,",
    "16": "Who remembers the piety of the Patriarchs,",
    "17": "and Who brings a redeemer",
    "18": "to their children's children,",
    "19": "for the sake of His Name, with love.",
    "20": "<small>(Between Rosh Hashanah and Yom Kippur, add:</small>",
    "21": "Remember us for life",
    "22": "King, Who desires life;",
    "23": "and inscribe us in the Book of Life,",
    "24": "for Your sake, Living God.)",
    "26": "King, Helper, and Deliverer and Shield.",
    "27": "Blessed are You, Adonoy,",
    "28": "Shield of Abraham.",
    "30": "You are mighty forever, my Master;",
    "31": "You are the Resurrector of the dead",
    "32": "the powerful One to deliver us.",
    "33": "<small>From the Musaf of the first day of Pesach until the Musaf of Shemini Atzeres you should say:</small>",
    "34": "He causes the dew to descend.",
    "35": "<small>(From the Musaf of Shemini Atzeres until the Musaf of the first day of Pesach you should say:</small>",
    "36": "Causer of the wind to blow",
    "37": "and of the rain to fall.)",
    "39": "Sustainer of the living with kindliness,",
    "40": "Resurrector of the dead with great mercy,",
    "41": "Supporter of the fallen,",
    "42": "and Healer of the sick,",
    "43": "and Releaser of the imprisoned,",
    "44": "and Fulfiller of His faithfulness",
    "45": "to those who sleep in the dust.",
    "46": "Who is like You, Master of mighty deeds,",
    "47": "and who can be compared to You?",
    "48": "King Who causes death and restores life,",
    "49": "and causes deliverance to sprout forth.",
    "50": "<small>(Between Rosh Hashanah and Yom Kippur, add:</small>",
    "51": "Who is like You merciful Father,",
    "52": "Who remembers His creatures for life,",
    "53": "in His mercy).",
    "55": "And You are faithful",
    "56": "to restore the dead to life.",
    "57": "Blessed are You, Adonoy,",
    "58": "Resurrector of the dead.",
    "59": "<small>When praying silently, continue “You are holy,” on page 000. (When the Chazzan repeats the Shemoneh Esrei, the Kedushah is said here.)</small>",
    "61": "<small>The Congregation says and the Chazzan repeats:</small>",
    "62": "A crown is given to You",
    "63": "Adonoy, our God",
    "64": "by the angels on high",
    "65": "and by Your people who assemble below:",
    "66": "all of them together",
    "67": "thrice repeat “holy” unto You",
    "68": "as is said by way of Your prophet,",
    "69": "“And they called one to another, and said:",
    "70": "<small>Congregation and Chazzan:</small>",
    "71": "‘Holy, holy, holy,",
    "72": "is Adonoy of hosts,",
    "73": "the fullness of all the earth is His glory.'”",
    "74": "His glory fills the world,",
    "75": "His ministering angels ask one another—",
    "76": "“Where is the place of His glory?”",
    "77": "Facing them, they offer praise and say:",
    "78": "<small>Congregation and Chazzan:</small>",
    "79": "“Blessed is the glory of Adonoy",
    "80": "from His place.”",
    "81": "From His place, He will turn in compassion,",
    "82": "and favor the people",
    "83": "who proclaim the Oneness of His Name;",
    "84": "evening and morning, each day, continually,",
    "85": "twice each day, with love, they recite “Shema.”",
    "86": "<small>Congregation and Chazzan:</small>",
    "87": "“Hear Israel,",
    "88": "Adonoy is our God, Adonoy is One.”",
    "89": "He is our God, He is our Father,",
    "90": "He is our King, He is our Deliverer,",
    "91": "He will deliver us",
    "92": "and redeem us again",
    "93": "and He will let us hear in His mercy",
    "94": "a second time",
    "95": "in the presence of all the living",
    "96": "saying:",
    "97": "Behold, I have redeemed you",
    "98": "from this final [exile] as from the first,",
    "99": "to be your God.",
    "100": "“I am Adonoy, your God.”",
    "101": "And among Your holy words it is written:",
    "102": "<small>Congregation and Chazzan:</small>",
    "103": "“Adonoy will reign forever,",
    "104": "your God, Zion, throughout all generations!",
    "105": "Praise God.”",
    "106": "<small>The Chazzan concludes:</small>",
    "107": "From generation to generation",
    "108": "we will declare Your greatness,",
    "109": "and to all eternity,",
    "110": "we will sanctify Your holiness,",
    "111": "and Your praise, our God,",
    "112": "will not depart from our mouths",
    "113": "forever and ever;",
    "114": "because You are the Almighty",
    "115": "Who is King; Great, and Holy.",
    "116": "<small>Between Rosh Hashanah and Yom Kippur the Chazzan continues at the asterisk (*) below.</small>",
    "117": "Blessed are You, Adonoy,",
    "118": "the Almighty, the Holy One.",
    "119": "*Blessed are You, Adonoy,",
    "120": "the King, the Holy One.",
    "134": "<small>On Shabbos-Rosh Chodesh continue “You formed” on page 000:</small>",
    "135": "You instituted the Sabbath",
    "136": "and took pleasure in its offerings.",
    "137": "You commanded its explanatory laws",
    "138": "together with the sequential order",
    "139": "of its drink-offering.",
    "140": "Those who make it delightful",
    "141": "will forever inherit honor;",
    "142": "those who savor it",
    "143": "merit [eternal] life;",
    "144": "and also those who love its words [teachings]",
    "145": "have chosen greatness.",
    "146": "Then from [before] Sinai",
    "147": "they were commanded",
    "148": "with the precepts",
    "149": "concerning its proper observance",
    "150": "and You commanded us, Adonoy our God [at Sinai]",
    "151": "to offer on it [the Sabbath]",
    "152": "the Musaf sacrifice of the Sabbath,",
    "153": "according to its laws.",
    "154": "May it be Your will",
    "155": "Adonoy, our God and God of our fathers,",
    "156": "to bring us up in joy to our land,",
    "157": "and to plant us within our borders.",
    "158": "There we will offer before You",
    "159": "our mandatory sacrifices—",
    "160": "the daily-offerings in their sequence,",
    "161": "and the Musaf-offerings",
    "162": "according to their laws.",
    "163": "And the Musaf of this Sabbath Day,",
    "164": "we will offer and bring near before You",
    "165": "with love,",
    "166": "according to the command of Your will;",
    "167": "as You wrote for us in Your Torah,",
    "168": "through the hands of Moses, Your servant,",
    "169": "from the mouth of Your glory, as it is said:",
    "170": "On the Sabbath day [the offering is]:",
    "171": "two male yearling lambs without blemish;",
    "172": "two tenths [of an <i>ephah</i>] of fine flour",
    "173": "for a meal-offering",
    "174": "mixed with the [olive] oil, and its libation.",
    "175": "This is the burnt-offering for every Sabbath,",
    "176": "in addition to the daily burnt-offering",
    "177": "and its libation.",
    "178": "They shall rejoice in Your kingship—",
    "179": "those who preserve the Sabbath",
    "180": "and call it a delight.",
    "181": "The people who sanctify the seventh day",
    "182": "will all be satisfied",
    "183": "and delighted from Your goodness.",
    "184": "And in the seventh day—You took pleasure",
    "185": "and You hallowed it.",
    "186": "“Most desirable of days,” You called it—",
    "187": "a commemoration of the work of creation.",
    "188": "Our God, and God of our fathers,",
    "189": "be pleased with our rest,",
    "190": "sanctify us with Your commandments",
    "191": "and give us our share in Your Torah;",
    "192": "satisfy us from Your goodness",
    "193": "and gladden us with Your deliverance,",
    "194": "and purify our hearts to serve You in truth.",
    "195": "And give us as our inheritance,",
    "196": "Adonoy our God,",
    "197": "in love and in pleasure",
    "198": "Your holy Sabbath;",
    "199": "and may all Israel rest thereon—",
    "200": "the sanctifiers of Your Name—",
    "201": "Blessed are You Adonoy,",
    "202": "Sanctifier of the Sabbath.",
    "203": "<small>On a regular Shabbos continue “Be pleased,” on page 000.</small>",
    "312": "Be pleased, Adonoy, our God,",
    "313": "with Your people Israel and their prayer,",
    "314": "and restore the service",
    "315": "to the Holy of Holies in Your abode,",
    "316": "and the fire-offerings of Israel;",
    "317": "and accept their prayer, lovingly and willingly.",
    "318": "And may You always find pleasure",
    "319": "with the service of Your people, Israel.",
    "320": "And may our eyes behold",
    "321": "Your merciful return to Zion.",
    "322": "Blessed are You, Adonoy,",
    "323": "Who returns His Divine Presence to Zion.",
    "324": "<small>At the words, We are thankful, <i>bend forward; at </i>Adonoy <i>return to an upright position.</i></small>",
    "326": "We are thankful to You",
    "327": "that You Adonoy are our God,",
    "328": "and the God of our fathers forever;",
    "329": "Rock of our lives,",
    "330": "the Shield of our deliverance,",
    "331": "You are in every generation.",
    "332": "We will give thanks to You",
    "333": "and recount Your praise,",
    "334": "for our lives",
    "335": "which are committed into Your hand,",
    "336": "and for our souls which are entrusted to You,",
    "337": "and for Your miracles of every day with us",
    "338": "and for Your wonders and benefactions",
    "339": "at all times—",
    "340": "evening, morning and noon.",
    "341": "(You are) The Beneficent One—",
    "342": "for Your compassion is never withheld;",
    "343": "And (You are) the Merciful One—",
    "344": "for Your kindliness never ceases;",
    "345": "we have always placed our hope in You.",
    "347": "We are thankful to You,",
    "348": "that You Adonoy are our God",
    "349": "and God of our fathers,",
    "350": "God of all flesh,",
    "351": "our Creator, Creator of the Beginning.",
    "352": "Blessings and thanksgivings",
    "353": "to Your great and holy Name",
    "354": "for keeping us alive, and sustaining us;",
    "355": "so may You always keep us alive",
    "356": "and sustain us,",
    "357": "and gather our exiles",
    "358": "to the Courtyards of Your Sanctuary",
    "359": "to observe Your statutes",
    "360": "and to do Your will,",
    "361": "and to serve You wholeheartedly",
    "362": "for we are thankful to You.",
    "363": "Blessed is the Almighty",
    "364": "to Whom all thanks are due.",
    "365": "<small>On Chanukah the following prayer is added. If you omitted it, see page 000.</small>",
    "366": "[We thank You] for the miracles",
    "367": "for the redemption, for the mighty deeds,",
    "368": "for the deliverances, and for the wars",
    "369": "that You performed for our fathers",
    "370": "in those days at this season.",
    "371": "In the days of Matisyahu,",
    "372": "son of Yochanan the High Priest,",
    "373": "the Hasmonean and his sons.",
    "374": "When the evil Greek kingdom rose up",
    "375": "against Your people Israel",
    "376": "to make them forget Your Torah",
    "377": "and to turn them away",
    "378": "from the statutes of Your will—",
    "379": "You, in Your abundant mercy",
    "380": "stood by them in their time of distress,",
    "381": "You defended their cause,",
    "382": "You judged their grievances,",
    "383": "You avenged them.",
    "384": "You delivered the mighty",
    "385": "into the hands of the weak,",
    "386": "many into the hands of the few,",
    "387": "defiled people into the hands of the undefiled,",
    "388": "the wicked into the hands of the righteous,",
    "389": "and insolent [sinners] into the hands of",
    "390": "diligent students of Your Torah.",
    "391": "And You made Yourself",
    "392": "a great and sanctified Name in Your world.",
    "393": "And for Your people, Israel,",
    "394": "You performed a great deliverance",
    "395": "and redemption unto this very day.",
    "396": "Afterwards, Your sons entered",
    "397": "the Holy of Holies of Your Abode,",
    "398": "cleaned Your Temple,",
    "399": "purified Your Sanctuary,",
    "400": "and kindled lights",
    "401": "in the Courtyards of Your Sanctuary,",
    "402": "and designated these eight days of Chanukah",
    "403": "to thank and praise Your great Name.",
    "404": "And for all the foregoing",
    "405": "blessed, exalted and extolled",
    "406": "your Name, our King",
    "407": "constantly, forever and ever.",
    "408": "<small>(Between Rosh Hashanah and Yom Kippur, add:</small>",
    "409": "Inscribe for a good life",
    "410": "all the children of Your covenant.)",
    "412": "And all the living shall thank You forever",
    "413": "and praise and bless",
    "414": "Your great Name with sincerity forever;",
    "415": "for You are goodness—",
    "416": "the Almighty, Who is our deliverance",
    "417": "and our help forever—",
    "418": "the benevolent Almighty.",
    "419": "Blessed are You, Adonoy,",
    "420": "“The Beneficent” is Your Name",
    "421": "and You it is fitting to praise.",
    "422": "<small>To be said by the Chazzan</small>",
    "424": "Our God, and God of our fathers, bless us",
    "425": "with the threefold blessing of the Torah,",
    "426": "written by the hand of Moses, Your servant,",
    "427": "pronounced from the mouth of Aaron",
    "428": "and his sons, the <i>kohanim,</i> Your holy people;",
    "429": "as it is said:",
    "430": "Adonoy bless you and guard you.",
    "431": "Adonoy shine His countenance upon you",
    "432": "and be gracious unto you.",
    "433": "Adonoy turn His countenance toward you",
    "434": "and grant you peace.",
    "435": "<small>After Birkas Kohanim the congregation says:</small>",
    "436": "Mighty One on high who dwells in might,",
    "437": "You are peace and Your Name is peace.",
    "438": "May it be Your will that You grant us",
    "439": "and all of Your people, the House of Israel",
    "440": "life and blessing",
    "441": "for a safeguard to peace.",
    "443": "Grant peace, goodness, and blessing,",
    "444": "life favor, kindness and compassion",
    "445": "upon us and upon all Israel, Your people.",
    "446": "Bless us, our Father, all of us as one",
    "447": "with the light of Your countenance.",
    "448": "For by the light of Your countenance",
    "449": "You gave us Adonoy our God,",
    "450": "a Torah of life and the love of kindliness,",
    "451": "righteousness, blessing, compassion,",
    "452": "life, and peace.",
    "453": "And may it be good in Your sight",
    "454": "to bless us",
    "455": "and to bless Your people Israel,",
    "456": "at all times and at every moment",
    "457": "with Your peace",
    "458": "(with much strength and peace).",
    "459": "<small>*(Between Rosh Hashanah and Yom Kippur, continue here:)</small>",
    "460": "In the book of life, blessing, peace",
    "461": "and abundant maintenance,",
    "462": "good decrees, salvations and condolences,",
    "463": "may we be remembered and inscribed",
    "464": "before You;",
    "465": "we and all Your people, the House of Israel",
    "466": "for a good life and peace.",
    "468": "Blessed are You, Adonoy,",
    "469": "Who blesses His people Israel",
    "470": "with peace.",
    "471": "May they be acceptable",
    "472": "the words of my mouth",
    "473": "and the thoughts of my heart, before You",
    "474": "Adonoy, my Rock and my Redeemer."
   }
  }
 }
}
