{
 "id": "shabbat/musaf/ein-keloheinu-and-incense-study:sefard",
 "refs": {
  "Shabbat Siddur Sefard Linear, Musaf Service, Ein Keiloheinu": {
   "edition": "metsudah-sefard-shabbat",
   "he": {
    "1": "קַוֵּה אֶל יְהֹוָה",
    "2": "חֲזַק וְיַאֲמֵץ לִבֶּֽךָ",
    "3": "וְקַוֵּה אֶל יְהֹוָה:",
    "4": "אֵין קָדוֹשׁ כַּיהֹוָה",
    "5": "כִּי אֵין בִּלְתֶּֽךָ",
    "6": "וְאֵין צוּר כֵּאלֹהֵֽינוּ:",
    "7": "כִּי מִי אֱלֽוֹהַּ מִבַּלְעֲדֵי יְהֹוָה",
    "8": "וּמִי צוּר זוּלָתִי אֱלֹהֵֽינוּ:",
    "9": "אֵין כֵּאלֹהֵֽינוּ.",
    "10": "אֵין כַּאדוֹנֵֽנוּ.",
    "11": "אֵין כְּמַלְכֵּֽנוּ.",
    "12": "אֵין כְּמוֹשִׁיעֵֽנוּ:",
    "13": "מִי כֵאלֹהֵֽינוּ.",
    "14": "מִי כַאדוֹנֵֽנוּ.",
    "15": "מִי כְמַלְכֵּֽנוּ.",
    "16": "מִי כְמוֹשִׁיעֵֽנוּ:",
    "17": "נוֹדֶה לֵאלֹהֵֽינוּ.",
    "18": "נוֹדֶה לַאדוֹנֵֽנוּ.",
    "19": "נוֹדֶה לְמַלְכֵּֽנוּ.",
    "20": "נוֹדֶה לְמוֹשִׁיעֵֽנוּ:",
    "21": "בָּרוּךְ אֱלֹהֵֽינוּ.",
    "22": "בָּרוּךְ אֲדוֹנֵֽנוּ.",
    "23": "בָּרוּךְ מַלְכֵּֽנוּ.",
    "24": "בָּרוּךְ מוֹשִׁיעֵֽנוּ:",
    "25": "אַתָּה הוּא אֱלֹהֵֽינוּ.",
    "26": "אַתָּה הוּא אֲדוֹנֵֽנוּ.",
    "27": "אַתָּה הוּא מַלְכֵּֽנוּ.",
    "28": "אַתָּה הוּא מוֹשִׁיעֵֽנוּ.",
    "29": "אַתָּה הוּא",
    "30": "שֶׁהִקְטִֽרוּ אֲבוֹתֵֽינוּ לְפָנֶֽיךָ",
    "31": "אֶת קְטֹֽרֶת הַסַּמִּים",
    "32": "פִּטּוּם הַקְּ֒טֹֽרֶת",
    "33": "הַצֳּרִי וְהַצִּפֹּֽרֶן",
    "34": "הַחֶלְבְּ֒נָה וְהַלְּ֒בוֹנָה",
    "35": "מִשְׁקַל שִׁבְעִים שִׁבְעִים מָנֶה.",
    "36": "מוֹר וּקְצִיעָה",
    "37": "שִׁבֹּֽלֶת נֵרְדְּ וְכַרְכֹּם",
    "38": "מִשְׁקַל",
    "39": "שִׁשָּׁה עָשָׂר שִׁשָּׁה עָשָׂר מָנֶה.",
    "40": "הַקּשְׁטְ שְׁנֵים עָשָׂר",
    "41": "וְקִלּוּפָה שְׁלשָׁה",
    "42": "וְקִנָּמוֹן תִּשְׁעָה.",
    "44": "בֹּרִית כַּרְשִׁינָה תִּשְׁעָה קַבִּין.",
    "45": "יֵין קַפְרִיסִין",
    "46": "סְאִין תְּלָתָא וְקַבִּין תְּלָתָא.",
    "47": "וְאִם אֵין לוֹ יֵין קַפְרִיסִין",
    "48": "מֵבִיא חֲמַר חִוַּרְיָן עַתִּיק.",
    "49": "מֶֽלַח סְדוֹמִית רֹֽבַע הַקָּב.",
    "50": "מַעֲלֶה עָשָׁן כָּל שֶׁהוּא.",
    "51": "רַבִּי נָתָן הַבַּבְלִי אוֹמֵר",
    "52": "אַף כִּפַּת הַיַּרְדֵּן כָּל שֶׁהוּא.",
    "54": "וְאִם נָֽתַן בָּהּ דְּבַשׁ פְּסָלָהּ",
    "55": "וְאִם חִסַּר אַחַת מִכָּל סַמָּנֶֽיהָ",
    "56": "חַיָּב מִיתָה:",
    "57": "רַבָּן שִׁמְעוֹן בֶּן גַּמְלִיאֵל אוֹמֵר",
    "58": "הַצֳּרִי אֵינוֹ אֶלָּא שְׂרָף",
    "59": "הַנּוֹטֵף מֵעֲצֵי הַקְּ֒טָף.",
    "60": "בֹּרִית כַּרְשִׁינָה לָֽמָּה הִיא בָאָה",
    "61": "כְּדֵי לְיַפּוֹת בָּהּ אֶת הַצִּפֹּֽרֶן",
    "62": "כְּדֵי שֶׁתְּ֒הֵא נָאָה.",
    "63": "יֵין קַפְרִיסִין לָֽמָּה הוּא בָא",
    "64": "כְּדֵי לִשְׁרוֹת בּוֹ אֶת הַצִּפֹּֽרֶן",
    "65": "כְּדֵי שֶׁתְּ֒הֵא עַזָּה.",
    "66": "וַהֲלֹא מֵי רַגְלַֽיִם",
    "67": "יָפִין לָהּ",
    "68": "אֶלָּא שֶׁאֵין מַכְנִיסִין",
    "69": "מֵי רַגְלַֽיִם בַּמִּקְדָּשׁ",
    "70": "מִפְּנֵי הַכָּבוֹד:",
    "71": "הַשִּׁיר",
    "72": "שֶׁהַלְ֒וִיִּם הָיוּ אוֹמְ֒רִים",
    "73": "בְּבֵית הַמִּקְדָּשׁ:",
    "74": "בַּיּוֹם הָרִאשׁוֹן הָיוּ אוֹמְ֒רִים.",
    "75": "לַיהֹוָה הָאָֽרֶץ וּמְלֹאָהּ",
    "76": "תֵּבֵל",
    "77": "וְיֽשְׁ֒בֵי בָהּ:",
    "78": "בַּשֵּׁנִי הָיוּ אוֹמְ֒רִים.",
    "79": "גָּדוֹל יְהֹוָה וּמְהֻלָּל מְאֹד",
    "80": "בְּעִיר אֱלֹהֵֽינוּ",
    "81": "הַר קָדְשׁוֹ:",
    "82": "בַּשְּׁ֒לִישִׁי הָיוּ אוֹמְ֒רִים.",
    "83": "אֱלֹהִים נִצָּב",
    "84": "בַּעֲדַת אֵל",
    "85": "בְּקֶֽרֶב אֱלֹהִים יִשְׁפֹּט:",
    "86": "בָּרְ֒בִיעִי הָיוּ אוֹמְ֒רִים.",
    "87": "אֵל נְקָמוֹת יְהֹוָה",
    "88": "אֵל נְקָמוֹת הוֹפִֽיעַ:",
    "89": "בַּחֲמִישִׁי הָיוּ אוֹמְ֒רִים.",
    "90": "הַרְנִֽינוּ לֵאלֹהִים עֻזֵּֽנוּ",
    "91": "הָרִֽיעוּ לֵאלֹהֵי יַעֲקֹב:",
    "92": "בַּשִּׁשִּׁי הָיוּ אוֹמְ֒רִים.",
    "93": "יְהֹוָה מָלָךְ",
    "94": "גֵּאוּת לָבֵשׁ",
    "95": "לָבֵשׁ יְהֹוָה",
    "96": "עֹז הִתְאַזָּר",
    "97": "אַף תִּכּוֹן תֵּבֵל",
    "98": "בַּל תִּמּוֹט:",
    "99": "בַּשַּׁבָּת הָיוּ אוֹמְרִים.",
    "100": "מִזְמוֹר שִׁיר לְיוֹם הַשַּׁבָּת.",
    "101": "מִזְמוֹר שִׁיר לֶעָתִיד לָבֹא.",
    "102": "לְיוֹם שֶׁכֻּלּוֹ שַׁבָּת",
    "103": "וּמְנוּחָה לְחַיֵּי הָעוֹלָמִים:",
    "104": "תָּנָא דְבֵי אֵלִיָּֽהוּ",
    "105": "כָּל הַשּׁוֹנֶה הֲלָכוֹת בְּכָל יוֹם",
    "106": "מֻבְטָח לוֹ",
    "107": "שֶׁהוּא בֶּן עוֹלָם הַבָּא",
    "108": "שֶׁנֶּאֱמַר",
    "109": "הֲלִיכוֹת עוֹלָם לוֹ",
    "110": "אַל תִּקְרֵי הֲלִיכוֹת",
    "111": "אֶלָּא הֲלָכוֹת:",
    "112": "אָמַר רַבִּי אֶלְעָזָר",
    "113": "אָמַר רַבִּי חֲנִינָא.",
    "114": "תַּלְמִידֵי חֲכָמִים",
    "115": "מַרְבִּים שָׁלוֹם בָּעוֹלָם.",
    "116": "שֶׁנֶּאֱמַר",
    "117": "וְכָל בָּנַֽיִךְ",
    "118": "לִמּוּדֵי יְהֹוָה",
    "119": "וְרַב שְׁלוֹם בָּנָֽיִךְ:",
    "120": "אַל תִּקְרֵי בָּנָֽיִךְ",
    "121": "אֶלָּא בּוֹנָֽיִךְ:",
    "122": "שָׁלוֹם רָב",
    "123": "לְאֹהֲבֵי תוֹרָתֶֽךָ",
    "124": "וְאֵין",
    "125": "לָֽמוֹ מִכְשׁוֹל:",
    "126": "יְהִי שָׁלוֹם בְּחֵילֵךְ",
    "127": "שַׁלְוָה בְּאַרְמְנוֹתָֽיִךְ:",
    "128": "לְמַֽעַן אַחַי וְרֵעָי",
    "129": "אֲדַבְּ֒רָה נָא שָׁלוֹם בָּךְ:",
    "130": "לְמַֽעַן",
    "131": "בֵּית יְהֹוָה אֱלֹהֵֽינוּ",
    "132": "אֲבַקְשָׁה טוֹב לָךְ:",
    "133": "יְהֹוָה עֹז לְעַמּוֹ יִתֵּן",
    "134": "יְהֹוָה יְבָרֵךְ אֶת עַמּוֹ בַשָּׁלוֹם:"
   },
   "en": {
    "1": "Hope to Adonoy;",
    "2": "be strong and He will give you courage",
    "3": "and hope to Adonoy.",
    "4": "There is none holy like Adonoy",
    "5": "for there is none beside You",
    "6": "and there is no stronghold like our God.",
    "7": "For who is a god other than Adonoy",
    "8": "and who is a stronghold beside our God.",
    "9": "There is none like our God.",
    "10": "There is none like our Master.",
    "11": "There is none like our King.",
    "12": "There is none like our Deliverer.",
    "13": "Who is like our God?",
    "14": "Who is like our Master?",
    "15": "Who is like our King?",
    "16": "Who is like our Deliverer?",
    "17": "Let us thank our God.",
    "18": "Let us thank our Master.",
    "19": "Let us thank our King.",
    "20": "Let us thank our Deliverer.",
    "21": "Blessed is our God.",
    "22": "Blessed is our Master.",
    "23": "Blessed is our King.",
    "24": "Blessed is our Deliverer.",
    "25": "You are our God.",
    "26": "You are our Master.",
    "27": "You are our King.",
    "28": "You are our Deliverer.",
    "29": "You are He",
    "30": "before whom our fathers burned",
    "31": "the incense-offering.",
    "32": "The composition of the incense consisted of",
    "33": "balm, onycha,",
    "34": "galbanum, and frankincense—",
    "35": "by weight, seventy <i>maneh</i> of each;",
    "36": "myrrh, cassia,",
    "37": "spikenard and saffron",
    "38": "by weight—",
    "39": "sixteen <i>maneh</i> of each;",
    "40": "twelve <i>maneh</i> of costus,",
    "41": "three <i>maneh</i> of aromatic bark,",
    "42": "and nine <i>maneh</i> of cinnamon.",
    "44": "Nine <i>kabin</i> of Carshina lye,",
    "45": "Cyprus wine [measuring]",
    "46": "three <i>s'in</i> and three <i>kabin</i>—",
    "47": "if he had no Cyprus wine,",
    "48": "he could use strong white wine—",
    "49": "a fourth of a <i>kab</i> of Sodom salt,",
    "50": "and a minute quantity of <i>maaleh ashan.</i>",
    "51": "Rabbi Nosson of Babylonia says,",
    "52": "“A minute quantity of Jordan amber",
    "54": "If one added honey, the incense became unfit;",
    "55": "and if one omitted any of its spices",
    "56": "he was liable to the death penalty.”",
    "57": "Rabbi Shimon ben Gamliel says:",
    "58": "“The balm is nothing but sap",
    "59": "which drips from the balsam tree.",
    "60": "Why was Carshina lye used?",
    "61": "To refine the onycha",
    "62": "in order to make it pleasant.",
    "63": "Why was Cyprus wine used?",
    "64": "The onycha was soaked in it",
    "65": "to give it a pungent odor.",
    "66": "Though the water of Raglayim",
    "67": "was well suited for that purpose,",
    "68": "they did not bring",
    "69": "the water of Raglayim into the Temple",
    "70": "because it would be disrespectful.",
    "71": "These are the Psalms",
    "72": "which the Levites recited",
    "73": "in the Holy Temple:",
    "74": "On Sunday, they used to recite,",
    "75": "“The earth is Adonoy's and the fullness thereof,",
    "76": "the inhabited world",
    "77": "and those who dwell in it.”",
    "78": "On Monday, they used to recite,",
    "79": "“Adonoy is great and highly extolled",
    "80": "in the city of our God,",
    "81": "the mountain of His Sanctuary.”",
    "82": "On Tuesday, they used to recite,",
    "83": "“God stands",
    "84": "in the congregation of the Almighty;",
    "85": "in the midst of judges, He gives judgment.”",
    "86": "On Wednesday, they used to recite,",
    "87": "“Almighty of vengeance, Adonoy,",
    "88": "Almighty of vengeance, reveal Yourself.”",
    "89": "On Thursday, they used to recite,",
    "90": "“Sing joyously to God, our strength,",
    "91": "shout for joy to the God of Jacob.”",
    "92": "On Friday, they used to recite,",
    "93": "“Adonoy has begun His reign,",
    "94": "He has clothed Himself with majesty;",
    "95": "Adonoy clothed Himself,",
    "96": "He has girded Himself with strength,",
    "97": "He has firmly established the world",
    "98": "so that it cannot be moved.”",
    "99": "On the Sabbath, they used to recite,",
    "100": "“A psalm, a song for the Sabbath day.”",
    "101": "It is a psalm, a song for the future,",
    "102": "for the day which will be entirely Sabbath",
    "103": "and rest for everlasting life.",
    "104": "It was taught in the school of Elijah;",
    "105": "whoever studies <i>halachos</i> every day,",
    "106": "he is assured",
    "107": "of life in the World-to-Come,",
    "108": "for it is said,",
    "109": "“The ways (halichos) of the world are His.”",
    "110": "Do not read halichos,",
    "111": "but <i>halachos</i>.",
    "112": "Rabbi Eliezer said",
    "113": "on behalf of Rabbi Chanina:",
    "114": "“The disciples of the wise",
    "115": "increase peace in the world,",
    "116": "for it is said:",
    "117": "‘And all your children",
    "118": "will be disciples of Adonoy's [Torah];",
    "119": "and great will be the peace of your children.'",
    "120": "Do not read <i>banayich</i> [your children]",
    "121": "but read <i>bo¯nayich</i> [your builders].”",
    "122": "Great is the peace",
    "123": "of those who love Your Torah,",
    "124": "and they will have no",
    "125": "stumbling block [misfortune].",
    "126": "Let there be peace within your moats,",
    "127": "serenity within your palaces.",
    "128": "For the sake of my brethren and companions,",
    "129": "I will say: “Peace be with you.”",
    "130": "For the sake",
    "131": "of the House of Adonoy, our God,",
    "132": "I will seek [pray for] your good.",
    "133": "Adonoy will give strength to His people,",
    "134": "Adonoy will bless His people with peace."
   }
  }
 }
}
