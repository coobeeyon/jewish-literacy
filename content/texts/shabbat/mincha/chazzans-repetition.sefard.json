{
 "id": "shabbat/mincha/chazzans-repetition:sefard",
 "refs": {
  "Shabbat Siddur Sefard Linear, Mincha Service for Shabbos and Yom Tov, Amidah": {
   "edition": "metsudah-sefard-shabbat",
   "he": {
    "1": "כִּי שֵׁם יְהֹוָה אֶקְרָא",
    "2": "הָבוּ גֹֽדֶל לֵאלֹהֵֽינוּ:",
    "3": "אֲדֹנָי שְׂפָתַי תִּפְתָּח",
    "4": "וּפִי יַגִּיד תְּהִלָּתֶֽךָ:",
    "6": "בָּרוּךְ אַתָּה יְהֹוָה",
    "7": "אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ",
    "8": "אֱלֹהֵי אַבְרָהָם אֱלֹהֵי יִצְחָק",
    "9": "וֵאלֹהֵי יַעֲקֹב",
    "10": "הָאֵל",
    "11": "הַגָּדוֹל הַגִּבּוֹר וְהַנּוֹרָא",
    "12": "אֵל עֶלְיוֹן",
    "13": "גּוֹמֵל חֲסָדִים טוֹבִים",
    "14": "וְקוֹנֵה הַכֹּל",
    "15": "וְזוֹכֵר חַסְ֒דֵי אָבוֹת",
    "16": "וּמֵבִיא גוֹאֵל",
    "17": "לִבְ֒נֵי בְנֵיהֶם",
    "18": "לְמַֽעַן שְׁמוֹ בְּאַהֲבָה:",
    "20": "<small>זָכְ֒רֵֽנוּ לְחַיִּים</small>",
    "21": "<small>מֶֽלֶךְ חָפֵץ בַּחַיִּים</small>",
    "22": "<small>וְכָתְ֒בֵֽנוּ בְּסֵֽפֶר הַחַיִּים</small>",
    "23": "<small>לְמַעַנְ֒ךָ אֱלֹהִים חַיִּים:</small>",
    "25": "מֶֽלֶךְ עוֹזֵר וּמוֹשִֽׁיעַ וּמָגֵן:",
    "26": "בָּרוּךְ אַתָּה יְהֹוָה",
    "27": "מָגֵן אַבְרָהָם:",
    "29": "אַתָּה גִבּוֹר לְעוֹלָם אֲדֹנָי",
    "30": "מְחַיֶּה מֵתִים אַתָּה",
    "31": "רַב לְהוֹשִֽׁיעַ:",
    "33": "<b>מוֹרִיד הַטָּל</b>",
    "35": "<b>מַשִּׁיב הָרֽוּחַ</b>",
    "36": "<b>וּמוֹרִיד הַגֶּֽשֶׁם:</b>",
    "38": "מְכַלְכֵּל חַיִּים בְּחֶֽסֶד",
    "39": "מְחַיֵּה מֵתִים בְּרַחֲמִים רַבִּים",
    "40": "סוֹמֵךְ נוֹפְ֒לִים",
    "41": "וְרוֹפֵא חוֹלִים",
    "42": "וּמַתִּיר אֲסוּרִים",
    "43": "וּמְ֒קַיֵּם אֱמוּנָתוֹ",
    "44": "לִישֵׁנֵי עָפָר,",
    "45": "מִי כָמֽוֹךָ בַּֽעַל גְּבוּרוֹת",
    "46": "וּמִי דּֽוֹמֶה לָּךְ",
    "47": "מֶֽלֶךְ מֵמִית וּמְ֒חַיֶּה",
    "48": "וּמַצְמִֽיחַ יְשׁוּעָה:",
    "50": "<small>מִי כָמֽוֹךָ אָב הָרַחַמָן</small>",
    "51": "<small>זוֹכֵר יְצוּרָיו לְחַיִּים</small>",
    "52": "<small>בְּרַחֲמִים:</small>",
    "54": "וְנֶאֱמָן אַתָּה",
    "55": "לְהַחֲיוֹת מֵתִים:",
    "56": "בָּרוּךְ אַתָּה יְהֹוָה",
    "57": "מְחַיֵּה הַמֵּתִים:",
    "62": "נַקְדִישָׁךְ וְנַעֲרִיצָךְ",
    "63": "כְּנֹֽעַם שִֽׂיחַ",
    "64": "סוֹד שַׂרְ֒פֵי קֽוֹדֶשׁ",
    "65": "הַמְּ֒שַׁלְּ֒שִׁים לְךָ קְדֻשָּׁה",
    "66": "כַּכָּתוּב עַל יַד נְבִיאֶֽךָ",
    "67": "וְקָרָא זֶה אֶל זֶה וְאָמַר:",
    "69": "<b>קָדוֹשׁ קָדוֹשׁ קָדוֹשׁ</b>",
    "70": "<b>יְהֹוָה צְבָאוֹת</b>",
    "71": "<b>מְלֹא כָל הָאָֽרֶץ כְּבוֹדוֹ:</b>",
    "73": "לְעֻמָּתָם מְשַׁבְּ֒חִים וְאוֹמְ֒רִים:",
    "75": "<b>בָּרוּךְ כְּבוֹד יְהֹוָה</b>",
    "76": "<b>מִמְּ֒קוֹמוֹ:</b>",
    "78": "וּבְ֒דִבְ֒רֵי קָדְשְׁ֒ךָ כָּתוּב לֵאמֹר:",
    "80": "<b>יִמְלֹךְ יְהֹוָה לְעוֹלָם</b>",
    "81": "<b>אֱלֹהַֽיִךְ צִיּוֹן לְדֹר וָדֹר:</b>",
    "82": "<b>הַלְ֒לוּיָהּ:</b>",
    "83": "<b>קדושת השם</b>",
    "84": "אַתָּה קָדוֹשׁ וְשִׁמְךָ קָדוֹשׁ",
    "85": "וּקְ֒דוֹשִׁים",
    "86": "בְּכָל יוֹם יְהַלְ֒לֽוּךָ סֶּֽלָה:",
    "87": "כִּי אֵל מֶֽלֶךְ",
    "88": "גָּדוֹל וְקָדוֹשׁ אָֽתָּה:",
    "90": "בָּרוּךְ אַתָּה יְהֹוָה",
    "91": "הָאֵל הַקָּדוֹשׁ:",
    "93": "<small>בָּרוּךְ אַתָּה יְהֹוָה</small>",
    "94": "<small>הַמֶּֽלֶךְ הַקָּדוֹשׁ:</small>",
    "96": "אַתָּה אֶחָד וְשִׁמְךָ אֶחָד.",
    "97": "וּמִי כְּעַמְּ֒ךָ יִשְׂרָאֵל",
    "98": "גּוֹי אֶחָד בָּאָֽרֶץ.",
    "99": "תִּפְאֶֽרֶת גְּדֻלָּה",
    "100": "וַעֲטֶֽרֶת יְשׁוּעָה.",
    "101": "יוֹם מְנוּחָה וּקְדֻשָּׁה",
    "102": "לְעַמְּ֒ךָ נָתָֽתָּ.",
    "103": "אַבְרָהָם יָגֵל. יִצְחָק יְרַנֵּן.",
    "104": "יַעֲקֹב וּבָנָיו יָנֽוּחוּ בוֹ.",
    "105": "מְנוּחַת אַהֲבָה וּנְדָבָה.",
    "106": "מְנוּחַת אֱמֶת וֶאֱמוּנָה.",
    "107": "מְנוּחַת שָׁלוֹם וְשַׁלְוָה",
    "108": "וְהַשְׁקֵט וָבֶֽטַח.",
    "109": "מְנוּחָה שְׁלֵמָה",
    "110": "שֶׁאַתָּה רֽוֹצֶה בָהּ.",
    "111": "יַכִּֽירוּ בָנֶֽיךָ וְיֵדְ֒עוּ",
    "112": "כִּי מֵאִתְּ֒ךָ הִיא מְנוּחָתָם.",
    "113": "וְעַל מְנוּחָתָם",
    "114": "יַקְדִּֽישׁוּ אֶת שְׁמֶֽךָ:",
    "115": "אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ",
    "116": "רְצֵה בִמְנוּחָתֵֽנוּ.",
    "117": "קַדְּ֒שֵֽׁנוּ בְּמִצְוֹתֶֽיךָ",
    "118": "וְתֵן חֶלְקֵֽנוּ בְּתוֹרָתֶֽךָ",
    "119": "שַׂבְּ֒עֵֽנוּ מִטּוּבֶֽךָ.",
    "120": "וְשַׂמַּח נַפְשֵֽׁנוּ בִּישׁוּעָתֶֽךָ.",
    "121": "וְטַהֵר לִבֵּֽנוּ לְעָבְדְּ֒ךָ בֶּאֱמֶת.",
    "122": "וְהַנְחִילֵֽנוּ",
    "123": "יְהֹוָה אֱלֹהֵֽינוּ",
    "124": "בְּאַהֲבָה וּבְרָצוֹן",
    "125": "שַׁבַּת קָדְשֶֽׁךָ.",
    "126": "וְיָנֽוּחוּ בָם יִשְׂרָאֵל",
    "127": "מְקַדְּ֒שֵׁי שְׁמֶֽךָ.",
    "128": "בָּרוּךְ אַתָּה יְהֹוָה",
    "129": "מְקַדֵּשׁ הַשַּׁבָּת:",
    "131": "רְצֵה יְהֹוָה אֱלֹהֵֽינוּ",
    "132": "בְּעַמְּ֒ךָ יִשְׂרָאֵל וּבִתְפִלָּתָם שְׁעֵה.",
    "133": "וְהָשֵׁב אֶת הָעֲבוֹדָה",
    "134": "לִדְבִיר בֵּיתֶֽךָ",
    "135": "וְאִשֵּׁי יִשְׂרָאֵל.",
    "136": "וּתְפִלָּתָם בְּאַהֲבָה תְקַבֵּל בְּרָצוֹן",
    "137": "וּתְהִי לְרָצוֹן תָּמִיד",
    "138": "עֲבוֹדַת יִשְׂרָאֵל עַמֶּֽךָ:",
    "141": "אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ",
    "142": "יַעֲלֶה וְיָבֹא וְיַגִּֽיעַ",
    "143": "וְיֵרָאֶה וְיֵרָצֶה וְיִשָּׁמַע",
    "144": "וְיִפָּקֵד וְיִזָּכֵר",
    "145": "זִכְרוֹנֵֽנוּ וּפִקְדוֹנֵֽנוּ",
    "146": "וְזִכְרוֹן אֲבוֹתֵֽינוּ",
    "147": "וְזִכְרוֹן מָשִֽׁיחַ",
    "148": "בֶּן דָּוִד עַבְדֶּֽךָ",
    "149": "וְזִכְרוֹן יְרוּשָׁלַֽםִ",
    "150": "עִיר קָדְשֶֽׁךָ",
    "151": "וְזִכְרוֹן כָּל עַמְּ֒ךָ",
    "152": "בֵּית יִשְׂרָאֵל לְפָנֶֽיךָ.",
    "153": "לִפְלֵיטָה לְטוֹבָה",
    "154": "לְחֵן וּלְחֶֽסֶד וּלְרַחֲמִים",
    "155": "לְחַיִּים טוֹבִים וּלְשָׁלוֹם",
    "156": "בְּיוֹם",
    "157": "<small>לר\"ח:</small> רֹאשׁ הַחֹֽדֶשׁ הַזֶּה ",
    "158": "<small>לפסח:</small> חַג הַמַּצּוֹת הַזֶּה",
    "159": "<small>לסכות:</small> חַג הַסֻּכּוֹת הַזֶּה",
    "160": "זָכְרֵֽנוּ יְהֹוָה אֱלֹהֵֽינוּ",
    "161": "בּוֹ לְטוֹבָה.",
    "162": "וּפָקְדֵֽנוּ בוֹ לִבְרָכָה.",
    "163": "וְהוֹשִׁיעֵֽנוּ בוֹ לְחַיִּים טוֹבִים.",
    "164": "וּבִדְבַר יְשׁוּעָה",
    "165": "וְרַחֲמִים",
    "166": "חוּס וְחָנֵּֽנוּ.",
    "167": "וְרַחֵם עָלֵֽינוּ וְהוֹשִׁיעֵֽנוּ.",
    "168": "כִּי אֵלֶֽיךָ עֵינֵֽינוּ.",
    "169": "כִּי אֵל",
    "170": "מֶֽלֶךְ חַנּוּן וְרַחוּם אָֽתָּה:",
    "172": "וְתֶחֱזֶֽינָה עֵינֵֽינוּ",
    "173": "בְּשׁוּבְ֒ךָ לְצִיּוֹן בְּרַחֲמִים.",
    "174": "בָּרוּךְ אַתָּה יְהֹוָה",
    "175": "הַמַּחֲזִיר שְׁכִינָתוֹ לְצִיּוֹן:",
    "178": "מוֹדִים אֲנַֽחְנוּ לָךְ",
    "179": "שָׁאַתָּה הוּא יְהֹוָה אֱלֹהֵֽינוּ",
    "180": "וֵאלֹהֵי אֲבוֹתֵֽינוּ לְעוֹלָם וָעֶד",
    "181": "צוּרֵֽנוּ צוּר חַיֵּֽינוּ",
    "182": "מָגֵן יִשְׁעֵֽנוּ",
    "183": "אַתָּה הוּא לְדוֹר וָדוֹר",
    "184": "נוֹדֶה לְּךָ",
    "185": "וּנְסַפֵּר תְּהִלָּתֶֽךָ",
    "186": "עַל חַיֵּֽינוּ",
    "187": "הַמְּ֒סוּרִים בְּיָדֶֽךָ",
    "188": "וְעַל נִשְׁמוֹתֵֽינוּ הַפְּ֒קוּדוֹת לָךְ",
    "189": "וְעַל נִסֶּֽיךָ שֶׁבְּ֒כָל יוֹם עִמָּֽנוּ",
    "190": "וְעַל נִפְלְ֒אוֹתֶֽיךָ וְטוֹבוֹתֶֽיךָ",
    "191": "שֶׁבְּ֒כָל עֵת.",
    "192": "עֶֽרֶב וָבֹֽקֶר וְצָהֳרָֽיִם.",
    "193": "הַטּוֹב",
    "194": "כִּי לֹא כָלוּ רַחֲמֶֽיךָ",
    "195": "וְהַמְ֒רַחֵם",
    "196": "כִּי לֹא תַֽמּוּ חֲסָדֶֽיךָ.",
    "197": "מֵעוֹלָם קִוִּֽינוּ לָךְ:",
    "199": "מוֹדִים אֲנַֽחְנוּ לָךְ",
    "200": "שָׁאַתָּה הוּא יְהֹוָה אֱלֹהֵֽינוּ",
    "201": "וֵאלֹהֵי אֲבוֹתֵֽינוּ",
    "202": "אֱלֹהֵי כָל בָּשָׂר",
    "203": "יוֹצְ֒רֵֽנוּ יוֹצֵר בְּרֵאשִׁית",
    "204": "בְּרָכוֹת וְהוֹדָאוֹת",
    "205": "לְשִׁמְךָ הַגָּדוֹל וְהַקָּדוֹשׁ",
    "206": "עַל שֶׁהֶחֱיִיתָֽנוּ וְקִיַּמְתָּֽנוּ",
    "207": "כֵּן תְּחַיֵּֽינוּ",
    "208": "וּתְקַיְּ֒מֵֽנוּ",
    "209": "וְתֶאֱסוֹף גָּלֻיּוֹתֵֽינוּ",
    "210": "לְחַצְרוֹת קָדְשֶֽׁךָ",
    "211": "לִשְׁמוֹר חֻקֶּֽיךָ",
    "212": "וְלַעֲשׂוֹת רְצוֹנֶֽךָ",
    "213": "וּלְעָבְדְּ֒ךָ בְּלֵבָב שָׁלֵם",
    "214": "עַל שֶׁאָֽנוּ מוֹדִים לָךְ.",
    "215": "בָּרוּךְ אֵל",
    "216": "הַהוֹדָאוֹת:",
    "218": "וְעַל הַנִּסִּים",
    "219": "וְעַל הַפֻּרְקָן וְעַל הַגְּ֒בוּרוֹת",
    "220": "וְעַל הַתְּ֒שׁוּעוֹת וְעַל הַנִּפְלָאוֹת",
    "221": "וְעַל הַנֶּחָמוֹת וְעַל הַמִּלְחָמוֹת",
    "222": "שֶׁעָשִֽׂיתָ לַאֲבוֹתֵֽינוּ",
    "223": "בַּיָּמִים הָהֵם בִּזְּ֒מַן הַזֶּה:",
    "224": "בִּימֵי מַתִּתְיָֽהוּ",
    "225": "בֶּן יוֹחָנָן כֹּהֵן גָּדוֹל",
    "226": "חַשְׁמוֹנָאִי וּבָנָיו",
    "227": "כְּשֶׁעָמְ֒דָה מַלְ֒כוּת יָוָן הָרְ֒שָׁעָה",
    "228": "עַל עַמְּ֒ךָ יִשְׂרָאֵל",
    "229": "לְהַשְׁכִּיחָם תּוֹרָתֶֽךָ",
    "230": "וּלְ֒הַעֲבִירָם",
    "231": "מֵחֻקֵּי רְצוֹנֶֽךָ,",
    "232": "וְאַתָּה בְּרַחֲמֶֽיךָ הָרַבִּים",
    "233": "עָמַֽדְתָּ לָהֶם בְּעֵת צָרָתָם",
    "234": "רַֽבְתָּ אֶת רִיבָם",
    "235": "דַּֽנְתָּ אֶת דִּינָם",
    "236": "נָקַֽמְתָּ אֶת נִקְ֒מָתָם",
    "237": "מָסַֽרְתָּ גִבּוֹרִים",
    "238": "בְּיַד חַלָּשִׁים",
    "239": "וְרַבִּים בְּיַד מְעַטִּים",
    "240": "וּטְ֒מֵאִים בְּיַד טְהוֹרִים",
    "241": "וּרְ֒שָׁעִים בְּיַד צַדִּיקִים",
    "242": "וְזֵדִים בְּיַד",
    "243": "עוֹסְ֒קֵי תוֹרָתֶֽךָ",
    "244": "וּלְ֒ךָ עָשִֽׂיתָ",
    "245": "שֵׁם גָּדוֹל וְקָדוֹשׁ בְּעוֹלָמֶֽךָ",
    "246": "וּלְ֒עַמְּ֒ךָ יִשְׂרָאֵל",
    "247": "עָשִֽׂיתָ תְּשׁוּעָה גְדוֹלָה",
    "248": "וּפֻרְקָן כְּהַיּוֹם הַזֶּה",
    "249": "וְאַחַר כַּךְ בָּֽאוּ בָנֶֽיךָ",
    "250": "לִדְ֒בִיר בֵּיתֶֽךָ",
    "251": "וּפִנּוּ אֶת הֵיכָלֶֽךָ",
    "252": "וְטִהֲרוּ אֶת מִקְדָּשֶֽׁךָ",
    "253": "וְהִדְלִֽיקוּ נֵרוֹת",
    "254": "בְּחַצְ֒רוֹת קָדְשֶֽׁךָ",
    "255": "וְקָבְ֒עוּ שְׁמוֹנַת יְמֵי חֲנֻכָּה אֵֽלּוּ",
    "256": "לְהוֹדוֹת וּלְ֒הַלֵּל לְשִׁמְ֒ךָ הַגָּדוֹל:",
    "257": "וְעַל כֻּלָּם",
    "258": "יִתְבָּרַךְ וְיִתְרוֹמַם וְיִתְנַשֵׂא",
    "259": "שִׁמְ֒ךָ מַלְכֵּֽנוּ",
    "260": "תָּמִיד",
    "261": "לְעוֹלָם וָעֶד:",
    "263": "<small>וּכְתֹב לְחַיִּים טוֹבִים</small>",
    "264": "<small>כָּל בְּנֵי בְרִיתֶֽךָ:</small>",
    "266": "וְכֹל הַחַיִּים יוֹדֽוּךָ סֶּֽלָה",
    "267": "וִיהַלְ֒לוּ וְיבָרְ֒כוּ",
    "268": "אֶת שִׁמְ֒ךָ הַגָּדוֹל בְּאֱמֶת לְעוֹלָם",
    "269": "כִּי טוֹב",
    "270": "הָאֵל יְשׁוּעָתֵֽנוּ",
    "271": "וְעֶזְרָתֵֽנוּ סֶֽלָה",
    "272": "הָאֵל הַטּוֹב:",
    "273": "בָּרוּךְ אַתָּה יְהֹוָה",
    "274": "הַטּוֹב שִׁמְ֒ךָ",
    "275": "וּלְ֒ךָ נָאֶה לְהוֹדוֹת:",
    "277": "שִׂים שָׁלוֹם טוֹבָה וּבְ֒רָכָה",
    "278": "חַיִים חֵן וָחֶֽסֶד וְרַחֲמִים",
    "279": "עָלֵֽינוּ וְעַל כָּל יִשְׂרָאֵל עַמֶּֽךָ,",
    "280": "בָּרְ֒כֵֽנוּ אָבִֽינוּ כֻּלָּֽנוּ כְּאֶחָד",
    "281": "בְּאוֹר פָּנֶֽיךָ",
    "282": "כִּי בְאוֹר פָּנֶֽיךָ",
    "283": "נָתַֽתָּ לָּֽנוּ יְהֹוָה אֱלֹהֵֽינוּ",
    "284": "תּוֹרַת חַיִּים וְאַהֲבַת חֶֽסֶד",
    "285": "וּצְ֒דָקָה וּבְ֒רָכָה וְרַחֲמִים",
    "286": "וְחַיִּים וְשָׁלוֹם,",
    "287": "וְטוֹב יִהְיֶה בְּעֵינֶֽיךָ",
    "288": "לְבָרְ֒כֵֽנוּ",
    "289": "וּלְ֒בָרֵךְ אֶת כָּל עַמְּ֒ךָ יִשְׂרָאֵל",
    "290": "בְּכָל עֵת וּבְכָל שָׁעָה",
    "291": "בִּשְׁ֒לוֹמֶֽךָ",
    "292": "(בְּרוֹב עוֹז וְשָׁלוֹם).",
    "294": "<small>בְּסֵֽפֶר חַיִּים בְּרָכָה וְשָׁלוֹם</small>",
    "295": "<small>וּפַרְנָסָה טוֹבָה</small>",
    "296": "<small> וּגְ֒זֵרוֹת טוֹבוֹת, יְשׁוּעוֹת וְנֶחָמוֹת,</small>",
    "297": "<small>נִזָּכֵר וְנִכָּתֵב</small>",
    "298": "<small>לְפָנֶֽיךָ</small>",
    "299": "<small>אֲנַֽחְנוּ וְכָל עַמְּ֒ךָ בֵּית יִשְׂרָאֵל</small>",
    "300": "<small>לְחַיִּים טוֹבִים וּלְ֒שָׁלוֹם:</small>",
    "302": "בָּרוּךְ אַתָּה יְהֹוָה",
    "303": "הַמְּ֒בָרֵךְ אֶת עַמּוֹ יִשְׂרָאֵל",
    "304": "בַּשָּׁלוֹם:",
    "305": "יִהְיוּ לְרָצוֹן",
    "306": "אִמְ֒רֵי פִי",
    "307": "וְהֶגְיוֹן לִבִּי לְפָנֶֽיךָ",
    "308": "יְהֹוָה צוּרִי וְגוֹאֲלִי:"
   },
   "en": {
    "1": "When I proclaim Adonoy's Name",
    "2": "attribute greatness to our God.",
    "3": "My Master, open my lips,",
    "4": "and my mouth will declare Your praise.",
    "6": "Blessed are You, Adonoy,",
    "7": "our God, and God of our fathers,",
    "8": "God of Abraham, God of Isaac,",
    "9": "and God of Jacob,",
    "10": "the Almighty,",
    "11": "the Great, the Powerful, the Awesome,",
    "12": "most high Almighty,",
    "13": "Who bestows beneficent kindness,",
    "14": "Who possesses everything,",
    "15": "Who remembers the piety of the Patriarchs,",
    "16": "and Who brings a redeemer",
    "17": "to their children's children,",
    "18": "for the sake of His Name, with love.",
    "19": "<small>(During the Ten Days of Penitence add:</small>",
    "20": "Remember us for life",
    "21": "King, Who desires life;",
    "22": "and inscribe us in the Book of Life,",
    "23": "for Your sake, Living God.)",
    "25": "King, Helper, and Deliverer and Shield.",
    "26": "Blessed are You, Adonoy,",
    "27": "Shield of Abraham.",
    "29": "You are mighty forever, my Master;",
    "30": "You are the Resurrector of the dead",
    "31": "the Powerful One to deliver us.",
    "32": "<small>From the Musaf of the first day of Pesach until the Musaf of Shemini Atzeres you should say:</small>",
    "33": "He causes the dew to descend.",
    "34": "<small>From the Musaf of Shemini Atzeres until the Musaf of the first day of Pesach you should say:</small>",
    "35": "Causer of the wind to blow",
    "36": "and of the rain to fall.",
    "38": "Sustainer of the living with kindliness,",
    "39": "Resurrector of the dead with great mercy,",
    "40": "Supporter of the fallen,",
    "41": "and Healer of the sick,",
    "42": "and Releaser of the imprisoned,",
    "43": "and Fulfiller of His faithfulness",
    "44": "to those who sleep in the dust.",
    "45": "Who is like You, Master of mighty deeds,",
    "46": "and who can be compared to You?",
    "47": "King Who causes death and restores life,",
    "48": "and causes deliverance to sprout forth.",
    "49": "<small>(During the Ten Days of Penitence add:</small>",
    "50": "Who is like You merciful Father,",
    "51": "Who remembers His creatures for life,",
    "52": "in His mercy.)",
    "54": "And You are faithful",
    "55": "to restore the dead to life.",
    "56": "Blessed are You, Adonoy,",
    "57": "Resurrector of the dead.",
    "58": "<small>When praying silently, continue “Your are holy,” on page 000.</small>",
    "59": "<small>(When the Chazzan repeats the Shemoneh Esrei, the Kedushah is said here)</small>",
    "61": "<small>The Congregation says and the Chazzan repeats:</small>",
    "62": "We will hallow and revere You",
    "63": "as [with] the sweet words",
    "64": "of the company of the holy Seraphim",
    "65": "who thrice repeat “holy” unto You,",
    "66": "as is written by the hand of Your prophet,",
    "67": "“And they called one to another, and said:",
    "68": "<small>Congregation says and Chazzan repeats:</small>",
    "69": "‘Holy, holy, holy,",
    "70": "is Adonoy of Hosts,",
    "71": "the fullness of all the earth is His glory.'”",
    "72": "<small>The Chazzan says:</small>",
    "73": "Facing them, they offer praise and say:",
    "74": "<small>Congregation says and Chazzan repeats:</small>",
    "75": "“Blessed is the glory of Adonoy",
    "76": "from its place”",
    "77": "<small>The Chazzan says:</small>",
    "78": "And in Your Holy Words it is written:",
    "79": "<small>Congregation says and Chazzan repeats:</small>",
    "80": "“Adonoy will reign forever;",
    "81": "Your God, Zion, throughout all generations!",
    "82": "Praise God.”",
    "83": "<b>DIVINE SANCTIFICATION</b>",
    "84": "You are holy and Your Name is holy",
    "85": "and holy beings",
    "86": "praise You every day, forever.",
    "87": "For a great and Almighty King—",
    "88": "great and holy—are You.",
    "89": "<small>During the Ten Days of Penitence, continue at the asterisk (*) below</small>",
    "90": "Blessed are You, Adonoy,",
    "91": "the Almighty, the Holy One.",
    "92": "<small>*During the Ten Days of Penitence:</small>",
    "93": "Blessed are You, Adonoy,",
    "94": "the King, the Holy One.",
    "96": "You are One and Your Name is One,",
    "97": "and who is like Your people Israel",
    "98": "a unique nation on earth.",
    "99": "The glory of greatness,",
    "100": "and the crown of deliverance—",
    "101": "a day of rest and holiness—",
    "102": "have You given Your people.",
    "103": "Abraham exults, Isaac sings joyously,",
    "104": "Jacob and his sons rest thereon—",
    "105": "a rest of love and free will,",
    "106": "a rest of truth and faith(fulness),",
    "107": "a rest of peace and tranquility,",
    "108": "and of serenity and security,",
    "109": "—a perfect rest",
    "110": "with which you are pleased.",
    "111": "Your children will realize and know",
    "112": "that from You does their rest come,",
    "113": "and through their rest,",
    "114": "they sanctify Your Name.",
    "115": "Our God, and God of our fathers,",
    "116": "be pleased with our rest,",
    "117": "sanctify us with Your commandments",
    "118": "and give us our share in Your Torah;",
    "119": "satisfy us from Your goodness",
    "120": "and gladden our souls with Your deliverance,",
    "121": "and purify our hearts to serve You in truth.",
    "122": "And give us as our inheritance,",
    "123": "Adonoy our God,",
    "124": "in love and in pleasure",
    "125": "Your holy Sabbath;",
    "126": "and may Israel rest thereon—",
    "127": "the sanctifiers of Your Name.",
    "128": "Blessed are You, Adonoy,",
    "129": "Sanctifier of the Sabbath.",
    "131": "Be pleased, Adonoy, our God,",
    "132": "with Your people Israel and their prayer,",
    "133": "and restore the service",
    "134": "to the Holy of Holies in Your abode,",
    "135": "and the fire-offerings of Israel;",
    "136": "and accept their prayer, lovingly and willingly.",
    "137": "And may You always find pleasure",
    "138": "with the service of Your people, Israel.",
    "139": "<small>On a regular Shabbos, continue, “And may our eyes,” on p. 000</small>",
    "140": "<small>(On Rosh Chodesh and on Chol HaMoed, the following prayer is added:</small>",
    "141": "Our God and God of our fathers,",
    "142": "may there ascend, come, and reach,",
    "143": "appear, be desired, and heard,",
    "144": "counted and recalled",
    "145": "our remembrance and reckoning;",
    "146": "the remembrance of our fathers;",
    "147": "the remembrance of the Messiah",
    "148": "the son of David, Your servant;",
    "149": "the remembrance of Jerusalem,",
    "150": "city of Your Sanctuary;",
    "151": "and the remembrance of Your entire people,",
    "152": "the House of Israel, before You,",
    "153": "for survival, for well-being,",
    "154": "for favor, kindliness, compassion,",
    "155": "for good life and peace",
    "156": "on this day of:",
    "157": "<i>Rosh Chodesh</i>",
    "158": "the <i>Festival of Matzos</i>",
    "159": "the <i>Festival of Sukkos</i>",
    "160": "Remember us Adonoy, our God",
    "161": "on this day for well-being;",
    "162": "be mindful of us on this day for blessing,",
    "163": "and deliver us for good life.",
    "164": "In accord with the promise of deliverance",
    "165": "and compassion,",
    "166": "spare us and favor us,",
    "167": "have compassion on us and deliver us;",
    "168": "for to You our eyes are directed",
    "169": "because You are the Almighty",
    "170": "Who is King, Gracious, and Merciful.",
    "172": "And may our eyes behold",
    "173": "Your merciful return to Zion.",
    "174": "Blessed are You, Adonoy,",
    "175": "Who returns His Divine Presence to Zion.",
    "176": "<small><i>At the words, </i>We are thankful, <i>bend forward; at </i>Adonoy <i>return to an upright position.</i></small>",
    "178": "We are thankful to You",
    "179": "that You Adonoy are our God",
    "180": "and the God of our fathers forever;",
    "181": "our Rock, Rock of our lives,",
    "182": "the Shield of our deliverance,",
    "183": "You are in every generation.",
    "184": "We will give thanks to You",
    "185": "and recount Your praise,",
    "186": "for our lives",
    "187": "which are committed into Your hand.",
    "188": "And for our souls which are entrusted to You,",
    "189": "and for Your miracles of every day with us",
    "190": "and for Your wonders and benefactions",
    "191": "at all times—",
    "192": "evening, morning and noon.",
    "193": "(You are) The Beneficent One—",
    "194": "for Your compassion is never withheld;",
    "195": "And (You are) the Merciful One—",
    "196": "for Your kindliness never ceases;",
    "197": "we have always placed our hope in You.",
    "199": "We are thankful to You,",
    "200": "that You Adonoy are our God",
    "201": "and God of our fathers,",
    "202": "God of all flesh,",
    "203": "Our Creator, Creator of the Beginning.",
    "204": "Blessings and thanksgivings",
    "205": "to Your great and holy Name",
    "206": "for keeping us alive, and sustaining us;",
    "207": "so may You always keep us alive",
    "208": "and sustain us,",
    "209": "and gather our exiles",
    "210": "to the Courtyards of Your Sanctuary",
    "211": "to observe Your statutes",
    "212": "and to do Your will,",
    "213": "and to serve You wholeheartedly",
    "214": "for we are thankful to You.",
    "215": "Blessed is the Almighty",
    "216": "to Whom all thanks are due.",
    "217": "<small>On Chanukah the following prayer is added. If you omitted it, see page 000.</small>",
    "218": "[We thank You] for the miracles",
    "219": "for the redemption, for the mighty deeds,",
    "220": "for the deliverances, for the wonders",
    "221": "for the consolations and for the wars",
    "222": "that You performed for our fathers",
    "223": "in those days at this season.",
    "224": "In the days of Matisyahu,",
    "225": "son of Yochanan the High Priest,",
    "226": "the Hasmonean and his sons,",
    "227": "when the evil Greek kingdom rose up",
    "228": "against Your people Israel",
    "229": "to make them forget Your Torah",
    "230": "and to turn them away",
    "231": "from the statutes of Your will—",
    "232": "You, in Your abundant mercy,",
    "233": "stood by them in their time of distress,",
    "234": "You defended their cause,",
    "235": "You judged their grievances,",
    "236": "You avenged them.",
    "237": "You delivered the mighty",
    "238": "into the hands of the weak,",
    "239": "many into the hands of the few,",
    "240": "defiled people into the hands of the undefiled,",
    "241": "the wicked into the hands of the righteous,",
    "242": "and insolent [sinners] into the hands of",
    "243": "diligent students of Your Torah.",
    "244": "And You made Yourself",
    "245": "a great and sanctified name in Your world.",
    "246": "And for Your people, Israel,",
    "247": "You performed a great deliverance",
    "248": "and redemption unto this very day.",
    "249": "Afterwards, Your sons entered",
    "250": "the Holy of Holies of Your Abode,",
    "251": "cleaned Your Temple,",
    "252": "purified Your Sanctuary,",
    "253": "and kindled lights",
    "254": "in the Courtyards of Your Sanctuary,",
    "255": "and designated these eight days of Chanukah",
    "256": "to thank and praise Your great Name.",
    "257": "And for all the foregoing",
    "258": "blessed, exalted and extolled",
    "259": "your Name, our King",
    "260": "constantly,",
    "261": "forever and ever.",
    "262": "<small>(Between Rosh Hashanah and Yom Kippur, add:</small>",
    "263": "Inscribe for a good life",
    "264": "all the children of Your covenant.)",
    "266": "And all the living shall thank You forever",
    "267": "and praise and bless",
    "268": "Your great Name with sincerity forever;",
    "269": "for You are goodness—",
    "270": "the Almighty, Who is our deliverance",
    "271": "and our help forever—",
    "272": "the benevolent Almighty.",
    "273": "Blessed are You, Adonoy,",
    "274": "“The Beneficent” is Your Name",
    "275": "and You it is fitting to praise.",
    "277": "Grant peace, goodness, and blessing,",
    "278": "life favor, kindness and compassion",
    "279": "upon us and upon all Israel, Your people.",
    "280": "Bless us, our Father, all of us as one",
    "281": "with the light of Your countenance.",
    "282": "For by the light of Your countenance",
    "283": "You gave us Adonoy our God,",
    "284": "a Torah of life and the love of kindliness,",
    "285": "righteousness, blessing, compassion,",
    "286": "life, and peace.",
    "287": "And may it be good in Your sight",
    "288": "to bless us",
    "289": "and to bless Your people Israel,",
    "290": "at all times and at every moment",
    "291": "with Your peace",
    "292": "(with much strength and peace).",
    "293": "<small>During the Ten Days of Penitence continue here:</small>",
    "294": "In the book of life, blessing, peace",
    "295": "and abundant maintenance,",
    "296": "good decrees, salvations and condolences,",
    "297": "may we be remembered and inscribed",
    "298": "before You;",
    "299": "we and all Your people, the House of Israel",
    "300": "for a good life and peace.",
    "302": "Blessed are You, Adonoy,",
    "303": "Who blesses His people Israel",
    "304": "with peace.",
    "305": "May they be acceptable",
    "306": "the words of my mouth",
    "307": "and the thoughts of my heart, before You",
    "308": "Adonoy, my Rock and my Redeemer."
   }
  }
 }
}
