{
 "id": "shabbat/mincha/full-kaddish:sefard",
 "refs": {
  "Shabbat Siddur Sefard Linear, Mincha Service for Shabbos and Yom Tov, Amidah": {
   "edition": "metsudah-sefard-shabbat",
   "he": {
    "361": "יִתְגַּדַּל וְיִתְקַדַּשׁ שְׁמֵהּ רַבָּא",
    "362": "בְּעָלְמָא דִּי בְרָא",
    "363": "כִרְעוּתֵהּ",
    "364": "וְיַמְלִיךְ מַלְכוּתֵהּ",
    "365": "וְיַצְמַח פּוּרְקָנֵהּ",
    "366": "וִיקָרֵב (קֵץ) מְשִׁיחֵהּ.",
    "367": "בְּחַיֵּיכוֹן וּבְיוֹמֵיכוֹן",
    "368": "וּבְחַיֵּי",
    "369": "דְכָל בֵּית יִשְׂרָאֵל.",
    "370": "בַּעֲגָלָא וּבִזְמַן קָרִיב",
    "371": "וְאִמְרוּ אָמֵן:",
    "372": "יְהֵא שְׁמֵהּ רַבָּא מְבָרַךְ",
    "373": "לְעָלַם וּלְעָלְמֵי עָלְמַיָּא:",
    "374": "יִתְבָּרַךְ וְיִשְׁתַּבַּח",
    "375": "וְיִתְפָּאַר וְיִתְרוֹמַם וְיִתְנַשֵּׂא",
    "376": "וְיִתְהַדָּר וְיִתְעַלֶּה וְיִתְהַלָּל",
    "377": "שְׁמֵהּ דְקֻדְשָׁא. בְּרִיךְ הוּא",
    "378": "לְעֵֽלָּא (<small>בעשי\"ת</small> וּלְעֵֽלָּא מִכָּל) ",
    "379": "מִן כָּל בִּרְכָתָא וְשִׁירָתָא.",
    "380": "תֻּשְׁבְּ֒חָתָא וְנֶחֱמָתָא.",
    "381": "דַּאֲמִירָן בְּעָלְמָא. וְאִמְרוּ אָמֵן:",
    "382": "תִּתְקַבֵּל",
    "383": "צְלוֹתְ֒הוֹן וּבָעוּתְ֒הוֹן",
    "384": "דְּכָל בֵּית יִשְׂרָאֵל",
    "385": "קֳדָם אֲבוּהוֹן דִּי בִשְׁמַיָּא",
    "386": "וְאִמְרוּ אָמֵן:",
    "387": "יְהֵא שְׁלָמָא רַבָּא מִן שְׁמַיָּא",
    "388": "וְחַיִּים טוֹבִים",
    "389": "עָלֵֽינוּ וְעַל כָּל יִשְׂרָאֵל",
    "390": "וְאִמְרוּ אָמֵן:",
    "391": "עוֹשֶׂה שָׁלוֹם בִּמְרוֹמָיו",
    "392": "הוּא יַעֲשֶׂה שָׁלוֹם",
    "393": "עָלֵֽינוּ וְעַל כָּל יִשְׂרָאֵל",
    "394": "וְאִמְרוּ אָמֵן:"
   },
   "en": {
    "360": "<small>The Chazzan recites the following Kaddish:</small>",
    "361": "Exalted and sanctified be His great Name",
    "362": "in the world which He created",
    "363": "according to His will",
    "364": "and may He rule His kingdom",
    "365": "bring forth His redemption",
    "366": "and hasten the coming of His Mashiach",
    "367": "in your lifetime and in your days,",
    "368": "and in the lifetime",
    "369": "of the entire House of Israel,",
    "370": "speedily and in the near future—",
    "371": "and say Amein.",
    "372": "May His great Name be blessed",
    "373": "forever and for all eternity.",
    "374": "Blessed and praised,",
    "375": "glorified, and exalted and uplifted,",
    "376": "honored and elevated and extolled",
    "377": "be the Name of the Holy One, blessed is He;",
    "378": "above (<i>Shabbos Shuva:</i> far above)",
    "379": "all the blessings and hymns,",
    "380": "praises and consolations",
    "381": "which we utter in the world—and say Amein.",
    "382": "May there be acceptance",
    "383": "of the prayers and supplications",
    "384": "of the entire House of Israel",
    "385": "before their Father in heaven.",
    "386": "And say, Amein.",
    "387": "May there be abundant peace from heaven",
    "388": "and good life",
    "389": "for us and for all Israel,",
    "390": "—and say Amein.",
    "391": "He Who makes peace in His high heavens",
    "392": "may He, make peace",
    "393": "for us and for all Israel,",
    "394": "—and say Amein."
   }
  }
 }
}
