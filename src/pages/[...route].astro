---
// One prebuilt page per view of every map, each with its movement, prayer and section open, followed
// by every map closed (so day and service switch in place; see allMaps in src/view/map.tsx). A deep
// link's small inline script puts its target at the top before the first paint (see landingFor); one
// that opens on a calendar box runs the small script that writes its verdict (src/notes-script.ts).
import Page from "../layouts/Page.astro";
import { notesScript } from "../notes-script";
import { mapRoutes, type MapRoute } from "../routes";
import { allMaps, renderMapPage } from "../view/map";

export function getStaticPaths() {
  return mapRoutes().map(route => ({ params: { route: [route.map.day, route.map.id, route.section, route.part, route.sub].filter(Boolean).join("/") }, props: { route } }));
}

const { route } = Astro.props as { route: MapRoute };
const page = renderMapPage(route);
---
<Page title={page.title} opensOnText={page.opensOnText}>
  <Fragment set:html={page.main} />
  {page.main.includes("data-note=") && <script is:inline set:html={notesScript(page.main)} />}
  {page.landing && <script is:inline set:html={`(function(s){for(var e of document.querySelectorAll(s))if(e.getClientRects().length){e.scrollIntoView({block:"start",behavior:"instant"});break}})(${JSON.stringify(page.landing)})`} />}
  <Fragment set:html={allMaps()} />
</Page>
